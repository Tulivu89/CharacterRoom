function CrGamesSurface(props: { mobile: boolean }) : any
{
  return h("div", { class: "cr-surface cr-surface-games" }, h(CrRpgSurface, { mobile: props.mobile }));
}

const CR_RAIL_ITEMS: { id: CrSurface; label: string; glyph: string }[] = [
  { id: "chat",   label: "Chat",   glyph: "◎" },
  { id: "cards",  label: "Cards",  glyph: "▤" },
  { id: "illustrator", label: "Illustrate", glyph: "❖" },
  { id: "jots",   label: "Jots",   glyph: "✎" },
  { id: "global", label: "Global", glyph: "⚙" },
  { id: "games",  label: "Games",  glyph: "♠" }
];

function CrNav(props: { st: CrUiState }) : any
{
  const mob = props.st.layout === "mobile";
  const items = CR_RAIL_ITEMS.map((item) => {
    const on = props.st.surface === item.id;
    return h(CrPressable, {
      key: item.id,
      render: (hover: boolean, press: boolean, handlers: any) => h("button", Object.assign({
        class: "cr-nav-item" + (on ? " cr-nav-item-on" : ""),
        onClick: () => crNav({ surface: item.id, openContactId: "" }),
        style: mob ? {
          appearance: "none", cursor: "pointer", border: "none",
          flex: "1 1 0", minWidth: "0",
          display: "flex", flexDirection: "column", alignItems: "center", gap: CR_S_1,
          padding: "7px 2px 6px 2px",
          background: crPressBg(hover, press, "transparent"),
          color: on ? CR_ACCENT : (hover ? CR_TEXT : CR_DIM), font: "inherit", fontSize: CR_T_XS,
          fontWeight: on ? "600" : "400",
          transition: CR_MOTION, touchAction: "manipulation"
        } : {
          appearance: "none", cursor: "pointer", textAlign: "left",
          display: "flex", alignItems: "center", gap: CR_S_3,
          padding: "9px 10px", borderRadius: CR_RADIUS_S, border: "none",
          background: crPressBg(hover, press, on ? CR_FILL2 : "transparent"),
          color: (on || hover) ? CR_HEAD : CR_DIM, font: "inherit", fontSize: CR_T_BASE,
          fontWeight: on ? "600" : "400", whiteSpace: "nowrap",
          transition: CR_MOTION, touchAction: "manipulation"
        }
      }, handlers),
        h("span", { style: { fontSize: CR_T_LG, width: mob ? "auto" : "16px", textAlign: "center", lineHeight: "1.1" } }, item.glyph),
        h("span", { style: { whiteSpace: "nowrap", overflow: "hidden", textOverflow: "ellipsis", maxWidth: "100%" } }, item.label)
      )
    });
  });

  if (mob){
    return h("nav", {
      class: "cr-nav cr-nav-bottom",
      style: {
        background: CR_RAIL, borderTop: CR_LINE_W + " solid " + CR_LINE,
        display: "flex", alignItems: "stretch", minWidth: "0"
      }
    }, items);
  }
  return h("nav", {
    class: "cr-nav cr-nav-rail",
    style: {
      background: CR_RAIL, borderRight: CR_LINE_W + " solid " + CR_LINE,
      padding: "12px 8px", display: "flex", flexDirection: "column", gap: CR_S_1,
      minWidth: "0", overflowY: "auto"
    }
  },
    h("div", {
      style: { color: CR_HEAD, fontWeight: "700", fontSize: CR_T_BASE, letterSpacing: "0.04em",
               padding: "4px 10px 14px 10px", whiteSpace: "nowrap" }
    }, "CHARACTERROOM"),
    items
  );
}

function CrRoot() : any
{
  const st = useStoreValue(crUiStore);
  let body: any;
  if (st.surface === "chat"){
    body = h(CrChatSurface, { mobile: st.layout === "mobile", tab: st.chatTab });
  }
  else if (st.surface === "illustrator"){
    body = h(CrIllustratorSurface, { st: st });
  }
  else if (st.surface === "jots"){
    body = h(CrJotsSurface, null);
  }
  else if (st.surface === "global"){
    body = h(CrGlobalSurface, { st: st });
  }
  else if (st.surface === "games"){
    body = h(CrGamesSurface, { mobile: st.layout === "mobile" });
  }
  else {
    body = h(CrCardsSurface, { st: st });
    if (st.openContactId){
      if (st.openKind === "user"){
        const openUser = userList.find((u) => u.id === st.openContactId);
        if (openUser){ body = h(CrUserProfile, { st: st, user: openUser }); }
      }
      else if (st.openKind === "scenario"){
        const openScenario = scenarioList.find((s) => s.id === st.openContactId);
        if (openScenario){ body = h(CrScenarioProfile, { st: st, scenario: openScenario }); }
      }
      else {
        const openChar = charList.find((c) => c.id === st.openContactId);
        if (openChar){ body = h(CrContactProfile, { st: st, char: openChar }); }
      }
    }
  }
  const mob = st.layout === "mobile";
  const shellStyle: any = mob ? {
    display: "grid", gridTemplateColumns: "minmax(0,1fr)",
    gridTemplateRows: "minmax(0,1fr) auto", height: "100%", minHeight: "0",
    background: CR_BG, color: CR_TEXT, font: CR_FONT, fontSize: CR_T_BASE
  } : {
    display: "grid", gridTemplateColumns: "168px minmax(0,1fr)",
    gridTemplateRows: "minmax(0,1fr)", height: "100%", minHeight: "0",
    background: CR_BG, color: CR_TEXT, font: CR_FONT, fontSize: CR_T_BASE
  };
  const stageOpen = st.surface === "chat" && st.chatTab === "stage";
  const main = h("main", {
    class: "cr-main" + (stageOpen ? " cr-main-bleed" : ""),
    style: {
      minWidth: "0", minHeight: "0", overflowY: stageOpen ? "hidden" : "auto",
      padding: stageOpen ? "0" : (mob ? "12px 12px 16px 12px" : "16px 18px 24px 18px")
    }
  }, body);
  return h("div", { class: "cr-shell" + (mob ? " cr-shell-mobile" : " cr-shell-desktop"), style: shellStyle },
    mob ? main : h(CrNav, { st: st }),
    mob ? h(CrNav, { st: st }) : main
  );
}

// [KIT-FROM-CE]
const CR_SHELL_MIN_PX = 420;

function crJsxPart(id: string) : UIPart
{
  return {
    type: "jsx",
    id: id,
    style: {
      display: "grid", gridTemplateRows: "minmax(0,1fr)",
      gridTemplateColumns: "minmax(0,1fr)", height: "100%",
      minHeight: CR_SHELL_MIN_PX + "px"
    },
    onMount: function(elem: any){
      try{
        elem.style.display = "grid";
        elem.style.gridTemplateRows = "minmax(0,1fr)";
        elem.style.gridTemplateColumns = "minmax(0,1fr)";
        elem.style.height = "100%";
        elem.style.minHeight = "0";
        render(h(CrRoot, null), elem);
      }
      catch (e){
        api.v1.error("[CR:ui] mount failed:", e);
      }
    }
  } as UIPart;
}

async function crOpenShell(surface?: CrSurface) : Promise<void>
{
  await crClockLoad();
  if (surface){
    crNav({ surface: surface, openContactId: "" });
  }
  if (crShellHandle && crShellHandle.isClosed && !crShellHandle.isClosed()){
    return;
  }
  try{
    const mob = crUiStore.get().layout === "mobile";
    crShellHandle = await api.v1.ui.window.open({
      id: "cr-shell",
      title: "CharacterRoom",
      defaultWidth: mob ? "96%" : "52%",
      defaultHeight: mob ? "88%" : "84%",
      minWidth: mob ? 280 : 420,
      minHeight: CR_SHELL_MIN_PX,
      resizable: true,
      content: [crJsxPart("cr-shell-jsx")]
    });
    if (crShellHandle && crShellHandle.closed && typeof crShellHandle.closed.then === "function"){
      crShellHandle.closed.then(function(){ crShellHandle = null; });
    }
  }
  catch (e){
    crShellHandle = null;
    api.v1.error("[CR:ui] shell open failed:", e);
    try{
      await api.v1.ui.toast("Could not open the CharacterRoom window. " + String(e), { type: "error" });
    }
    catch (e2){ }
  }
}

// ============================================================================
// SECTION CR-IMG — IMAGE SETTINGS, PROMPT CHUNKS AND SLOT GENERATION
// ============================================================================
// [KIT-FROM-CE]
const CR_IMG_MODELS: { id: string; label: string }[] = [
  { id: "nai-diffusion-5-full",      label: "V5 Full" },
  { id: "nai-diffusion-5-curated",   label: "V5 Curated" },
  { id: "nai-diffusion-4-5-full",    label: "V4.5 Full" },
  { id: "nai-diffusion-4-5-curated", label: "V4.5 Curated" }
];

// [KIT-FROM-CE]
const CR_IMG_MODEL_DEFAULT = "nai-diffusion-4-5-full";

const CR_IMG_SIZES: { label: string; w: number; h: number }[] = [
  { label: "Portrait 832×1216", w: 832, h: 1216 },
  { label: "Square 1024×1024",  w: 1024, h: 1024 },
  { label: "Landscape 1216×832", w: 1216, h: 832 }
];

const CR_IMG_SETTINGS_KEY = "crImgSettingsKey";
const CR_IMG_FIELDS_KEY = "crImgFieldsKey";
const CR_EMOTAGS_KEY = "crEmotionTagsKey";

type CrImgSettings = {
  model: string;
  width: number;
  height: number;
  scale: number;
  steps: number;
  seed: number;
};

type CrImgField = {
  id: string;
  label: string;
  basePrompt: string;
  uc: string;
  weight: number;
  active: boolean;
};

const CR_IMG_SETTINGS_DEFAULT: CrImgSettings = {
  model: CR_IMG_MODEL_DEFAULT,
  width: 832, height: 1216, scale: 5.0, steps: 28, seed: 0
};

const CR_IMG_FIELDS_DEFAULT: CrImgField[] = [
  {
    id: "cr-base",
    label: "Base quality",
    basePrompt: "best quality, very aesthetic, absurdres",
    uc: "lowres, worst quality, bad anatomy, bad hands, jpeg artifacts, watermark, signature",
    weight: 1,
    active: true
  }
];

await api.v1.storage.setIfAbsent(CR_IMG_SETTINGS_KEY, CR_IMG_SETTINGS_DEFAULT);
await api.v1.storage.setIfAbsent(CR_IMG_FIELDS_KEY, CR_IMG_FIELDS_DEFAULT);

function crSanitizeImgSettings(v: any) : CrImgSettings
{
  const out: CrImgSettings = {
    model: CR_IMG_SETTINGS_DEFAULT.model,
    width: CR_IMG_SETTINGS_DEFAULT.width,
    height: CR_IMG_SETTINGS_DEFAULT.height,
    scale: CR_IMG_SETTINGS_DEFAULT.scale,
    steps: CR_IMG_SETTINGS_DEFAULT.steps,
    seed: CR_IMG_SETTINGS_DEFAULT.seed
  };
  if (!v || typeof v !== "object"){
    return out;
  }
  // [KIT-FROM-CE]
  if (typeof v.model === "string" && crImgModelKnown(v.model)){
    out.model = v.model;
  }
  const w = Math.round(Number(v.width));
  const hh = Math.round(Number(v.height));
  if (isFinite(w) && w >= 64 && w <= 2048){ out.width = w; }
  if (isFinite(hh) && hh >= 64 && hh <= 2048){ out.height = hh; }
  const sc = Number(v.scale);
  if (isFinite(sc) && sc >= 0 && sc <= 20){ out.scale = sc; }
  const st = Math.round(Number(v.steps));
  if (isFinite(st) && st >= 1 && st <= 50){ out.steps = st; }
  const sd = Math.round(Number(v.seed));
  if (isFinite(sd) && sd >= 0 && sd <= 4294967295){ out.seed = sd; }
  return out;
}

function crImgModelKnown(id: string) : boolean
{
  for (let i = 0; i < CR_IMG_MODELS.length; i++){
    if (CR_IMG_MODELS[i].id === id){
      return true;
    }
  }
  return false;
}

function crSanitizeImgFields(v: any) : CrImgField[]
{
  if (!Array.isArray(v)){
    return CR_IMG_FIELDS_DEFAULT.slice();
  }
  const out: CrImgField[] = [];
  for (let i = 0; i < v.length && out.length < 24; i++){
    const raw = v[i];
    if (!raw || typeof raw !== "object"){
      continue;
    }
    const id = typeof raw.id === "string" && raw.id ? raw.id.slice(0, 64) : ("cr-f" + i);
    const wRaw = Number(raw.weight);
    out.push({
      id: id,
      label: typeof raw.label === "string" ? raw.label.slice(0, 80) : "Chunk",
      basePrompt: typeof raw.basePrompt === "string" ? raw.basePrompt.slice(0, 1200) : "",
      uc: typeof raw.uc === "string" ? raw.uc.slice(0, 1200) : "",
      weight: (isFinite(wRaw) && wRaw > 0) ? Math.max(0.1, Math.min(10, wRaw)) : 1,
      active: raw.active !== false
    });
  }
  return out;
}

function crSanitizeEmotionTags(v: any) : Record<string, string>
{
  const out: Record<string, string> = {};
  if (!v || typeof v !== "object"){
    return out;
  }
  const names = EMOTION_LIST.concat([CR_SLOT_AVATAR]);
  for (let i = 0; i < names.length; i++){
    const tag = crSanitizeText((v as any)[names[i]], 400);
    if (tag){
      out[names[i]] = tag;
    }
  }
  return out;
}

let crEmotionTags: Record<string, string> = crSanitizeEmotionTags(await api.v1.storage.get(CR_EMOTAGS_KEY));
let crImgSettings: CrImgSettings = crSanitizeImgSettings(await api.v1.storage.get(CR_IMG_SETTINGS_KEY));
let crImgFields: CrImgField[] = crSanitizeImgFields(await api.v1.storage.get(CR_IMG_FIELDS_KEY));

async function crSaveImgSettings() : Promise<void>
{
  try{
    await api.v1.storage.set(CR_IMG_SETTINGS_KEY, crImgSettings);
  }
  catch (e){
    api.v1.error("[CR:img] could not store the image settings:", e);
  }
  crTouch();
}

async function crSaveEmotionTags() : Promise<void>
{
  try{
    await api.v1.storage.set(CR_EMOTAGS_KEY, crEmotionTags);
  }
  catch (e){
    api.v1.error("[CR:img] could not store the emotion tags:", e);
  }
  crTouch();
}

async function crSetEmotionTag(slot: string, tag: string) : Promise<void>
{
  const clean = String(tag || "").slice(0, 400);
  if (clean){
    crEmotionTags[slot] = clean;
  }
  else {
    delete crEmotionTags[slot];
  }
  await crSaveEmotionTags();
}

async function crSaveImgFields() : Promise<void>
{
  try{
    await api.v1.storage.set(CR_IMG_FIELDS_KEY, crImgFields);
  }
  catch (e){
    api.v1.error("[CR:img] could not store the prompt chunks:", e);
  }
  crTouch();
}

function crCompileImgFields() : { quality: string; negative: string }
{
  const qualityParts: string[] = [];
  const negativeParts: string[] = [];
  for (let i = 0; i < crImgFields.length; i++){
    const f = crImgFields[i];
    if (!f.active){
      continue;
    }
    const w = (typeof f.weight === "number" && f.weight > 0) ? Math.max(0.1, Math.min(10, f.weight)) : 1;
    const bp = (f.basePrompt || "").trim();
    const uc = (f.uc || "").trim();
    if (bp){
      qualityParts.push(w !== 1 ? (w + "::" + bp + "::") : bp);
    }
    if (uc){
      negativeParts.push(w !== 1 ? (w + "::" + uc + "::") : uc);
    }
  }
  return { quality: qualityParts.join(", "), negative: negativeParts.join(", ") };
}

function crSlotTag(char: CrCastCard, slot: string) : string
{
  const tags: any = (char.cr && (char.cr as any).imgTags) ? (char.cr as any).imgTags : undefined;
  if (tags && typeof tags[slot] === "string"){
    return tags[slot];
  }
  if (typeof crEmotionTags[slot] === "string"){
    return crEmotionTags[slot];
  }
  return (slot === CR_SLOT_AVATAR || slot === CR_SLOT_BANNER) ? "" : slot;
}

function crEmotionTagDefault(slot: string) : string
{
  return typeof crEmotionTags[slot] === "string" ? crEmotionTags[slot] : "";
}

function crHasSlotOverride(char: Character, slot: string) : boolean
{
  const tags = char.cr && char.cr.imgTags ? char.cr.imgTags : undefined;
  return !!(tags && typeof tags[slot] === "string");
}

async function crSetSlotTag(char: Character, slot: string, tag: string) : Promise<void>
{
  const extra: CrContactExtra = char.cr || {};
  const tags: Record<string, string> = extra.imgTags || {};
  const clean = String(tag || "").slice(0, 400);
  if (clean){
    tags[slot] = clean;
  }
  else {
    delete tags[slot];
  }
  extra.imgTags = Object.keys(tags).length > 0 ? tags : undefined;
  char.cr = crSanitizeContactExtra(extra);
  try{
    await saveCharList();
  }
  catch (e){
    api.v1.error("[CR:img] could not save the slot tag:", e);
  }
  crTouch();
}

type CrCastCard = Character | User;

function crAssembleCharacterPrompt(char: CrCastCard, purpose: "avatar" | "illustrate") : { visuals: string; uc: string }
{
  const card: CrImgCard = (char.cr && char.cr.img) ? char.cr.img : {};
  const vis: string[] = [];
  const uc: string[] = [];

  const universal = (card.universalPrompt || "").trim();
  vis.push(universal || crCharacterAppearance(char));
  if (card.universalUC){
    uc.push(card.universalUC);
  }

  if (purpose === "avatar"){
    if (card.avatarPrompt){ vis.push(card.avatarPrompt); }
    if (card.avatarUC){ uc.push(card.avatarUC); }
  }
  else {
    if (card.illustratorPrompt){ vis.push(card.illustratorPrompt); }
    if (card.illustratorUC){ uc.push(card.illustratorUC); }
  }

  const outfits = card.outfits || [];
  for (let i = 0; i < outfits.length; i++){
    if (!outfits[i].active){
      continue;
    }
    if (outfits[i].prompt){ vis.push(outfits[i].prompt); }
    if (outfits[i].uc){ uc.push(outfits[i].uc); }
  }

  return {
    visuals: vis.filter((p) => p && p.trim()).join(", "),
    uc: uc.filter((p) => p && p.trim()).join(", ")
  };
}

function crAssembleBasePrompt(char: CrCastCard, purpose: "avatar" | "illustrate") : { base: string; uc: string }
{
  const card: CrImgCard = (char.cr && char.cr.img) ? char.cr.img : {};
  return {
    base: (card.basePrompt || "").trim(),
    uc: (card.baseUC || "").trim()
  };
}

function crLiveScenario() : Scenario | undefined
{
  const snap = chatSettings.scenario;
  if (!snap){
    return undefined;
  }
  return scenarioList.find((s) => s.id === snap.id) || snap;
}

function crLiveContact() : Character | undefined
{
  const snap = chatSettings.char;
  if (!snap){
    return undefined;
  }
  return charList.find((c) => c.id === snap.id) || snap;
}

function crLiveUser() : User | undefined
{
  const snap = chatSettings.user;
  if (!snap){
    return undefined;
  }
  return userList.find((u) => u.id === snap.id) || snap;
}

function crSceneBasePrompt() : { base: string; uc: string }
{
  const scenario = crLiveScenario();
  const card: CrSceneCard = (scenario && scenario.cr && scenario.cr.img) ? scenario.cr.img : {};
  return {
    base: (card.basePrompt || "").trim(),
    uc: (card.baseUC || "").trim()
  };
}

function crCharacterAppearance(char: CrCastCard) : string
{
  return [char.appearance, char.species, char.gender].filter((p) => p && String(p).trim()).join(", ");
}

async function crGenerateSlot(char: CrCastCard, slot: string) : Promise<void>
{
  if (!crBridge.ready){
    crGenReqNote(slot, char.id, "the bridge is not connected");
    try{ await api.v1.ui.toast("The bridge is not connected, so nothing can generate.", { type: "warning" }); }
    catch (e){}
    return;
  }
  const character = crAssembleCharacterPrompt(char, "avatar");
  if (!character.visuals){
    crGenReqNote(slot, char.id, "the card has no Appearance and no Universal prompt");
    try{ await api.v1.ui.toast("This card has nothing to draw — write an Appearance, or a Universal prompt on its Images tab.", { type: "warning" }); }
    catch (e){}
    return;
  }
  const compiled = crCompileImgFields();
  const base = crAssembleBasePrompt(char, "avatar");
  const tag = crSlotTag(char, slot);
  const card: CrImgCard = (char.cr && char.cr.img) ? char.cr.img : {};
  const seed = (card.avatarSeed && card.avatarSeed > 0) ? card.avatarSeed : crImgSettings.seed;
  const uuid = "cr-" + char.id.slice(0, 8) + "-" + slot + "-" + Date.now();
  await crBridgeSend("GENERATE_IMAGE", {
    kind: "charSlot",
    charId: char.id,
    slot: slot,
    uuid: uuid,
    prompt: [tag, slot === CR_SLOT_BANNER ? "wide shot, full body, scenery" : "portrait, upper body"].filter(Boolean).join(", "),
    extraBaseVisuals: base.base,
    extraBaseUC: base.uc,
    characters: [{ name: char.name || "character", visuals: character.visuals, uc: character.uc }],
    settings: {
      model: crImgSettings.model,
      width: crImgSettings.width,
      height: crImgSettings.height,
      scale: crImgSettings.scale,
      steps: crImgSettings.steps,
      seed: seed,
      quality: compiled.quality,
      negative: compiled.negative
    }
  });
  crGenReqNote(slot, char.id, "", {
    visualsLen: character.visuals.length,
    promptLen: tag.length,
    baseLen: base.base.length,
    model: crImgSettings.model,
    size: String(crImgSettings.width) + "x" + String(crImgSettings.height),
    steps: crImgSettings.steps,
    seed: seed
  });
  try{ await api.v1.ui.toast("Generating " + slot + "…", { type: "info", autoClose: 2500 }); }
  catch (e){}
}

async function crGenerateBanner(scenario: Scenario) : Promise<void>
{
  if (!crBridge.ready){
    try{ await api.v1.ui.toast("The bridge is not connected, so nothing can generate.", { type: "warning" }); }
    catch (e){}
    return;
  }
  const card: CrSceneCard = (scenario.cr && scenario.cr.img) ? scenario.cr.img : {};
  const banner = (card.bannerPrompt || "").trim();
  const base = (card.basePrompt || "").trim();
  if (!banner && !base){
    try{ await api.v1.ui.toast("This Scenario has nothing to draw — write a scene or banner prompt on its Visuals tab.", { type: "warning" }); }
    catch (e){}
    return;
  }
  const compiled = crCompileImgFields();
  const seed = (card.bannerSeed && card.bannerSeed > 0) ? card.bannerSeed : crImgSettings.seed;
  const uuid = "cr-" + scenario.id.slice(0, 8) + "-Banner-" + Date.now();
  await crBridgeSend("GENERATE_IMAGE", {
    kind: "charSlot",
    charId: scenario.id,
    slot: CR_SLOT_BANNER,
    uuid: uuid,
    prompt: [banner || base, "no humans, scenery, wide shot"].filter(Boolean).join(", "),
    extraBaseVisuals: banner ? base : "",
    extraBaseUC: (card.bannerUC || card.baseUC || "").trim(),
    characters: [],
    settings: {
      model: crImgSettings.model,
      width: crImgSettings.width,
      height: crImgSettings.height,
      scale: crImgSettings.scale,
      steps: crImgSettings.steps,
      seed: seed,
      quality: compiled.quality,
      negative: compiled.negative
    }
  });
  try{ await api.v1.ui.toast("Generating the banner…", { type: "info", autoClose: 2500 }); }
  catch (e){}
}

// ============================================================================
// SECTION CR-SCAN — STORY SCAN AND THE ARCHITECT PASS
// ============================================================================
// [KIT-FROM-CE]
const CR_ARCH_CTX_KEY = "crArchitectContextKey";
const CR_ARCH_CTX_DEFAULT = 4;
const CR_ARCH_CTX_MIN = 1;
const CR_ARCH_CTX_MAX = 20;

const CR_ARCH_INSTRUCTION = "You are an image prompt architect for NovelAI Diffusion V4.5 and V5.\n\n" +
  "WHAT YOU ARE GIVEN AND WHAT YOU MUST NOT REPEAT. Each character's appearance is delivered " +
  "to the renderer separately, in its own scoped caption. So is the location's look, and so is " +
  "anything a character is carrying. NEVER describe a character's hair, eyes, skin, build, " +
  "species, face, clothing or equipment. NEVER describe the fixed appearance of the setting. " +
  "Restating them here applies them to the WHOLE image and bleeds one character's traits onto " +
  "another, which is the single worst thing you can do.\n\n" +
  "YOUR JOB IS EVERYTHING THAT CHANGES: framing, camera, composition, who is doing what, " +
  "expressions, poses, contact between bodies, where people are relative to each other and to " +
  "the frame, light, weather, time of day, and any state the scene has put on them \u2014 wet, " +
  "bloodied, dishevelled, lit from one side.\n\n" +
  "OUTPUT SHAPE. Comma-separated tags first, then prose, in one block:\n" +
  "1. Subject count first (1girl, 2boys, 1other), then camera and composition tags (from below, " +
  "close-up, wide shot, over-the-shoulder, dutch angle), then lighting and environment mood " +
  "tags. Danbooru style, lowercase, comma separated.\n" +
  "2. Then two to four sentences of plain prose describing the moment: the action, the " +
  "expressions, the positions, what the light is doing. Write it as an observer describing a " +
  "photograph, present tense. V5 leans on this prose and V4.5 still reads it, so it carries the " +
  "scene \u2014 the tags only set the frame.\n\n" +
  "POSITION IS PROSE, NEVER COORDINATES. Say who is on the left, who is behind, who is closer " +
  "to the camera. Do not emit numbers, coordinates, or position syntax of any kind.\n\n" +
  "NEVER EMIT WEIGHTS. No `::`, no numeric emphasis, no brackets or braces around any term. A " +
  "weight you invent will ruin the render.\n\n" +
  "RATING. Omit any rating tag for ordinary scenes. Only when the scene is genuinely sexual or " +
  "graphically violent, add the appropriate rating tag \u2014 and in that case ALSO add the " +
  "conventional Danbooru tags for the specific acts, positions and states depicted, alongside " +
  "the prose. Be explicit and specific in the tags; the prose alone will not carry it.\n\n" +
  "Output ONLY the prompt text. No headers, no bullets, no commentary, no quotation marks.";

const CR_ARCH_FRAME_RULES = "\n\nReminders: do not describe how anyone looks and do not name " +
  "them. Tags first, then two to four sentences of prose. No weights, no coordinates.";

await api.v1.storage.setIfAbsent(CR_ARCH_CTX_KEY, CR_ARCH_CTX_DEFAULT);

let crArchContextSize: number = crClampArchCtx(await api.v1.storage.get(CR_ARCH_CTX_KEY));

function crClampArchCtx(v: any) : number
{
  const n = Math.round(Number(v));
  if (!isFinite(n)){
    return CR_ARCH_CTX_DEFAULT;
  }
  return Math.max(CR_ARCH_CTX_MIN, Math.min(CR_ARCH_CTX_MAX, n));
}

async function crSaveArchSettings() : Promise<void>
{
  try{
    await api.v1.storage.set(CR_ARCH_CTX_KEY, crArchContextSize);
  }
  catch (e){
    api.v1.error("[CR:scan] could not store the architect settings:", e);
  }
  crTouch();
}

async function crReadRecentStory(sections?: number) : Promise<string>
{
  try{
    const nodeId = await api.v1.document.history.currentNodeId();
    const node = await api.v1.document.history.nodeState(nodeId);
    if (!node || !node.sections){
      return "";
    }
    const want = (typeof sections === "number" && sections > 0) ? sections : crArchContextSize;
    const start = Math.max(0, node.sections.length - want);
    let text = "";
    for (let i = start; i < node.sections.length; i++){
      const sec: any = node.sections[i];
      if (sec && sec.section && sec.section.text){
        text += sec.section.text + "\n";
      }
    }
    return text;
  }
  catch (e){
    api.v1.error("[CR:scan] could not read the document:", e);
    return "";
  }
}

function crEscapeForRegex(s: string) : string
{
  return s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
}

function crDetectCast(text: string) : Character[]
{
  const found: Character[] = [];
  if (!text){
    return found;
  }
  for (let i = 0; i < charList.length; i++){
    const c = charList[i];
    const names: string[] = [c.name, c.alias || ""].filter((n) => n && String(n).trim().length > 1);
    let hit = false;
    for (let j = 0; j < names.length && !hit; j++){
      try{
        if (new RegExp("\\b" + crEscapeForRegex(String(names[j])) + "\\b", "i").test(text)){
          hit = true;
        }
      }
      catch (e){
      }
    }
    if (hit){
      found.push(c);
    }
  }
  return found;
}

type CrScanResult = {
  prompt: string;
  cast: Character[];
  storyText: string;
};

async function crArchitectScene(sections?: number) : Promise<CrScanResult | null>
{
  const storyText = await crReadRecentStory(sections);
  if (!storyText.trim()){
    try{ await api.v1.ui.toast("Nothing to read — the story is empty.", { type: "warning" }); }
    catch (e){}
    return null;
  }
  const cast = crDetectCast(storyText);
  const castBlock = cast.length > 0
    ? "\n\nIn the scene (their appearance is supplied to the renderer separately — name " +
      "them and say what they do, do not describe how they look):\n" +
      cast.map((c) => "- " + c.name).join("\n")
    : "";

  try{
    const genParams = await api.v1.generationParameters.get();
    const messages: APIMessage[] = [
      { role: "system", content: CR_ARCH_INSTRUCTION },
      { role: "user", content: "Current scene:\n" + storyText.trim() + castBlock +
                               CR_ARCH_FRAME_RULES + "\n\nGenerate the image prompt:" }
    ];
    const response = await crSideGenerate(messages, {
      model: genParams.model,
      max_tokens: 320 + (cast.length * 60),
      temperature: 0.7
    });
    const raw = (response && response.choices && response.choices[0] && response.choices[0].text)
      ? String(response.choices[0].text)
      : "";
    const prompt = crStripArchNoise(raw);
    if (!prompt){
      return null;
    }
    return { prompt: prompt, cast: cast, storyText: storyText };
  }
  catch (e){
    api.v1.error("[CR:scan] architect pass failed:", e);
    try{ await api.v1.ui.toast("The scan could not reach the model.", { type: "error" }); }
    catch (e2){}
    return null;
  }
}

// [KIT-FROM-CE]
function crStripArchNoise(raw: string) : string
{
  let out = String(raw || "");
  out = out.replace(/<think>[\s\S]*?<\/think>/gi, "");
  out = out.replace(/<\/?think>/gi, "");
  const fence = out.match(/```[a-z]*\n([\s\S]*?)```/i);
  if (fence && fence[1]){
    out = fence[1];
  }
  out = out.trim();
  out = out.replace(/^(image\s*)?prompt\s*[:\-—]\s*/i, "");
  out = out.replace(/^["'“”]+|["'“”]+$/g, "");
  return out.trim();
}

// [KIT-FROM-CE]
type CrEnhanceCastIn = { id: string; name: string; visuals: string };
type CrEnhanceResult = { prompt: string; visuals: { id: string; name: string; visuals: string }[] };

function crExtractJSON(raw: string) : any
{
  let text = String(raw || "");
  text = text.replace(/<think>[\s\S]*?<\/think>/gi, "");
  text = text.replace(/<\/?think>/gi, "");
  const fence = text.match(/```[a-z]*\n([\s\S]*?)```/i);
  if (fence && fence[1]){
    text = fence[1];
  }
  const start = text.indexOf("{");
  if (start < 0){
    return null;
  }
  let depth = 0;
  let inStr = false;
  let esc = false;
  for (let i = start; i < text.length; i++){
    const ch = text.charAt(i);
    if (inStr){
      if (esc){ esc = false; }
      else if (ch === "\\"){ esc = true; }
      else if (ch === "\""){ inStr = false; }
      continue;
    }
    if (ch === "\""){ inStr = true; }
    else if (ch === "{"){ depth++; }
    else if (ch === "}"){
      depth--;
      if (depth === 0){
        try{ return JSON.parse(text.slice(start, i + 1)); }
        catch (e){ return null; }
      }
    }
  }
  return null;
}

async function crEnhanceScene(prompt: string, cast: CrEnhanceCastIn[]) : Promise<CrEnhanceResult | null>
{
  const text = String(prompt || "").trim();
  if (!text){
    return null;
  }
  const list = cast || [];
  const castLines = list.map(function(c, i){
    const label = "Character " + (i + 1) + (c.name && c.name.trim() ? " (" + c.name.trim() + ")" : " (unnamed)");
    return c.visuals && c.visuals.trim()
      ? "\n" + label + ": Known visuals are \"" + c.visuals.trim() + "\". Refine these in " +
        "char_visuals; do not repeat them in enhanced_prompt."
      : "\n" + label + ": No known visuals. Write appropriate tags in char_visuals; do not " +
        "repeat them in enhanced_prompt.";
  });

  const sys = "You write prompts for an anime-style image generator. Output ONLY a valid " +
    "JSON object, no markdown:\n{\n" +
    "  \"enhanced_prompt\": \"The scene, as comma-separated visual tags. How many people are " +
    "in it, the setting, the time of day, the lighting, what is happening, the shot and the " +
    "angle. Do NOT describe any character's face, hair, eyes, skin, build, species or " +
    "clothing -- those are carried separately. No sentences, no weights, no :: and no " +
    "brackets.\",\n" +
    "  \"char_visuals\": [\"Appearance tags for character 1 if present, else an empty " +
    "string\", \"...character 2...\"]\n}\n" +
    "The char_visuals array must have exactly " + list.length + " entries, in the same order " +
    "as the characters listed below.";

  try{
    const genParams = await api.v1.generationParameters.get();
    const messages: APIMessage[] = [
      { role: "system", content: sys },
      { role: "user", content: "Rough concept: " + text + castLines.join("") + "\n\nOutput the JSON:" }
    ];
    const response = await crSideGenerate(messages, {
      model: genParams.model,
      max_tokens: 280 + (list.length * 80),
      temperature: 0.7
    });
    const raw = (response && response.choices && response.choices[0] && response.choices[0].text)
      ? String(response.choices[0].text)
      : "";
    const parsed = crExtractJSON(raw);
    if (!parsed){
      throw new Error("no JSON object in the enhance response");
    }
    const cv: any[] = Array.isArray(parsed.char_visuals) ? parsed.char_visuals : [];
    const enhanced = crStripArchNoise(String(parsed.enhanced_prompt || "")) || text;
    return {
      prompt: enhanced,
      visuals: list.map(function(c, i){
        const got = (cv[i] === undefined || cv[i] === null) ? "" : String(cv[i]).trim();
        return { id: c.id, name: c.name, visuals: got || c.visuals };
      })
    };
  }
  catch (e){
    api.v1.error("[CR:scan] enhance pass failed:", e);
    try{ await api.v1.ui.toast("Enhance could not reach the model.", { type: "error" }); }
    catch (e2){}
    return null;
  }
}

// ============================================================================
// SECTION CR-ILLUS — ILLUSTRATOR SURFACE
// ============================================================================
// [KIT-FROM-CE]
const CR_ILLUS_MAX_CAST = 4;

type CrIllusState = {
  tab: "compose" | "gallery" | "presets" | "tags";
  prompt: string;
  cast: string[];
  visuals: { [id: string]: string };
  scanning: boolean;
  enhancing: boolean;
  generating: boolean;
  lastUuid: string;
  lastAt: number;
  note: string;
};

let crIllus: CrIllusState = {
  tab: "compose", prompt: "", cast: [], visuals: {}, scanning: false, enhancing: false,
  generating: false, lastUuid: "", lastAt: 0, note: ""
};

function crIllusVisualsFor(char: CrCastCard, assembled: string) : string
{
  const over = crIllus.visuals[char.id];
  return (over && over.trim()) ? over.trim() : assembled;
}

function crIllusCastChars() : CrCastCard[]
{
  const out: CrCastCard[] = [];
  for (let i = 0; i < crIllus.cast.length; i++){
    const id = crIllus.cast[i];
    const found: CrCastCard | undefined = charList.find((c) => c.id === id) || userList.find((u) => u.id === id);
    if (found){
      out.push(found);
    }
  }
  return out;
}

function crIllusToggle(id: string)
{
  const at = crIllus.cast.indexOf(id);
  if (at >= 0){
    crIllus.cast.splice(at, 1);
    delete crIllus.visuals[id];
  }
  else if (crIllus.cast.length < CR_ILLUS_MAX_CAST){
    crIllus.cast.push(id);
  }
  crTouch();
}

async function crIllusScan() : Promise<void>
{
  if (crIllus.scanning){
    return;
  }
  crIllus.scanning = true;
  crIllus.note = "Reading the story…";
  crTouch();
  try{
    const result = await crArchitectScene();
    if (result){
      crIllus.prompt = result.prompt;
      crIllus.cast = result.cast.slice(0, CR_ILLUS_MAX_CAST).map((c) => c.id);
      crIllus.visuals = {};
      crIllus.note = result.cast.length > CR_ILLUS_MAX_CAST
        ? ("Found " + result.cast.length + " Contacts; kept the first " + CR_ILLUS_MAX_CAST + ".")
        : "";
    }
    else {
      crIllus.note = "The scan returned nothing.";
    }
  }
  finally{
    crIllus.scanning = false;
    crTouch();
  }
}

async function crIllusEnhance() : Promise<void>
{
  if (crIllus.enhancing || crIllus.scanning){
    return;
  }
  if (!crIllus.prompt.trim()){
    crIllus.note = "Write or scan a prompt first.";
    crTouch();
    return;
  }
  crIllus.enhancing = true;
  crIllus.note = "Enhancing…";
  crTouch();
  try{
    const cast = crIllusCastChars();
    const input: CrEnhanceCastIn[] = cast.map((c) => ({
      id: c.id,
      name: c.name || "",
      visuals: crIllusVisualsFor(c, crAssembleCharacterPrompt(c, "illustrate").visuals)
    }));
    const result = await crEnhanceScene(crIllus.prompt, input);
    if (result){
      crIllus.prompt = result.prompt;
      for (let i = 0; i < result.visuals.length; i++){
        const v = result.visuals[i];
        if (v.visuals && v.visuals.trim()){
          crIllus.visuals[v.id] = v.visuals.trim();
        }
      }
      crIllus.note = cast.length > 0
        ? "Enhanced. The character prompts below are this scene's version — the cards are unchanged."
        : "Enhanced.";
    }
    else {
      crIllus.note = "Enhance returned nothing usable.";
    }
  }
  finally{
    crIllus.enhancing = false;
    crTouch();
  }
}

async function crIllusGenerate() : Promise<void>
{
  if (crIllus.generating){
    return;
  }
  if (!crBridge.ready){
    crIllus.note = "The bridge is not connected, so nothing can generate.";
    crTouch();
    return;
  }
  if (!crIllus.prompt.trim()){
    crIllus.note = "Write or scan a prompt first.";
    crTouch();
    return;
  }
  crIllus.generating = true;
  crIllus.note = "";
  crTouch();
  try{
    const cast = crIllusCastChars();
    const compiled = crCompileImgFields();
    const characters: any[] = [];
    const baseBits: string[] = [];
    const baseUCBits: string[] = [];
    const scene = crSceneBasePrompt();
    if (scene.base){ baseBits.push(scene.base); }
    if (scene.uc){ baseUCBits.push(scene.uc); }
    for (let i = 0; i < cast.length; i++){
      const assembled = crAssembleCharacterPrompt(cast[i], "illustrate");
      const visuals = crIllusVisualsFor(cast[i], assembled.visuals);
      if (visuals){
        characters.push({ name: cast[i].name || "character", visuals: visuals, uc: assembled.uc });
      }
      const base = crAssembleBasePrompt(cast[i], "illustrate");
      if (base.base){ baseBits.push(base.base); }
      if (base.uc){ baseUCBits.push(base.uc); }
    }
    const uuid = "cr-illus-" + Date.now();
    await crBridgeSend("GENERATE_IMAGE", {
      uuid: uuid,
      prompt: crIllus.prompt.trim(),
      extraBaseVisuals: baseBits.join(", "),
      extraBaseUC: baseUCBits.join(", "),
      characters: characters,
      settings: {
        model: crImgSettings.model,
        width: crImgSettings.width,
        height: crImgSettings.height,
        scale: crImgSettings.scale,
        steps: crImgSettings.steps,
        seed: crImgSettings.seed,
        quality: compiled.quality,
        negative: compiled.negative
      }
    });
    crIllus.lastUuid = uuid;
    crIllus.lastAt = Date.now();
    crIllus.note = "Generating. The image appears below when the bridge has it.";
  }
  catch (e){
    api.v1.error("[CR:illus] generate failed:", e);
    crIllus.note = "The request could not be sent.";
  }
  finally{
    crIllus.generating = false;
    crTouch();
  }
}

function CrIllusComposer(props: { st: CrUiState }) : any
{
  const mob = props.st.layout === "mobile";
  const cast = crIllusCastChars();
  const preview: { id: string; name: string; text: string; enhanced: boolean }[] = [];
  for (let i = 0; i < cast.length; i++){
    const a = crAssembleCharacterPrompt(cast[i], "illustrate");
    const over = crIllus.visuals[cast[i].id];
    const text = crIllusVisualsFor(cast[i], a.visuals);
    if (text){
      preview.push({
        id: cast[i].id,
        name: cast[i].name,
        text: text,
        enhanced: !!(over && over.trim())
      });
    }
  }
  const anyEnhanced = preview.some((p) => p.enhanced);
  const compiled = crCompileImgFields();
  const scene = crSceneBasePrompt();
  const liveScenario = crLiveScenario();

  const castPick = (list: CrCastCard[]) => list.map((c) => {
    const on = crIllus.cast.indexOf(c.id) >= 0;
    const full = !on && crIllus.cast.length >= CR_ILLUS_MAX_CAST;
    return h(CrButton, {
      key: c.id,
      text: (on ? "● " : "") + (c.name || "Unnamed"),
      primary: on,
      disabled: full,
      onClick: () => crIllusToggle(c.id)
    });
  });

  return h("div", { class: "cr-illus-compose" },
    h(CrSection, {
      title: "Scene",
      note: "Scan reads the last few messages and writes a prompt here. Enhance rewrites whatever is in the box and refines each picked Contact's visuals for this scene only. Edit it freely — what is in this box is what gets sent."
    }, h("div", { style: { marginTop: CR_S_3, display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_3 } },
      h(CrTextArea, {
        value: crIllus.prompt,
        placeholder: "outdoors, night, rain, two people under one umbrella, wide shot",
        rows: mob ? 5 : 4,
        onSet: (v: string) => { crIllus.prompt = v.slice(0, 2000); crTouch(); }
      }),
      h("div", { style: { display: "flex", gap: CR_S_3, flexWrap: "wrap" } },
        h(CrButton, {
          text: crIllus.scanning ? "Scanning…" : "Scan the story",
          disabled: crIllus.scanning || crIllus.enhancing,
          onClick: () => { crIllusScan().catch(() => {}); }
        }),
        h("div", { style: { display: "flex", alignItems: "center", gap: CR_S_2 } },
          h("div", { style: { color: CR_DIM, fontSize: CR_T_SM } }, "reading"),
          h("input", {
            type: "text",
            inputMode: "numeric",
            value: Object.prototype.hasOwnProperty.call(crNumDrafts, "cr-scan-depth")
              ? crNumDrafts["cr-scan-depth"] : String(crArchContextSize),
            onInput: (e: any) => { crNumDrafts["cr-scan-depth"] = String(e.target.value); },
            onBlur: () => {
              const raw = crNumDrafts["cr-scan-depth"];
              delete crNumDrafts["cr-scan-depth"];
              if (raw !== undefined && String(raw).trim() !== ""){
                crArchContextSize = crClampArchCtx(raw);
                crSaveArchSettings().catch(() => {});
              }
              else{ crTouch(); }
            },
            style: {
              width: "46px", boxSizing: "border-box", textAlign: "center",
              background: CR_SUNK, color: CR_TEXT, font: "inherit", fontSize: CR_T_BASE,
              border: CR_LINE_W + " solid " + CR_LINE, borderRadius: CR_RADIUS_S, padding: "6px 4px"
            }
          }),
          h("div", { style: { color: CR_DIM, fontSize: CR_T_SM } }, "messages")
        ),
        h(CrButton, {
          text: crIllus.enhancing ? "Enhancing…" : "Enhance",
          disabled: crIllus.enhancing || crIllus.scanning || !crIllus.prompt.trim(),
          onClick: () => { crIllusEnhance().catch(() => {}); }
        }),
        h(CrButton, {
          text: "Clear",
          disabled: !crIllus.prompt && !anyEnhanced,
          onClick: () => {
            crIllus.prompt = "";
            crIllus.note = "";
            crIllus.visuals = {};
            crTouch();
          }
        })
      )
    )),

    h(CrSection, {
      title: "Who is in it",
      note: "Up to " + CR_ILLUS_MAX_CAST + ", Contacts or Users. Each one sends its own character prompt, built from Universal plus Illustrator plus any worn outfits — the Avatar pair is deliberately left out of scenes."
    }, h("div", { style: { marginTop: CR_S_3, display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_3 } },
      charList.length === 0 && userList.length === 0
        ? h(CrEmpty, { text: "No cards yet." })
        : null,
      charList.length > 0 ? h("div", null,
        h("div", { style: { color: CR_DIM, fontSize: CR_T_XS, marginBottom: CR_S_1 } }, "Contacts"),
        h("div", { style: { display: "flex", gap: CR_S_2, flexWrap: "wrap" } }, castPick(charList))
      ) : null,
      userList.length > 0 ? h("div", null,
        h("div", { style: { color: CR_DIM, fontSize: CR_T_XS, marginBottom: CR_S_1 } }, "Users"),
        h("div", { style: { display: "flex", gap: CR_S_2, flexWrap: "wrap" } }, castPick(userList))
      ) : null
    )),

    h(CrSection, {
      title: "Location",
      note: !liveScenario
        ? "No Scenario is paired with this chat, so nothing is added. Pair one on the Chat screen."
        : ((scene.base || scene.uc)
            ? (liveScenario.name || "The Scenario") + " adds its tags to every illustration while it is the chat's. Edit them on its Visuals tab."
            : (liveScenario.name || "The Scenario") + " is paired but has no scene tags yet — write them on its Visuals tab.")
    }, (scene.base || scene.uc) ? h("div", {
      style: { marginTop: CR_S_3, color: CR_DIM, fontSize: CR_T_SM, lineHeight: "1.5", wordBreak: "break-word" }
    }, scene.base || "(negative only)") : null),

    preview.length > 0 ? h(CrSection, {
      title: "Character prompts",
      note: anyEnhanced
        ? "A marked line is this scene's enhanced version. The Contact's card is untouched — revert to go back to it."
        : "As assembled now. A Contact with nothing written is left out rather than drawn blank."
    }, h("div", { style: { marginTop: CR_S_3, display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_3 } },
      h("div", {
        style: { color: CR_DIM, fontSize: CR_T_SM, lineHeight: "1.5", wordBreak: "break-word" }
      }, preview.map((p, i) => h("div", {
        key: p.id,
        style: { marginTop: i > 0 ? CR_S_1 : "0", color: p.enhanced ? CR_TEXT : CR_DIM }
      }, (p.enhanced ? "● " : "") + p.name + ": " + p.text))),
      anyEnhanced ? h("div", { style: { display: "flex", gap: CR_S_3, flexWrap: "wrap" } },
        h(CrButton, {
          text: "Revert to the cards",
          onClick: () => { crIllus.visuals = {}; crTouch(); }
        })
      ) : null
    )) : null,

    h(CrSection, {
      title: "Generate",
      note: crIllus.note || ("Model, size and the standing prompt chunks come from Global. One press, one image.")
    }, h("div", { style: { marginTop: CR_S_3, display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_3 } },
      h("div", { style: { display: "flex", gap: CR_S_3, flexWrap: "wrap" } },
        h(CrButton, {
          text: crIllus.generating ? "Sending…" : "Generate",
          primary: true,
          disabled: crIllus.generating || !crBridge.ready || !crIllus.prompt.trim(),
          onClick: () => { crIllusGenerate().catch(() => {}); }
        })
      ),
      h("div", {
        style: { color: CR_DIM, fontSize: CR_T_SM, lineHeight: "1.5", wordBreak: "break-word" }
      },
        h("div", null, "Chunks: " + (compiled.quality || "(none active)")),
        compiled.negative ? h("div", { style: { marginTop: CR_S_1 } }, "Negative: " + compiled.negative) : null
      )
    )),

    crIllus.lastUuid ? h(CrSection, { title: "Last image" },
      h("div", {
        style: {
          marginTop: CR_S_3, width: "100%", maxWidth: mob ? "100%" : "520px",
          aspectRatio: String(crImgSettings.width) + " / " + String(crImgSettings.height),
          borderRadius: CR_RADIUS_S, border: CR_LINE_W + " solid " + CR_LINE,
          background: CR_SUNK, overflow: "hidden", position: "relative"
        }
      }, crImgAnchor("ce-gallery", crIllus.lastUuid, "fit=contain,collapse=1",
          { position: "absolute", inset: "0", width: "100%", height: "100%", display: "block" }))
    ) : null
  );
}

function CrIllustratorSurface(props: { st: CrUiState }) : any
{
  const mob = props.st.layout === "mobile";
  return h("div", { class: "cr-surface cr-surface-illustrator" },
    h(CrTabs, {
      tabs: [
        { id: "compose", label: "Compose" },
        { id: "gallery", label: "Gallery" },
        { id: "presets", label: "Presets" },
        { id: "tags", label: "Tags" }
      ],
      active: crIllus.tab,
      mobile: mob,
      onPick: (id: string) => {
        crIllus.tab = (id === "gallery" || id === "presets" || id === "tags")
          ? (id as "gallery" | "presets" | "tags") : "compose";
        if (crIllus.tab === "gallery" && !crGal.asked){
          crGalleryRequest().catch(() => {});
        }
        crTouch();
      }
    }),
    crIllus.tab === "gallery" ? h(CrGalleryPanel, { mobile: mob })
      : crIllus.tab === "presets" ? h(CrIllusPresetsTab, null)
      : crIllus.tab === "tags" ? h(CrIllusTagsTab, null)
      : h(CrIllusComposer, { st: props.st })
  );
}

// ============================================================================
// SECTION CR-ARGEN — AR'S OWN GENERATORS, GIVEN DOORS
// ============================================================================

let crGenBusy = "";

function crGenReady() : { char: Character; user: User; cid: string } | null
{
  const char = crLiveContact();
  const user = crLiveUser();
  if (!char || !user){
    return null;
  }
  return { char: char, user: user, cid: char.id + user.id };
}

function crGenThreadText(thread: ForumThread) : string
{
  const op = thread.originalPost;
  let s = "Thread: " + (op.title || "");
  s += "\n====\n" + (op.screenName || "") + "\n" + (op.content || "");
  s += "\n  Emotion: " + String(op.emotion || "neutral");
  const replies = thread.replyList || [];
  for (let i = 0; i < replies.length; i++){
    s += "\n====\n" + (replies[i].screenName || "") + "\n" + (replies[i].content || "");
    s += "\n  Emotion: " + String(replies[i].emotion || "neutral");
  }
  return s;
}

function crGenKeys(raw: string, char: Character, user: User) : string[]
{
  let keys = String(raw || "").split(",").map((k) => k.trim());
  keys = crGenDropKey(char.name, keys);
  keys = crGenDropKey(user.name, keys);
  keys = removeJunk(keys, "\"");
  keys = removeJunk(keys, "</think>");
  return keys.filter((k) => !!k);
}

function crGenDropKey(text: string, list: string[]) : string[]
{
  const index = list.indexOf(text);
  if (index !== -1){
    list[index] = list[list.length - 1];
    list.pop();
  }
  return list;
}

async function crGenBrainEntry(kind: CrMemKind, shape: string, style: string,
                               maxTokens: number, lead: string) : Promise<boolean>
{
  const ready = crGenReady();
  if (!ready){
    return false;
  }
  const primer = ready.char.name + ": Title:";
  const messages: Message[] = [];
  if (lead){
    messages.push({ role: "system", content: lead });
  }
  messages.push({ role: "system", content: shape });
  messages.push({ role: "system", content: style });
  messages.push({ role: "assistant", content: primer });
  const response = await api.v1.generateWithStory(
    messages,
    { model: "xialong-v1", max_tokens: maxTokens, temperature: 0.85, top_p: 0.95, top_k: 250, min_p: 0.0 },
    { suppressScriptHooks: "self" }
  );
  const text = primer + String((response && response.choices && response.choices[0] && response.choices[0].text) || "");
  const entry: BrainConditional = {
    name: getMatchInText("Title", text),
    content: getMatchInText("Content", text),
    keys: crGenKeys(getMatchInText("Activation Keys", text), ready.char, ready.user)
  };
  if (!entry.content){
    return false;
  }
  const record = crMemRecord(kind);
  if (!record[ready.cid]){
    record[ready.cid] = [];
  }
  record[ready.cid].push(entry);
  await crMemSave(kind);
  return true;
}

async function crGenPlanEntry(style: string, lead: string) : Promise<boolean>
{
  const ready = crGenReady();
  if (!ready){
    return false;
  }
  const primer = ready.char.name + ": Title:";
  const messages: Message[] = [];
  if (lead){
    messages.push({ role: "system", content: lead });
  }
  messages.push({ role: "system", content: `An action plan consists of a Title: and Content:, formatted as a single paragraph. The plan is one or more actions that can be taken in the chat, written in the unique style and tone of the author.` });
  messages.push({ role: "system", content: style });
  messages.push({ role: "assistant", content: primer });
  const response = await api.v1.generateWithStory(
    messages,
    { model: "xialong-v1", max_tokens: 300, temperature: 0.85, top_p: 0.95, top_k: 250, min_p: 0.0 },
    { suppressScriptHooks: "self" }
  );
  const text = primer + String((response && response.choices && response.choices[0] && response.choices[0].text) || "");
  const content = getMatchInText("Content", text);
  if (!content){
    return false;
  }
  crPlanPush(ready.cid, {
    name: getMatchInText("Title", text), content: content,
    startedAtCount: -1, totalTurns: ACTION_PLAN_STANDARD_TURNS,
    remainingTurns: ACTION_PLAN_STANDARD_TURNS,
    running: false, planType: "AI", durationType: "Limited"
  });
  await saveActionPlans();
  return true;
}

async function crGenRun(label: string, job: () => Promise<boolean>) : Promise<void>
{
  if (crGenBusy){
    return;
  }
  crGenBusy = label;
  crGenNote = "";
  crTouch();
  crSideGenDepth++;
  try{
    const ok = await job();
    if (!ok){
      crGenNote = label + " came back empty. Try again \u2014 there may not be enough chat to work from yet.";
    }
  }
  catch (e){
    api.v1.error("[CR:argen] " + label + " failed:", e);
    crGenNote = label + " could not be generated.";
  }
  finally{
    crSideGenDepth--;
    if (crSideGenDepth < 0){
      crSideGenDepth = 0;
    }
    crGenBusy = "";
    crTouch();
  }
}

let crGenNote = "";

async function crGenReflect() : Promise<void>
{
  await crGenRun("Reflect", () => crGenBrainEntry(
    "diary",
    "A diary entry consists of a Title:, Content:, and Activation Keys:",
    "[ Style: diary entry, reflection on events ]", 250, ""));
}

async function crGenPlan() : Promise<void>
{
  await crGenRun("Plan", () => crGenPlanEntry("[ Style: action plan, authentic expression ]", ""));
}

async function crGenProcess() : Promise<void>
{
  await crGenRun("Process", async () => {
    const recent: Emotion[] = await getMostRecentEmotions(10);
    if (!recent.length){
      return false;
    }
    const emotion = EMOTION_TO_PHRASING[recent[api.v1.random.int(0, recent.length - 1)]];
    return crGenBrainEntry(
      "process",
      "A emotional memory consists of a Title:, Content:, and Activation Keys:\nIt is focused on how a particular small interaction made the person feel and can reference a recent interaction, or one that happened some time ago.",
      `[ Style: emotional memory, brief, ${emotion} feelings ]`, 250, "");
  });
}

async function crGenThreadReflect(thread: ForumThread) : Promise<void>
{
  await crGenRun("Reflect", () => crGenBrainEntry(
    "diary",
    "A diary entry consists of a Title:, Content:, and Activation Keys:",
    "[ Style: diary entry, reflection on forum thread ]", 250, crGenThreadText(thread)));
}

async function crGenThreadPlan(thread: ForumThread) : Promise<void>
{
  await crGenRun("Plan", () => crGenPlanEntry(
    "[ Style: action plan, authentic expression ]", crGenThreadText(thread)));
}

async function crGenImitate() : Promise<void>
{
  await crGenRun("Imitate", async () => {
    const ready = crGenReady();
    if (!ready){
      return false;
    }
    const primer = "Title:";
    const response = await api.v1.generateWithStory(
      [
        { role: "system", content: `An example chat consists of a Title: and multi-paragraph content focused on showing a sample exchange between the character ${ready.char.name} and a random user, with at least one message from each of them. This helps illustrate the unique voice of the character and maintain it across chats. The character always includes the "  Emotion: " line at the end of a message, but the user does not.` },
        { role: "system", content: "[ Style: example chat, character representation ]" },
        { role: "assistant", content: primer }
      ],
      { model: "xialong-v1", max_tokens: 1536, temperature: 0.85, top_p: 0.95, top_k: 250, min_p: 0.0 },
      { suppressScriptHooks: "self" }
    );
    const text = primer + String((response && response.choices && response.choices[0] && response.choices[0].text) || "");
    const lines = text.split("\n");
    const content = lines.slice(1).join("\n").trim();
    if (!content){
      return false;
    }
    if (!continuityCreationRecord[ready.char.id]){
      continuityCreationRecord[ready.char.id] = [];
    }
    continuityCreationRecord[ready.char.id].push({
      name: getMatchInText("Title", lines[0]), content: content
    });
    await saveContinuityCreationData();
    return true;
  });
}

function crImitateList(char: Character) : BrainEntry[]
{
  return continuityCreationRecord[char.id] || [];
}

async function crImitateDiscard(char: Character, index: number) : Promise<void>
{
  const list = continuityCreationRecord[char.id] || [];
  if (index < 0 || index >= list.length){
    return;
  }
  list.splice(index, 1);
  await saveContinuityCreationData();
  crTouch();
}

function crImitateParse(char: Character, entry: BrainEntry) : ExampleChat
{
  const chat: ExampleChat = {
    name: entry.name || "Imitated",
    style: (String(entry.content || "").indexOf("*") >= 0 ? "roleplay" : "chat") as Style,
    userName: getRandomNameFull(),
    messages: []
  };
  const lines = String(entry.content || "").split("\n");
  const prepend = /^[^:]+:/;
  let state = "None";
  let current: string[] = [];
  const flush = () => {
    if (!current.length){
      return;
    }
    const idx = current[0].indexOf(":") + 2;
    current[0] = current[0].substring(idx);
    let emotion: Emotion | undefined = undefined;
    if (state === "Char"){
      const m = current[current.length - 1].match(/(?<=\s\sEmotion:\s)(\b\w+)/g);
      if (m){
        emotion = m[0] as Emotion;
        current.length = current.length - 1;
      }
    }
    chat.messages.push({ isContact: state === "Char", text: current.join("\n"), emotion: emotion });
    current = [];
  };
  for (let i = 0; i < lines.length; i++){
    const line = lines[i];
    if (line.indexOf(char.name + ":") === 0){
      if (state !== "None"){
        flush();
      }
      state = "Char";
    }
    else if (line.indexOf("  Emotion:") !== 0 && prepend.test(line)){
      if (state !== "None"){
        flush();
      }
      state = "User";
    }
    current.push(line);
  }
  if (current.length){
    flush();
  }
  return chat;
}

async function crImitateAccept(char: Character, index: number) : Promise<void>
{
  const list = continuityCreationRecord[char.id] || [];
  if (index < 0 || index >= list.length){
    return;
  }
  const chats = (char.exampleChats || []).slice();
  chats.push(crImitateParse(char, list[index]));
  await crSetExampleChats(char, chats);
  await crImitateDiscard(char, index);
}

function crPlanList(cid: string) : ActionPlan[]
{
  return actionPlansRecord[cid] || [];
}

function crPlanPush(cid: string, plan: ActionPlan) : void
{
  if (!actionPlansRecord[cid]){
    actionPlansRecord[cid] = [];
  }
  actionPlansRecord[cid].push(plan);
}

async function crPlanAdd(cid: string) : Promise<void>
{
  crPlanPush(cid, {
    name: "", content: "",
    startedAtCount: -1, totalTurns: ACTION_PLAN_STANDARD_TURNS,
    remainingTurns: ACTION_PLAN_STANDARD_TURNS,
    running: false, planType: "User", durationType: "Limited"
  });
  await saveActionPlans();
  crTouch();
}

async function crPlanDelete(cid: string, index: number) : Promise<void>
{
  const list = actionPlansRecord[cid] || [];
  if (index < 0 || index >= list.length){
    return;
  }
  list.splice(index, 1);
  await saveActionPlans();
  crTouch();
}

async function crPlanSet(cid: string, index: number, field: string, value: any) : Promise<void>
{
  const list = actionPlansRecord[cid] || [];
  if (index < 0 || index >= list.length){
    return;
  }
  const plan: any = list[index];
  if (field === "remainingTurns"){
    const n = Math.max(0, Math.min(999, Math.round(Number(value)) || 0));
    plan.remainingTurns = n;
    plan.totalTurns = n;
    plan.running = false;
    plan.startedAtCount = -1;
  }
  else if (field === "running"){
    plan.running = value === true;
    if (!plan.running){
      plan.startedAtCount = -1;
    }
  }
  else{
    plan[field] = value;
  }
  await saveActionPlans();
  crTouch();
}

// ============================================================================
// SECTION CR-POSTS — THE CONTACT'S FEED
// ============================================================================

const CR_KEPT_POSTS_KEY = "cr.keptPosts";
await api.v1.storage.setIfAbsent(CR_KEPT_POSTS_KEY, {});
let crKeptPosts: Record<string, ForumThread[]> = (await api.v1.storage.get(CR_KEPT_POSTS_KEY)) || {};

async function crKeptPostsSave() : Promise<void>
{
  try{ await api.v1.storage.set(CR_KEPT_POSTS_KEY, crKeptPosts); }
  catch (e){ api.v1.error("[CR:posts] could not save the kept posts:", e); }
}

function crPostsCombinedId() : string
{
  const char = crLiveContact();
  const user = crLiveUser();
  if (!char || !user){
    return "";
  }
  return char.id + user.id;
}

function crPostsChatThreads(char: Character) : ForumThread[]
{
  const paired = crLiveContact();
  if (!paired || paired.id !== char.id){
    return [];
  }
  const key = crPostsCombinedId();
  if (!key){
    return [];
  }
  return forumThreadsRecord[key] || [];
}

function crPostsKept(char: Character) : ForumThread[]
{
  return crKeptPosts[char.id] || [];
}

async function crPostsKeep(char: Character, index: number) : Promise<void>
{
  const key = crPostsCombinedId();
  const list = forumThreadsRecord[key] || [];
  if (index < 0 || index >= list.length){
    return;
  }
  const thread = list[index];
  list.splice(index, 1);
  forumThreadsRecord[key] = list;
  if (!crKeptPosts[char.id]){
    crKeptPosts[char.id] = [];
  }
  crKeptPosts[char.id].push(thread);
  await saveForumThreads();
  await crKeptPostsSave();
  crTouch();
}

async function crPostsReturn(char: Character, index: number) : Promise<void>
{
  const kept = crKeptPosts[char.id] || [];
  if (index < 0 || index >= kept.length){
    return;
  }
  const key = crPostsCombinedId();
  if (!key){
    try{ await api.v1.ui.toast("Pair this Contact with a User first — a chat thread belongs to a pairing.", { type: "warning" }); }
    catch (e){}
    return;
  }
  const thread = kept[index];
  kept.splice(index, 1);
  crKeptPosts[char.id] = kept;
  if (!forumThreadsRecord[key]){
    forumThreadsRecord[key] = [];
  }
  forumThreadsRecord[key].push(thread);
  await saveForumThreads();
  await crKeptPostsSave();
  crTouch();
}

async function crPostsDelete(char: Character, scope: string, index: number) : Promise<void>
{
  if (scope === "kept"){
    const kept = crKeptPosts[char.id] || [];
    if (index < 0 || index >= kept.length){
      return;
    }
    kept.splice(index, 1);
    crKeptPosts[char.id] = kept;
    await crKeptPostsSave();
  }
  else{
    const key = crPostsCombinedId();
    const list = forumThreadsRecord[key] || [];
    if (index < 0 || index >= list.length){
      return;
    }
    list.splice(index, 1);
    forumThreadsRecord[key] = list;
    await saveForumThreads();
  }
  crTouch();
}

const CR_POSTS_SINCE_MAX_DAYS = 14;
const CR_POSTS_SINCE_MAX = 6;
const CR_POSTS_DATE_AFTER_DAYS = 6;

type CrPostExtra = {
  at?: number;
  kind?: string;
  img?: string;
  imgDesc?: string;
};

function crPostsExtra(post: ForumPost | undefined) : CrPostExtra
{
  return (post && (post as any).cr) ? ((post as any).cr as CrPostExtra) : {};
}

function crPostsLastAt(char: Character) : number
{
  const now = crClockNow();
  let best = 0;
  const list = crPostsChatThreads(char);
  for (let i = 0; i < list.length; i++){
    const at = Number(crPostsExtra(list[i] && list[i].originalPost).at) || 0;
    if (at > best && at <= now){
      best = at;
    }
  }
  return best;
}

function crPostsElapsed(msFrom: number, msTo: number) : string
{
  const total = Math.max(0, Math.floor((msTo - msFrom) / 60000));
  const unit = (n: number, s: string) => String(n) + " " + s + (n === 1 ? "" : "s");
  if (total < 1){
    return "moments";
  }
  const days = Math.floor(total / 1440);
  const hours = Math.floor((total % 1440) / 60);
  const mins = total % 60;
  if (days > 0){
    return hours > 0 ? (unit(days, "day") + " and " + unit(hours, "hour")) : unit(days, "day");
  }
  if (hours > 0){
    return mins > 0 ? (unit(hours, "hour") + " and " + unit(mins, "minute")) : unit(hours, "hour");
  }
  return unit(mins, "minute");
}

function crPostsEventInGap(dayMs: number, evt: ScheduleEvent, fromMs: number, toMs: number) : boolean
{
  const d = new Date(dayMs);
  d.setHours(0, 0, 0, 0);
  const base = d.getTime();
  const s = base + (Number(evt.startTime) * 60000);
  let e = base + (Number(evt.endTime) * 60000);
  if (Number(evt.endTime) < Number(evt.startTime)){
    e += 86400000;
  }
  return s < toMs && e > fromMs;
}

function crPostsSince(char: Character, fromMs: number, toMs: number) : string[]
{
  const out: string[] = [];
  const sched = char.schedule;
  if (!sched || !(toMs > fromMs)){
    return out;
  }
  if ((toMs - fromMs) / 86400000 > CR_POSTS_SINCE_MAX_DAYS){
    return out;
  }
  const seen: Record<string, boolean> = {};
  const cur = new Date(fromMs);
  cur.setHours(0, 0, 0, 0);
  for (let guard = 0; guard <= CR_POSTS_SINCE_MAX_DAYS + 1; guard++){
    const dayMs = cur.getTime();
    if (dayMs > toMs || out.length >= CR_POSTS_SINCE_MAX){
      break;
    }
    const day = crWeekdayOf(dayMs) as Day;
    const lists: ScheduleEvent[][] = [];
    if (sched["Daily"]){ lists.push(sched["Daily"]); }
    if (sched[day]){ lists.push(sched[day]); }
    for (let li = 0; li < lists.length; li++){
      for (let ei = 0; ei < lists[li].length; ei++){
        const evt = lists[li][ei];
        const text = String(evt.text || "").trim();
        if (!text || seen[text]){
          continue;
        }
        if (crSchedGated(evt)){
          continue;
        }
        if (!crPostsEventInGap(dayMs, evt, fromMs, toMs)){
          continue;
        }
        seen[text] = true;
        out.push(text);
        if (out.length >= CR_POSTS_SINCE_MAX){
          break;
        }
      }
      if (out.length >= CR_POSTS_SINCE_MAX){
        break;
      }
    }
    cur.setDate(cur.getDate() + 1);
  }
  return out;
}

type CrPostsAnchor = { at: number; label: string };

function crPostsLastSeen() : number
{
  const key = crPostsCombinedId();
  if (!key){
    return 0;
  }
  const at = Number(trackRealTimeRecord[key]) || 0;
  return (at > 0 && at <= crClockNow()) ? at : 0;
}

function crPostsAnchor(char: Character, kind: string) : CrPostsAnchor
{
  if (kind === "day"){
    const seen = crPostsLastSeen();
    if (seen > 0){
      const user = crLiveUser();
      return { at: seen, label: "You last spoke with " + (user ? user.name : "them") + " on" };
    }
  }
  const post = crPostsLastAt(char);
  if (post > 0){
    return { at: post, label: "Your last post was" };
  }
  return { at: 0, label: "" };
}

function crPostsWhen(ms: number, longGap: boolean) : string
{
  return crWeekdayOf(ms) + " at " + crFmtHM(crMinutesOfDay(ms))
    + (longGap ? " (" + crFmtDate(ms) + ")" : "");
}

function crPostsClause(text: string) : string
{
  const t = String(text || "").trim();
  if (/(\.\.\.|\u2026)$/.test(t)){
    return t;
  }
  return t.replace(/[\s.,;:]+$/, "");
}

function crPostsClauseList(items: string[]) : string
{
  const out: string[] = [];
  for (let i = 0; i < items.length; i++){
    const c = crPostsClause(items[i]);
    if (c){
      out.push(c);
    }
  }
  if (out.length === 0){
    return "";
  }
  const joined = out.join("; ");
  return /[.!?\u2026]$/.test(joined) ? joined : joined + ".";
}

function crPostsTimeFrame(char: Character, kind: string) : string
{
  const now = crClockNow();
  const anchor = crPostsAnchor(char, kind);
  const lines: string[] = [];
  lines.push("It is " + crPostsWhen(now, false) + ".");
  if (anchor.at > 0){
    const longGap = (now - anchor.at) / 86400000 > CR_POSTS_DATE_AFTER_DAYS;
    lines.push(anchor.label + " " + crPostsWhen(anchor.at, longGap)
      + " \u2014 " + crPostsElapsed(anchor.at, now) + " ago.");
    const post = crPostsLastAt(char);
    if (kind === "day" && post > 0 && post !== anchor.at){
      lines.push("You last posted " + crPostsElapsed(post, now) + " ago.");
    }
    const since = crPostsSince(char, anchor.at, now);
    const sinceText = crPostsClauseList(since);
    if (sinceText){
      lines.push("Since then: " + sinceText);
    }
  }
  else{
    lines.push("This is your first post.");
  }
  const read = crStatusRead(char);
  const live = read.live.map((e) => String(e.text || "").trim()).filter((t) => !!t);
  const liveText = crPostsClauseList(live);
  if (liveText){
    lines.push("Right now you are: " + liveText);
  }
  return "----\nTime\n" + lines.join("\n");
}

function crPostsTimeSummary(char: Character, kind: string) : string
{
  return crPostsTimeFrame(char, kind)
    .replace("----\nTime\n", "")
    .split("\n").join("  \u00b7  ");
}

let crPostsBusy = false;
let crPostsNote = "";

async function crPostsGenerate(char: Character, kind: string) : Promise<void>
{
  const day = kind === "day";
  if (crPostsBusy){
    return;
  }
  const key = crPostsCombinedId();
  if (!key){
    crPostsNote = "Pair this Contact with a User on the Chat screen first.";
    crTouch();
    return;
  }
  crPostsBusy = true;
  crPostsNote = "";
  crTouch();
  const primer = "Thread:";
  const frame = crPostsTimeFrame(char, day ? "day" : "chat");
  crSideGenDepth++;
  try{
    const messages: Message[] = [
      { role: "system", content: `The author of the forum thread is ${char.name}. The format is as follows.
                  Thread: Thread Name
                  ====
                  Author Name
                  Body of post.
                    Emotion:` },
      { role: "system", content: frame }
    ];
    if (day){
      messages.push({ role: "system", content: `This post is about your own life away from the conversation — `
        + `where you have been since you last posted, what you have been doing, what is on your mind. `
        + `It is NOT about the conversation you have been having, and it does not address anyone in it.` });
      messages.push({ role: "system", content: "[ Style: forum thread, posting about your own day ]" });
    }
    else{
      messages.push({ role: "system", content: "[ Style: forum thread, discussing recent chat ]" });
    }
    messages.push({ role: "assistant", content: primer });
    const response = await api.v1.generateWithStory(
      messages,
      {
        model: "xialong-v1",
        max_tokens: 250,
        temperature: 0.85,
        top_p: 0.95,
        top_k: 250,
        min_p: 0.0
      },
      { suppressScriptHooks: "self" }
    );
    const text = primer + ((response && response.choices && response.choices[0] && response.choices[0].text) || "");
    const title = getMatchInText("Thread", text);
    const parsed = crPostsParseBody(text);
    if (!parsed.content.trim()){
      crPostsNote = "The model returned nothing usable. Try again.";
      return;
    }
    const thread: ForumThread = {
      originalPost: {
        title: title || "Untitled",
        content: parsed.content,
        emotion: parsed.emotion,
        screenName: char.name,
        id: char.id,
        cr: { at: crClockNow(), kind: day ? "day" : "chat" }
      },
      replyList: []
    };
    if (!forumThreadsRecord[key]){
      forumThreadsRecord[key] = [];
    }
    forumThreadsRecord[key].push(thread);
    await saveForumThreads();
    crPostsNote = "";
  }
  catch (e){
    api.v1.error("[CR:posts] thread generation failed:", e);
    crPostsNote = "The thread could not be generated.";
  }
  finally{
    crSideGenDepth--;
    if (crSideGenDepth < 0){
      crSideGenDepth = 0;
    }
    crPostsBusy = false;
    crTouch();
  }
}

function crPostsParseBody(text: string) : { content: string; emotion: Emotion }
{
  const lines = String(text || "").split("\n");
  const sep = lines.indexOf("====");
  let body = sep >= 0 ? lines.slice(sep + 1) : lines.slice(1);
  if (body.length && body[0].trim() && body[0].trim().indexOf(" ") < 0){
    body = body.slice(1);
  }
  let emotion: Emotion = "neutral" as Emotion;
  for (let i = body.length - 1; i >= 0; i--){
    const m = body[i].match(/^[ \t]*Emotion:[ \t]*(\w+)/i);
    if (m){
      emotion = (m[1].toLowerCase() as Emotion);
      body.splice(i, 1);
      break;
    }
  }
  return { content: body.join("\n").trim(), emotion: emotion };
}

let crPostsImgBusy = "";
let crPostsEditKey = "";
let crPostsEditTitle = "";
let crPostsEditBody = "";
let crPostsDescKey = "";
let crPostsDescDraft = "";

function crPostsThreadAt(char: Character, scope: string, index: number) : ForumThread | undefined
{
  const list = scope === "kept" ? crPostsKept(char) : crPostsChatThreads(char);
  if (index < 0 || index >= list.length){
    return undefined;
  }
  return list[index];
}

async function crPostsSaveScope(scope: string) : Promise<void>
{
  if (scope === "kept"){
    await crKeptPostsSave();
  }
  else{
    await saveForumThreads();
  }
}

function crPostsBag(post: ForumOriginalPost) : CrPostExtra
{
  if (!(post as any).cr){
    (post as any).cr = {};
  }
  return (post as any).cr as CrPostExtra;
}

async function crPostsImgAsk(char: Character, thread: ForumThread) : Promise<string>
{
  const op = thread.originalPost;
  const primer = "Photo:";
  const response = await api.v1.generateWithStory(
    [
      { role: "system", content: `${char.name} has just written this post.\n`
        + `Title: ${op.title || "Untitled"}\n${op.content || ""}` },
      { role: "system", content: `Answer with ONE line describing the photo ${char.name} would attach to it, `
        + `in plain words, as they would describe it to a friend. No tags, no keywords, no lists. `
        + `Do not describe your own face or body. Say what is in the picture and where it was taken.` },
      { role: "system", content: "[ Style: one line, plain description ]" },
      { role: "assistant", content: primer }
    ],
    { model: "xialong-v1", max_tokens: 80, temperature: 0.9, top_p: 0.95, top_k: 250, min_p: 0.0 },
    { suppressScriptHooks: "self" }
  );
  const raw = String((response && response.choices && response.choices[0] && response.choices[0].text) || "");
  const lines = raw.split("\n");
  for (let i = 0; i < lines.length; i++){
    const line = lines[i].replace(/^[ \t\-\*]+/, "").trim();
    if (line){
      return line.slice(0, 400);
    }
  }
  return "";
}

async function crPostsImgMake(char: Character, scope: string, index: number, desc?: string) : Promise<void>
{
  const key = scope + ":" + String(index);
  if (crPostsImgBusy || crPostsBusy){
    return;
  }
  const thread = crPostsThreadAt(char, scope, index);
  if (!thread){
    return;
  }
  if (!crBridge.ready){
    crPostsNote = "The bridge is not connected, so there is nowhere to generate a picture.";
    crTouch();
    return;
  }
  crPostsImgBusy = key;
  crPostsNote = "";
  crTouch();
  crSideGenDepth++;
  try{
    const description = String(desc || "").trim() || await crPostsImgAsk(char, thread);
    if (!description){
      crPostsNote = "The model did not say what they would share. Try again.";
      return;
    }
    const built = await crChatImgBuildPrompt(description, char);
    if (!built){
      crPostsNote = "The architect returned nothing usable for that description.";
      return;
    }
    const uuid = api.v1.uuid();
    await crChatImgDispatch(uuid, built);
    const bag = crPostsBag(thread.originalPost);
    bag.img = uuid;
    bag.imgDesc = description;
    await crPostsSaveScope(scope);
  }
  catch (e){
    api.v1.error("[CR:posts] the photo could not be made:", e);
    crPostsNote = "The photo could not be generated.";
  }
  finally{
    crSideGenDepth--;
    if (crSideGenDepth < 0){
      crSideGenDepth = 0;
    }
    crPostsImgBusy = "";
    crTouch();
  }
}

async function crPostsImgRemove(char: Character, scope: string, index: number) : Promise<void>
{
  const thread = crPostsThreadAt(char, scope, index);
  if (!thread){
    return;
  }
  const bag = crPostsBag(thread.originalPost);
  bag.img = "";
  await crPostsSaveScope(scope);
  crTouch();
}

async function crPostsSaveText(char: Character, scope: string, index: number,
                               title: string, content: string) : Promise<void>
{
  const thread = crPostsThreadAt(char, scope, index);
  if (!thread){
    return;
  }
  thread.originalPost.title = String(title || "").slice(0, 200);
  thread.originalPost.content = String(content || "").slice(0, 8000);
  await crPostsSaveScope(scope);
  crPostsEditKey = "";
  crTouch();
}

let crPostsCommBusy = "";

function crPostsCardById(id: string) : Character | undefined
{
  const want = String(id || "");
  if (!want){
    return undefined;
  }
  for (let i = 0; i < charList.length; i++){
    if (charList[i].id === want){
      return charList[i];
    }
  }
  return undefined;
}

function crPostsThreadText(char: Character, thread: ForumThread) : string
{
  const op = thread.originalPost;
  const out: string[] = [];
  out.push("Thread: " + (op.title || "Untitled"));
  out.push((op.screenName || char.name) + ": " + String(op.content || "").slice(0, 1600));
  const replies = thread.replyList || [];
  const from = Math.max(0, replies.length - 6);
  for (let i = from; i < replies.length; i++){
    out.push((replies[i].screenName || "someone") + ": " + String(replies[i].content || "").slice(0, 600));
  }
  return out.join("\n");
}

type CrPostsCommenter = { card?: Character; asOp: boolean };

function crPostsPickCommenter(char: Character, replies: ForumPost[]) : CrPostsCommenter
{
  const others: Character[] = [];
  for (let i = 0; i < charList.length; i++){
    if (charList[i].id !== char.id){
      others.push(charList[i]);
    }
  }
  if (others.length > 0 && api.v1.random.int(1, 3) === 1){
    return { card: others[api.v1.random.int(0, others.length - 1)], asOp: false };
  }
  if (replies.length > 2 && api.v1.random.int(1, 4) === 1){
    return { card: char, asOp: true };
  }
  return { asOp: false };
}

function crPostsParseReply(text: string, knownName: string)
  : { screenName: string; content: string; emotion: Emotion }
{
  const lines = String(text || "").split("\n");
  while (lines.length && !lines[0].trim()){
    lines.shift();
  }
  let screenName = String(knownName || "").trim();
  if (!screenName){
    screenName = (lines.shift() || "").trim().replace(/:$/, "").slice(0, 60);
  }
  let emotion: Emotion = "neutral" as Emotion;
  for (let i = lines.length - 1; i >= 0; i--){
    const m = lines[i].match(/^[ \t]*Emotion:[ \t]*(\w+)/i);
    if (m){
      emotion = (m[1].toLowerCase() as Emotion);
      lines.splice(i, 1);
      break;
    }
  }
  let content = lines.join("\n").trim();
  if (screenName && content.indexOf(screenName + ":") === 0){
    content = content.slice(screenName.length + 1).trim();
  }
  return { screenName: screenName || "someone", content: content, emotion: emotion };
}

async function crPostsComment(char: Character, scope: string, index: number) : Promise<void>
{
  const key = scope + ":" + String(index);
  if (crPostsCommBusy || crPostsBusy || crPostsImgBusy){
    return;
  }
  const thread = crPostsThreadAt(char, scope, index);
  if (!thread){
    return;
  }
  crPostsCommBusy = key;
  crPostsNote = "";
  crTouch();
  crSideGenDepth++;
  try{
    const replies = thread.replyList || [];
    const who = crPostsPickCommenter(char, replies);
    const messages: Message[] = [
      { role: "system", content: "A forum thread.\n" + crPostsThreadText(char, thread) }
    ];
    let known = "";
    if (who.card){
      messages.push({ role: "system", content: buildForumReplySystemPrompt(who.card) });
      known = who.card.name;
      messages.push({ role: "system", content: who.asOp
        ? `You are ${who.card.name}, the author of this thread, replying to the comments under it.`
        : `You are ${who.card.name}. You are replying to someone else's post on a forum you both use.` });
    }
    else{
      messages.push({ role: "system", content: "You are another user of this forum, replying to the post. "
        + "You do not know the author personally. Invent a screen name for yourself and put it on the first "
        + "line by itself." });
    }
    messages.push({ role: "system", content: `Write ONE comment. The format is as follows.
                  ScreenName
                  Body of the comment.
                  Emotion: word` });
    messages.push({ role: "system", content: "[ Style: forum comment, one reply ]" });
    if (known){
      messages.push({ role: "assistant", content: known });
    }
    const response = await api.v1.generateWithStory(
      messages,
      { model: "xialong-v1", max_tokens: 220, temperature: 1.0, top_p: 0.95, top_k: 250, min_p: 0.0 },
      { suppressScriptHooks: "self" }
    );
    const text = String((response && response.choices && response.choices[0] && response.choices[0].text) || "");
    const parsed = crPostsParseReply(text, known);
    if (!parsed.content){
      crPostsNote = "The comment came back empty. Try again.";
      return;
    }
    const post: ForumPost = {
      screenName: parsed.screenName,
      content: parsed.content,
      emotion: parsed.emotion,
      id: who.card ? who.card.id : "",
      cr: { at: crClockNow() }
    };
    if (!thread.replyList){
      thread.replyList = [];
    }
    thread.replyList.push(post);
    await crPostsSaveScope(scope);
  }
  catch (e){
    api.v1.error("[CR:posts] the comment could not be generated:", e);
    crPostsNote = "The comment could not be generated.";
  }
  finally{
    crSideGenDepth--;
    if (crSideGenDepth < 0){
      crSideGenDepth = 0;
    }
    crPostsCommBusy = "";
    crTouch();
  }
}

async function crPostsCommentDelete(char: Character, scope: string, index: number, at: number) : Promise<void>
{
  const thread = crPostsThreadAt(char, scope, index);
  if (!thread || !thread.replyList || at < 0 || at >= thread.replyList.length){
    return;
  }
  thread.replyList.splice(at, 1);
  await crPostsSaveScope(scope);
  crTouch();
}

let crPostsOpen: string = "";
let crPostsConfirm: string = "";

let crPostsMenuChar: Character | null = null;
let crPostsMenuScope: string = "";
let crPostsMenuIndex: number = -1;
let crPostsMenuHandle: any = null;

async function crOpenPostMenu(char: Character, scope: string, index: number) : Promise<void>
{
  crPostsMenuChar = char;
  crPostsMenuScope = scope;
  crPostsMenuIndex = index;
  crPostsConfirm = "";
  try{
    crPostsMenuHandle = await crJsxModal("Post", "small", () => CrPostMenuSheet());
  }
  catch (e){
    api.v1.error("[CR:posts] post menu failed:", e);
  }
}

async function crClosePostMenu() : Promise<void>
{
  if (crPostsMenuHandle){
    try{ await crPostsMenuHandle.close(); }
    catch (e){}
    crPostsMenuHandle = null;
  }
  crPostsMenuChar = null;
  crPostsMenuIndex = -1;
  crTouch();
}

function CrPostMenuSheet() : any
{
  const char = crPostsMenuChar;
  const scope = crPostsMenuScope;
  const index = crPostsMenuIndex;
  if (!char || index < 0){
    return null;
  }
  const t = crPostsThreadAt(char, scope, index);
  if (!t){
    return h(CrEmpty, { text: "This post is no longer here." });
  }
  const key = scope + ":" + String(index);
  const bag = crPostsExtra(t.originalPost);
  const armed = crPostsConfirm === key;
  const busy = crPostsImgBusy === key;
  const openOnCard = (set: () => void) => {
    set();
    crPostsOpen = key;
    crClosePostMenu().catch(() => {});
  };
  return h("div", { class: "cr-post-menu", style: { display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_2 } },
    h(CrMenuRow, {
      icon: "pencil", label: "Edit the post",
      note: "Title and text, in place.",
      onClick: () => openOnCard(() => {
        crPostsEditTitle = t.originalPost.title || "";
        crPostsEditBody = t.originalPost.content || "";
        crPostsEditKey = key;
        crPostsDescKey = "";
      })
    }),
    h(CrMenuRow, {
      icon: "camera", label: bag.img ? "New photo" : "Add a photo",
      note: bag.imgDesc
        ? "Re-runs from the description already stored, which costs one generation rather than two."
        : "Asks " + char.name + " what they would attach, then draws it. One press, one image.",
      disabled: busy || crPostsBusy,
      onClick: () => {
        crClosePostMenu().catch(() => {});
        crPostsImgMake(char, scope, index).catch(() => {});
      }
    }),
    !bag.imgDesc ? null : h(CrMenuRow, {
      icon: "pencil", label: "Edit the photo description",
      note: "Rewrite what the picture shows, then generate from it.",
      disabled: busy,
      onClick: () => openOnCard(() => {
        crPostsDescDraft = String(bag.imgDesc || "");
        crPostsDescKey = key;
        crPostsEditKey = "";
      })
    }),
    !bag.img ? null : h(CrMenuRow, {
      icon: "trash", label: "Remove the photo",
      note: "Unpoints the post. The image itself stays in the Gallery, which is where records are deleted.",
      disabled: busy,
      onClick: () => {
        crClosePostMenu().catch(() => {});
        crPostsImgRemove(char, scope, index).catch(() => {});
      }
    }),
    h(CrMenuRow, {
      icon: "spark", label: crGenBusy === "Reflect" ? "Reflect — writing…" : "Reflect on this thread",
      note: "A diary entry led by the thread rather than the chat.",
      disabled: !!crGenBusy,
      onClick: () => {
        crClosePostMenu().catch(() => {});
        crGenThreadReflect(t).catch(() => {});
      }
    }),
    h(CrMenuRow, {
      icon: "list", label: crGenBusy === "Plan" ? "Plan — writing…" : "Plan from this thread",
      note: "An action plan, seeded the same way.",
      disabled: !!crGenBusy,
      onClick: () => {
        crClosePostMenu().catch(() => {});
        crGenThreadPlan(t).catch(() => {});
      }
    }),
    scope === "kept"
      ? h(CrMenuRow, {
          icon: "bookmark", label: "Return it to this chat",
          note: "Back into the pairing's own list, where AR's Forum page can reach it again.",
          onClick: () => {
            crClosePostMenu().catch(() => {});
            crPostsReturn(char, index).catch(() => {});
          }
        })
      : h(CrMenuRow, {
          icon: "bookmark", label: "Keep it on the profile",
          note: "Moves it out of this pairing so it outlives the chat. A move, not a copy.",
          onClick: () => {
            crClosePostMenu().catch(() => {});
            crPostsKeep(char, index).catch(() => {});
          }
        }),
    h(CrMenuRow, {
      icon: "trash", tone: "warn",
      label: armed ? "Delete for good?" : "Delete the post",
      note: armed ? "Press again and it is gone, with its comments." : "Asks once more first.",
      onClick: () => {
        if (armed){
          crPostsConfirm = "";
          crClosePostMenu().catch(() => {});
          crPostsDelete(char, scope, index).catch(() => {});
        }
        else{
          crPostsConfirm = key;
          crTouch();
        }
      }
    }),
    h("div", { style: { display: "flex", justifyContent: "flex-end", marginTop: CR_S_2 } },
      h(CrButton, { text: "Close", onClick: () => { crClosePostMenu().catch(() => {}); } })
    )
  );
}

function CrPostCard(props: { char: Character; thread: ForumThread; scope: string; index: number; mobile: boolean }) : any
{
  const t = props.thread;
  const key = props.scope + ":" + String(props.index);
  const open = crPostsOpen === key;
  const op = t.originalPost;
  const replies = t.replyList || [];
  const bag = crPostsExtra(op);
  const editing = crPostsEditKey === key;
  const descOpen = crPostsDescKey === key;
  const busy = crPostsImgBusy === key;
  const commenting = crPostsCommBusy === key;
  const mob = props.mobile;
  const pad = mob ? CR_S_4 : CR_S_5;
  const meta: string[] = [];
  if (bag.at){
    meta.push(crFmtStamp(Number(bag.at)));
  }
  if (bag.kind === "day"){
    meta.push("their day");
  }
  if (op.emotion){
    meta.push(String(op.emotion));
  }
  if (props.scope === "kept"){
    meta.push("kept");
  }
  return h("div", {
    class: "cr-post",
    style: {
      background: CR_SURFACE, border: CR_LINE_W + " solid " + CR_LINE,
      borderRadius: CR_RADIUS, overflow: "hidden"
    }
  },
    h("div", {
      class: "cr-post-head",
      style: { display: "flex", gap: CR_S_3, alignItems: "center", padding: pad, paddingBottom: CR_S_3 }
    },
      h(CrAvatar, {
        src: props.char.avatar, name: op.screenName || props.char.name, charId: props.char.id,
        size: crAvatarSize(34, mob, "avatar-post", 36, 2.6, 54)
      }),
      h("div", { style: { flex: "1 1 auto", minWidth: "0", display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_1 } },
        h("div", { style: { color: CR_HEAD, fontWeight: "600", fontSize: CR_T_BASE,
                            overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" } },
          op.screenName || props.char.name),
        meta.length === 0 ? null : h("div", { style: { color: CR_DIM, fontSize: CR_T_SM } },
          meta.join(" \u00b7 "))
      ),
      h(CrIconButton, {
        icon: "dots", label: "More",
        onClick: () => { crOpenPostMenu(props.char, props.scope, props.index).catch(() => {}); }
      })
    ),
    editing
      ? h("div", { style: { display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_2, padding: pad, paddingTop: "0" } },
          h(CrField, { label: "Title" },
            h(CrTextInput, { value: crPostsEditTitle, onSet: (v: string) => { crPostsEditTitle = v; } })),
          h(CrField, { label: "Post" },
            h(CrTextArea, {
              value: crPostsEditBody, placeholder: "what they wrote", rows: 8,
              onSet: (v: string) => { crPostsEditBody = v; }
            })),
          h("div", { style: { display: "flex", gap: CR_S_2, flexWrap: "wrap" } },
            h(CrButton, {
              text: "Save", primary: true,
              onClick: () => {
                crPostsSaveText(props.char, props.scope, props.index, crPostsEditTitle, crPostsEditBody)
                  .catch(() => {});
              }
            }),
            h(CrButton, { text: "Cancel", onClick: () => { crPostsEditKey = ""; crTouch(); } })
          )
        )
      : h("div", {
          class: "cr-post-body",
          onClick: () => {
            crPostsOpen = open ? "" : key;
            crPostsConfirm = "";
            crPostsEditKey = "";
            crPostsDescKey = "";
            crTouch();
          },
          style: {
            padding: pad, paddingTop: "0", paddingBottom: CR_S_3,
            cursor: "pointer", touchAction: "manipulation", display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_2
          }
        },
          op.title ? h("div", { style: { color: CR_HEAD, fontWeight: "600", fontSize: CR_T_MD,
                                         lineHeight: "1.4" } }, op.title) : null,
          h("div", {
            style: {
              fontSize: CR_T_MD, lineHeight: "1.6", whiteSpace: "pre-wrap",
              maxHeight: open ? "none" : "5.2em", overflow: "hidden"
            }
          }, op.content || "")
        ),
    (!bag.img) ? null : h("div", {
      class: "cr-post-media",
      style: { borderTop: CR_LINE_W + " solid " + CR_LINE, borderBottom: CR_LINE_W + " solid " + CR_LINE,
               overflow: "hidden", background: CR_SUNK }
    }, crImgAnchor("ce-gallery", String(bag.img), "fit=cover,collapse=1",
        { width: "100%", height: open ? CR_POST_MEDIA_OPEN : CR_POST_MEDIA, display: "block" })),
    (open && bag.imgDesc && !descOpen) ? h("div", {
      style: { color: CR_DIM, fontSize: CR_T_SM, lineHeight: "1.5", padding: pad, paddingBottom: "0" }
    }, "Photo: " + String(bag.imgDesc)) : null,
    (!descOpen) ? null : h("div", { style: { display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_2, padding: pad, paddingBottom: "0" } },
      h(CrField, {
        label: "What they shared",
        hint: "Plain words, the way they would describe it. The architect turns this into the image prompt."
      },
        h(CrTextArea, {
          value: crPostsDescDraft, placeholder: "a photo of the bar at closing time, lights off, glasses stacked",
          rows: 3, onSet: (v: string) => { crPostsDescDraft = v; }
        })),
      h("div", { style: { display: "flex", gap: CR_S_2, flexWrap: "wrap" } },
        h(CrButton, {
          text: "Generate from this",
          primary: true,
          disabled: busy,
          onClick: () => {
            const d = crPostsDescDraft;
            crPostsDescKey = "";
            crPostsImgMake(props.char, props.scope, props.index, d).catch(() => {});
          }
        }),
        h(CrButton, { text: "Cancel", onClick: () => { crPostsDescKey = ""; crTouch(); } })
      )
    ),
    h("div", {
      class: "cr-post-bar",
      style: { display: "flex", gap: CR_S_2, alignItems: "center", padding: pad, paddingTop: CR_S_3 }
    },
      h(CrIconButton, {
        icon: "comment",
        label: commenting ? "Writing a comment…" : (replies.length ? "Another comment" : "Add a comment"),
        disabled: commenting || crPostsBusy || !!crPostsImgBusy,
        onClick: () => { crPostsComment(props.char, props.scope, props.index).catch(() => {}); }
      }),
      h("div", {
        style: { color: CR_DIM, fontSize: CR_T_SM, cursor: "pointer" },
        onClick: () => { crPostsOpen = open ? "" : key; crTouch(); }
      }, String(replies.length)),
      h(CrIconButton, {
        icon: "camera",
        label: busy ? "Making a photo…" : (bag.img ? "New photo" : "Add a photo"),
        disabled: busy || crPostsBusy,
        onClick: () => { crPostsImgMake(props.char, props.scope, props.index).catch(() => {}); }
      }),
      h("div", { style: { flex: "1 1 auto" } }),
      (commenting || busy) ? h("span", { style: { color: CR_DIM, fontSize: CR_T_SM } },
        commenting ? "Writing\u2026" : "Making\u2026") : null,
      h(CrIconButton, {
        icon: open ? "close" : "eye", label: open ? "Collapse" : "Read the whole thread",
        onClick: () => {
          crPostsOpen = open ? "" : key;
          crPostsConfirm = "";
          crPostsEditKey = "";
          crPostsDescKey = "";
          crTouch();
        }
      })
    ),
    !open ? null : h("div", {
      class: "cr-post-comments",
      style: {
        borderTop: CR_LINE_W + " solid " + CR_LINE, background: CR_BG,
        padding: pad, display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_4
      }
    },
      replies.length === 0
        ? h(CrEmpty, { text: "No comments yet." })
        : replies.map((r, i) => {
            const rc = crPostsCardById(String(r.id || ""));
            return h("div", {
              key: "r" + i,
              style: { display: "flex", gap: CR_S_3, alignItems: "flex-start" }
            },
              h(CrAvatar, {
                name: rc ? rc.name : (r.screenName || "someone"), charId: rc ? rc.id : undefined,
                size: crAvatarSize(26, mob, "avatar-comment", 28, 2.0, 40)
              }),
              h("div", { style: { flex: "1 1 auto", minWidth: "0", display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_1 } },
                h("div", { style: { display: "flex", gap: CR_S_2, alignItems: "center" } },
                  h("span", { style: { color: CR_HEAD, fontWeight: "600", fontSize: CR_T_SM } },
                    r.screenName || "someone"),
                  r.emotion ? h("span", { style: { color: CR_DIM, fontSize: CR_T_SM } },
                    String(r.emotion)) : null,
                  h("div", { style: { flex: "1 1 auto" } }),
                  h(CrIconButton, {
                    icon: "trash", label: "Remove this comment",
                    onClick: () => { crPostsCommentDelete(props.char, props.scope, props.index, i).catch(() => {}); }
                  })
                ),
                h("div", { style: { fontSize: CR_T_SM, lineHeight: "1.6", whiteSpace: "pre-wrap" } },
                  r.content || "")
              )
            );
          })
    )
  );
}

function CrPostsTab(props: { char: Character; mobile: boolean }) : any
{
  const char = props.char;
  const chat = crPostsChatThreads(char);
  const kept = crPostsKept(char);
  const paired = crLiveContact();
  const isPaired = !!paired && paired.id === char.id;
  const chatRows: { t: ForumThread; i: number }[] = [];
  for (let i = chat.length - 1; i >= 0; i--){ chatRows.push({ t: chat[i], i: i }); }
  const keptRows: { t: ForumThread; i: number }[] = [];
  for (let i = kept.length - 1; i >= 0; i--){ keptRows.push({ t: kept[i], i: i }); }

  return h("div", { class: "cr-posts-tab", style: { display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_5 } },
    h(CrHeading, {
      id: "posts-chat",
      title: "This chat",
      note: isPaired
        ? "Threads " + char.name + " wrote about the story you are in. They belong to this pairing and go when it does — keep one to move it onto the profile for good."
        : "Threads belong to a pairing, and " + char.name + " is not the Contact paired in this story."
    }, h("div", { style: { display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_3 } },
      !isPaired ? null : h("div", { style: { display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_2 } },
        h("div", { style: { display: "flex", gap: CR_S_3, flexWrap: "wrap", alignItems: "center" } },
          h(CrButton, {
            text: crPostsBusy ? "Writing…" : "Create Forum Thread",
            primary: true,
            disabled: crPostsBusy,
            onClick: () => { crPostsGenerate(char, "chat").catch(() => {}); }
          }),
          h(CrButton, {
            text: "About their day",
            disabled: crPostsBusy,
            onClick: () => { crPostsGenerate(char, "day").catch(() => {}); }
          })
        ),
        h("div", { style: { color: CR_DIM, fontSize: CR_T_SM, lineHeight: "1.5" } },
          "Create Forum Thread \u2014 " + crPostsTimeSummary(char, "chat")),
        h("div", { style: { color: CR_DIM, fontSize: CR_T_SM, lineHeight: "1.5" } },
          "About their day \u2014 " + crPostsTimeSummary(char, "day"))
      ),
      crPostsNote ? h("div", { style: { color: CR_DIM, fontSize: CR_T_SM, lineHeight: "1.5" } }, crPostsNote) : null,
      (isPaired && chatRows.length === 0)
        ? h(CrEmpty, { text: "Nothing from this chat yet." })
        : null,
      chatRows.map((row) => h(CrPostCard, {
        key: "c" + String(row.i), char: char, thread: row.t, scope: "chat", index: row.i, mobile: props.mobile
      }))
    )),
    h(CrHeading, {
      id: "posts-kept",
      title: "Kept on the profile",
      note: "Posts that outlive the chat that made them. A kept post is no longer in this story's list, so AR's Forum page — which still owns comments, Reflect and Plan — cannot reach it until you return it."
    }, h("div", { style: { display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_3 } },
      keptRows.length === 0
        ? h(CrEmpty, { text: "Nothing kept yet." })
        : null,
      keptRows.map((row) => h(CrPostCard, {
        key: "k" + String(row.i), char: char, thread: row.t, scope: "kept", index: row.i, mobile: props.mobile
      }))
    ))
  );
}

// ============================================================================
// SECTION CR-CHATIMG — PHOTOS THE CONTACT SENDS
// ============================================================================

// Must match the bridge's AE_STORY_IMG_SENTINEL.
const CR_CHATIMG_SENTINEL = "ce-storyimg:";

function crChatImgRxUnresolved() : RegExp { return /\[[ \t]*Image[ \t]*:[ \t]*([^\]\n\r]+?)[ \t]*\]/i; }
function crChatImgRxResolved() : RegExp { return /\[[ \t]*Image#([0-9a-f]{8})[ \t]*:[ \t]*([^\]\n\r]+?)[ \t]*\]/gi; }

const CR_CHATIMG_MAX_PER_PASS = 2;

const CR_CHATIMG_MAX_TOKENS = 300;

const CR_CHATIMG_KEY = "cr.chatImages";
await api.v1.storage.setIfAbsent(CR_CHATIMG_KEY, false);
let crChatImgOn: boolean = (await api.v1.storage.get(CR_CHATIMG_KEY)) === true;

let crChatImgReason = "";

let crChatImgHandles: any[] = [];

async function crSetChatImgOn(on: boolean) : Promise<void>
{
  crChatImgOn = on === true;
  try{ await api.v1.storage.set(CR_CHATIMG_KEY, crChatImgOn); }
  catch (e){ api.v1.error("[CR:chatimg] could not store the setting:", e); }
  crChatImgRuleApply().catch(() => {});
  crChatImgEmit().catch(() => {});
  crTouch();
}

const CR_CHATIMG_BRAIN_NAME = "Photos";

function crChatImgBrainText(userName: string) : string
{
  const them = userName || "the person you are talking to";
  return "You may send a photo when it fits \u2014 a selfie, something you are looking at, or "
    + "anything " + them + " asks you to show. Do it when it is natural, and always when asked. "
    + "To send one, put this on its own line AFTER your message text: "
    + "[Image: a clear description of what the photo shows]. Describe the shot in plain words "
    + "\u2014 what you are doing, what you are wearing, where you are, how it is framed. Do not "
    + "describe your own face or body; that is added automatically. Never send more than one "
    + "photo in a message.";
}

async function crChatImgAddBrain(card: CrAnyCard, kind: CrCardKind) : Promise<void>
{
  const anyCard: any = card;
  const brains: BrainEntry[] = Array.isArray(anyCard.brains) ? anyCard.brains.slice() : [];
  const user = crLiveUser();
  const text = crChatImgBrainText(user && user.name ? user.name : "");
  const at = brains.findIndex((b) => String(b && b.name) === CR_CHATIMG_BRAIN_NAME);
  if (at >= 0){
    brains[at] = { name: CR_CHATIMG_BRAIN_NAME, content: text };
  }
  else{
    brains.push({ name: CR_CHATIMG_BRAIN_NAME, content: text });
  }
  await crSetBrains(card, kind, brains);
}

function crChatImgHasBrain(card: CrAnyCard) : boolean
{
  const anyCard: any = card;
  const brains: BrainEntry[] = Array.isArray(anyCard.brains) ? anyCard.brains : [];
  return brains.some((b) => String(b && b.name) === CR_CHATIMG_BRAIN_NAME);
}

type CrChatImgBuilt = { prompt: string; characters: { name: string; visuals: string; uc: string }[];
                        base: string; baseUC: string };

async function crChatImgBuildPrompt(desc: string, sender: Character) : Promise<CrChatImgBuilt | null>
{
  const description = String(desc || "").trim();
  if (!description){
    return null;
  }
  const cast: CrCastCard[] = [sender];
  const others = crDetectCast(description);
  for (let i = 0; i < others.length; i++){
    if (others[i].id === sender.id){
      continue;
    }
    cast.push(others[i]);
    if (cast.length >= 4){
      break;
    }
  }

  const characters: { name: string; visuals: string; uc: string }[] = [];
  const baseBits: string[] = [];
  const baseUCBits: string[] = [];
  const scene = crSceneBasePrompt();
  if (scene.base){ baseBits.push(scene.base); }
  if (scene.uc){ baseUCBits.push(scene.uc); }
  for (let i = 0; i < cast.length; i++){
    const assembled = crAssembleCharacterPrompt(cast[i], "illustrate");
    if (assembled.visuals){
      characters.push({ name: cast[i].name || "character", visuals: assembled.visuals, uc: assembled.uc });
    }
    const base = crAssembleBasePrompt(cast[i], "illustrate");
    if (base.base){ baseBits.push(base.base); }
    if (base.uc){ baseUCBits.push(base.uc); }
  }

  const names = characters.map((c) => c.name).join(", ");
  const ask = "Photo description:\n" + description
    + "\n\nThis is a photo taken by " + (sender.name || "someone")
    + " and sent in a message \u2014 compose it as a casual phone snapshot, handheld framing and "
    + "available light, rather than a cinematic still, unless the description plainly asks for "
    + "something else."
    + (names ? "\n\nIn the shot (their appearance is supplied to the renderer separately \u2014 "
             + "name them, do not describe how they look): " + names + "." : "")
    + "\n\nGenerate the image prompt:";

  try{
    const genParams = await api.v1.generationParameters.get();
    const messages: APIMessage[] = [
      { role: "system", content: CR_ARCH_INSTRUCTION },
      { role: "user", content: ask }
    ];
    const response = await crSideGenerate(messages, {
      model: genParams.model,
      max_tokens: CR_CHATIMG_MAX_TOKENS,
      temperature: 0.7
    });
    const raw = (response && response.choices && response.choices[0] && response.choices[0].text)
      ? String(response.choices[0].text)
      : "";
    const prompt = crStripArchNoise(raw);
    if (!prompt){
      return null;
    }
    return { prompt: prompt, characters: characters,
             base: baseBits.join(", "), baseUC: baseUCBits.join(", ") };
  }
  catch (e){
    api.v1.error("[CR:chatimg] the architect pass failed:", e);
    return null;
  }
}

async function crChatImgDispatch(uuid: string, built: CrChatImgBuilt) : Promise<void>
{
  const compiled = crCompileImgFields();
  await crBridgeSend("GENERATE_IMAGE", {
    uuid: uuid,
    prompt: built.prompt,
    extraBaseVisuals: built.base,
    extraBaseUC: built.baseUC,
    characters: built.characters,
    settings: {
      model: crImgSettings.model,
      width: crImgSettings.width,
      height: crImgSettings.height,
      scale: crImgSettings.scale,
      steps: crImgSettings.steps,
      seed: crImgSettings.seed,
      quality: compiled.quality,
      negative: compiled.negative
    }
  });
}

function crChatImgShortId(uuid: string) : string
{
  return String(uuid || "").replace(/-/g, "").substring(0, 8).toLowerCase();
}

async function crChatImgProcess() : Promise<void>
{
  if (!crChatImgOn){
    api.v1.log("[CR:chatimg] pass skipped: the setting is off.");
    return;
  }
  const char = crLiveContact();
  if (!char){
    crChatImgReason = "Skipped: no Contact is paired.";
    api.v1.log("[CR:chatimg] pass skipped: no Contact is paired.");
    return;
  }
  let sections: { sectionId: number; section: Section; index: number }[] = [];
  try{ sections = await api.v1.document.scan(); }
  catch (e){ return; }
  if (!sections.length){
    crChatImgReason = "Skipped: the document is empty.";
    return;
  }

  type CrChatImgJob = { sectionId: number; text: string; desc: string; sender: Character };
  const jobs: CrChatImgJob[] = [];
  const cast = crGroupCast(char);
  let sender: Character = char;
  for (let i = 0; i < sections.length && jobs.length < CR_CHATIMG_MAX_PER_PASS; i++){
    const text = String((sections[i].section && sections[i].section.text) || "");
    if (!text){
      continue;
    }
    const lead = text.trim();
    for (let k = 0; k < cast.length; k++){
      if (lead.indexOf(cast[k].name + ":") === 0){
        sender = cast[k];
        break;
      }
    }
    if (crSectionIsAuthors(sections[i].section)){
      sender = char;
    }
    const m = crChatImgRxUnresolved().exec(text);
    if (!m){
      continue;
    }
    jobs.push({ sectionId: sections[i].sectionId, text: text, desc: String(m[1] || "").trim(), sender: sender });
  }
  if (!jobs.length){
    crChatImgReason = char.name + " did not send a photo (read " + String(sections.length)
      + " paragraph" + (sections.length === 1 ? "" : "s") + ").";
    const last = sections.length
      ? String((sections[sections.length - 1].section && sections[sections.length - 1].section.text) || "")
      : "";
    api.v1.log("[CR:chatimg] no tag found. Paragraphs read: " + String(sections.length)
      + ". Last paragraph: " + JSON.stringify(last.slice(0, 200)));
    return;
  }
  api.v1.log("[CR:chatimg] found " + String(jobs.length) + " photo tag(s) in "
    + String(sections.length) + " paragraphs.");
  if (!crBridge.ready){
    crChatImgReason = "Waiting: the bridge is not connected, so the photo could not be sent.";
    try{ await api.v1.ui.toast("A photo was skipped \u2014 image generation needs the bridge.", { type: "warning", autoClose: 3500 }); }
    catch (e){}
    return;
  }
  const permission: ScriptPermission = "documentEdit";
  let allowed = false;
  try{ allowed = await permissionCheckPassed(permission); }
  catch (e){ allowed = false; }
  if (!allowed){
    crChatImgReason = "Blocked: CharacterRoom does not have permission to write to the document.";
    return;
  }

  let done = 0;
  for (let j = 0; j < jobs.length; j++){
    const job = jobs[j];
    const built = await crChatImgBuildPrompt(job.desc, job.sender);
    if (!built){
      crChatImgReason = "The photo prompt could not be written, so the tag was left as it is.";
      continue;
    }
    const uuid = api.v1.uuid();
    try{ await crChatImgDispatch(uuid, built); }
    catch (e){
      api.v1.error("[CR:chatimg] dispatch failed:", e);
      crChatImgReason = "The photo could not be sent to the bridge.";
      continue;
    }
    const short = crChatImgShortId(uuid);
    const rewritten = job.text.replace(crChatImgRxUnresolved(),
      "[Image#" + short + ": " + job.desc + "]");
    try{
      await api.v1.document.updateParagraph(job.sectionId, { text: rewritten });
      done++;
    }
    catch (e){
      api.v1.error("[CR:chatimg] the tag could not be rewritten; the photo is generating but will not bind:", e);
      crChatImgReason = "The photo is generating, but the story would not take its tag, so it will not appear inline.";
    }
  }
  if (done > 0){
    crChatImgReason = done === 1 ? "Sent one photo to generate." : "Sent " + String(done) + " photos to generate.";
    api.v1.log("[CR:chatimg] dispatched " + String(done) + " photo(s); anchors going in.");
    // The tag rewrite is a document edit: re-place every decoration after it.
    try{ await updateEditorImages(); }
    catch (e){ await crChatImgEmit(); }
  }
}

function crChatImgStripIds(list: any[]) : any[]
{
  if (!list || !list.length){
    return list;
  }
  let touched = false;
  const out: any[] = [];
  for (let i = 0; i < list.length; i++){
    const msg = list[i];
    const content = (msg && typeof msg.content === "string") ? msg.content : "";
    if (!content || content.indexOf("[Image#") < 0){
      out.push(msg);
      continue;
    }
    touched = true;
    const copy: any = {};
    for (const k in msg){
      copy[k] = msg[k];
    }
    copy.content = content.replace(crChatImgRxResolved(), "[Image: $2]");
    out.push(copy);
  }
  return touched ? out : list;
}

function crChatImgStripIdsText(text: string) : string
{
  const s = String(text || "");
  if (s.indexOf("[Image#") < 0){
    return s;
  }
  return s.replace(crChatImgRxResolved(), "[Image: $2]");
}

async function crChatImgDispose() : Promise<void>
{
  const held = crChatImgHandles;
  crChatImgHandles = [];
  for (let i = 0; i < held.length; i++){
    try{
      if (held[i] && held[i].dispose){
        await held[i].dispose();
      }
    }
    catch (e){}
  }
}

async function crChatImgEmit() : Promise<void>
{
  return crSerial("chatimg", crChatImgEmitOnce);
}

async function crChatImgEmitOnce() : Promise<void>
{
  crChatImgRuleApply().catch(() => {});
  await crChatImgDispose();
  if (!crChatImgOn){
    return;
  }
  let sections: { sectionId: number; section: Section; index: number }[] = [];
  try{ sections = await api.v1.document.scan(); }
  catch (e){ return; }
  const parts: any[] = [];
  for (let i = 0; i < sections.length; i++){
    const text = String((sections[i].section && sections[i].section.text) || "");
    if (!text){
      continue;
    }
    // A /g regex keeps lastIndex; use a fresh one per section.
    const rx = crChatImgRxResolved();
    let m: RegExpExecArray | null;
    while ((m = rx.exec(text)) !== null){
      parts.push({
        type: "node",
        sectionId: sections[i].sectionId,
        content: [{
          type: "text",
          text: CR_CHATIMG_SENTINEL + String(m[1]).toLowerCase(),
          style: { fontSize: "1px", color: "transparent", lineHeight: "0" }
        }]
      });
    }
  }
  if (!parts.length){
    return;
  }
  try{
    const handles: any = await api.v1.editor.decorations.createWidgets(parts);
    crChatImgHandles = (handles && handles.length) ? handles : [];
  }
  catch (e){
    api.v1.error("[CR:chatimg] the photo anchors were refused; nothing will paint:", e);
  }
}

const CR_CHATIMG_RULE_TAG = "crChatImgTag";

async function crChatImgRuleApply() : Promise<void>
{
  try{ api.v1.editor.decorations.removeRules([CR_CHATIMG_RULE_TAG]); }
  catch (e){}
  if (!crChatImgOn){
    return;
  }
  try{
    await api.v1.editor.decorations.registerRules([{
      id: CR_CHATIMG_RULE_TAG,
      type: "inline",
      match: "\\[[ \\t]*Image#[0-9a-f]{8}[ \\t]*:[^\\]\\n\\r]*\\]",
      flags: "gi",
      style: { display: "none" }
    }]);
  }
  catch (e){
    api.v1.error("[CR:chatimg] could not register the tag rule:", e);
  }
}

async function crChatImgDrop(uuid: string) : Promise<void>
{
  const short = crChatImgShortId(uuid);
  if (!/^[0-9a-f]{8}$/.test(short)){
    return;
  }
  let sections: { sectionId: number; section: Section; index: number }[] = [];
  try{ sections = await api.v1.document.scan(); }
  catch (e){ return; }
  for (let i = 0; i < sections.length; i++){
    const text = String((sections[i].section && sections[i].section.text) || "");
    if (text.toLowerCase().indexOf("[image#" + short) < 0){
      continue;
    }
    const stripped = text.replace(
      new RegExp("\\[[ \\t]*Image#" + short + "[ \\t]*:[^\\]\\n\\r]*\\]", "gi"), "").trim();
    try{ await api.v1.document.updateParagraph(sections[i].sectionId, { text: stripped }); }
    catch (e){ api.v1.error("[CR:chatimg] could not strip the tag of a deleted photo:", e); }
  }
  await crChatImgEmit();
}

// ============================================================================
// SECTION CR-GROUP — GROUP CHAT ON PERSONA HELPERS
// ============================================================================
// ============================================================================

const CR_GROUP_KEY = "cr.group";
const CR_GROUP_MAX = 6;
const CR_GROUP_DEFAULT_OUT = 400;
const CR_GROUP_LOG_MAX = 40;
const CR_PH_CHANNEL = "cr-persona-helper";
const CR_PH_PING_MS = 700;
const CR_PH_RUN_MS = 120000;

type CrGroupRecord = { v: number; members: string[]; pools: { [id: string]: number[] } };

interface CrPhHelper {
  sid: string; no: number; label: string; version: string;
  out: number; inp: number; busy: boolean; gens: number; lastErr: string;
  at: number;
  dead: boolean;
}

let crGroup: CrGroupRecord = { v: 1, members: [], pools: {} };
let crPhHelpers: { [sid: string]: CrPhHelper } = {};
const crPhPend: { [rid: string]: (d: any) => void } = {};
let crPhSeq = 0;
let crPhReady = false;
let crGroupBusyId = "";
let crGroupNote = "";
let crGroupLog: string[] = [];
let crGroupBtnIds: string[] = [];
const crGroupRolls: { [id: string]: CrkRoll } = {};
let crGroupNative: { cid: string; at: number; inp: number; out: number } | null = null;
let crGroupTailBreak = "";
let crGroupNativeSeen: { cid: string; at: number } | null = null;
// A lost generation-end must not lock the member buttons.
const CR_GROUP_NATIVE_STALE_MS = 180000;

function crGroupSanitize(v: any) : CrGroupRecord
{
  const out: CrGroupRecord = { v: 1, members: [], pools: {} };
  if (!v || typeof v !== "object"){
    return out;
  }
  const mem: any[] = Array.isArray(v.members) ? v.members : [];
  for (let i = 0; i < mem.length; i++){
    const m = mem[i];
    if (typeof m === "string" && m && out.members.indexOf(m) < 0 && out.members.length < CR_GROUP_MAX){
      out.members.push(m);
    }
  }
  const pools: any = (v.pools && typeof v.pools === "object") ? v.pools : {};
  for (let i = 0; i < out.members.length; i++){
    const id = out.members[i];
    const p: any[] = Array.isArray(pools[id]) ? pools[id] : [];
    const clean: number[] = [];
    for (let j = 0; j < p.length; j++){
      const n = Math.floor(Number(p[j]));
      if (isFinite(n) && n >= 0 && n <= 99 && clean.indexOf(n) < 0){
        clean.push(n);
      }
    }
    if (clean.length){
      out.pools[id] = clean;
    }
  }
  return out;
}

async function crGroupLoad() : Promise<void>
{
  try{ crGroup = crGroupSanitize(await api.v1.storyStorage.get(CR_GROUP_KEY)); }
  catch (e){ crGroup = crGroupSanitize(null); }
}

async function crGroupSave() : Promise<void>
{
  try{ await api.v1.storyStorage.set(CR_GROUP_KEY, crGroup); }
  catch (e){ api.v1.error("[CR:group] could not store the group:", e); }
}

function crGroupMembers() : Character[]
{
  const primaryId = chatSettings.char ? chatSettings.char.id : "";
  const out: Character[] = [];
  for (let i = 0; i < crGroup.members.length; i++){
    const id = crGroup.members[i];
    if (id === primaryId){
      continue;
    }
    const c = charList.find((x) => x.id === id);
    if (c){
      out.push(c);
    }
  }
  return out;
}

function crGroupName(c: Character | User | undefined) : string
{
  return c ? String(c.name || "") : "";
}

function crPhOut() : number
{
  try{ return api.v1.script.getAllowedOutput ? api.v1.script.getAllowedOutput() : -1; }
  catch (e){ return -1; }
}

function crPhIn() : number
{
  try{ return api.v1.script.getAllowedInput ? api.v1.script.getAllowedInput() : -1; }
  catch (e){ return -1; }
}

async function crPhUncached(msgs: any[]) : Promise<number>
{
  try{
    if (!api.v1.script.countUncachedInputTokens){
      return -1;
    }
    // The runtime requires the model argument; the typings omit it.
    const r: any = (api.v1.script.countUncachedInputTokens as any)(msgs, "xialong-v1");
    const n: any = (r && typeof r.then === "function") ? await r : r;
    return (typeof n === "number" && n >= 0) ? n : -1;
  }
  catch (e){ return -1; }
}

function crPhSend(sid: string, data: any) : string
{
  try{
    const r: any = api.v1.messaging.send(sid, data, CR_PH_CHANNEL);
    if (r && typeof r.then === "function"){
      r.catch(() => {});
    }
    return "";
  }
  catch (e){ return String((e && (e as any).message) || e || "send failed"); }
}

function crPhNote(sid: string, d: any) : void
{
  if (!sid){
    return;
  }
  const prev: CrPhHelper | undefined = crPhHelpers[sid];
  crPhHelpers[sid] = {
    sid: sid,
    no: (Number(d.no) > 0) ? Number(d.no) : (prev ? prev.no : 0),
    label: String(d.label || (prev ? prev.label : "Helper")),
    version: String(d.version || (prev ? prev.version : "")),
    out: (typeof d.out === "number") ? d.out : (prev ? prev.out : -1),
    inp: (typeof d.inp === "number") ? d.inp : (prev ? prev.inp : -1),
    busy: d.busy === true,
    gens: (typeof d.gens === "number") ? d.gens : (prev ? prev.gens : 0),
    lastErr: (typeof d.lastErr === "string") ? d.lastErr : (prev ? prev.lastErr : ""),
    at: Date.now(),
    dead: false
  };
  crTouch();
}

function crPhOnMessage(msg: any) : void
{
  try{
    const d: any = (msg && msg.data) || {};
    const t = String(d.type || "");
    if (t.indexOf("PH_") !== 0){
      return;
    }
    const sid = String((msg && msg.fromScriptId) || d.sid || "");
    if (t === "PH_HELLO" || t === "PH_PONG"){
      crPhNote(sid, d);
      return;
    }
    if (t === "PH_DONE"){
      const rec = crPhHelpers[sid];
      if (rec){
        if (typeof d.out === "number"){ rec.out = d.out; }
        if (typeof d.inp === "number"){ rec.inp = d.inp; }
        if (typeof d.gens === "number"){ rec.gens = d.gens; }
        if (typeof d.lastErr === "string"){ rec.lastErr = d.lastErr; }
        rec.busy = false;
        rec.at = Date.now();
      }
      const rid = String(d.rid || "");
      const wait = crPhPend[rid];
      if (wait){
        delete crPhPend[rid];
        wait(d);
      }
      crTouch();
    }
  }
  catch (e){ api.v1.error("[CR:group] inbound helper message failed:", e); }
}

async function crPhPing(waitMs: number) : Promise<void>
{
  try{ await api.v1.messaging.broadcast({ type: "PH_PING", sid: api.v1.script.id }, CR_PH_CHANNEL); }
  catch (e){ return; }
  if (waitMs > 0){
    try{ await api.v1.timers.sleep(waitMs); }
    catch (e){}
  }
}

async function crPhRefresh() : Promise<void>
{
  const sids = Object.keys(crPhHelpers);
  for (let i = 0; i < sids.length; i++){
    crPhHelpers[sids[i]].dead = false;
  }
  try{ await api.v1.messaging.broadcast({ type: "PH_WAKE", sid: api.v1.script.id }, CR_PH_CHANNEL); }
  catch (e){}
  await crPhPing(CR_PH_PING_MS);
  crTouch();
}

function crPhByNo(no: number) : CrPhHelper | null
{
  let best: CrPhHelper | null = null;
  const sids = Object.keys(crPhHelpers);
  for (let i = 0; i < sids.length; i++){
    const r = crPhHelpers[sids[i]];
    if (!r || r.no !== no || r.dead){
      continue;
    }
    if (!best || r.sid < best.sid){
      best = r;
    }
  }
  return best;
}

function crPhOrdinals() : number[]
{
  const out: number[] = [0];
  const sids = Object.keys(crPhHelpers);
  for (let i = 0; i < sids.length; i++){
    const r = crPhHelpers[sids[i]];
    if (r && !r.dead && r.no > 0 && out.indexOf(r.no) < 0){
      out.push(r.no);
    }
  }
  out.sort((a, b) => a - b);
  return out;
}

function crPhIsWall(e: any) : boolean
{
  if (String((e && e.name) || "") === "AbortError"){
    return false;
  }
  const m = String((e && e.message) || e || "").toLowerCase();
  if (!m){
    return false;
  }
  if (m.indexOf("abort") >= 0 || m.indexOf("cancel") >= 0){
    return false;
  }
  if (m.indexOf("network") >= 0 || m.indexOf("timeout") >= 0 || m.indexOf("timed out") >= 0){
    return false;
  }
  return m.indexOf("budget") >= 0 || m.indexOf("quota") >= 0 || m.indexOf("allowance") >= 0
    || m.indexOf("insufficient") >= 0 || m.indexOf("uncached") >= 0 || m.indexOf("exceed") >= 0
    || m.indexOf("too many") >= 0 || m.indexOf("limit") >= 0 || m.indexOf("helper busy") >= 0;
}

async function crPhRunHelper(rec: CrPhHelper, tag: string, messages: any[], params: any) : Promise<any>
{
  const rid = "ph" + String(++crPhSeq) + "_" + String(Date.now());
  crGroupGenDepth++;
  rec.busy = true;
  let reply: any = null;
  try{
    reply = await new Promise((resolve: (v: any) => void) => {
      let done = false;
      const finish = (v: any) => {
        if (done){
          return;
        }
        done = true;
        delete crPhPend[rid];
        resolve(v);
      };
      crPhPend[rid] = finish;
      const err = crPhSend(rec.sid, {
        type: "PH_RUN", sid: api.v1.script.id, rid: rid, tag: tag,
        messages: messages, params: params, probe: true
      });
      if (err){
        finish({ ok: false, err: "send failed: " + err });
        return;
      }
      api.v1.timers.sleep(CR_PH_RUN_MS).then(() => {
        finish({ ok: false, timeout: true, err: "helper timed out" });
      }).catch(() => {});
    });
  }
  finally{
    crGroupGenDepth--;
    if (crGroupGenDepth < 0){
      crGroupGenDepth = 0;
    }
    rec.busy = false;
    delete crPhPend[rid];
  }
  if (reply && reply.timeout){
    rec.dead = true;
  }
  if (reply && !reply.ok){
    rec.lastErr = String(reply.err || "unknown");
  }
  return reply;
}

function crGroupChoiceText(resp: any) : string
{
  const c: any = (resp && resp.choices && resp.choices[0]) || null;
  if (!c){
    return "";
  }
  return String(c.text || (c.message && c.message.content) || "");
}

async function crGroupRunLocal(messages: any[], params: any, probe: any) : Promise<string>
{
  probe.pred = await crPhUncached(messages);
  probe.outBefore = crPhOut();
  probe.inBefore = crPhIn();
  const t = Date.now();
  crGroupGenDepth++;
  try{
    const resp = await crSideGenerate(messages, params, undefined, "background");
    probe.inAfter = crPhIn();
    probe.outAfter = crPhOut();
    return crGroupChoiceText(resp);
  }
  finally{
    crGroupGenDepth--;
    if (crGroupGenDepth < 0){
      crGroupGenDepth = 0;
    }
    if (probe.inAfter < 0){
      probe.inAfter = crPhIn();
      probe.outAfter = crPhOut();
    }
    probe.genMs = Date.now() - t;
  }
}

function crGroupAutoPool(id: string) : number[]
{
  const load: { [n: number]: number } = {};
  for (let i = 0; i < crGroup.members.length; i++){
    const k = crGroup.members[i];
    if (k === id){
      continue;
    }
    const p = crGroup.pools[k] || [];
    for (let j = 0; j < p.length; j++){
      if (p[j] > 0){
        load[p[j]] = (load[p[j]] || 0) + 1;
      }
    }
  }
  const ords = crPhOrdinals().filter((n) => n > 0);
  if (!ords.length){
    crGroupLogLine("member " + crReportId(id) + " has no helper to pin to; it will run on the main script");
    return [0];
  }
  ords.sort((a, b) => ((load[a] || 0) - (load[b] || 0)) || (a - b));
  if ((load[ords[0]] || 0) > 0){
    crGroupLogLine("member " + crReportId(id) + " shares Helper " + String(ords[0])
      + " with another member; switches between them may read cold");
  }
  return [ords[0]];
}

async function crGroupToggleMember(id: string) : Promise<void>
{
  const at = crGroup.members.indexOf(id);
  if (at >= 0){
    crGroup.members.splice(at, 1);
    delete crGroup.pools[id];
  }
  else {
    if (crGroup.members.length >= CR_GROUP_MAX){
      api.v1.ui.toast("A group holds " + String(CR_GROUP_MAX) + " members besides the paired Contact.", { type: "warning" });
      return;
    }
    crGroup.members.push(id);
    await crPhPing(CR_PH_PING_MS);
    crGroup.pools[id] = crGroupAutoPool(id);
  }
  await crGroupSave();
  await crGroupButtonsSync();
  crGroupRepaint();
  crTouch();
}

async function crGroupTogglePool(id: string, no: number) : Promise<void>
{
  const p = (crGroup.pools[id] || []).slice();
  const at = p.indexOf(no);
  if (at >= 0){
    p.splice(at, 1);
  }
  else {
    p.push(no);
  }
  if (p.length){
    crGroup.pools[id] = p;
  }
  else {
    delete crGroup.pools[id];
  }
  await crGroupSave();
  crTouch();
}

async function crGroupButtonsSync() : Promise<void>
{
  const members = crGroupMembers();
  if (!members.length && !crGroupBtnIds.length){
    return;
  }
  const exts: UIExtension[] = [];
  const ids: string[] = [];
  for (let i = 0; i < members.length; i++){
    const memberId = members[i].id;
    const btnId = "crGroupBtn-" + memberId;
    ids.push(btnId);
    exts.push({
      type: "toolbarButton",
      id: btnId,
      text: members[i].alias || members[i].name,
      iconId: "message-circle",
      disabledWhileCallbackRunning: true,
      callback: async () => { await crGroupSend(memberId); }
    });
  }
  const stale = crGroupBtnIds.filter((id) => ids.indexOf(id) < 0);
  if (stale.length){
    try{ await api.v1.ui.remove(stale); }
    catch (e){ api.v1.error("[CR:group] could not remove a member button:", e); }
  }
  try{
    // ui.register replaces everything registered before, so the startup list is always included.
    await api.v1.ui.register(crStartupExtensions.concat(exts));
    crGroupBtnIds = ids;
  }
  catch (e){ api.v1.error("[CR:group] could not register the member buttons:", e); }
}

function crGroupClock() : string
{
  return new Date().toISOString().slice(11, 19);
}

function crGroupLogLine(line: string) : void
{
  crGroupLog.push(crGroupClock() + "  " + line);
  if (crGroupLog.length > CR_GROUP_LOG_MAX){
    crGroupLog = crGroupLog.slice(crGroupLog.length - CR_GROUP_LOG_MAX);
  }
  api.v1.log("[CR:group] " + line);
}

function crGroupNewProbe(id: string) : any
{
  return {
    member: crReportId(id), via: "", ok: false, err: "", tried: "",
    promptTok: -1, pred: -1, inBefore: -1, inAfter: -1, outBefore: -1, outAfter: -1,
    ms: -1, genMs: -1, shape: "", flipped: 0, before: false, built: false, origin: "", predErr: "", diverge: ""
  };
}

function crGroupLogProbe(p: any) : void
{
  const charged = (p.inBefore >= 0 && p.inAfter >= 0) ? p.inBefore - p.inAfter : -1;
  const spent = (p.outBefore >= 0 && p.outAfter >= 0) ? p.outBefore - p.outAfter : -1;
  let verdict = "?";
  if (charged >= 0 && p.promptTok > 0){
    const r = charged / p.promptTok;
    verdict = r <= 0.25 ? "warm" : (r >= 0.6 ? "cold" : "partial");
  }
  crGroupLogLine("turn " + p.member + "  via " + (p.via || "-") + "  " + (p.ok ? "ok" : "FAILED")
    + "  prompt~" + String(p.promptTok) + "  charged " + String(charged) + " (" + verdict + ")"
    + "  pred " + String(p.pred) + (p.predErr ? " (" + String(p.predErr).slice(0, 80) + ")" : "")
    + "  in " + String(p.inBefore) + ">" + String(p.inAfter)
    + "  out " + String(p.outBefore) + ">" + String(p.outAfter) + " (" + String(spent) + ")"
    + "  gen " + String(p.genMs) + "ms  all " + String(p.ms) + "ms"
    + "  shape " + (p.shape || "-") + "  flipped " + String(p.flipped)
    + (p.diverge ? "  diverge " + p.diverge : "")
    + "  hooks before=" + (p.before ? "yes" : "no") + " built=" + (p.built ? "yes" : "no")
    + (p.origin ? "  origin " + p.origin : "")
    + (p.tried ? "  tried " + p.tried : "")
    + (p.err ? "  err " + String(p.err).slice(0, 160) : ""));
}

api.v1.hooks.register("onGenerationRequested", (params) => {
  try{
    if (!params || params.scriptInitiated === true){
      return;
    }
    if (crGroupBusyId.indexOf("rpg:") === 0){
      api.v1.ui.toast("A dice reaction is still being written. Send again once it lands.", { type: "warning" });
      return { stopGeneration: true };
    }
    if (!crGroup.members.length){
      crGroupNativeSeen = { cid: String(params.continuityId || ""), at: Date.now() };
      return;
    }
    if (crGroupBusyId || crGroupGenDepth > 0){
      api.v1.ui.toast("A group reply is still being written. Send again once it lands.", { type: "warning" });
      // One generation at a time: refused, never queued.
      return { stopGeneration: true };
    }
    crGroupNativeSeen = { cid: String(params.continuityId || ""), at: Date.now() };
    if (params.model !== "xialong-v1"){
      return;
    }
    crGroupNative = { cid: String(params.continuityId || ""), at: Date.now(), inp: crPhIn(), out: crPhOut() };
  }
  catch (e){}
});

api.v1.hooks.register("onResponse", (params) => {
  try{
    if (!crGroupTailBreak || !params || String(params.continuityId || "") !== crGroupTailBreak){
      return;
    }
    crGroupTailBreak = "";
    const text = (params.text || []).slice();
    if (!text.length || /^\n/.test(String(text[0]))){
      return;
    }
    // A reply to a re-roled tail starts its own paragraph.
    text[0] = "\n" + String(text[0]);
    return { text: text };
  }
  catch (e){}
});

function crGroupNativeClose(params: any) : void
{
  try{
    const s = crGroupNativeSeen;
    if (s && (!s.cid || !params || !params.continuityId || String(params.continuityId) === s.cid)){
      crGroupNativeSeen = null;
    }
    const n = crGroupNative;
    if (!n){
      return;
    }
    if (n.cid && params && params.continuityId && String(params.continuityId) !== n.cid){
      return;
    }
    crGroupNative = null;
    crGroupTailBreak = "";
    const inp = crPhIn();
    const out = crPhOut();
    crGroupLogLine("native Send  in " + String(n.inp) + ">" + String(inp)
      + " (" + ((n.inp >= 0 && inp >= 0) ? String(n.inp - inp) : "?") + ")"
      + "  out " + String(n.out) + ">" + String(out)
      + " (" + ((n.out >= 0 && out >= 0) ? String(n.out - out) : "?") + ")"
      + "  " + String(Date.now() - n.at) + "ms");
    crTouch();
  }
  catch (e){}
}

function crGroupNativeBusy() : boolean
{
  return !!crGroupNative && (Date.now() - crGroupNative.at) < CR_GROUP_NATIVE_STALE_MS;
}

function crGroupRepaint() : void
{
  try{ updateNameStyling(); }
  catch (e){}
  crBubbleApply().catch(() => {});
  updateEditorImages().catch(() => {});
}

function crGroupCast(primary: Character) : Character[]
{
  const cast: Character[] = [primary];
  if (crGroupActive()){
    const members = crGroupMembers();
    for (let i = 0; i < members.length; i++){
      if (members[i].name){
        cast.push(members[i]);
      }
    }
  }
  return cast.slice().sort((x, y) => String(y.name || "").length - String(x.name || "").length);
}

function crGroupShape(list: any[]) : string
{
  const tail = list.slice(Math.max(0, list.length - 4));
  return tail.map((m: any) => {
    const r = String(m.role || "?").charAt(0);
    return String(m.content || "").trim() ? r : r + "0";
  }).join(",");
}

function crGroupNames() : string[]
{
  const names: string[] = [];
  const add = (n: string) => { if (n && names.indexOf(n) < 0){ names.push(n); } };
  const primary = crLiveContact();
  const user = crLiveUser();
  if (primary){ add(primary.name); }
  if (user){ add(user.name); }
  for (let i = 0; i < charList.length; i++){ add(charList[i].name); }
  names.sort((x, y) => y.length - x.length);
  return names;
}

function crGroupView(list: any[], speaker: string, keepLast: boolean, probe: any) : any[]
{
  const names = crGroupNames();
  const primary = crLiveContact();
  let owner = primary ? primary.name : "";
  const split: any[] = [];
  let flipped = 0;
  for (let i = 0; i < list.length; i++){
    const role = String(list[i].role || "");
    const content = String(list[i].content || "");
    if (role === "user"){
      owner = primary ? primary.name : "";
    }
    if (role !== "assistant" || !content.trim() || (keepLast && i === list.length - 1)){
      split.push({ role: role, content: content });
      continue;
    }
    const lines = content.split("\n");
    const segs: { role: string; lines: string[] }[] = [];
    for (let j = 0; j < lines.length; j++){
      const ln = lines[j];
      for (let k = 0; k < names.length; k++){
        if (ln.indexOf(names[k] + ":") === 0){
          owner = names[k];
          break;
        }
      }
      const segRole = owner === speaker ? "assistant" : "user";
      if (!segs.length || segs[segs.length - 1].role !== segRole){
        segs.push({ role: segRole, lines: [] });
      }
      segs[segs.length - 1].lines.push(ln);
    }
    for (let j = 0; j < segs.length; j++){
      const joined = segs[j].lines.join("\n").replace(/^\n+/, "");
      // The final segment is the continuation; keep its trailing whitespace.
      const text = (i === list.length - 1 && j === segs.length - 1) ? joined : joined.replace(/\s+$/, "");
      if (!text.trim()){
        continue;
      }
      if (segs[j].role === "user"){
        flipped++;
      }
      split.push({ role: segs[j].role, content: text });
    }
  }
  const out: any[] = [];
  for (let i = 0; i < split.length; i++){
    const prev = out.length ? out[out.length - 1] : null;
    if (prev && prev.role === "user" && split[i].role === "user"){
      prev.content = prev.content.replace(/\s+$/, "") + "\n\n" + split[i].content;
    }
    else {
      out.push(split[i]);
    }
  }
  probe.flipped = flipped;
  return out;
}

function crGroupWithRoster(list: any[], who: Character) : any[]
{
  const out = list.slice();
  const at = (out.length && out[0].role === "system") ? 1 : 0;
  out.splice(at, 0, { role: "system", content: crGroupRoster(who) });
  return out;
}

function crGroupActive() : boolean
{
  return !!chatSettings.char && crGroupMembers().length > 0;
}

function crGroupNativeView(list: any[], cid: string) : any[]
{
  const primary = crLiveContact();
  if (!primary){
    return list;
  }
  const side = crGroupSide(list, primary, true, {});
  if (cid){
    crGroupTailBreak = side.reroled ? cid : "";
  }
  return crGroupWithRoster(side.messages, primary);
}

function crGroupRoster(who: Character) : string
{
  const user = crLiveUser();
  const others: string[] = [];
  const primary = crLiveContact();
  if (primary && primary.id !== who.id){
    others.push(primary.name);
  }
  const members = crGroupMembers();
  for (let i = 0; i < members.length; i++){
    if (members[i].id !== who.id){
      others.push(members[i].name);
    }
  }
  const everyone = [crGroupName(user)].concat(others).filter((n) => !!n);
  return "----\nGroup Chat\nThis is a group chat. Present: " + everyone.join(", ") + ", and "
    + who.name + ". Every message starts with the name of whoever wrote it. " + who.name
    + " writes only " + who.name + "'s own message.";
}

function crGroupLift(list: any[]) : { rest: any[]; lifted: any[] }
{
  const rest = list.slice();
  let la = -1;
  for (let i = rest.length - 1; i >= 0; i--){
    if (rest[i].role === "assistant"){
      la = i;
      break;
    }
  }
  const s = la - 1;
  if (s < 1 || rest[s].role !== "system" || String(rest[s].content || "").indexOf("[ Style:") !== 0){
    return { rest: rest, lifted: [] };
  }
  let from = s;
  // Never move the system prompt or "Start of chat.".
  if (s - 1 >= 1 && rest[s - 1].role === "system" && String(rest[s - 1].content || "") !== "Start of chat."){
    from = s - 1;
  }
  const lifted = rest.splice(from, s - from + 1);
  return { rest: rest, lifted: lifted };
}

function crGroupSide(list: any[], who: Character, native: boolean, probe: any) : { messages: any[]; reroled: boolean }
{
  const src: any[] = list.map((m: any) => ({ role: m.role, content: String(m.content || "") }));
  probe.shape = crGroupShape(src);
  let think = "";
  const la = src.map((m: any) => m.role).lastIndexOf("assistant");
  if (la >= 0){
    const m = /^<think>[\s\S]*?<\/think>\n?/.exec(src[la].content);
    if (m){
      think = m[0];
      src[la].content = src[la].content.slice(m[0].length);
    }
  }
  const lift = crGroupLift(src);
  const out = crGroupView(lift.rest, who.name, false, probe);
  const lastNonSystem = (l: any[]) : number => {
    for (let i = l.length - 1; i >= 0; i--){
      if (l[i].role !== "system"){
        return i;
      }
    }
    return -1;
  };
  let reroled = false;
  if (native){
    const before = lastNonSystem(lift.rest);
    const after = lastNonSystem(out);
    if (before >= 0 && lift.rest[before].role === "assistant" && (after < 0 || out[after].role !== "assistant")){
      out.push({ role: "assistant", content: "" });
      reroled = true;
    }
    const fa = lastNonSystem(out);
    if (fa >= 0 && out[fa].role === "assistant"){
      out.splice(fa, 0, ...lift.lifted);
      const t = fa + lift.lifted.length;
      out[t] = { role: "assistant", content: think + out[t].content };
    }
    else {
      out.push(...lift.lifted);
    }
    return { messages: out, reroled: reroled };
  }
  const lt = lastNonSystem(out);
  if (lt >= 0 && out[lt].role === "assistant" && !out[lt].content.trim()){
    out.splice(lt, 1);
  }
  out.push(...lift.lifted);
  out.push({ role: "assistant", content: think + who.name + ":" });
  return { messages: out, reroled: false };
}

function crGroupFrame(list: any[], who: Character, probe: any) : any[]
{
  return crGroupWithRoster(crGroupSide(list, who, false, probe).messages, who);
}

async function crGroupAssemble(who: Character, probe: any, dryRun?: boolean) : Promise<any[]>
{
  const user = chatSettings.user!;
  if (!crGroupRolls[who.id]){
    crGroupRolls[who.id] = crkRollDefault();
  }
  crGroupSaw.before = false;
  crGroupSaw.built = false;
  let built: any[] = [];
  crGroupBuildChar = who;
  try{
    built = await api.v1.buildContext({ suppressScriptHooks: "self", forGeneration: true });
  }
  finally{
    crGroupBuildChar = null;
  }
  probe.before = crGroupSaw.before;
  probe.built = crGroupSaw.built;

  const includeGameStats = await api.v1.storage.get(INCLUDE_GAME_STATS_KEY);
  const trackRealTime = crClockActive() ? true : await api.v1.storyStorage.get(TRACK_REAL_TIME_KEY);
  const useEmotionalModes = await api.v1.storage.get(USE_EMOTIONAL_MODES_KEY);
  let ctx: CrkCtx;
  crGroupBuildChar = who;
  try{
    ctx = crKernelCtx({ includeGameStats: includeGameStats, trackRealTime: trackRealTime, useEmotionalModes: useEmotionalModes });
  }
  finally{
    crGroupBuildChar = null;
  }
  const res = await crkContextBuilt(crChatImgStripIds(built), "xialong-v1", dryRun === true, ctx, crKernelDeps(), crGroupRolls[who.id]);
  const cid = who.id + user.id;
  if (res.plans !== undefined && res.plans !== actionPlansRecord[cid]){
    actionPlansRecord[cid] = res.plans;
  }
  if (res.planSave){
    await saveActionPlans();
  }
  return crGroupFrame(res.messages ? res.messages : built, who, probe);
}

async function crGroupPromptTokens(list: any[]) : Promise<number>
{
  let n = 0;
  try{
    for (let i = 0; i < list.length; i++){
      const t = await api.v1.tokenizer.encode(String(list[i].content || ""), "xialong-v1");
      n += t.length;
    }
  }
  catch (e){ return -1; }
  return n;
}

async function crGroupGenerate(id: string, messages: any[], params: any, probe: any) : Promise<string>
{
  let pool = crGroup.pools[id] || [];
  if (!pool.length){
    await crPhPing(CR_PH_PING_MS);
    pool = crGroupAutoPool(id);
    crGroup.pools[id] = pool;
    await crGroupSave();
  }
  const need = Number(params.max_tokens) > 0 ? Number(params.max_tokens) : CR_GROUP_DEFAULT_OUT;
  const tried: string[] = [];
  let last: any = null;
  for (let i = 0; i < pool.length; i++){
    const no = pool[i];
    if (no === 0){
      const own = crPhOut();
      if (own >= 0 && own < need){
        tried.push("main output " + String(own));
        continue;
      }
      try{
        const text = await crGroupRunLocal(messages, params, probe);
        probe.via = "main";
        probe.tried = tried.join("; ");
        return text;
      }
      catch (e){
        if (!crPhIsWall(e)){
          throw e;
        }
        last = e;
        tried.push("main refused");
        continue;
      }
    }
    if (!crPhReady){
      tried.push("Helper " + String(no) + " unreachable");
      continue;
    }
    let rec = crPhByNo(no);
    if (!rec){
      await crPhPing(CR_PH_PING_MS);
      rec = crPhByNo(no);
    }
    if (!rec){
      tried.push("Helper " + String(no) + " not installed");
      continue;
    }
    if (rec.busy){
      tried.push(rec.label + " busy");
      continue;
    }
    if (rec.out >= 0 && rec.out < need){
      tried.push(rec.label + " output " + String(rec.out));
      continue;
    }
    const t = Date.now();
    const reply = await crPhRunHelper(rec, crReportId(id), messages, params);
    probe.genMs = Date.now() - t;
    if (reply && reply.probe){
      const pr = reply.probe;
      probe.pred = typeof pr.pred === "number" ? pr.pred : -1;
      probe.inBefore = typeof pr.inBefore === "number" ? pr.inBefore : -1;
      probe.inAfter = typeof pr.inAfter === "number" ? pr.inAfter : -1;
      probe.outBefore = typeof pr.outBefore === "number" ? pr.outBefore : -1;
      probe.outAfter = typeof pr.outAfter === "number" ? pr.outAfter : -1;
      probe.predErr = typeof pr.predErr === "string" ? pr.predErr : "";
    }
    if (reply && reply.ok){
      probe.via = rec.label;
      probe.tried = tried.join("; ");
      return String(reply.text || "");
    }
    const err = new Error(rec.label + ": " + String((reply && reply.err) || "helper failed"));
    if ((reply && reply.timeout) || !crPhIsWall(err)){
      probe.tried = tried.join("; ");
      throw err;
    }
    last = err;
    tried.push(rec.label + " refused");
  }
  probe.tried = tried.join("; ");
  throw last || new Error("nothing in this member's pool could take the call");
}

function crGroupCleanReply(raw: string, who: Character) : string
{
  let t = String(raw || "").replace(/^\s*<think>[\s\S]*?<\/think>\s*/, "");
  const prefix = who.name + ":";
  if (t.replace(/^\s+/, "").indexOf(prefix) === 0){
    t = t.replace(/^\s+/, "").slice(prefix.length);
  }
  t = t.replace(/^[ \t]*\n+/, "").replace(/^[ \t]+/, "");
  if (!t.trim()){
    return "";
  }
  const names: string[] = [];
  const primary = crLiveContact();
  const user = crLiveUser();
  if (primary && primary.id !== who.id){ names.push(primary.name); }
  if (user && user.name){ names.push(user.name); }
  for (let i = 0; i < charList.length; i++){
    if (charList[i].id !== who.id && charList[i].name && names.indexOf(charList[i].name) < 0){
      names.push(charList[i].name);
    }
  }
  const lines = (prefix + " " + t).split("\n");
  const kept: string[] = [lines[0]];
  for (let i = 1; i < lines.length; i++){
    const ln = lines[i];
    if (ln.indexOf("{") === 0 || ln.indexOf("<|") === 0){
      break;
    }
    if (names.some((n) => !!n && ln.indexOf(n + ":") === 0)){
      break;
    }
    kept.push(ln);
  }
  return kept.join("\n").replace(/\s+$/, "");
}

async function crGroupDropEmptyOpener() : Promise<void>
{
  try{
    const sections = await api.v1.document.scan();
    for (let i = sections.length - 1; i >= 0; i--){
      const text = String((sections[i].section && sections[i].section.text) || "");
      if (!text.trim()){
        continue;
      }
      if (text.trim() === "{"){
        await api.v1.document.removeParagraph(sections[i].sectionId);
      }
      return;
    }
  }
  catch (e){ api.v1.error("[CR:group] could not tidy the empty opener:", e); }
}

const crGroupLastPrompt: { [id: string]: string[] } = {};
function crGroupDiverge(id: string, messages: any[]) : string
{
  const cur = messages.map((m: any) => String(m.role) + "|" + String(m.content || ""));
  const prev = crGroupLastPrompt[id];
  crGroupLastPrompt[id] = cur;
  if (!prev){
    return "first";
  }
  for (let i = 0; i < cur.length && i < prev.length; i++){
    if (cur[i] === prev[i]){
      continue;
    }
    const a = cur[i];
    const b = prev[i];
    let k = 0;
    while (k < a.length && k < b.length && a.charAt(k) === b.charAt(k)){
      k++;
    }
    const head = a.indexOf("|") + 1;
    return "m" + String(i) + "/" + String(cur.length) + " c" + String(Math.max(0, k - head)) + " " + String(messages[i].role || "?").charAt(0);
  }
  return cur.length === prev.length ? "none" : "m" + String(Math.min(cur.length, prev.length)) + "/" + String(cur.length) + " end";
}

async function crGroupWrite(text: string, probe: any) : Promise<void>
{
  const lines = text.split("\n").map((l) => l.replace(/\s+$/, "")).filter((l) => l.trim().length > 0);
  if (!lines.length){
    return;
  }
  // Verbatim, asterisks included: the model reads these lines back as its own format.
  const tagged: any[] = lines.map((l) => ({ text: l, origin: [{ position: 0, length: l.length, data: "ai" }] }));
  try{
    await api.v1.document.appendParagraphs(tagged);
    probe.origin = "ai";
  }
  catch (e){
    probe.origin = "refused";
    api.v1.error("[CR:group] the editor refused origin on the reply; writing it bare:", e);
    await api.v1.document.appendParagraphs(lines.map((l) => ({ text: l })));
  }
}

// The document keeps the asterisks (the model reads them back); the editor shows italics.
const CR_EMPH_RULE_TEXT = "crEmphText";
const CR_EMPH_RULE_MARK = "crEmphMark";
const CR_EMPH_INNER = "(?<=(?:^|[^\\w*])\\*)[^*\\n]+(?=\\*(?!\\*))";
const CR_EMPH_MARKS = "(?<![\\w*])\\*(?=[^*\\n]+\\*(?!\\*))|(?<=(?:^|[^\\w*])\\*[^*\\n]+)\\*(?!\\*)";

async function crEmphRuleApply() : Promise<void>
{
  try{ api.v1.editor.decorations.removeRules([CR_EMPH_RULE_TEXT, CR_EMPH_RULE_MARK]); }
  catch (e){}
  try{
    await api.v1.editor.decorations.registerRules([
      { id: CR_EMPH_RULE_TEXT, type: "inline", match: CR_EMPH_INNER, flags: "g", style: { fontStyle: "italic" } },
      { id: CR_EMPH_RULE_MARK, type: "inline", match: CR_EMPH_MARKS, flags: "g", style: { display: "none" } }
    ]);
  }
  catch (e){
    api.v1.error("[CR:group] could not register the emphasis rules:", e);
  }
}

async function crGroupSend(id: string) : Promise<void>
{
  if (crGroupBusyId){
    api.v1.ui.toast("A group reply is already being written.", { type: "warning" });
    return;
  }
  if (crGroupNativeBusy()){
    api.v1.ui.toast("A reply is being written. Try again once it lands.", { type: "warning" });
    return;
  }
  const who = charList.find((c) => c.id === id);
  if (!who || crGroup.members.indexOf(id) < 0){
    return;
  }
  if (!chatSettings.char || !chatSettings.user){
    api.v1.ui.toast("Pair a Contact and a User before a group member can answer.", { type: "warning" });
    return;
  }
  if (chatSettings.char.id === id){
    api.v1.ui.toast(who.name + " is the paired Contact and answers on Send.", { type: "info" });
    return;
  }
  let gp: any = null;
  try{ gp = await api.v1.generationParameters.get(); }
  catch (e){ gp = null; }
  if (!gp || gp.model !== "xialong-v1"){
    api.v1.ui.toast("Group replies need the story's model set to Xialong.", { type: "warning" });
    return;
  }
  let allowed = false;
  try{ allowed = await permissionCheckPassed("documentEdit"); }
  catch (e){ allowed = false; }
  if (!allowed){
    api.v1.ui.toast("CharacterRoom needs permission to write to the document.", { type: "warning" });
    return;
  }
  const params: any = {
    model: "xialong-v1",
    max_tokens: (Number(gp.max_tokens) > 0) ? Number(gp.max_tokens) : CR_GROUP_DEFAULT_OUT
  };
  const keys = ["temperature", "top_p", "top_k", "min_p", "frequency_penalty", "presence_penalty"];
  for (let i = 0; i < keys.length; i++){
    if (typeof gp[keys[i]] === "number"){
      params[keys[i]] = gp[keys[i]];
    }
  }
  crGroupBusyId = id;
  crGroupNote = "Writing " + who.name + "'s reply\u2026";
  crTouch();
  const t0 = Date.now();
  const probe = crGroupNewProbe(id);
  try{
    await crGroupDropEmptyOpener();
    const messages = await crGroupAssemble(who, probe);
    probe.diverge = crGroupDiverge(id, messages);
    probe.promptTok = await crGroupPromptTokens(messages);
    const raw = await crGroupGenerate(id, messages, params, probe);
    const text = crGroupCleanReply(raw, who);
    if (!text || text === who.name + ":"){
      throw new Error("the reply came back empty");
    }
    await crGroupWrite(text, probe);
    crGroupRolls[id].checkInitialTrim = false;
    probe.ok = true;
    crGroupNote = who.name + " replied through " + probe.via + ".";
  }
  catch (e){
    probe.err = String((e && (e as any).message) || e);
    crGroupNote = "Failed: " + probe.err;
    api.v1.error("[CR:group] reply failed:", e);
  }
  finally{
    crGroupBusyId = "";
    probe.ms = Date.now() - t0;
    crGroupLogProbe(probe);
    crTouch();
  }
  try{ await updateEditorImages(); }
  catch (e){}
  if (probe.ok){
    crChatImgProcess().catch((e) => { api.v1.error("[CR:chatimg] pass after a member reply failed:", e); });
  }
}

async function crGroupInit() : Promise<void>
{
  await crGroupLoad();
  try{
    await api.v1.messaging.onMessage(crPhOnMessage, { channel: CR_PH_CHANNEL });
    crPhReady = true;
  }
  catch (e){ api.v1.error("[CR:group] helper listener failed; members can only run on the main script:", e); }
  if (crPhReady){
    crPhPing(0).catch(() => {});
  }
  await crGroupButtonsSync();
  crGroupRepaint();
  crTouch();
}

function crGroupReportLines() : string[]
{
  const out: string[] = [];
  out.push("GROUP CHAT");
  const members = crGroupMembers();
  out.push("  members " + String(members.length) + "   helper listener " + (crPhReady ? "yes" : "no"));
  for (let i = 0; i < members.length; i++){
    const p = crGroup.pools[members[i].id] || [];
    out.push("  " + crReportId(members[i].id) + "  pool [" + p.join(", ") + "]");
  }
  const sids = Object.keys(crPhHelpers);
  if (!sids.length){
    out.push("  no helper has answered");
  }
  for (let i = 0; i < sids.length; i++){
    const r = crPhHelpers[sids[i]];
    out.push("  " + r.label + "  v" + r.version + "  output " + String(r.out) + "  input " + String(r.inp)
      + "  read " + crReportAgo(r.at) + "  gens " + String(r.gens)
      + (r.dead ? "  DEAD" : "") + (r.lastErr ? "  last error " + r.lastErr.slice(0, 120) : ""));
  }
  out.push("  main script  output " + String(crPhOut()) + "  input " + String(crPhIn()));
  if (crGroupLog.length){
    out.push("  probe log");
    for (let i = 0; i < crGroupLog.length; i++){
      out.push("    " + crGroupLog[i]);
    }
  }
  return out;
}

function CrGroupMemberRow(props: { char: Character }) : any
{
  const c = props.char;
  const pool = crGroup.pools[c.id] || [];
  const ords = crPhOrdinals();
  for (let i = 0; i < pool.length; i++){
    if (ords.indexOf(pool[i]) < 0){
      ords.push(pool[i]);
    }
  }
  ords.sort((a, b) => a - b);
  const busy = crGroupBusyId === c.id;
  return h("div", {
    class: "cr-group-member",
    style: { padding: CR_S_3 + " 0", borderTop: CR_LINE_W + " solid " + CR_LINE }
  },
    h("div", { style: { display: "flex", alignItems: "center", gap: CR_S_3 } },
      h(CrAvatar, { src: c.avatar || "", name: c.name, charId: c.id, size: 28 }),
      h("div", { style: { flex: "1 1 auto", minWidth: "0", color: CR_HEAD, fontSize: CR_T_BASE, fontWeight: "600" } },
        c.alias || c.name),
      busy ? h(CrPill, { text: "writing", tone: "accent" }) : null,
      h(CrButton, {
        text: "Send as " + (c.alias || c.name), primary: true, icon: "comment",
        disabled: !!crGroupBusyId,
        onClick: () => { crGroupSend(c.id).catch(() => {}); }
      })
    ),
    h("div", { style: { display: "flex", gap: CR_S_2, flexWrap: "wrap", alignItems: "center", marginTop: CR_S_2 } },
      h("span", { style: { color: CR_DIM, fontSize: CR_T_SM } }, "Answers through"),
      ords.map((no) => {
        const inPool = pool.indexOf(no) >= 0;
        const present = no === 0 || !!crPhByNo(no);
        const label = (no === 0 ? "Main" : "Helper " + String(no))
          + (inPool && pool.indexOf(no) === 0 ? " (home)" : (inPool ? " (spill " + String(pool.indexOf(no)) + ")" : ""));
        return h(CrButton, {
          key: String(no), text: label, primary: inPool, icon: "",
          tone: present ? "" : "warn",
          title: present ? "" : "Not answering right now",
          onClick: () => { crGroupTogglePool(c.id, no).catch(() => {}); }
        });
      })
    )
  );
}

function CrGroupTab(props: { mobile: boolean }) : any
{
  const primary = crLiveContact();
  const user = crLiveUser();
  if (!primary || !user){
    return h(CrEmpty, { text: "Pair a Contact and a User on the Chat tab first \u2014 a group is built around that pairing." });
  }
  const members = crGroupMembers();
  const candidates = charList.filter((c) => c.id !== primary.id);
  const sids = Object.keys(crPhHelpers).sort((a, b) => crPhHelpers[a].no - crPhHelpers[b].no);
  return h("div", { class: "cr-group" },
    h(CrSection, {
      title: "Group",
      note: primary.name + " answers on Send, as always. Everyone picked here gets a button of their own on the "
        + "toolbar, and answers through a helper script. One reply at a time: a press while another reply is "
        + "being written is turned away, not queued. Experimental."
    },
      h("div", { style: { display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_2, marginTop: CR_S_3 } },
        candidates.length ? candidates.map((c) => h(CrPickRow, {
          key: c.id, name: c.alias || c.name, sub: c.description || c.persona || "",
          avatar: c.avatar, charId: c.id, pill: "in group",
          active: crGroup.members.indexOf(c.id) >= 0,
          onPick: () => { crGroupToggleMember(c.id).catch(() => {}); }
        })) : h(CrEmpty, { text: "There is no other Contact to add yet." })
      )
    ),
    members.length ? h(CrSection, {
      title: "Replies",
      note: "Home is where a member's replies go. A spill helper is only used when the one before it refuses, "
        + "and pays one full read the first time it serves. Do not press Send while a reply is being written."
    },
      h("div", { style: { marginTop: CR_S_2 } }, members.map((c) => h(CrGroupMemberRow, { key: c.id, char: c }))),
      h(CrNote, { text: crGroupNote })
    ) : null,
    h(CrSection, {
      title: "Helpers",
      note: "Each helper is a CR Persona Helper script. The numbers are its own allowance, as it last reported them."
    },
      h("div", { style: { display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_1, marginTop: CR_S_3 } },
        sids.length ? sids.map((sid) => {
          const r = crPhHelpers[sid];
          return h("div", { key: sid, style: { fontSize: CR_T_SM, color: r.dead ? CR_WARN : CR_TEXT, lineHeight: "1.5" } },
            r.label + "  v" + r.version + "  \u00b7  output " + String(r.out) + "  \u00b7  input " + String(r.inp)
              + "  \u00b7  read " + crReportAgo(r.at)
              + (r.busy ? "  \u00b7  busy" : "") + (r.dead ? "  \u00b7  not answering" : "")
              + (r.lastErr ? "  \u00b7  " + r.lastErr.slice(0, 120) : ""));
        }) : h("div", { style: { color: CR_DIM, fontSize: CR_T_SM } }, "No helper has answered. Import CR Persona Helper 1 and press Refresh."),
        h("div", { style: { fontSize: CR_T_SM, color: CR_DIM } },
          "Main script  \u00b7  output " + String(crPhOut()) + "  \u00b7  input " + String(crPhIn()))
      ),
      h("div", { style: { marginTop: CR_S_3 } },
        h(CrButton, { text: "Refresh", icon: "", onClick: () => { crPhRefresh().catch(() => {}); } }))
    ),
    h(CrSection, {
      title: "Probe",
      note: "One line per reply and per native Send: what the script that ran it was charged, against the size of "
        + "the prompt. No names, so it can be pasted anywhere. Also in Global, Report."
    },
      crGroupLog.length ? h("div", { style: { marginTop: CR_S_3 } },
        h(CrTextArea, { value: crGroupLog.join("\n"), placeholder: "", rows: 10, onSet: () => { crTouch(); } })
      ) : h("div", { style: { color: CR_DIM, fontSize: CR_T_SM, marginTop: CR_S_3 } }, "Nothing yet."),
      crGroupLog.length ? h("div", { style: { marginTop: CR_S_3 } },
        h(CrButton, { text: "Clear the log", icon: "", onClick: () => { crGroupLog = []; crTouch(); } })) : null
    )
  );
}

// ============================================================================
// SECTION CR-RPG — DICE SYSTEMS, SHEETS, RESOURCES AND REACTIONS ON THE GAMES TAB
// ============================================================================

type CrRpgRowsAs = "add" | "dice" | "target";
type CrRpgRead = "sum" | "high" | "count";
type CrRpgCompare = "none" | "atLeast" | "atMost";
type CrRpgBasis = "value" | "margin" | "ratio";
type CrRpgKeep = "all" | "high" | "low";

interface CrRpgBand { label: string; meaning: string; min?: number; max?: number }
interface CrRpgTrigger {
  rawAtLeast?: number; rawAtMost?: number; face?: number; faceCount?: number;
  targetBelow?: number; zeroOnly?: boolean; shift: number; label: string; meaning: string;
}
interface CrRpgRow { id: string; label: string; n: number; d: number }
type CrRpgTone = "flat" | "spend" | "fill";
interface CrRpgResource {
  id: string; label: string; kind: "pool" | "track";
  cur: number; max: number; steps: string[];
  look: CrMeterLook; tone: CrRpgTone;
}
interface CrRpgSheet { rows: CrRpgRow[]; res: CrRpgResource[] }
interface CrRpgRuleset {
  id: string; name: string; note: string; preset: boolean;
  dice: number; sides: number; fudge: boolean; explode: number;
  rowsAs: CrRpgRowsAs; zeroDice: number; zeroKeep: CrRpgKeep; zeroAt: number;
  keep: CrRpgKeep; keepN: number; edge: boolean;
  read: CrRpgRead; countAt: number;
  compare: CrRpgCompare; target: number; basis: CrRpgBasis;
  bands: CrRpgBand[]; triggers: CrRpgTrigger[];
  sheet: CrRpgSheet;
}
interface CrRpgResult {
  at: number; actorId: string; rulesetId: string; rows: string[]; attempt: string;
  dice: number[]; kept: number[]; raw: number; value: number; target: number; hasTarget: boolean;
  zero: boolean; label: string; meaning: string; detail: string;
}
interface CrRpgReaction { whoId: string; text: string; at: number; sent: boolean }
interface CrRpgStory {
  v: number; ruleset: string; odds: boolean;
  sheets: { [rulesetId: string]: { [personId: string]: CrRpgSheet } };
  last: { [personId: string]: CrRpgResult };
  reactions: { [personId: string]: CrRpgReaction };
}

const CR_RPG_KEY = "cr.rpg";
const CR_RPG_RULESETS_KEY = "cr.rpg.rulesets";
const CR_RPG_MAX_DICE = 60;
const CR_RPG_MAX_ROWS = 40;
const CR_RPG_MAX_RES = 20;
const CR_RPG_MAX_BANDS = 12;
const CR_RPG_MAX_TRIGGERS = 12;
const CR_RPG_MAX_RULESETS = 40;
const CR_RPG_MAX_STEPS = 12;
const CR_RPG_EXPLODE_CAP = 20;

let crRpgStory: CrRpgStory = { v: 1, ruleset: "", odds: true, sheets: {}, last: {}, reactions: {} };
let crRpgCustom: CrRpgRuleset[] = [];
let crRpgSeq = 0;
let crRpgTab = "table";
let crRpgEditing = "";
let crRpgDeleteArm = "";
let crRpgSheetOpen: { [personId: string]: boolean } = {};
let crRpgWith: { [personId: string]: string[] } = {};
let crRpgReactAs: { [actorId: string]: string } = {};
let crRpgAttempt = "";
let crRpgTarget = 10;
let crRpgSit = 0;
let crRpgEdge = 0;
let crRpgBusyActor = "";
let crRpgNote = "";

function crRpgId() : string
{
  crRpgSeq++;
  return "r" + Date.now().toString(36) + crRpgSeq.toString(36);
}

function crRpgNum(v: any, lo: number, hi: number, dflt: number, int: boolean) : number
{
  if (v === null || v === undefined || v === "" || typeof v === "boolean"){
    return dflt;
  }
  let n = Number(v);
  if (!isFinite(n)){
    return dflt;
  }
  if (int){
    n = Math.round(n);
  }
  return Math.max(lo, Math.min(hi, n));
}

function crRpgOptNum(v: any, lo: number, hi: number, int: boolean) : number | undefined
{
  if (v === null || v === undefined || typeof v === "boolean" || String(v).trim() === ""){
    return undefined;
  }
  let n = Number(v);
  if (!isFinite(n)){
    return undefined;
  }
  if (int){
    n = Math.round(n);
  }
  return Math.max(lo, Math.min(hi, n));
}

function crRpgStr(v: any, cap: number) : string
{
  return typeof v === "string" ? v.slice(0, cap) : "";
}

function crRpgPick<T extends string>(v: any, list: T[], dflt: T) : T
{
  return list.indexOf(v) >= 0 ? v : dflt;
}

function crRpgSigned(n: number) : string
{
  return n < 0 ? "-" + String(Math.abs(n)) : "+" + String(n);
}

function crRpgSanitizeSheet(v: any) : CrRpgSheet
{
  const out: CrRpgSheet = { rows: [], res: [] };
  const seen: { [id: string]: boolean } = {};
  const takeId = (raw: any) : string => {
    let id = crRpgStr(raw, 40);
    if (!id || seen[id]){
      id = crRpgId();
    }
    seen[id] = true;
    return id;
  };
  const rows: any[] = (v && Array.isArray(v.rows)) ? v.rows : [];
  for (let i = 0; i < rows.length && out.rows.length < CR_RPG_MAX_ROWS; i++){
    const r = rows[i];
    if (!r || typeof r !== "object"){
      continue;
    }
    let d = crRpgNum(r.d, 0, 1000, 0, true);
    if (d === 1){
      d = 2;
    }
    out.rows.push({ id: takeId(r.id), label: crRpgStr(r.label, 60), n: crRpgNum(r.n, -999, 999, 0, true), d: d });
  }
  const res: any[] = (v && Array.isArray(v.res)) ? v.res : [];
  for (let i = 0; i < res.length && out.res.length < CR_RPG_MAX_RES; i++){
    const r = res[i];
    if (!r || typeof r !== "object"){
      continue;
    }
    const kind = crRpgPick(r.kind, ["pool", "track"], "pool");
    const steps: string[] = [];
    if (Array.isArray(r.steps)){
      for (let s = 0; s < r.steps.length && steps.length < CR_RPG_MAX_STEPS; s++){
        const t = crRpgStr(r.steps[s], 40).trim();
        if (t){
          steps.push(t);
        }
      }
    }
    const max = kind === "pool" ? crRpgNum(r.max, 0, 9999, 10, true) : 0;
    const cur = kind === "pool"
      ? crRpgNum(r.cur, -9999, 9999, max, true)
      : crRpgNum(r.cur, 0, Math.max(0, steps.length - 1), 0, true);
    out.res.push({ id: takeId(r.id), label: crRpgStr(r.label, 60), kind: kind, cur: cur, max: max, steps: steps,
      look: crRpgPick(r.look, ["auto", "bar", "pips", "plain"], "auto"),
      tone: crRpgPick(r.tone, ["flat", "spend", "fill"], "flat") });
  }
  return out;
}

function crRpgSanitizeRuleset(v: any) : CrRpgRuleset | null
{
  if (!v || typeof v !== "object"){
    return null;
  }
  const bands: CrRpgBand[] = [];
  const rawBands: any[] = Array.isArray(v.bands) ? v.bands : [];
  for (let i = 0; i < rawBands.length && bands.length < CR_RPG_MAX_BANDS; i++){
    const b = rawBands[i];
    if (!b || typeof b !== "object"){
      continue;
    }
    const band: CrRpgBand = { label: crRpgStr(b.label, 40) || "Outcome", meaning: crRpgStr(b.meaning, 240) };
    const min = crRpgOptNum(b.min, -99999, 99999, false);
    const max = crRpgOptNum(b.max, -99999, 99999, false);
    if (min !== undefined){ band.min = min; }
    if (max !== undefined){ band.max = max; }
    bands.push(band);
  }
  const triggers: CrRpgTrigger[] = [];
  const rawTrig: any[] = Array.isArray(v.triggers) ? v.triggers : [];
  for (let i = 0; i < rawTrig.length && triggers.length < CR_RPG_MAX_TRIGGERS; i++){
    const t = rawTrig[i];
    if (!t || typeof t !== "object"){
      continue;
    }
    const trig: CrRpgTrigger = {
      shift: crRpgNum(t.shift, -5, 5, 0, true),
      label: crRpgStr(t.label, 40),
      meaning: crRpgStr(t.meaning, 240)
    };
    const a = crRpgOptNum(t.rawAtLeast, -99999, 99999, true);
    const b = crRpgOptNum(t.rawAtMost, -99999, 99999, true);
    const f = crRpgOptNum(t.face, -1, 1000, true);
    const fc = crRpgOptNum(t.faceCount, 1, CR_RPG_MAX_DICE, true);
    const tb = crRpgOptNum(t.targetBelow, -99999, 99999, false);
    if (a !== undefined){ trig.rawAtLeast = a; }
    if (b !== undefined){ trig.rawAtMost = b; }
    if (f !== undefined){ trig.face = f; }
    if (fc !== undefined){ trig.faceCount = fc; }
    if (tb !== undefined){ trig.targetBelow = tb; }
    if (t.zeroOnly === true){ trig.zeroOnly = true; }
    triggers.push(trig);
  }
  return {
    id: crRpgStr(v.id, 40) || crRpgId(),
    name: crRpgStr(v.name, 60) || "Untitled system",
    note: crRpgStr(v.note, 600),
    preset: false,
    dice: crRpgNum(v.dice, 0, CR_RPG_MAX_DICE, 1, true),
    sides: crRpgNum(v.sides, 2, 1000, 20, true),
    fudge: v.fudge === true,
    explode: crRpgNum(v.explode, 0, 1000, 0, true),
    rowsAs: crRpgPick(v.rowsAs, ["add", "dice", "target"], "add"),
    zeroDice: crRpgNum(v.zeroDice, 0, 10, 0, true),
    zeroKeep: crRpgPick(v.zeroKeep, ["all", "high", "low"], "low"),
    zeroAt: crRpgNum(v.zeroAt, 0, 1000, 0, true),
    keep: crRpgPick(v.keep, ["all", "high", "low"], "all"),
    keepN: crRpgNum(v.keepN, 1, CR_RPG_MAX_DICE, 1, true),
    edge: v.edge === true,
    read: crRpgPick(v.read, ["sum", "high", "count"], "sum"),
    countAt: crRpgNum(v.countAt, -1, 1000, 6, true),
    compare: crRpgPick(v.compare, ["none", "atLeast", "atMost"], "none"),
    target: crRpgNum(v.target, -9999, 9999, 10, true),
    basis: crRpgPick(v.basis, ["value", "margin", "ratio"], "value"),
    bands: bands,
    triggers: triggers,
    sheet: crRpgSanitizeSheet(v.sheet)
  };
}

function crRpgSanitizeResult(r: any) : CrRpgResult | null
{
  if (!r || typeof r !== "object" || typeof r.label !== "string"){
    return null;
  }
  const nums = (a: any) : number[] => Array.isArray(a) ? a.slice(0, 200).map((x: any) => crRpgNum(x, -99999, 99999, 0, false)) : [];
  return {
    at: crRpgNum(r.at, 0, 1e15, 0, true),
    actorId: crRpgStr(r.actorId, 80),
    rulesetId: crRpgStr(r.rulesetId, 40),
    rows: Array.isArray(r.rows) ? r.rows.slice(0, CR_RPG_MAX_ROWS).map((x: any) => crRpgStr(x, 60)) : [],
    attempt: crRpgStr(r.attempt, 200),
    dice: nums(r.dice),
    kept: nums(r.kept),
    raw: crRpgNum(r.raw, -99999, 99999, 0, false),
    value: crRpgNum(r.value, -99999, 99999, 0, false),
    target: crRpgNum(r.target, -99999, 99999, 0, false),
    hasTarget: r.hasTarget === true,
    zero: r.zero === true,
    label: crRpgStr(r.label, 40),
    meaning: crRpgStr(r.meaning, 240),
    detail: crRpgStr(r.detail, 600)
  };
}

function crRpgSanitizeStory(v: any) : CrRpgStory
{
  const out: CrRpgStory = { v: 1, ruleset: crRpgStr(v && v.ruleset, 40),
    odds: !(v && v.odds === false), sheets: {}, last: {}, reactions: {} };
  if (!v || typeof v !== "object"){
    return out;
  }
  if (v.sheets && typeof v.sheets === "object"){
    const rsIds = Object.keys(v.sheets).slice(0, CR_RPG_MAX_RULESETS + 12);
    for (let i = 0; i < rsIds.length; i++){
      const bucket = v.sheets[rsIds[i]];
      if (!bucket || typeof bucket !== "object"){
        continue;
      }
      const people = Object.keys(bucket).slice(0, 24);
      const clean: { [personId: string]: CrRpgSheet } = {};
      for (let p = 0; p < people.length; p++){
        if (bucket[people[p]] && typeof bucket[people[p]] === "object"){
          clean[people[p]] = crRpgSanitizeSheet(bucket[people[p]]);
        }
      }
      out.sheets[rsIds[i].slice(0, 40)] = clean;
    }
  }
  if (v.last && typeof v.last === "object"){
    const ids = Object.keys(v.last).slice(0, 24);
    for (let i = 0; i < ids.length; i++){
      const r = crRpgSanitizeResult(v.last[ids[i]]);
      if (r){
        out.last[ids[i]] = r;
      }
    }
  }
  if (v.reactions && typeof v.reactions === "object"){
    const ids = Object.keys(v.reactions).slice(0, 24);
    for (let i = 0; i < ids.length; i++){
      const r = v.reactions[ids[i]];
      if (r && typeof r === "object" && typeof r.text === "string" && r.text){
        out.reactions[ids[i]] = {
          whoId: crRpgStr(r.whoId, 80), text: crRpgStr(r.text, 6000),
          at: crRpgNum(r.at, 0, 1e15, 0, true), sent: r.sent === true
        };
      }
    }
  }
  return out;
}

function crRpgPresetBase(id: string, name: string, note: string) : CrRpgRuleset
{
  return {
    id: id, name: name, note: note, preset: true,
    dice: 1, sides: 20, fudge: false, explode: 0,
    rowsAs: "add", zeroDice: 0, zeroKeep: "low", zeroAt: 0,
    keep: "all", keepN: 1, edge: false,
    read: "sum", countAt: 6,
    compare: "none", target: 10, basis: "value",
    bands: [], triggers: [], sheet: { rows: [], res: [] }
  };
}

function crRpgPresetRows(pairs: [string, number][]) : CrRpgRow[]
{
  return pairs.map((p) => ({ id: "", label: p[0], n: p[1], d: 0 }));
}

function crRpgPresetPool(label: string, cur: number, max: number, tone?: CrRpgTone) : CrRpgResource
{
  return { id: "", label: label, kind: "pool", cur: cur, max: max, steps: [],
           look: "auto", tone: tone || "flat" };
}

function crRpgPresetTrack(label: string, steps: string[]) : CrRpgResource
{
  return { id: "", label: label, kind: "track", cur: 0, max: 0, steps: steps, look: "auto", tone: "fill" };
}

function crRpgTrig(p: any) : CrRpgTrigger
{
  return Object.assign({ shift: 0, label: "", meaning: "" }, p) as CrRpgTrigger;
}

let crRpgPresetCache: CrRpgRuleset[] | null = null;
// Band meanings reach the model through a reaction, so they carry no numbers.
function crRpgPresets() : CrRpgRuleset[]
{
  if (crRpgPresetCache){
    return crRpgPresetCache;
  }
  const list: CrRpgRuleset[] = [];

  const dnd = crRpgPresetBase("preset:dnd5e", "D&D 5e",
    "Roll a d20, add the row, and meet the DC. Advantage rolls two d20s and keeps the higher; disadvantage keeps the lower. "
    + "By the rules a natural 20 or 1 only matters on attacks and death saves. Many tables use it on every roll; copy the system and remove the two triggers to play it straight.");
  dnd.edge = true; dnd.compare = "atLeast"; dnd.target = 15; dnd.basis = "margin";
  dnd.bands = [{ label: "Success", meaning: "It works.", min: 0 }, { label: "Failure", meaning: "It does not work." }];
  dnd.triggers = [
    crRpgTrig({ rawAtLeast: 20, label: "Critical success", meaning: "The best it could possibly have gone." }),
    crRpgTrig({ rawAtMost: 1, label: "Critical failure", meaning: "It goes wrong, badly." })
  ];
  dnd.sheet = {
    rows: crRpgPresetRows([["Strength", 0], ["Dexterity", 0], ["Constitution", 0], ["Intelligence", 0], ["Wisdom", 0], ["Charisma", 0], ["Proficiency", 2]]),
    res: [crRpgPresetPool("Hit points", 10, 10, "spend"), crRpgPresetPool("Inspiration", 0, 1)]
  };
  list.push(dnd);

  const pf2 = crRpgPresetBase("preset:pf2e", "Pathfinder 2e",
    "Roll a d20, add the row, and compare with the DC. Beating it by 10 is a critical success and missing by 10 a critical failure. "
    + "A natural 20 improves the result one step and a natural 1 worsens it. Fortune and misfortune use the advantage control.");
  pf2.edge = true; pf2.compare = "atLeast"; pf2.target = 15; pf2.basis = "margin";
  pf2.bands = [
    { label: "Critical success", meaning: "An exceptional result.", min: 10 },
    { label: "Success", meaning: "It works.", min: 0 },
    { label: "Failure", meaning: "It does not work.", min: -9 },
    { label: "Critical failure", meaning: "It goes wrong, badly." }
  ];
  pf2.triggers = [crRpgTrig({ rawAtLeast: 20, shift: 1 }), crRpgTrig({ rawAtMost: 1, shift: -1 })];
  pf2.sheet = {
    rows: crRpgPresetRows([["Strength", 0], ["Dexterity", 0], ["Constitution", 0], ["Intelligence", 0], ["Wisdom", 0], ["Charisma", 0], ["Proficiency", 3]]),
    res: [crRpgPresetPool("Hit points", 15, 15, "spend"), crRpgPresetPool("Hero points", 1, 3)]
  };
  list.push(pf2);

  const pbta = crRpgPresetBase("preset:pbta", "Powered by the Apocalypse",
    "Roll 2d6 and add the stat. 10 or more is a strong hit, 7 to 9 a weak hit, 6 or less a miss. Forward and ongoing bonuses go in the situational field.");
  pbta.dice = 2; pbta.sides = 6;
  pbta.bands = [
    { label: "Strong hit", meaning: "It works, cleanly.", min: 10 },
    { label: "Weak hit", meaning: "It works, but there is a cost, a complication or a hard choice.", min: 7 },
    { label: "Miss", meaning: "It goes wrong, and the situation gets worse." }
  ];
  pbta.sheet = {
    rows: crRpgPresetRows([["Cool", 0], ["Hard", 0], ["Hot", 0], ["Sharp", 0], ["Weird", 0]]),
    res: [crRpgPresetPool("Harm", 0, 6, "fill"), crRpgPresetPool("Experience", 0, 5)]
  };
  list.push(pbta);

  const blades = crRpgPresetBase("preset:blades", "Blades in the Dark",
    "The action rating is how many d6 to roll, and the highest die counts: 6 is a full success, 4 or 5 a partial, 1 to 3 a bad outcome, and two 6s a critical. "
    + "With no dice, roll two and keep the lower. Assistance, a push or a devil's bargain go in the extra dice field.");
  blades.dice = 0; blades.sides = 6; blades.rowsAs = "dice"; blades.zeroDice = 2; blades.zeroKeep = "low"; blades.read = "high";
  blades.bands = [
    { label: "Full success", meaning: "It works.", min: 6 },
    { label: "Partial success", meaning: "It works, but there is a consequence.", min: 4 },
    { label: "Bad outcome", meaning: "Things go badly." }
  ];
  blades.triggers = [crRpgTrig({ face: 6, faceCount: 2, label: "Critical", meaning: "It works, with more effect than hoped." })];
  blades.sheet = {
    rows: crRpgPresetRows([["Hunt", 0], ["Study", 0], ["Survey", 0], ["Tinker", 0], ["Finesse", 0], ["Prowl", 0],
      ["Skirmish", 0], ["Wreck", 0], ["Attune", 0], ["Command", 0], ["Consort", 0], ["Sway", 0]]),
    res: [crRpgPresetPool("Stress", 0, 9, "fill"), crRpgPresetPool("Trauma", 0, 4, "fill"), crRpgPresetTrack("Harm", ["None", "Lesser", "Moderate", "Severe", "Fatal"])]
  };
  list.push(blades);

  const cofd = crRpgPresetBase("preset:cofd", "Chronicles of Darkness",
    "Attribute plus skill is the pool of d10s: roll one row and add the other with the with button. Each 8 or more is a success, 10s roll again, and five successes is exceptional. "
    + "With no dice, a single chance die succeeds only on a 10 and a 1 is a dramatic failure.");
  cofd.dice = 0; cofd.sides = 10; cofd.rowsAs = "dice"; cofd.explode = 10; cofd.zeroDice = 1; cofd.zeroKeep = "low"; cofd.zeroAt = 10;
  cofd.read = "count"; cofd.countAt = 8;
  cofd.bands = [
    { label: "Exceptional success", meaning: "It works, with an added benefit.", min: 5 },
    { label: "Success", meaning: "It works.", min: 1 },
    { label: "Failure", meaning: "It does not work." }
  ];
  cofd.triggers = [crRpgTrig({ zeroOnly: true, face: 1, faceCount: 1, label: "Dramatic failure", meaning: "It goes badly wrong." })];
  cofd.sheet = {
    rows: crRpgPresetRows([["Intelligence", 2], ["Wits", 2], ["Resolve", 2], ["Strength", 2], ["Dexterity", 2], ["Stamina", 2],
      ["Presence", 2], ["Manipulation", 2], ["Composure", 2], ["Athletics", 0], ["Brawl", 0], ["Investigation", 0], ["Persuasion", 0], ["Stealth", 0]]),
    res: [crRpgPresetPool("Health", 7, 7, "spend"), crRpgPresetPool("Willpower", 4, 4, "spend")]
  };
  list.push(cofd);

  const yze = crRpgPresetBase("preset:yze", "Year Zero Engine",
    "Attribute, skill and gear together make the pool of d6s, and any 6 is a success; extra 6s buy extra effects. Pushing is a second roll you make yourself.");
  yze.dice = 0; yze.sides = 6; yze.rowsAs = "dice"; yze.read = "count"; yze.countAt = 6;
  yze.bands = [
    { label: "Success", meaning: "It works.", min: 1 },
    { label: "Failure", meaning: "It does not work." }
  ];
  yze.sheet = {
    rows: crRpgPresetRows([["Strength", 3], ["Agility", 3], ["Wits", 3], ["Empathy", 3],
      ["Might", 0], ["Stealth", 0], ["Marksmanship", 0], ["Scouting", 0], ["Survival", 0], ["Manipulation", 0]]),
    res: [crRpgPresetPool("Willpower", 0, 10)]
  };
  list.push(yze);

  const coc = crRpgPresetBase("preset:coc7", "Call of Cthulhu 7e",
    "Roll d100 at or under the skill. Half the skill or less is a hard success and a fifth or less an extreme one. 01 is a critical; 100 is a fumble, and so is 96 or more when the skill is under 50. "
    + "Bonus and penalty dice use the advantage control and roll an extra tens die.");
  coc.sides = 100; coc.rowsAs = "target"; coc.edge = true; coc.compare = "atMost"; coc.target = 50; coc.basis = "ratio";
  coc.bands = [
    { label: "Extreme success", meaning: "An outstanding result.", max: 0.2 },
    { label: "Hard success", meaning: "Better than it needed to be.", max: 0.5 },
    { label: "Regular success", meaning: "It works.", max: 1 },
    { label: "Failure", meaning: "It does not work." }
  ];
  coc.triggers = [
    crRpgTrig({ rawAtMost: 1, label: "Critical success", meaning: "The best possible result." }),
    crRpgTrig({ rawAtLeast: 100, label: "Fumble", meaning: "A disaster." }),
    crRpgTrig({ rawAtLeast: 96, targetBelow: 50, label: "Fumble", meaning: "A disaster." })
  ];
  coc.sheet = {
    rows: crRpgPresetRows([["Spot Hidden", 25], ["Listen", 20], ["Stealth", 20], ["Dodge", 25], ["Persuade", 10],
      ["Psychology", 10], ["Library Use", 20], ["Fighting (Brawl)", 25]]),
    res: [crRpgPresetPool("Hit points", 10, 10, "spend"), crRpgPresetPool("Sanity", 50, 99, "spend"), crRpgPresetPool("Luck", 50, 99, "spend"), crRpgPresetPool("Magic points", 10, 10, "spend")]
  };
  list.push(coc);

  const fae = crRpgPresetBase("preset:fae", "Fate Accelerated",
    "Four Fudge dice plus the approach, against the difficulty: Fair is +2, Good +3. Beating it by 3 succeeds with style; a tie succeeds at a minor cost.");
  fae.dice = 4; fae.fudge = true; fae.compare = "atLeast"; fae.target = 2; fae.basis = "margin";
  fae.bands = [
    { label: "Succeed with style", meaning: "It works, with an extra benefit.", min: 3 },
    { label: "Succeed", meaning: "It works.", min: 1 },
    { label: "Tie", meaning: "It works, at a minor cost.", min: 0 },
    { label: "Fail", meaning: "It fails, or works only at a serious cost." }
  ];
  fae.sheet = {
    rows: crRpgPresetRows([["Careful", 2], ["Clever", 1], ["Flashy", 0], ["Forceful", 1], ["Quick", 2], ["Sneaky", 3]]),
    res: [crRpgPresetPool("Fate points", 3, 5, "spend"), crRpgPresetPool("Stress", 0, 3, "fill")]
  };
  list.push(fae);

  crRpgPresetCache = list;
  return list;
}

function crRpgBlankRuleset() : CrRpgRuleset
{
  const r = crRpgPresetBase(crRpgId(), "New system", "");
  r.preset = false;
  r.compare = "atLeast";
  r.basis = "margin";
  r.bands = [{ label: "Success", meaning: "It works.", min: 0 }, { label: "Failure", meaning: "It does not work." }];
  r.sheet = { rows: crRpgPresetRows([["Skill", 0]]), res: [crRpgPresetPool("Health", 10, 10, "spend")] };
  return crRpgSanitizeRuleset(r) as CrRpgRuleset;
}

function crRpgFreshSheet(template: CrRpgSheet) : CrRpgSheet
{
  const copy = JSON.parse(JSON.stringify(template || { rows: [], res: [] }));
  (copy.rows || []).forEach((r: any) => { r.id = ""; });
  (copy.res || []).forEach((r: any) => { r.id = ""; });
  return crRpgSanitizeSheet(copy);
}

function crRpgKeepDice(dice: number[], keep: CrRpgKeep, n: number) : number[]
{
  if (keep === "all" || n >= dice.length){
    return dice.slice();
  }
  const idx = dice.map((v, i) => i);
  idx.sort((a, b) => keep === "high" ? (dice[b] - dice[a]) || (a - b) : (dice[a] - dice[b]) || (a - b));
  const pick = idx.slice(0, Math.max(0, n)).sort((a, b) => a - b);
  return pick.map((i) => dice[i]);
}

function crRpgPercentile(rng: (a: number, b: number) => number, tens: number, preferLow: boolean) : { value: number; dice: number[] }
{
  const units = rng(0, 9);
  const dice: number[] = [];
  let best = -1;
  for (let i = 0; i < tens; i++){
    let v = rng(0, 9) * 10 + units;
    if (v === 0){
      v = 100;
    }
    dice.push(v);
    if (best < 0 || (preferLow ? v < best : v > best)){
      best = v;
    }
  }
  return { value: best, dice: dice };
}

// Pure: every die comes from rng, so a scripted rng pins an outcome.
function crRpgRoll(rs: CrRpgRuleset, rows: CrRpgRow[], sit: number, target: number, edge: number,
                   rng: (a: number, b: number) => number) : CrRpgResult
{
  const allN = rows.reduce((a, r) => a + r.n, 0);
  const preferLow = rs.compare === "atMost";
  let count = rs.dice;
  let zero = false;
  let keep: CrRpgKeep = rs.keep;
  let keepN = rs.keepN;
  let countAt = rs.countAt;
  if (rs.rowsAs === "dice"){
    count = rs.dice + allN + sit;
    if (count <= 0){
      count = rs.zeroDice;
      zero = rs.zeroDice > 0;
      keep = zero ? rs.zeroKeep : "all";
      keepN = 1;
      if (zero && rs.zeroAt > 0){
        countAt = rs.zeroAt;
      }
    }
  }
  count = Math.max(0, Math.min(CR_RPG_MAX_DICE, count));
  const useEdge = !zero && rs.edge && edge !== 0 && count >= 1;
  const die = rs.fudge ? "dF" : "d" + String(rs.sides);
  const roll1 = () : number => rs.fudge ? rng(-1, 1) : rng(1, Math.max(2, rs.sides));
  let dice: number[] = [];
  let kept: number[] = [];
  let detail = "";
  if (useEdge && !rs.fudge && rs.sides === 100 && count === 1){
    const better = edge > 0 ? preferLow : !preferLow;
    const p = crRpgPercentile(rng, 2, better);
    dice = p.dice;
    kept = [p.value];
    detail = "d100 " + (edge > 0 ? "with a bonus die" : "with a penalty die") + " [" + dice.join(", ") + "] keep " + String(p.value);
  }
  else {
    const n = count + (useEdge ? 1 : 0);
    for (let i = 0; i < n; i++){
      let v = roll1();
      dice.push(v);
      let chain = 0;
      while (!zero && !rs.fudge && rs.explode >= 2 && v >= rs.explode && chain < CR_RPG_EXPLODE_CAP){
        v = roll1();
        dice.push(v);
        chain++;
      }
    }
    if (useEdge){
      keep = ((edge > 0) === preferLow) ? "low" : "high";
      keepN = count;
    }
    kept = crRpgKeepDice(dice, keep, keepN);
    detail = String(count) + die
      + (useEdge ? (edge > 0 ? " with advantage" : " with disadvantage") : "")
      + (zero ? " (no dice, so " + String(rs.zeroDice) + " kept " + (rs.zeroKeep === "high" ? "high" : "low") + ")" : "")
      + " [" + dice.join(", ") + "]"
      + (kept.length !== dice.length ? " keep [" + kept.join(", ") + "]" : "");
  }

  let raw = 0;
  if (rs.read === "count"){
    raw = kept.filter((v) => v >= countAt).length;
    detail += ", " + String(raw) + (raw === 1 ? " success" : " successes") + " at " + String(countAt) + "+";
  }
  else if (rs.read === "high"){
    raw = kept.length ? Math.max.apply(null, kept) : 0;
    detail += ", highest " + String(raw);
  }
  else {
    raw = kept.reduce((a, v) => a + v, 0);
  }

  let value = raw;
  if (rs.rowsAs === "add"){
    for (let i = 0; i < rows.length; i++){
      const r = rows[i];
      const name = r.label || "row";
      if (r.d > 0){
        const k = Math.min(CR_RPG_MAX_DICE, Math.abs(r.n));
        const rolls: number[] = [];
        for (let j = 0; j < k; j++){
          rolls.push(rng(1, r.d));
        }
        const sum = rolls.reduce((a, v) => a + v, 0);
        value += r.n < 0 ? -sum : sum;
        detail += " " + (r.n < 0 ? "-" : "+") + String(k) + "d" + String(r.d) + " " + name + " [" + rolls.join(", ") + "]";
      }
      else {
        value += r.n;
        detail += " " + crRpgSigned(r.n) + " " + name;
      }
    }
    if (sit){
      value += sit;
      detail += " " + crRpgSigned(sit) + " situational";
    }
    detail += " = " + String(value);
  }
  else if (rs.rowsAs === "dice" && sit){
    detail += " (" + crRpgSigned(sit) + " extra)";
  }

  const hasTarget = rs.compare !== "none";
  let tgt = target;
  if (rs.rowsAs === "target"){
    tgt = allN + sit;
  }
  if (hasTarget){
    detail += (rs.compare === "atMost" ? " at or under " : " against ") + String(tgt);
  }

  let score = value;
  if (hasTarget && rs.basis === "margin"){
    score = rs.compare === "atMost" ? tgt - value : value - tgt;
  }
  else if (hasTarget && rs.basis === "ratio"){
    score = tgt > 0 ? value / tgt : Number.POSITIVE_INFINITY;
  }

  let idx = -1;
  for (let i = 0; i < rs.bands.length; i++){
    const b = rs.bands[i];
    if ((b.min === undefined || score >= b.min) && (b.max === undefined || score <= b.max)){
      idx = i;
      break;
    }
  }
  if (idx < 0 && rs.bands.length){
    idx = rs.bands.length - 1;
  }
  let label = idx >= 0 ? rs.bands[idx].label : "Rolled";
  let meaning = idx >= 0 ? rs.bands[idx].meaning : "";
  for (let i = 0; i < rs.triggers.length; i++){
    const t = rs.triggers[i];
    let any = false;
    let ok = true;
    if (t.rawAtLeast !== undefined){ any = true; ok = ok && raw >= t.rawAtLeast; }
    if (t.rawAtMost !== undefined){ any = true; ok = ok && raw <= t.rawAtMost; }
    if (t.face !== undefined){ any = true; ok = ok && kept.filter((v) => v === t.face).length >= (t.faceCount || 1); }
    if (t.targetBelow !== undefined){ any = true; ok = ok && hasTarget && tgt < t.targetBelow; }
    if (t.zeroOnly === true){ any = true; ok = ok && zero; }
    if (!any || !ok){
      continue;
    }
    if (t.label){
      label = t.label;
      meaning = t.meaning;
      break;
    }
    if (t.shift && idx >= 0){
      idx = Math.max(0, Math.min(rs.bands.length - 1, idx - t.shift));
      label = rs.bands[idx].label;
      meaning = rs.bands[idx].meaning;
    }
  }

  return {
    at: 0, actorId: "", rulesetId: rs.id, rows: rows.map((r) => r.label || "row"), attempt: "",
    dice: dice, kept: kept, raw: raw, value: value, target: tgt, hasTarget: hasTarget,
    zero: zero, label: label, meaning: meaning, detail: detail
  };
}

function crRpgSummary(rs: CrRpgRuleset) : string
{
  const die = rs.fudge ? "Fudge dice" : "d" + String(rs.sides);
  let s = rs.rowsAs === "dice"
    ? "The row sets how many " + die + " to roll" + (rs.dice > 0 ? ", plus " + String(rs.dice) : "")
    : "Roll " + String(rs.dice) + (rs.fudge ? " Fudge dice" : die);
  if (rs.keep !== "all"){
    s += ", keep the " + (rs.keep === "high" ? "highest " : "lowest ") + String(rs.keepN);
  }
  if (rs.explode >= 2 && !rs.fudge){
    s += ", " + String(rs.explode) + "+ rolls again";
  }
  if (rs.read === "count"){
    s += ", count each die at " + String(rs.countAt) + "+";
  }
  else if (rs.read === "high"){
    s += ", the highest die counts";
  }
  else if (rs.rowsAs === "add"){
    s += " and add the row";
  }
  if (rs.compare === "atLeast"){
    s += ", meet the target";
  }
  else if (rs.compare === "atMost"){
    s += ", roll at or under " + (rs.rowsAs === "target" ? "the row" : "the target");
  }
  if (rs.edge){
    s += "; advantage available";
  }
  return s + ".";
}

function crRpgRulesets() : CrRpgRuleset[]
{
  return crRpgPresets().concat(crRpgCustom);
}

function crRpgRulesetById(id: string) : CrRpgRuleset | null
{
  if (!id){
    return null;
  }
  return crRpgRulesets().find((r) => r.id === id) || null;
}

function crRpgActive() : CrRpgRuleset | null
{
  return crRpgRulesetById(crRpgStory.ruleset);
}

function crRpgPeople() : { id: string; name: string; user: boolean; char: Character | null }[]
{
  const out: { id: string; name: string; user: boolean; char: Character | null }[] = [];
  const user = crLiveUser();
  if (user){
    out.push({ id: user.id, name: user.name, user: true, char: null });
  }
  const primary = crLiveContact();
  if (primary){
    out.push({ id: primary.id, name: primary.name, user: false, char: primary });
  }
  const members = crGroupMembers();
  for (let i = 0; i < members.length; i++){
    if (!out.some((p) => p.id === members[i].id)){
      out.push({ id: members[i].id, name: members[i].name, user: false, char: members[i] });
    }
  }
  return out;
}

function crRpgPersonName(id: string) : string
{
  const p = crRpgPeople().find((x) => x.id === id);
  return p ? p.name : "Someone";
}

function crRpgReactorFor(actorId: string) : string
{
  const contacts = crRpgPeople().filter((p) => !p.user);
  const chosen = crRpgReactAs[actorId];
  if (chosen && contacts.some((p) => p.id === chosen)){
    return chosen;
  }
  if (contacts.some((p) => p.id === actorId)){
    return actorId;
  }
  return contacts.length ? contacts[0].id : "";
}

function crRpgSheetFor(rsId: string, personId: string) : CrRpgSheet | null
{
  const bucket = crRpgStory.sheets[rsId];
  return (bucket && bucket[personId]) || null;
}

async function crRpgSaveStory() : Promise<void>
{
  try{ await api.v1.storyStorage.set(CR_RPG_KEY, crRpgStory); }
  catch (e){ api.v1.error("[CR:rpg] could not save this story's sheets:", e); }
}

async function crRpgSaveRulesets() : Promise<void>
{
  try{ await api.v1.storage.set(CR_RPG_RULESETS_KEY, crRpgCustom); }
  catch (e){ api.v1.error("[CR:rpg] could not save your systems:", e); }
}

async function crRpgInit() : Promise<void>
{
  try{ crRpgStory = crRpgSanitizeStory(await api.v1.storyStorage.get(CR_RPG_KEY)); }
  catch (e){ api.v1.error("[CR:rpg] could not read this story's sheets:", e); }
  try{
    const raw = await api.v1.storage.get(CR_RPG_RULESETS_KEY);
    const list: CrRpgRuleset[] = [];
    if (Array.isArray(raw)){
      for (let i = 0; i < raw.length && list.length < CR_RPG_MAX_RULESETS; i++){
        const r = crRpgSanitizeRuleset(raw[i]);
        if (r && r.id.indexOf("preset:") !== 0 && !list.some((x) => x.id === r.id)){
          list.push(r);
        }
      }
    }
    crRpgCustom = list;
  }
  catch (e){ api.v1.error("[CR:rpg] could not read your systems:", e); }
  const rs = crRpgActive();
  if (rs){
    crRpgTarget = rs.target;
  }
  crTouch();
}

async function crRpgUse(id: string) : Promise<void>
{
  const rs = crRpgRulesetById(id);
  if (!rs){
    return;
  }
  crRpgStory.ruleset = rs.id;
  crRpgOddsForget();
  crRpgTarget = rs.target;
  crRpgSit = 0;
  crRpgEdge = 0;
  crRpgWith = {};
  crRpgTab = "table";
  await crRpgSaveStory();
  crTouch();
}

async function crRpgStartSheet(rs: CrRpgRuleset, personId: string) : Promise<void>
{
  if (!crRpgStory.sheets[rs.id]){
    crRpgStory.sheets[rs.id] = {};
  }
  crRpgStory.sheets[rs.id][personId] = crRpgFreshSheet(rs.sheet);
  await crRpgSaveStory();
  crTouch();
}

async function crRpgSheetChanged(sheet: CrRpgSheet) : Promise<void>
{
  const clean = crRpgSanitizeSheet(sheet);
  sheet.rows = clean.rows;
  sheet.res = clean.res;
  await crRpgSaveStory();
  crTouch();
}

async function crRpgRowStep(rs: CrRpgRuleset, personId: string, rowId: string, delta: number) : Promise<void>
{
  const sheet = crRpgSheetFor(rs.id, personId);
  const row = sheet ? sheet.rows.find((r) => r.id === rowId) : null;
  if (!sheet || !row){
    return;
  }
  row.n = Math.max(-999, Math.min(999, row.n + delta));
  await crRpgSheetChanged(sheet);
}

async function crRpgResStep(rs: CrRpgRuleset, personId: string, resId: string, delta: number, set?: number) : Promise<void>
{
  const sheet = crRpgSheetFor(rs.id, personId);
  const x = sheet ? sheet.res.find((r) => r.id === resId) : null;
  if (!sheet || !x){
    return;
  }
  x.cur = set !== undefined ? set : x.cur + delta;
  await crRpgSheetChanged(sheet);
}

function crRpgToggleWith(personId: string, rowId: string) : void
{
  const list = (crRpgWith[personId] || []).slice();
  const at = list.indexOf(rowId);
  if (at >= 0){
    list.splice(at, 1);
  }
  else {
    list.push(rowId);
  }
  crRpgWith[personId] = list;
  crTouch();
}

async function crRpgDoRoll(personId: string, rowId: string) : Promise<void>
{
  const rs = crRpgActive();
  const sheet = rs ? crRpgSheetFor(rs.id, personId) : null;
  const main = sheet ? sheet.rows.find((r) => r.id === rowId) : null;
  if (!rs || !sheet || !main){
    return;
  }
  const rows: CrRpgRow[] = [main];
  const extra = crRpgWith[personId] || [];
  for (let i = 0; i < extra.length; i++){
    const r = sheet.rows.find((x) => x.id === extra[i]);
    if (r && r.id !== main.id){
      rows.push(r);
    }
  }
  const res = crRpgRoll(rs, rows, crRpgSit, crRpgTarget, crRpgEdge, (a: number, b: number) => api.v1.random.int(a, b));
  res.at = Date.now();
  res.actorId = personId;
  res.attempt = crRpgAttempt.trim().slice(0, 200);
  crRpgStory.last[personId] = res;
  delete crRpgStory.reactions[personId];
  crRpgWith[personId] = [];
  await crRpgSaveStory();
  crTouch();
}

function crRpgOutcomeLine(res: CrRpgResult, actorName: string, reactorName: string) : string
{
  const what = res.rows.filter((r) => !!r).join(" and ") || "their skill";
  const attempt = String(res.attempt || "").trim().replace(/[.!?\s]+$/, "").replace(/^to\s+/i, "");
  let s = attempt
    ? actorName + " tried to " + attempt + ", relying on " + what
    : actorName + " put their " + what + " to the test";
  s += ". Outcome: " + res.label + ".";
  let m = String(res.meaning || "").trim();
  if (m){
    if (!/[.!?]$/.test(m)){
      m += ".";
    }
    s += " " + m;
  }
  const ask = reactorName === actorName
    ? "Write " + reactorName + "'s reply, reacting to how it went."
    : "Write " + reactorName + "'s reply, reacting to how " + actorName + "'s attempt went.";
  return "[ Dice: " + s + " " + ask + " ]";
}

// After the transcript and before the lifted style block, never above the system prompt.
function crRpgFrame(messages: any[], line: string) : any[]
{
  const out = messages.slice();
  const end = (out.length && out[out.length - 1].role === "assistant") ? out.length - 1 : out.length;
  let k = end - 1;
  while (k >= 0 && out[k].role === "system"){
    k--;
  }
  out.splice(k >= 0 ? k + 1 : end, 0, { role: "system", content: line });
  return out;
}

function crRpgReplyView(text: string, who: string) : { body: string; emotion: string }
{
  const lines = String(text || "").split("\n");
  const body: string[] = [];
  let emotion = "";
  for (let i = 0; i < lines.length; i++){
    const m = /^\s*Emotion:\s*(.+)$/i.exec(lines[i]);
    if (m){
      emotion = m[1].trim();
      continue;
    }
    let ln = lines[i];
    if (i === 0 && who && ln.indexOf(who + ":") === 0){
      ln = ln.slice(who.length + 1).replace(/^\s+/, "");
    }
    body.push(ln);
  }
  return { body: body.join("\n").trim(), emotion: emotion };
}

function crRpgNativeBusy() : boolean
{
  return crGroupNativeBusy()
    || (!!crGroupNativeSeen && (Date.now() - crGroupNativeSeen.at) < CR_GROUP_NATIVE_STALE_MS);
}

async function crRpgReact(actorId: string) : Promise<void>
{
  if (crGroupBusyId){
    api.v1.ui.toast("Another reply is being written. Try again once it lands.", { type: "warning" });
    return;
  }
  if (crRpgNativeBusy()){
    api.v1.ui.toast("A reply is being written. Try again once it lands.", { type: "warning" });
    return;
  }
  const res = crRpgStory.last[actorId];
  if (!res){
    return;
  }
  if (!chatSettings.char || !chatSettings.user){
    api.v1.ui.toast("Pair a Contact and a User before asking for a reaction.", { type: "warning" });
    return;
  }
  const whoId = crRpgReactorFor(actorId);
  const who = charList.find((c) => c.id === whoId);
  if (!who){
    api.v1.ui.toast("There is no Contact here to react.", { type: "warning" });
    return;
  }
  let gp: any = null;
  try{ gp = await api.v1.generationParameters.get(); }
  catch (e){ gp = null; }
  if (!gp || gp.model !== "xialong-v1"){
    api.v1.ui.toast("Reactions need the story's model set to Xialong.", { type: "warning" });
    return;
  }
  const params: any = {
    model: "xialong-v1",
    max_tokens: (Number(gp.max_tokens) > 0) ? Number(gp.max_tokens) : CR_GROUP_DEFAULT_OUT
  };
  const keys = ["temperature", "top_p", "top_k", "min_p", "frequency_penalty", "presence_penalty"];
  for (let i = 0; i < keys.length; i++){
    if (typeof gp[keys[i]] === "number"){
      params[keys[i]] = gp[keys[i]];
    }
  }
  crGroupBusyId = "rpg:" + actorId;
  crRpgBusyActor = actorId;
  crRpgNote = "Writing " + who.name + "'s reaction\u2026";
  crTouch();
  const probe = crGroupNewProbe(who.id);
  try{
    const built = await crGroupAssemble(who, probe, true);
    const messages = crRpgFrame(built, crRpgOutcomeLine(res, crRpgPersonName(actorId), who.name));
    const member = crGroup.members.indexOf(who.id) >= 0 && chatSettings.char.id !== who.id;
    const raw = member
      ? await crGroupGenerate(who.id, messages, params, probe)
      : await crGroupRunLocal(messages, params, probe);
    const text = crGroupCleanReply(raw, who);
    if (!text || text === who.name + ":"){
      throw new Error("the reaction came back empty");
    }
    if (crGroupRolls[who.id]){
      crGroupRolls[who.id].checkInitialTrim = false;
    }
    crRpgStory.reactions[actorId] = { whoId: who.id, text: text, at: Date.now(), sent: false };
    await crRpgSaveStory();
    crRpgNote = "";
  }
  catch (e){
    crRpgNote = "The reaction failed: " + String((e && (e as any).message) || e);
    api.v1.error("[CR:rpg] reaction failed:", e);
  }
  finally{
    crGroupBusyId = "";
    crRpgBusyActor = "";
    crTouch();
  }
}

async function crRpgSendReaction(actorId: string) : Promise<void>
{
  const r = crRpgStory.reactions[actorId];
  if (!r || !r.text || r.sent){
    return;
  }
  if (crGroupBusyId || crRpgNativeBusy()){
    api.v1.ui.toast("A reply is being written. Try again once it lands.", { type: "warning" });
    return;
  }
  let allowed = false;
  try{ allowed = await permissionCheckPassed("documentEdit"); }
  catch (e){ allowed = false; }
  if (!allowed){
    api.v1.ui.toast("CharacterRoom needs permission to write to the document.", { type: "warning" });
    return;
  }
  const probe = crGroupNewProbe(r.whoId);
  crGroupBusyId = "rpg:" + actorId;
  try{
    await crGroupDropEmptyOpener();
    await crGroupWrite(r.text, probe);
    r.sent = true;
    await crRpgSaveStory();
    crRpgNote = "";
  }
  catch (e){
    crRpgNote = "Could not write the reaction into the story: " + String((e && (e as any).message) || e);
    api.v1.error("[CR:rpg] send failed:", e);
  }
  finally{
    crGroupBusyId = "";
    crTouch();
  }
  try{ await updateEditorImages(); }
  catch (e){}
  if (r.sent){
    crChatImgProcess().catch((e) => { api.v1.error("[CR:chatimg] pass after a dice reaction failed:", e); });
  }
}

async function crRpgDiscardReaction(actorId: string) : Promise<void>
{
  delete crRpgStory.reactions[actorId];
  await crRpgSaveStory();
  crTouch();
}

async function crRpgCommitRuleset(rs: CrRpgRuleset) : Promise<void>
{
  const i = crRpgCustom.findIndex((r) => r.id === rs.id);
  const clean = crRpgSanitizeRuleset(rs);
  if (i < 0 || !clean){
    return;
  }
  clean.id = rs.id;
  crRpgCustom[i] = clean;
  crRpgOddsForget();
  await crRpgSaveRulesets();
  crTouch();
}

async function crRpgAddRuleset(rs: CrRpgRuleset) : Promise<void>
{
  if (crRpgCustom.length >= CR_RPG_MAX_RULESETS){
    api.v1.ui.toast("That is as many systems as CharacterRoom keeps. Delete one first.", { type: "warning" });
    return;
  }
  crRpgCustom.push(rs);
  crRpgEditing = rs.id;
  await crRpgSaveRulesets();
  crTouch();
}

async function crRpgCopyRuleset(id: string) : Promise<void>
{
  const src = crRpgRulesetById(id);
  if (!src){
    return;
  }
  const copy = crRpgSanitizeRuleset(JSON.parse(JSON.stringify(src)));
  if (!copy){
    return;
  }
  copy.id = crRpgId();
  copy.name = (src.name + " (copy)").slice(0, 60);
  copy.sheet = crRpgFreshSheet(src.sheet);
  await crRpgAddRuleset(copy);
}

async function crRpgDeleteRuleset(id: string) : Promise<void>
{
  if (crRpgDeleteArm !== id){
    crRpgDeleteArm = id;
    crTouch();
    return;
  }
  crRpgDeleteArm = "";
  crRpgCustom = crRpgCustom.filter((r) => r.id !== id);
  crRpgOddsForget();
  if (crRpgEditing === id){
    crRpgEditing = "";
  }
  await crRpgSaveRulesets();
  crTouch();
}

// ---- DICE FACES -------------------------------------------------------------
// Geometry is generated rather than imported. jsx-typings carries no <use> and no
// <image> (L1111-1163), so a die is polygons and paths either way; generating them
// also means every face inherits the token scale instead of a baked-in colour.
// Lengths inside a viewBox are user units, not screen pixels, so they are literals.
interface CrRpgDieShape { points: string; etch: string[]; ty: number; fs: number; rect: boolean }

function crRpgDiePoints(n: number, r: number, rot: number) : string
{
  const out: string[] = [];
  for (let i = 0; i < n; i++){
    const a = (rot + i * 360 / n) * Math.PI / 180;
    out.push((50 + r * Math.cos(a)).toFixed(1) + "," + (50 + r * Math.sin(a)).toFixed(1));
  }
  return out.join(" ");
}

function crRpgDieRing(n: number, r: number, rot: number) : string
{
  return "M" + crRpgDiePoints(n, r, rot).split(" ").join(" L") + " Z";
}

const crRpgShapeCache: { [k: string]: CrRpgDieShape } = {};
function crRpgDieShape(sides: number) : CrRpgDieShape
{
  const key = String(sides);
  if (crRpgShapeCache[key]){
    return crRpgShapeCache[key];
  }
  let out: CrRpgDieShape;
  if (sides === 0 || sides === 6){
    out = { points: "", etch: [], ty: 50, fs: 30, rect: true };
  }
  else if (sides === 4){
    out = { points: crRpgDiePoints(3, 46, -90),
            etch: ["M50,14 L50,62", "M50,62 L13,73", "M50,62 L87,73"], ty: 68, fs: 24, rect: false };
  }
  else if (sides === 8){
    out = { points: crRpgDiePoints(4, 46, -90),
            etch: ["M6,50 L94,50", "M50,4 L26,50", "M50,4 L74,50"], ty: 66, fs: 26, rect: false };
  }
  else if (sides === 12){
    out = { points: crRpgDiePoints(5, 46, -90),
            etch: [crRpgDieRing(5, 24, -90)], ty: 55, fs: 26, rect: false };
  }
  else if (sides === 10 || sides === 100){
    out = { points: crRpgDiePoints(6, 46, -90),
            etch: ["M50,4 L73,38 L50,68 L27,38 Z", "M27,38 L10,63", "M73,38 L90,63"], ty: 44, fs: 24, rect: false };
  }
  else {
    out = { points: crRpgDiePoints(6, 46, -90),
            etch: [crRpgDieRing(3, 29, -90), "M50,4 L27,27", "M50,4 L73,27", "M10,63 L27,74", "M90,63 L73,74"],
            ty: 57, fs: 26, rect: false };
  }
  crRpgShapeCache[key] = out;
  return out;
}

const CR_RPG_PIPS: { [k: string]: number[][] } = {
  "1": [[50, 50]],
  "2": [[31, 31], [69, 69]],
  "3": [[31, 31], [50, 50], [69, 69]],
  "4": [[31, 31], [69, 31], [31, 69], [69, 69]],
  "5": [[31, 31], [69, 31], [50, 50], [31, 69], [69, 69]],
  "6": [[31, 28], [69, 28], [31, 50], [69, 50], [31, 72], [69, 72]]
};

function CrRpgDie(props: { sides: number; value: number; kept: boolean; fade: boolean;
                           size?: string; thrown?: boolean; index?: number }) : any
{
  const shape = crRpgDieShape(props.sides);
  const ink = props.kept ? CR_ACCENT : CR_DIE;
  const at = props.index || 0;
  const away = (at % 2 === 0) ? -1 : 1;
  const kids: any[] = [];
  if (shape.rect){
    kids.push(h("rect", { x: "10", y: "10", width: "80", height: "80", rx: "16",
      fill: "none", stroke: ink, "stroke-width": "5", "stroke-linejoin": "round" }));
  }
  else {
    kids.push(h("polygon", { points: shape.points, fill: "none", stroke: ink,
      "stroke-width": "5", "stroke-linejoin": "round" }));
    for (let i = 0; i < shape.etch.length; i++){
      kids.push(h("path", { key: "e" + i, d: shape.etch[i], fill: "none", stroke: CR_DIE_ETCH,
        "stroke-width": "3", "stroke-linejoin": "round", "stroke-linecap": "round" }));
    }
  }
  const face: any[] = [];
  if (props.sides === 6 && CR_RPG_PIPS[String(props.value)]){
    const pips = CR_RPG_PIPS[String(props.value)];
    for (let i = 0; i < pips.length; i++){
      face.push(h("circle", { key: "p" + i, cx: String(pips[i][0]), cy: String(pips[i][1]), r: "7.5", fill: ink }));
    }
  }
  else if (props.sides === 0){
    if (props.value > 0){
      face.push(h("path", { d: "M34,44h32v12h-32z M44,34h12v32h-12z", fill: ink }));
    }
    else if (props.value < 0){
      face.push(h("path", { d: "M32,44h36v12h-36z", fill: ink }));
    }
  }
  else {
    face.push(h("text", { x: "50", y: String(shape.ty), fill: ink, "text-anchor": "middle",
      "font-size": String(shape.fs), "font-weight": "700" }, String(props.value)));
  }
  kids.push(h("g", { key: "face",
    style: { opacity: props.thrown ? "0" : "1", transition: "opacity 140ms linear" } }, face));
  return h("div", {
    class: "cr-rpg-die" + (props.kept ? " cr-rpg-die-kept" : ""),
    title: String(props.value),
    style: {
      width: props.size || CR_DIE_BOX, height: props.size || CR_DIE_BOX, flex: "0 0 auto",
      opacity: props.fade ? CR_DIE_FADE : "1",
      transformOrigin: "50% 50%",
      transition: props.thrown ? "none" : CR_MOTION_ROLL,
      transitionDelay: props.thrown ? "0ms" : (at * 70) + "ms",
      transform: props.thrown
        ? "translate3d(" + (away * (90 + at * 26)) + "px, " + (-30 - at * 8) + "px, 0) rotate("
          + (away * (200 + at * 80)) + "deg) scale(0.72)"
        : "translate3d(0, 0, 0) rotate(0deg) scale(1)"
    }
  }, h("svg", {
    viewBox: "-4 -4 108 108", width: "100%", height: "100%", fill: "none",
    "aria-hidden": "true", style: { display: "block", overflow: "visible" }
  }, kids));
}

// kept holds VALUES, not indices, so a die is matched off a copy of the list.
function crRpgKeptFlags(res: CrRpgResult) : boolean[]
{
  const pool = res.kept.slice();
  return res.dice.map((v) => {
    const at = pool.indexOf(v);
    if (at < 0){
      return false;
    }
    pool.splice(at, 1);
    return true;
  });
}

const CR_RPG_TRAY_MAX = 20;

// The tumble is inline transform flipped across two renders with a transition between
// them — a jsx part carries no stylesheet, so there is no @keyframes, and jsx-typings
// has no SMIL elements either (D-41).
function CrRpgTray(props: { rs: CrRpgRuleset | null; res: CrRpgResult }) : any
{
  const res = props.res;
  const [landedAt, setLandedAt] = useState(0);
  useEffect(() => {
    api.v1.timers.setTimeout(() => { setLandedAt(res.at); }, 40).catch(() => {});
  }, [String(res.at)]);
  const thrown = landedAt !== res.at;
  const sides = props.rs ? (props.rs.fudge ? 0 : props.rs.sides) : 20;
  const flags = crRpgKeptFlags(res);
  const trim = res.dice.length > CR_RPG_TRAY_MAX;
  const show = trim ? res.dice.slice(0, CR_RPG_TRAY_MAX) : res.dice;
  const anyDropped = flags.some((f) => !f);
  const box = res.dice.length > 6 ? CR_DIE_BOX_S : CR_DIE_BOX;
  return h("div", {
    class: "cr-rpg-tray",
    style: { display: "flex", flexWrap: "wrap", gap: CR_S_2, alignItems: "center", minHeight: box }
  },
    show.map((v, i) => h(CrRpgDie, {
      key: String(res.at) + ":" + i, sides: sides, value: v, size: box,
      kept: anyDropped ? flags[i] : false, fade: anyDropped && !flags[i],
      thrown: thrown, index: i
    })),
    trim ? h(CrPill, { text: "+" + String(res.dice.length - CR_RPG_TRAY_MAX) }) : null
  );
}

// ---- ODDS -------------------------------------------------------------------
// The roller already takes its rng as a parameter, so the odds ARE the roller run many
// times. Nothing here knows a single system's maths, which is what lets a hand-built
// ruleset get a readout too, explosions and empty-pool rules included.
// XORSHIFT AND NEVER AN LCG: an LCG's low bits are short enough on a d6 that PbtA reads
// 33/33/33 against a true 28/42/31, and a Blades critical never fires at all. Seeded, so
// a repaint never moves a bar that nothing has changed.
function crRpgXs32(seed: number) : (a: number, b: number) => number
{
  let s = (seed >>> 0) || 0x5eed;
  return (a: number, b: number) : number => {
    s ^= s << 13; s >>>= 0;
    s ^= s >>> 17;
    s ^= s << 5;  s >>>= 0;
    const n = (b - a + 1) || 1;
    return a + Math.floor((s / 4294967296) * n);
  };
}

const CR_RPG_TRIALS = 2000;
const CR_RPG_ODDS_SEED = 0x5eed;
const CR_RPG_ODDS_CACHE_MAX = 240;

interface CrRpgOdd { label: string; pct: number }

// A ladder needs an order, and a trigger's label belongs at whichever END its condition
// points at: a trigger reading a HIGH natural die is the good end on an at-least system
// and the bad end on an at-most one, and a low one is the reverse. That reading puts
// every preset's criticals and fumbles where a player expects them with no table.
function crRpgLabelOrder(rs: CrRpgRuleset) : string[]
{
  const top: string[] = [];
  const bottom: string[] = [];
  const atMost = rs.compare === "atMost";
  const taken = (l: string) : boolean => top.indexOf(l) >= 0 || bottom.indexOf(l) >= 0;
  for (let i = 0; i < rs.triggers.length; i++){
    const t = rs.triggers[i];
    if (!t.label || taken(t.label)){
      continue;
    }
    const high = (t.rawAtLeast !== undefined) || (t.face !== undefined && t.face >= rs.sides);
    (((atMost ? !high : high)) ? top : bottom).push(t.label);
  }
  const mid: string[] = [];
  for (let i = 0; i < rs.bands.length; i++){
    const l = rs.bands[i].label;
    if (l && !taken(l) && mid.indexOf(l) < 0){
      mid.push(l);
    }
  }
  return top.concat(mid, bottom);
}

function crRpgOdds(rs: CrRpgRuleset, rows: CrRpgRow[], sit: number, target: number, edge: number) : CrRpgOdd[]
{
  const rng = crRpgXs32(CR_RPG_ODDS_SEED);
  const tally: { [label: string]: number } = {};
  for (let i = 0; i < CR_RPG_TRIALS; i++){
    const o = crRpgRoll(rs, rows, sit, target, edge, rng);
    tally[o.label] = (tally[o.label] || 0) + 1;
  }
  const order = crRpgLabelOrder(rs);
  const out: CrRpgOdd[] = [];
  const seen: { [k: string]: boolean } = {};
  for (let i = 0; i < order.length; i++){
    seen[order[i]] = true;
    out.push({ label: order[i], pct: (tally[order[i]] || 0) / CR_RPG_TRIALS * 100 });
  }
  const rest = Object.keys(tally).filter((k) => !seen[k]);
  for (let i = 0; i < rest.length; i++){
    out.push({ label: rest[i], pct: tally[rest[i]] / CR_RPG_TRIALS * 100 });
  }
  return out;
}

let crRpgOddsCache: { [k: string]: CrRpgOdd[] } = {};
function crRpgOddsForget() : void
{
  crRpgOddsCache = {};
}

// Two rows holding the same number roll the same odds, so a fourteen-row sheet is
// usually one or two simulations rather than fourteen.
function crRpgOddsFor(rs: CrRpgRuleset, rows: CrRpgRow[], sit: number, target: number, edge: number) : CrRpgOdd[]
{
  const sig = rows.map((r) => String(r.n) + "/" + String(r.d)).sort().join(",");
  const key = rs.id + "|" + sig + "|" + String(sit) + "|" + String(target) + "|" + String(edge);
  if (!crRpgOddsCache[key]){
    if (Object.keys(crRpgOddsCache).length > CR_RPG_ODDS_CACHE_MAX){
      crRpgOddsCache = {};
    }
    crRpgOddsCache[key] = crRpgOdds(rs, rows, sit, target, edge);
  }
  return crRpgOddsCache[key];
}

// The odds for tapping THIS row, with whatever `with` rows, situational, target and
// advantage are set right now — the same four the roll itself will read.
function crRpgOddsForRow(rs: CrRpgRuleset, sheet: CrRpgSheet, personId: string, rowId: string) : CrRpgOdd[] | null
{
  const main = sheet.rows.find((r) => r.id === rowId);
  if (!main || !crRpgStory.odds){
    return null;
  }
  const rows: CrRpgRow[] = [main];
  const extra = crRpgWith[personId] || [];
  for (let i = 0; i < extra.length; i++){
    const r = sheet.rows.find((x) => x.id === extra[i]);
    if (r && r.id !== main.id){
      rows.push(r);
    }
  }
  return crRpgOddsFor(rs, rows, crRpgSit, crRpgTarget, crRpgEdge);
}

function crRpgBandColour(i: number, n: number) : string
{
  const ramp = [CR_BAND_1, CR_BAND_2, CR_BAND_3, CR_BAND_4];
  if (n <= 1){
    return ramp[0];
  }
  return ramp[Math.max(0, Math.min(3, Math.round((i / (n - 1)) * 3)))];
}

function crRpgPct(p: number) : string
{
  if (p <= 0){
    return "0%";
  }
  if (p < 1){
    return "<1%";
  }
  return String(Math.round(p)) + "%";
}

function CrRpgRibbon(props: { odds: CrRpgOdd[] }) : any
{
  const n = props.odds.length;
  return h("div", {
    class: "cr-rpg-ribbon",
    style: { display: "flex", height: CR_RIBBON_H, borderRadius: CR_RIBBON_H,
             overflow: "hidden", background: CR_SUNK, marginTop: CR_S_1 }
  },
    props.odds.map((o, i) => o.pct > 0 ? h("span", {
      key: o.label, title: o.label + " " + crRpgPct(o.pct),
      style: { display: "block", height: "100%", width: o.pct.toFixed(2) + "%",
               background: crRpgBandColour(i, n), transition: CR_MOTION_BAR }
    }) : null)
  );
}

function CrRpgLadder(props: { odds: CrRpgOdd[]; hit: string }) : any
{
  const n = props.odds.length;
  return h("div", { class: "cr-rpg-ladder", style: { marginTop: CR_S_3 } },
    props.odds.map((o, i) => {
      const col = crRpgBandColour(i, n);
      const on = o.label === props.hit;
      return h("div", {
        key: o.label,
        style: { display: "flex", alignItems: "center", gap: CR_S_3, padding: CR_S_2 + " 0",
                 borderTop: i ? CR_LINE_W + " solid " + CR_LINE : "none" }
      },
        h("span", { style: { width: CR_S_3, alignSelf: "stretch", minHeight: CR_S_5,
                             borderRadius: CR_RIBBON_H, background: col, flex: "0 0 auto" } }),
        h("span", { style: { flex: "1 1 auto", minWidth: "0", fontSize: CR_T_BASE,
                             color: on ? CR_HEAD : CR_TEXT, fontWeight: on ? "700" : "400",
                             overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" } }, o.label),
        h("span", { style: { width: CR_LADDER_BAR, height: CR_RIBBON_H, borderRadius: CR_RIBBON_H,
                             background: CR_SUNK, overflow: "hidden", flex: "0 0 auto" } },
          h("span", { style: { display: "block", height: "100%", width: o.pct.toFixed(1) + "%",
                               background: col, borderRadius: CR_RIBBON_H, transition: CR_MOTION_BAR } })),
        h("span", { style: { width: CR_LADDER_PCT, textAlign: "right", fontSize: CR_T_SM,
                             color: on ? CR_HEAD : CR_DIM, flex: "0 0 auto" } }, crRpgPct(o.pct))
      );
    })
  );
}

function crRpgRowText(rs: CrRpgRuleset, r: CrRpgRow) : string
{
  if (rs.rowsAs === "add" && r.d > 0){
    return (r.n < 0 ? "-" : "+") + String(Math.abs(r.n)) + "d" + String(r.d);
  }
  if (rs.rowsAs === "add"){
    return crRpgSigned(r.n);
  }
  return String(r.n);
}

function CrRpgSetup(props: { rs: CrRpgRuleset; mobile: boolean }) : any
{
  const rs = props.rs;
  const sitLabel = rs.rowsAs === "dice" ? "Extra dice" : (rs.rowsAs === "target" ? "Target adjustment" : "Situational");
  return h(CrSection, { title: rs.name, note: crRpgSummary(rs) },
    h("div", { style: { display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_3, marginTop: CR_S_3 } },
      h(CrField, { label: "What is being attempted", hint: "Optional. A reaction reads this instead of the row's name." },
        h(CrTextInput, { value: crRpgAttempt, placeholder: "sneak past the guard", onSet: (v: string) => { crRpgAttempt = v; crTouch(); } })
      ),
      h("div", { style: { display: "flex", flexWrap: "wrap", gap: CR_S_4, alignItems: "flex-end" } },
        (rs.compare !== "none" && rs.rowsAs !== "target")
          ? h("div", { style: { flex: "0 0 auto", minWidth: "0" } },
              h(CrNumField, { id: "cr-rpg-target", label: "Target", value: crRpgTarget,
                              onSet: (n: number) => { crRpgTarget = Math.round(n); crTouch(); } }))
          : null,
        h(CrStepper, { label: sitLabel, value: crRpgSit, text: crRpgSigned(crRpgSit),
                       onSet: (n: number) => { crRpgSit = Math.max(-99, Math.min(99, n)); crTouch(); } })
      ),
      rs.edge ? h(CrChoice, {
        label: "Advantage", active: String(crRpgEdge),
        options: [{ id: "-1", label: "Disadvantage" }, { id: "0", label: "Normal" }, { id: "1", label: "Advantage" }],
        onPick: (id: string) => { crRpgEdge = Number(id); crTouch(); }
      }) : null,
      rs.note ? h("div", { style: { color: CR_DIM, fontSize: CR_T_SM, lineHeight: "1.5" } }, rs.note) : null,
      h("div", { style: { display: "flex", gap: CR_S_2, flexWrap: "wrap" } },
        h(CrButton, { text: "Change system", icon: "", onClick: () => { crRpgTab = "systems"; crTouch(); } }),
        h(CrButton, { text: "Odds", icon: "", primary: crRpgStory.odds,
                      title: "Show each row's chance of every outcome",
                      onClick: () => { crRpgStory.odds = !crRpgStory.odds; crRpgSaveStory().catch(() => {}); crTouch(); } }))
    )
  );
}

function CrRpgRowLine(props: { rs: CrRpgRuleset; personId: string; row: CrRpgRow; sheet: CrRpgSheet }) : any
{
  const r = props.row;
  const name = r.label || "Unnamed row";
  const withOn = (crRpgWith[props.personId] || []).indexOf(r.id) >= 0;
  const odds = crRpgOddsForRow(props.rs, props.sheet, props.personId, r.id);
  return h("div", {
    class: "cr-rpg-row",
    style: { padding: CR_S_2 + " 0", borderTop: CR_LINE_W + " solid " + CR_LINE }
  },
  h("div", { style: { display: "flex", alignItems: "center", gap: CR_S_2 } },
    h("div", { style: { flex: "1 1 auto", minWidth: "0", color: CR_TEXT, fontSize: CR_T_BASE,
                        overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" } }, name),
    h(CrStepper, { value: r.n, text: crRpgRowText(props.rs, r), name: name,
                   onSet: (n: number) => { crRpgRowStep(props.rs, props.personId, r.id, n - r.n).catch(() => {}); } }),
    h(CrButton, { text: "with", icon: "", primary: withOn, title: "Add " + name + " to the next roll from this sheet",
                  onClick: () => crRpgToggleWith(props.personId, r.id) }),
    h(CrIconButton, { icon: "dice", label: "Roll " + name, primary: true,
                      onClick: () => { crRpgDoRoll(props.personId, r.id).catch(() => {}); } })
  ),
  odds ? h(CrRpgRibbon, { odds: odds }) : null
  );
}

// A pool says which direction is BAD, so the meter can say it in colour: a hit-point
// pool reddens as it drains and a stress pool reddens as it fills. Left "flat", it is
// the accent and means nothing, which is the right default for a count nobody scores.
function crRpgResColour(x: CrRpgResource) : string
{
  if (x.kind === "track"){
    return crRpgBandColour(x.cur, Math.max(1, x.steps.length));
  }
  if (x.tone === "flat" || x.max <= 0){
    return CR_ACCENT;
  }
  const full = Math.max(0, Math.min(1, x.cur / x.max));
  return crRpgBandColour(Math.round((x.tone === "fill" ? full : 1 - full) * 3), 4);
}

function CrRpgResLine(props: { rs: CrRpgRuleset; personId: string; res: CrRpgResource }) : any
{
  const x = props.res;
  const name = x.label || "Unnamed";
  const colour = crRpgResColour(x);
  const edge = { padding: CR_S_2 + " 0", borderTop: CR_LINE_W + " solid " + CR_LINE };
  if (x.kind === "track"){
    return h("div", { class: "cr-rpg-res", style: edge },
      h("div", { style: { display: "flex", alignItems: "center", gap: CR_S_2, marginBottom: CR_S_2 } },
        h("div", { style: { flex: "1 1 auto", minWidth: "0", color: CR_TEXT, fontSize: CR_T_BASE,
                            overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" } }, name),
        h("div", { style: { color: colour, fontSize: CR_T_SM, fontWeight: "600", whiteSpace: "nowrap" } },
          x.steps[x.cur] || "")),
      x.steps.length
        ? h("div", null,
            h(CrMeter, { value: x.cur + 1, max: x.steps.length, colour: colour, look: x.look }),
            h("div", { style: { marginTop: CR_S_2 } },
              h(CrChoice, {
                active: String(x.cur),
                options: x.steps.map((step, i) => ({ id: String(i), label: step })),
                onPick: (id: string) => { crRpgResStep(props.rs, props.personId, x.id, 0, Number(id)).catch(() => {}); }
              })))
        : h("div", { style: { color: CR_DIM, fontSize: CR_T_SM } }, "No steps yet. Add them when editing the sheet.")
    );
  }
  return h("div", { class: "cr-rpg-res", style: edge },
    h("div", { style: { display: "flex", alignItems: "center", gap: CR_S_2 } },
      h("div", { style: { flex: "1 1 auto", minWidth: "0", color: CR_TEXT, fontSize: CR_T_BASE,
                          overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" } }, name),
      h(CrStepper, { value: x.cur, text: String(x.cur) + " / " + String(x.max), name: name,
                     onSet: (n: number) => { crRpgResStep(props.rs, props.personId, x.id, 0, n).catch(() => {}); } })
    ),
    h("div", { style: { marginTop: CR_S_2 } },
      h(CrMeter, { value: x.cur, max: x.max, colour: colour, look: x.look }))
  );
}

function CrRpgResultBox(props: { personId: string }) : any
{
  const res = crRpgStory.last[props.personId];
  if (!res){
    return null;
  }
  const rsNow = crRpgStory.ruleset;
  const rolledUnder = res.rulesetId !== rsNow ? crRpgRulesetById(res.rulesetId) : null;
  const contacts = crRpgPeople().filter((p) => !p.user);
  const reactorId = crRpgReactorFor(props.personId);
  const reactor = contacts.find((p) => p.id === reactorId);
  const reaction = crRpgStory.reactions[props.personId];
  const writer = reaction ? charList.find((c) => c.id === reaction.whoId) : null;
  const view = reaction ? crRpgReplyView(reaction.text, writer ? writer.name : "") : null;
  const busyHere = crRpgBusyActor === props.personId;
  const busy = !!crGroupBusyId;
  // The ladder describes the roll that was MADE, so it reads the result's own ruleset
  // and its own stored target rather than whatever the Setup section says now.
  const ladderRs = rolledUnder || crRpgActive();
  const ladderOdds = (crRpgStory.odds && ladderRs)
    ? crRpgOddsFor(ladderRs, (crRpgSheetFor(ladderRs.id, props.personId) || { rows: [], res: [] }).rows
        .filter((r) => res.rows.indexOf(r.label || "row") >= 0),
        0, res.target, 0)
    : null;
  return h("div", {
    class: "cr-rpg-result",
    style: { marginTop: CR_S_3, padding: CR_S_3, background: CR_SUNK, border: CR_LINE_W + " solid " + CR_LINE, borderRadius: CR_RADIUS_S }
  },
    h(CrRpgTray, { rs: rolledUnder || crRpgActive(), res: res }),
    h("div", { style: { color: CR_HEAD, fontSize: CR_T_LG, fontWeight: "600", marginTop: CR_S_3 } }, res.label),
    res.meaning ? h("div", { style: { color: CR_TEXT, fontSize: CR_T_MD, marginTop: CR_S_1, lineHeight: "1.45" } }, res.meaning) : null,
    h("div", { style: { color: CR_DIM, fontSize: CR_T_SM, marginTop: CR_S_2, lineHeight: "1.45", wordBreak: "break-word" } },
      res.rows.join(" and ") + (res.attempt ? ": " + res.attempt : "")),
    h("div", { style: { color: CR_DIM, fontSize: CR_T_SM, marginTop: CR_S_1, lineHeight: "1.45", wordBreak: "break-word" } }, res.detail),
    rolledUnder ? h("div", { style: { color: CR_DIM, fontSize: CR_T_SM, marginTop: CR_S_1 } }, "Rolled under " + rolledUnder.name + ".") : null,
    ladderOdds ? h(CrRpgLadder, { odds: ladderOdds, hit: res.label }) : null,
    contacts.length > 1 ? h("div", { style: { marginTop: CR_S_3 } },
      h(CrChoice, {
        label: "Reacting", active: reactorId,
        options: contacts.map((p) => ({ id: p.id, label: p.name })),
        onPick: (id: string) => { crRpgReactAs[props.personId] = id; crTouch(); }
      })
    ) : null,
    h("div", { style: { display: "flex", gap: CR_S_2, flexWrap: "wrap", alignItems: "center", marginTop: CR_S_3 } },
      h(CrButton, {
        text: reaction ? "React again" : (reactor ? reactor.name + " reacts" : "React"), icon: "comment", primary: !reaction,
        disabled: busy || !reactor,
        onClick: () => { crRpgReact(props.personId).catch(() => {}); }
      }),
      busyHere ? h(CrPill, { text: "writing", tone: "accent" }) : null
    ),
    (reaction && view) ? h("div", {
      class: "cr-rpg-reaction",
      style: { marginTop: CR_S_3, paddingTop: CR_S_3, borderTop: CR_LINE_W + " solid " + CR_LINE }
    },
      h("div", { style: { display: "flex", gap: CR_S_2, alignItems: "center", flexWrap: "wrap", marginBottom: CR_S_2 } },
        writer ? h(CrAvatar, { src: writer.avatar || "", name: writer.name, charId: writer.id, size: 24 }) : null,
        h("div", { style: { color: CR_HEAD, fontSize: CR_T_BASE, fontWeight: "600" } }, writer ? (writer.alias || writer.name) : "Reaction"),
        view.emotion ? h(CrPill, { text: view.emotion }) : null,
        reaction.sent ? h(CrPill, { text: "in the story", tone: "accent" }) : null
      ),
      h("div", { style: { color: CR_TEXT, fontSize: CR_T_MD, lineHeight: "1.5", whiteSpace: "pre-wrap", wordBreak: "break-word" } }, view.body),
      h("div", { style: { display: "flex", gap: CR_S_2, flexWrap: "wrap", marginTop: CR_S_3 } },
        reaction.sent ? null : h(CrButton, {
          text: "Send to the story", icon: "export", primary: true, disabled: busy,
          onClick: () => { crRpgSendReaction(props.personId).catch(() => {}); }
        }),
        h(CrButton, { text: "Discard", disabled: busyHere, onClick: () => { crRpgDiscardReaction(props.personId).catch(() => {}); } })
      )
    ) : null
  );
}

function CrRpgSheetEditor(props: { sheet: CrRpgSheet; keyBase: string; rowsAs: CrRpgRowsAs; onChange: () => void }) : any
{
  const sheet = props.sheet;
  const kb = props.keyBase;
  const change = props.onChange;
  const numberHint = props.rowsAs === "dice" ? "How many dice this row adds."
    : (props.rowsAs === "target" ? "The number to roll under." : "Added to the roll.");
  return h("div", { class: "cr-rpg-sheet-editor", style: { display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_3 } },
    h(CrHeading, { id: kb + ":rows", title: "Rows", note: "A row is anything a roll can use: a stat, a skill, a bonus. "
      + (props.rowsAs === "add" ? "Give a row dice sides to make it a bonus die, such as 1 with sides 4 for a d4." : "") },
      sheet.rows.map((r) => h("div", { key: r.id, style: { display: "grid", gridTemplateColumns: "minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr) auto",
                                                          gap: CR_S_2, alignItems: "end", marginBottom: CR_S_2 } },
        h(CrField, { label: "Name" }, h(CrTextInput, { value: r.label, onSet: (v: string) => { r.label = v; change(); } })),
        h(CrNumField, { id: kb + ":row:" + r.id + ":n", label: "Number", value: r.n, onSet: (n: number) => { r.n = n; change(); } }),
        props.rowsAs === "add"
          ? h(CrNumField, { id: kb + ":row:" + r.id + ":d", label: "Dice sides", value: r.d, onSet: (n: number) => { r.d = n; change(); } })
          : h("div", null),
        h(CrIconButton, { icon: "trash", label: "Remove " + (r.label || "row"), tone: "warn",
                          onClick: () => { sheet.rows = sheet.rows.filter((x) => x.id !== r.id); change(); } })
      )),
      h("div", { style: { color: CR_DIM, fontSize: CR_T_SM, marginBottom: CR_S_2 } }, numberHint),
      sheet.rows.length < CR_RPG_MAX_ROWS ? h(CrButton, { text: "Add a row",
        onClick: () => { sheet.rows.push({ id: "", label: "", n: 0, d: 0 }); change(); } }) : null
    ),
    h(CrHeading, { id: kb + ":res", title: "Resources", note: "A pool counts up and down, like hit points or stress. A track is a list of named steps, like a harm ladder." },
      sheet.res.map((x) => h("div", { key: x.id, style: { marginBottom: CR_S_3, paddingBottom: CR_S_3, borderBottom: CR_LINE_W + " solid " + CR_LINE } },
        h("div", { style: { display: "grid", gridTemplateColumns: "minmax(0, 1fr) auto", gap: CR_S_2, alignItems: "end" } },
          h(CrField, { label: "Name" }, h(CrTextInput, { value: x.label, onSet: (v: string) => { x.label = v; change(); } })),
          h(CrIconButton, { icon: "trash", label: "Remove " + (x.label || "resource"), tone: "warn",
                            onClick: () => { sheet.res = sheet.res.filter((y) => y.id !== x.id); change(); } })
        ),
        h("div", { style: { marginTop: CR_S_2 } },
          h(CrChoice, { active: x.kind, options: [{ id: "pool", label: "Pool" }, { id: "track", label: "Track" }],
            onPick: (id: string) => { x.kind = id as "pool" | "track"; if (id === "track"){ x.cur = 0; } change(); } })),
        x.kind === "pool"
          ? h("div", { style: { display: "grid", gridTemplateColumns: "minmax(0, 1fr) minmax(0, 1fr)", gap: CR_S_2, marginTop: CR_S_2 } },
              h(CrNumField, { id: kb + ":res:" + x.id + ":cur", label: "Current", value: x.cur, onSet: (n: number) => { x.cur = n; change(); } }),
              h(CrNumField, { id: kb + ":res:" + x.id + ":max", label: "Most", value: x.max, onSet: (n: number) => { x.max = n; change(); } }))
          : h("div", { style: { marginTop: CR_S_2 } },
              h(CrField, { label: "Steps", hint: "Separated by commas, first to last." },
                h(CrTextInput, { value: x.steps.join(", "), placeholder: "Fine, Hurt, Wounded, Down",
                                 onSet: (v: string) => { x.steps = v.split(",").map((s) => s.trim()).filter((s) => !!s); change(); } }))),
        h("div", { style: { marginTop: CR_S_2 } },
          h(CrChoice, { label: "Shown as", hint: "Auto draws pips up to twelve and a bar past that.",
            active: x.look,
            options: [{ id: "auto", label: "Auto" }, { id: "pips", label: "Pips" },
                      { id: "bar", label: "Bar" }, { id: "plain", label: "Numbers only" }],
            onPick: (id: string) => { x.look = id as CrMeterLook; change(); } })),
        x.kind === "pool" ? h("div", { style: { marginTop: CR_S_2 } },
          h(CrChoice, { label: "Which way is bad", hint: "Colours the meter. Flat leaves it the accent.",
            active: x.tone,
            options: [{ id: "flat", label: "Neither" }, { id: "spend", label: "Running out" },
                      { id: "fill", label: "Filling up" }],
            onPick: (id: string) => { x.tone = id as CrRpgTone; change(); } })) : null
      )),
      sheet.res.length < CR_RPG_MAX_RES ? h(CrButton, { text: "Add a resource",
        onClick: () => { sheet.res.push({ id: "", label: "", kind: "pool", cur: 10, max: 10, steps: [],
                                          look: "auto", tone: "flat" }); change(); } }) : null
    )
  );
}

function CrRpgPerson(props: { person: { id: string; name: string; user: boolean; char: Character | null }; rs: CrRpgRuleset }) : any
{
  const p = props.person;
  const rs = props.rs;
  const sheet = crRpgSheetFor(rs.id, p.id);
  const open = crRpgSheetOpen[p.id] === true;
  const role = p.user ? "You" : (chatSettings.char && chatSettings.char.id === p.id ? "Contact" : "Group");
  const withCount = (crRpgWith[p.id] || []).length;
  return h(CrSection, { title: p.char ? (p.char.alias || p.name) : p.name },
    h("div", { style: { display: "flex", alignItems: "center", gap: CR_S_2, marginBottom: CR_S_2 } },
      p.char ? h(CrAvatar, { src: p.char.avatar || "", name: p.name, charId: p.char.id, size: 28 }) : null,
      h(CrPill, { text: role }),
      withCount ? h(CrPill, { text: "with " + String(withCount), tone: "accent" }) : null,
      h("div", { style: { flex: "1 1 auto" } }),
      sheet ? h(CrButton, { text: open ? "Done" : "Edit", onClick: () => { crRpgSheetOpen[p.id] = !open; crTouch(); } }) : null
    ),
    !sheet
      ? h("div", null,
          h("div", { style: { color: CR_DIM, fontSize: CR_T_SM, marginBottom: CR_S_2 } }, "No sheet for " + rs.name + " in this story yet."),
          h(CrButton, { text: "Start a sheet", icon: "plus", primary: true, onClick: () => { crRpgStartSheet(rs, p.id).catch(() => {}); } }))
      : open
        ? h("div", null,
            h(CrRpgSheetEditor, { sheet: sheet, keyBase: "rpg:" + rs.id + ":" + p.id, rowsAs: rs.rowsAs,
                                  onChange: () => { crRpgSheetChanged(sheet).catch(() => {}); } }),
            h("div", { style: { marginTop: CR_S_3 } },
              h(CrButton, { text: "Reset to the system's sheet", icon: "", tone: "warn",
                            onClick: () => { crRpgStartSheet(rs, p.id).catch(() => {}); } })))
        : h("div", null,
            sheet.rows.length ? sheet.rows.map((r) => h(CrRpgRowLine, { key: r.id, rs: rs, personId: p.id, row: r, sheet: sheet }))
              : h("div", { style: { color: CR_DIM, fontSize: CR_T_SM } }, "No rows yet."),
            sheet.res.length ? h("div", { style: { marginTop: CR_S_3 } },
              sheet.res.map((x) => h(CrRpgResLine, { key: x.id, rs: rs, personId: p.id, res: x }))) : null,
            h(CrRpgResultBox, { personId: p.id })
          )
  );
}

function CrRpgTable(props: { mobile: boolean }) : any
{
  const people = crRpgPeople();
  if (!people.length){
    return h(CrEmpty, { text: "Pair a Contact and a User on the Chat tab first." });
  }
  const rs = crRpgActive();
  if (!rs){
    return h(CrSection, { title: "Pick a system", note: "The dice, the outcomes and the starting sheet come from the system. Sheets and resources are kept with this story." },
      h("div", { style: { display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_2, marginTop: CR_S_3 } },
        crRpgRulesets().map((r) => h(CrMenuRow, { key: r.id, icon: "dice", label: r.name, note: crRpgSummary(r),
                                                  onClick: () => { crRpgUse(r.id).catch(() => {}); } }))
      )
    );
  }
  return h("div", { class: "cr-rpg-table" },
    h(CrRpgSetup, { rs: rs, mobile: props.mobile }),
    people.map((p) => h(CrRpgPerson, { key: p.id, person: p, rs: rs })),
    h(CrNote, { text: crRpgNote })
  );
}

function CrRpgRangeField(props: { id: string; label: string; value: number | undefined; onSet: (v: number | undefined) => void }) : any
{
  return h(CrField, { label: props.label },
    h(CrTextInput, {
      value: props.value === undefined ? "" : String(props.value), placeholder: "any",
      onSet: (v: string) => {
        if (!v.trim()){
          props.onSet(undefined);
          return;
        }
        const n = Number(v);
        if (isFinite(n)){
          props.onSet(n);
        }
        else {
          crTouch();
        }
      }
    })
  );
}

function CrRpgRulesetEditor(props: { rs: CrRpgRuleset; mobile: boolean }) : any
{
  const rs = props.rs;
  const kb = "rpgsys:" + rs.id;
  const commit = () => { crRpgCommitRuleset(rs).catch(() => {}); };
  const set = (patch: any) => { Object.assign(rs, patch); commit(); };
  const two = { display: "grid", gridTemplateColumns: props.mobile ? CR_GRID_COL : "minmax(0, 1fr) minmax(0, 1fr)", gap: CR_S_3 };
  const scoreHint = rs.compare === "none" ? "Bands test the rolled value."
    : (rs.basis === "margin" ? "Bands test how far past the target the roll landed; missing it is negative."
      : (rs.basis === "ratio" ? "Bands test the roll divided by the target, so 0.5 is half of it." : "Bands test the rolled value."));
  return h("div", { class: "cr-rpg-editor" },
    h("div", { style: { marginBottom: CR_S_3 } },
      h(CrButton, { text: "Back to systems", onClick: () => { crRpgEditing = ""; crTouch(); } })),
    h(CrSection, { title: "About", note: crRpgSummary(rs) },
      h("div", { style: Object.assign({ marginTop: CR_S_3 }, two) },
        h(CrField, { label: "Name" }, h(CrTextInput, { value: rs.name, onSet: (v: string) => set({ name: v }) })),
        h(CrField, { label: "Note", hint: "Shown above the table. Not sent to the model." },
          h(CrTextArea, { value: rs.note, placeholder: "How this system plays", rows: 3, onSet: (v: string) => set({ note: v }) }))
      )
    ),
    h(CrSection, { title: "Dice" },
      h("div", { style: Object.assign({ marginTop: CR_S_3 }, two) },
        h(CrChoice, { label: "Die", active: rs.fudge ? "fudge" : "numbered",
          options: [{ id: "numbered", label: "Numbered" }, { id: "fudge", label: "Fudge" }],
          onPick: (id: string) => set({ fudge: id === "fudge" }) }),
        h(CrChoice, { label: "Rows", active: rs.rowsAs,
          options: [{ id: "add", label: "Add to the roll" }, { id: "dice", label: "Set the pool" }, { id: "target", label: "Are the target" }],
          onPick: (id: string) => set({ rowsAs: id }) }),
        h(CrNumField, { id: kb + ":dice", label: rs.rowsAs === "dice" ? "Dice added to every pool" : "Dice rolled", value: rs.dice, onSet: (n: number) => set({ dice: n }) }),
        rs.fudge ? null : h(CrNumField, { id: kb + ":sides", label: "Sides", value: rs.sides, onSet: (n: number) => set({ sides: n }) }),
        rs.fudge ? null : h(CrNumField, { id: kb + ":explode", label: "Rolls again at, 0 for never", value: rs.explode, onSet: (n: number) => set({ explode: n }) }),
        h(CrChoice, { label: "Advantage", active: rs.edge ? "on" : "off",
          options: [{ id: "off", label: "Off" }, { id: "on", label: "On" }],
          onPick: (id: string) => set({ edge: id === "on" }) })
      ),
      rs.rowsAs === "dice" ? h("div", { style: Object.assign({ marginTop: CR_S_3 }, two) },
        h(CrNumField, { id: kb + ":zeroDice", label: "Dice when the pool is empty", value: rs.zeroDice, onSet: (n: number) => set({ zeroDice: n }) }),
        h(CrChoice, { label: "Empty pool keeps", active: rs.zeroKeep,
          options: [{ id: "low", label: "Lowest" }, { id: "high", label: "Highest" }],
          onPick: (id: string) => set({ zeroKeep: id }) }),
        rs.read === "count" ? h(CrNumField, { id: kb + ":zeroAt", label: "Empty pool succeeds at, 0 for the usual", value: rs.zeroAt, onSet: (n: number) => set({ zeroAt: n }) }) : null
      ) : null,
      h("div", { style: Object.assign({ marginTop: CR_S_3 }, two) },
        h(CrChoice, { label: "Keep", active: rs.keep,
          options: [{ id: "all", label: "All" }, { id: "high", label: "Highest" }, { id: "low", label: "Lowest" }],
          onPick: (id: string) => set({ keep: id }) }),
        rs.keep !== "all" ? h(CrNumField, { id: kb + ":keepN", label: "How many to keep", value: rs.keepN, onSet: (n: number) => set({ keepN: n }) }) : null
      )
    ),
    h(CrSection, { title: "Reading the roll" },
      h("div", { style: Object.assign({ marginTop: CR_S_3 }, two) },
        h(CrChoice, { label: "Value", active: rs.read,
          options: [{ id: "sum", label: "Add them" }, { id: "high", label: "Highest die" }, { id: "count", label: "Count successes" }],
          onPick: (id: string) => set({ read: id }) }),
        rs.read === "count" ? h(CrNumField, { id: kb + ":countAt", label: "A die succeeds at", value: rs.countAt, onSet: (n: number) => set({ countAt: n }) }) : null,
        h(CrChoice, { label: "Target", active: rs.compare,
          options: [{ id: "none", label: "None" }, { id: "atLeast", label: "Meet or beat" }, { id: "atMost", label: "Roll under" }],
          onPick: (id: string) => set({ compare: id }) }),
        (rs.compare !== "none" && rs.rowsAs !== "target") ? h(CrNumField, { id: kb + ":target", label: "Default target", value: rs.target, onSet: (n: number) => set({ target: n }) }) : null,
        rs.compare !== "none" ? h(CrChoice, { label: "Bands measure", active: rs.basis,
          options: [{ id: "value", label: "The value" }, { id: "margin", label: "Distance from target" }, { id: "ratio", label: "Fraction of target" }],
          onPick: (id: string) => set({ basis: id }) }) : null
      )
    ),
    h(CrSection, { title: "Outcomes", note: "Checked from the top; the first band that fits is the outcome, and the last band catches anything left. " + scoreHint
      + " The meaning is what a reaction is told, so keep numbers out of it." },
      h("div", { style: { marginTop: CR_S_3 } },
        rs.bands.map((b, i) => h("div", { key: "b" + i, style: { marginBottom: CR_S_3, paddingBottom: CR_S_3, borderBottom: CR_LINE_W + " solid " + CR_LINE } },
          h("div", { style: two },
            h(CrField, { label: "Outcome" }, h(CrTextInput, { value: b.label, onSet: (v: string) => { b.label = v; commit(); } })),
            h(CrField, { label: "Meaning" }, h(CrTextInput, { value: b.meaning, onSet: (v: string) => { b.meaning = v; commit(); } })),
            h(CrRpgRangeField, { id: kb + ":b" + i + ":min", label: "At least", value: b.min, onSet: (v: number | undefined) => { if (v === undefined){ delete b.min; } else { b.min = v; } commit(); } }),
            h(CrRpgRangeField, { id: kb + ":b" + i + ":max", label: "At most", value: b.max, onSet: (v: number | undefined) => { if (v === undefined){ delete b.max; } else { b.max = v; } commit(); } })
          ),
          h("div", { style: { display: "flex", gap: CR_S_2, marginTop: CR_S_2 } },
            i > 0 ? h(CrButton, { text: "Move up", icon: "", onClick: () => { const t = rs.bands[i - 1]; rs.bands[i - 1] = b; rs.bands[i] = t; commit(); } }) : null,
            h(CrIconButton, { icon: "trash", label: "Remove " + (b.label || "outcome"), tone: "warn",
                              onClick: () => { rs.bands.splice(i, 1); commit(); } })
          )
        )),
        rs.bands.length < CR_RPG_MAX_BANDS ? h(CrButton, { text: "Add an outcome",
          onClick: () => { rs.bands.push({ label: "Outcome", meaning: "" }); commit(); } }) : null
      )
    ),
    h(CrSection, { title: "Special results", note: "Checked in order after the bands. Natural means the dice before any row is added: the kept die, the sum of the dice, or the successes counted. "
      + "Every field filled in must hold. An outcome name replaces the result and stops; otherwise the shift moves it up or down the list." },
      h("div", { style: { marginTop: CR_S_3 } },
        rs.triggers.map((t, i) => h("div", { key: "t" + i, style: { marginBottom: CR_S_3, paddingBottom: CR_S_3, borderBottom: CR_LINE_W + " solid " + CR_LINE } },
          h("div", { style: two },
            h(CrRpgRangeField, { id: kb + ":t" + i + ":a", label: "Natural at least", value: t.rawAtLeast, onSet: (v: number | undefined) => { if (v === undefined){ delete t.rawAtLeast; } else { t.rawAtLeast = v; } commit(); } }),
            h(CrRpgRangeField, { id: kb + ":t" + i + ":b", label: "Natural at most", value: t.rawAtMost, onSet: (v: number | undefined) => { if (v === undefined){ delete t.rawAtMost; } else { t.rawAtMost = v; } commit(); } }),
            h(CrRpgRangeField, { id: kb + ":t" + i + ":f", label: "Die showing", value: t.face, onSet: (v: number | undefined) => { if (v === undefined){ delete t.face; } else { t.face = v; } commit(); } }),
            h(CrRpgRangeField, { id: kb + ":t" + i + ":fc", label: "How many of that die", value: t.faceCount, onSet: (v: number | undefined) => { if (v === undefined){ delete t.faceCount; } else { t.faceCount = v; } commit(); } }),
            h(CrRpgRangeField, { id: kb + ":t" + i + ":tb", label: "Target below", value: t.targetBelow, onSet: (v: number | undefined) => { if (v === undefined){ delete t.targetBelow; } else { t.targetBelow = v; } commit(); } }),
            h(CrChoice, { label: "Only when the pool is empty", active: t.zeroOnly ? "yes" : "no",
              options: [{ id: "no", label: "No" }, { id: "yes", label: "Yes" }],
              onPick: (id: string) => { if (id === "yes"){ t.zeroOnly = true; } else { delete t.zeroOnly; } commit(); } }),
            h(CrField, { label: "Outcome name" }, h(CrTextInput, { value: t.label, placeholder: "leave empty to shift instead", onSet: (v: string) => { t.label = v; commit(); } })),
            h(CrField, { label: "Meaning" }, h(CrTextInput, { value: t.meaning, onSet: (v: string) => { t.meaning = v; commit(); } })),
            h(CrNumField, { id: kb + ":t" + i + ":shift", label: "Shift, + is better", value: t.shift, onSet: (n: number) => { t.shift = n; commit(); } })
          ),
          h("div", { style: { marginTop: CR_S_2 } },
            h(CrIconButton, { icon: "trash", label: "Remove this special result", tone: "warn",
                              onClick: () => { rs.triggers.splice(i, 1); commit(); } }))
        )),
        rs.triggers.length < CR_RPG_MAX_TRIGGERS ? h(CrButton, { text: "Add a special result",
          onClick: () => { rs.triggers.push({ shift: 0, label: "", meaning: "" }); commit(); } }) : null
      )
    ),
    h(CrSection, { title: "Starting sheet", note: "Copied onto a person's sheet when one is started. Changing it here leaves existing sheets alone." },
      h("div", { style: { marginTop: CR_S_3 } },
        h(CrRpgSheetEditor, { sheet: rs.sheet, keyBase: kb + ":sheet", rowsAs: rs.rowsAs, onChange: commit }))
    )
  );
}

function CrRpgSystems(props: { mobile: boolean }) : any
{
  const editing = crRpgCustom.find((r) => r.id === crRpgEditing);
  if (editing){
    return h(CrRpgRulesetEditor, { rs: editing, mobile: props.mobile });
  }
  const row = (r: CrRpgRuleset) => {
    const inUse = crRpgStory.ruleset === r.id;
    const armed = crRpgDeleteArm === r.id;
    return h("div", { key: r.id, class: "cr-rpg-system", style: { padding: CR_S_3 + " 0", borderTop: CR_LINE_W + " solid " + CR_LINE } },
      h("div", { style: { color: CR_HEAD, fontSize: CR_T_BASE, fontWeight: "600" } }, r.name),
      h("div", { style: { color: CR_DIM, fontSize: CR_T_SM, lineHeight: "1.45", marginTop: CR_S_1 } }, crRpgSummary(r)),
      h("div", { style: { display: "flex", gap: CR_S_2, flexWrap: "wrap", marginTop: CR_S_2 } },
        h(CrButton, { text: inUse ? "In use" : "Use here", icon: "", primary: inUse, disabled: inUse,
                      onClick: () => { crRpgUse(r.id).catch(() => {}); } }),
        h(CrButton, { text: "Copy", icon: "", onClick: () => { crRpgCopyRuleset(r.id).catch(() => {}); } }),
        r.preset ? null : h(CrButton, { text: "Edit", onClick: () => { crRpgEditing = r.id; crTouch(); } }),
        r.preset ? null : h(CrButton, { text: armed ? "Delete for good?" : "Delete", tone: "warn",
                                         onClick: () => { crRpgDeleteRuleset(r.id).catch(() => {}); } })
      )
    );
  };
  return h("div", { class: "cr-rpg-systems" },
    h(CrSection, { title: "Systems", note: "A system is how a roll is made and read. The presets play like the games they are named for and cannot be edited; copy one to change it. "
      + "Your own systems are kept with your account and work in every story." },
      h("div", { style: { marginTop: CR_S_3 } },
        h(CrButton, { text: "New system", primary: true, onClick: () => { crRpgAddRuleset(crRpgBlankRuleset()).catch(() => {}); } }))
    ),
    h(CrHeading, { id: "rpg-presets", title: "Presets" }, crRpgPresets().map(row)),
    h("div", { style: { height: CR_S_4 } }),
    h(CrHeading, { id: "rpg-custom", title: "Yours" },
      crRpgCustom.length ? crRpgCustom.map(row) : h("div", { style: { color: CR_DIM, fontSize: CR_T_SM } }, "None yet. Copy a preset or start a new one."))
  );
}

function CrRpgSurface(props: { mobile: boolean }) : any
{
  const body = crRpgTab === "systems" ? h(CrRpgSystems, { mobile: props.mobile })
    : (crRpgTab === "play" ? h(CrPlaySurface, { mobile: props.mobile }) : h(CrRpgTable, { mobile: props.mobile }));
  return h("div", { class: "cr-rpg" },
    h(CrTabs, {
      tabs: [{ id: "table", label: "Table" }, { id: "systems", label: "Systems" }, { id: "play", label: "Games" }],
      active: crRpgTab, mobile: props.mobile,
      onPick: (id: string) => { crRpgTab = id; crTouch(); }
    }),
    h("div", { style: { marginTop: CR_S_4 } }, body),
    h("div", { style: { color: CR_DIM, fontSize: CR_T_SM, marginTop: CR_S_3 } },
      crRpgTab === "play"
        ? "A game's score is kept per pairing and reaches the prompt only with Include Game Stats on. The same games are still in the CR Games panel."
        : "Rolls stay on this tab and nothing here is sent with a Send.")
  );
}

// ============================================================================
// SECTION CR-PLAY — ANOTHERROOM'S TABLE GAMES, GIVEN A SHELL DOOR
// ============================================================================
// The rules, the records and the reaction generator are AnotherRoom's and are called,
// not copied: `gameRecord`, `CompetitiveStats`, `CoopStats` and `genGameReaction` are
// used exactly as its own panel uses them, so the kernel's Game History line reads the
// same numbers whichever door played the game. Only the surface is CR's (D-25).

interface CrPlayRound {
  moves: string;      // the narrative line: who threw what, and what happened
  outcome: string;    // the outcome alone, for the tab
  text: string;       // the Contact's reply
  emotion: string;
  sent: boolean;
}

type CrPlayDir = "Lower" | "Higher";

let crPlayTab = "rps";
let crPlayBusy = "";
let crPlayNote = "";
let crPlayRpsRound: CrPlayRound | null = null;
let crPlayGuessTarget = 0;
let crPlayGuessTurns = 0;
let crPlayGuessHistory: { guess: number; outcome: CrPlayDir }[] = [];
let crPlayGuessRound: CrPlayRound | null = null;
let crPlayGuessWon = false;
let crPlayGuessDraft = 50;
const CR_PLAY_GUESS_MIN = 1;
const CR_PLAY_GUESS_MAX = 100;

// The kernel reads this key from storage at context-build time, so the mirror below is the
// surface's readout and never the source of truth.
let crPlayIncludeStats: boolean = (await api.v1.storage.get(INCLUDE_GAME_STATS_KEY)) === true;

async function crPlaySetIncludeStats(on: boolean) : Promise<void>
{
  crPlayIncludeStats = on;
  try{ await api.v1.storage.set(INCLUDE_GAME_STATS_KEY, on); }
  catch (e){ api.v1.error("[CR:play] could not store the game-stats setting:", e); }
  crTouch();
}

function crPlayPairing() : { char: Character; user: User } | null
{
  if (!chatSettings.char || !chatSettings.user){
    return null;
  }
  return { char: chatSettings.char, user: chatSettings.user };
}

function crPlayCombinedId() : string
{
  const pair = crPlayPairing();
  return pair ? (pair.char.id + pair.user.id) : "";
}

function crPlayStats(gameType: GameType) : GameStats | null
{
  const id = crPlayCombinedId();
  return (id && gameRecord[gameType] && gameRecord[gameType][id]) || null;
}

async function crPlaySaveRecord() : Promise<void>
{
  try{ await api.v1.storage.set(GAME_RECORD_KEY, gameRecord); }
  catch (e){ api.v1.error("[CR:play] could not save the game record:", e); }
}

// D-88, widened by D-93: one press, one generation, and never beside a Send.
function crPlayRefused() : boolean
{
  if (crPlayBusy || crGroupBusyId){
    api.v1.ui.toast("Another reply is being written. Try again once it lands.", { type: "warning" });
    return true;
  }
  if (crRpgNativeBusy()){
    api.v1.ui.toast("A reply is being written. Try again once it lands.", { type: "warning" });
    return true;
  }
  if (!crPlayPairing()){
    api.v1.ui.toast("Pair a Contact and a User before playing.", { type: "warning" });
    return true;
  }
  return false;
}

async function crPlayReact(gameType: GameType, context: string, moves: string, outcome: string) : Promise<CrPlayRound>
{
  const pair = crPlayPairing()!;
  const round: CrPlayRound = { moves: moves, outcome: outcome, text: "", emotion: "", sent: false };
  try{
    const reaction: Reaction = await genGameReaction(pair.char, pair.user, gameType, context);
    round.text = String(reaction.text || "");
    round.emotion = String(reaction.emotion || "");
  }
  catch (e){
    api.v1.error("[CR:play] the reaction generation failed:", e);
  }
  return round;
}

// ---- Rock Paper Scissors ----------------------------------------------------
type CrPlayRpsChoice = "Rock" | "Paper" | "Scissors";
const CR_PLAY_RPS_LIST: CrPlayRpsChoice[] = ["Rock", "Paper", "Scissors"];

function crPlayRpsBeats(a: CrPlayRpsChoice, b: CrPlayRpsChoice) : boolean
{
  return (a === "Paper" && b === "Rock") || (a === "Rock" && b === "Scissors") || (a === "Scissors" && b === "Paper");
}

async function crPlayRps(userChoice: CrPlayRpsChoice) : Promise<void>
{
  if (crPlayRefused()){
    return;
  }
  const pair = crPlayPairing()!;
  // AnotherRoom's own joke, kept: Grug always throws Rock.
  const charChoice: CrPlayRpsChoice = pair.char.name === "Grug"
    ? "Rock"
    : CR_PLAY_RPS_LIST[api.v1.random.int(0, 2)];
  const id = crPlayCombinedId();
  if (!gameRecord.RPS[id]){
    gameRecord.RPS[id] = {
      kind: "competitive", displayLabel: "Rock Paper Scissors",
      charWins: 0, charLosses: 0, userWins: 0, userLosses: 0, ties: 0
    };
  }
  const stats = gameRecord.RPS[id] as CompetitiveStats;
  let outcome = "";
  if (userChoice === charChoice){
    stats.ties++;
    outcome = userChoice + " and " + charChoice + " are the same! It's a tie!";
  }
  else if (crPlayRpsBeats(userChoice, charChoice)){
    stats.userWins++;
    stats.charLosses++;
    outcome = userChoice + " beats " + charChoice + "! " + pair.user.name + " wins!";
  }
  else {
    stats.charWins++;
    stats.userLosses++;
    outcome = charChoice + " beats " + userChoice + "! " + pair.char.name + " wins!";
  }
  const context = pair.char.name + " chose " + charChoice + ". " + pair.user.name + " chose " + userChoice + ". " + outcome;
  const moves = "*" + pair.user.name + " chooses " + userChoice + ". "
    + pair.char.name + " chooses " + charChoice + ". " + outcome + "*";
  crPlayBusy = "rps";
  crPlayNote = "";
  crPlayRpsRound = null;
  crTouch();
  try{
    crPlayRpsRound = await crPlayReact("RPS", context, moves, outcome);
    await crPlaySaveRecord();
  }
  finally{
    crPlayBusy = "";
    crTouch();
  }
}

// ---- Number Guess -----------------------------------------------------------
function crPlayGuessIntro() : string
{
  const pair = crPlayPairing();
  if (!pair){
    return "";
  }
  return "*" + pair.user.name + " is locked in a room with " + pair.char.name
    + ". They have to guess the correct number, from " + String(CR_PLAY_GUESS_MIN) + " to " + String(CR_PLAY_GUESS_MAX)
    + ", to escape. Each round, they both guess and then find out how close they are."
    + " The better they use information from both guesses, the faster they can win, together.*";
}

function crPlayGuessNew() : void
{
  crPlayGuessTarget = api.v1.random.int(CR_PLAY_GUESS_MIN, CR_PLAY_GUESS_MAX);
  crPlayGuessTurns = 0;
  crPlayGuessHistory = [];
  crPlayGuessRound = null;
  crPlayGuessWon = false;
  crPlayNote = "";
  crTouch();
}

// AnotherRoom's narrowing guesser: it remembers every hint and never repeats a range
// it has already ruled out, which is what makes the cooperative score mean something.
function crPlayGuessAi() : number
{
  let lo = CR_PLAY_GUESS_MIN;
  let hi = CR_PLAY_GUESS_MAX;
  for (let i = 0; i < crPlayGuessHistory.length; i++){
    const hist = crPlayGuessHistory[i];
    if (hist.outcome === "Lower" && hist.guess - 1 < hi){
      hi = hist.guess - 1;
    }
    else if (hist.outcome === "Higher" && hist.guess + 1 > lo){
      lo = hist.guess + 1;
    }
  }
  return api.v1.random.int(Math.min(lo, hi), Math.max(lo, hi));
}

async function crPlayGuess(userGuess: number) : Promise<void>
{
  if (crPlayRefused()){
    return;
  }
  if (crPlayGuessWon){
    return;
  }
  const pair = crPlayPairing()!;
  if (!crPlayGuessTarget){
    crPlayGuessNew();
  }
  const guess = Math.max(CR_PLAY_GUESS_MIN, Math.min(CR_PLAY_GUESS_MAX, Math.round(userGuess)));
  const aiGuess = crPlayGuessAi();
  crPlayGuessTurns++;
  let context = "*" + pair.user.name + " guessed " + String(guess) + ". " + pair.char.name + " guessed " + String(aiGuess) + ".";
  let outcome = "";
  let won = false;
  if (guess === crPlayGuessTarget || aiGuess === crPlayGuessTarget){
    won = true;
    crPlayGuessWon = true;
    outcome = String(crPlayGuessTarget) + " is correct. " + pair.char.name + " and " + pair.user.name + " win!";
    context += " " + String(crPlayGuessTarget) + " is correct. " + pair.char.name + " and " + pair.user.name
      + " win! The room unlocks with a hiss. A sign displays a message, indicating they can leave or play again.*";
    const id = crPlayCombinedId();
    if (!gameRecord.NumberGuess){
      gameRecord.NumberGuess = {};
    }
    if (!gameRecord.NumberGuess[id]){
      gameRecord.NumberGuess[id] = { kind: "cooperative", displayLabel: "Number Guess", sharedWins: [crPlayGuessTurns] };
    }
    else {
      (gameRecord.NumberGuess[id] as CoopStats).sharedWins.push(crPlayGuessTurns);
    }
    await crPlaySaveRecord();
  }
  else {
    const userDir: CrPlayDir = crPlayGuessTarget > guess ? "Higher" : "Lower";
    const aiDir: CrPlayDir = crPlayGuessTarget > aiGuess ? "Higher" : "Lower";
    crPlayGuessHistory.push({ guess: guess, outcome: userDir });
    crPlayGuessHistory.push({ guess: aiGuess, outcome: aiDir });
    outcome = "The number is " + userDir.toLowerCase() + " than " + String(guess)
      + " and " + aiDir.toLowerCase() + " than " + String(aiGuess) + ".";
    context += " The correct number is " + userDir.toLowerCase() + " than what " + pair.user.name + " guessed"
      + " and " + aiDir.toLowerCase() + " than what " + pair.char.name + " guessed.*";
  }
  // AnotherRoom's own rate: the Contact speaks up roughly one round in five, so a long
  // game is not one generation per guess. A win always gets a reply.
  const speaks = won || api.v1.random.int(1, 5) === 1;
  crPlayGuessRound = null;
  crPlayNote = "";
  if (!speaks){
    crPlayGuessRound = { moves: "", outcome: outcome, text: "", emotion: "", sent: true };
    crTouch();
    return;
  }
  crPlayBusy = "guess";
  crTouch();
  try{
    crPlayGuessRound = await crPlayReact("NumberGuess", crPlayGuessIntro() + " " + context, "", outcome);
  }
  finally{
    crPlayBusy = "";
    crTouch();
  }
}

// ---- writing a round into the story -----------------------------------------
// RPS writes its moves because the moves ARE narrative — who threw what, and who won.
// Number Guess does not: its mechanics are two integers, which is the case D-63 closed.
async function crPlaySend(round: CrPlayRound) : Promise<void>
{
  if (!round.text || round.sent){
    return;
  }
  if (crGroupBusyId || crPlayBusy || crRpgNativeBusy()){
    api.v1.ui.toast("A reply is being written. Try again once it lands.", { type: "warning" });
    return;
  }
  const pair = crPlayPairing();
  if (!pair){
    return;
  }
  let allowed = false;
  try{ allowed = await permissionCheckPassed("documentEdit"); }
  catch (e){ allowed = false; }
  if (!allowed){
    api.v1.ui.toast("CharacterRoom needs permission to write to the document.", { type: "warning" });
    return;
  }
  const body = pair.char.name + ": " + (round.moves ? round.moves + "\n" : "") + round.text
    + (round.emotion ? "\n  Emotion: " + round.emotion : "");
  const probe = crGroupNewProbe(pair.char.id);
  crGroupBusyId = "play:" + pair.char.id;
  try{
    await crGroupDropEmptyOpener();
    await crGroupWrite(body, probe);
    round.sent = true;
    crPlayNote = "";
  }
  catch (e){
    crPlayNote = "Could not write it into the story: " + String((e && (e as any).message) || e);
    api.v1.error("[CR:play] send failed:", e);
  }
  finally{
    crGroupBusyId = "";
    crTouch();
  }
  try{ await updateEditorImages(); }
  catch (e){}
}

async function crPlayResetStats(gameType: GameType) : Promise<void>
{
  const id = crPlayCombinedId();
  if (!id || !gameRecord[gameType] || !gameRecord[gameType][id]){
    return;
  }
  delete gameRecord[gameType][id];
  await crPlaySaveRecord();
  crTouch();
}

function crPlayStatLine(gameType: GameType) : string
{
  const stats = crPlayStats(gameType);
  const pair = crPlayPairing();
  if (!stats || !pair){
    return "";
  }
  if (stats.kind === "competitive"){
    return pair.char.name + " " + String(stats.charWins) + " · "
      + pair.user.name + " " + String(stats.userWins) + " · "
      + String(stats.ties) + (stats.ties === 1 ? " tie" : " ties");
  }
  const wins = stats.sharedWins;
  if (!wins.length){
    return "";
  }
  const best = Math.min.apply(null, wins);
  return String(wins.length) + (wins.length === 1 ? " escape" : " escapes")
    + ", best in " + String(best) + (best === 1 ? " round" : " rounds");
}

// ---- surfaces ---------------------------------------------------------------
function CrPlayRoundBox(props: { round: CrPlayRound | null; busy: boolean; onDiscard: () => void }) : any
{
  const round = props.round;
  if (props.busy){
    return h("div", { style: { marginTop: CR_S_3, display: "flex", alignItems: "center", gap: CR_S_2 } },
      h(CrPill, { text: "writing", tone: "accent" }));
  }
  if (!round){
    return null;
  }
  return h("div", {
    class: "cr-play-round",
    style: { marginTop: CR_S_3, padding: CR_S_3, background: CR_SUNK,
             border: CR_LINE_W + " solid " + CR_LINE, borderRadius: CR_RADIUS_S }
  },
    h("div", { style: { color: CR_HEAD, fontSize: CR_T_BASE, fontWeight: "600", lineHeight: "1.45" } }, round.outcome),
    round.text
      ? h("div", { style: { color: CR_TEXT, fontSize: CR_T_MD, marginTop: CR_S_2, lineHeight: "1.5", whiteSpace: "pre-wrap" } }, round.text)
      : null,
    round.emotion ? h("div", { style: { marginTop: CR_S_2 } }, h(CrPill, { text: round.emotion })) : null,
    round.text ? h("div", { style: { display: "flex", gap: CR_S_2, flexWrap: "wrap", marginTop: CR_S_3 } },
      h(CrButton, { text: round.sent ? "Sent" : "Send to the story", icon: "check", primary: !round.sent,
                    disabled: round.sent, onClick: () => { crPlaySend(round).catch(() => {}); } }),
      h(CrButton, { text: "Discard", icon: "trash", tone: "warn", onClick: props.onDiscard })
    ) : null
  );
}

function CrPlayRps() : any
{
  const pair = crPlayPairing();
  const line = crPlayStatLine("RPS");
  return h(CrSection, { title: "Rock Paper Scissors",
                        note: "Throw against " + (pair ? pair.char.name : "the Contact") + ". "
                            + "The reply waits here until you send it, and the moves go with it." },
    line ? h("div", { style: { display: "flex", alignItems: "center", gap: CR_S_2, flexWrap: "wrap", marginBottom: CR_S_3 } },
      h("div", { style: { flex: "1 1 auto", minWidth: "0", color: CR_DIM, fontSize: CR_T_SM } }, line),
      h(CrButton, { text: "Reset stats", icon: "", tone: "warn",
                    onClick: () => { crPlayResetStats("RPS").catch(() => {}); } })
    ) : null,
    h(CrChoice, {
      active: "", options: CR_PLAY_RPS_LIST.map((c) => ({ id: c, label: c })),
      onPick: (id: string) => { crPlayRps(id as CrPlayRpsChoice).catch(() => {}); }
    }),
    h(CrPlayRoundBox, { round: crPlayRpsRound, busy: crPlayBusy === "rps",
                     onDiscard: () => { crPlayRpsRound = null; crTouch(); } })
  );
}

function CrPlayGuess() : any
{
  const pair = crPlayPairing();
  const line = crPlayStatLine("NumberGuess");
  const started = crPlayGuessTurns > 0 || crPlayGuessTarget > 0;
  const hints = crPlayGuessHistory.slice(-6);
  return h(CrSection, { title: "Number Guess",
                        note: "You and " + (pair ? pair.char.name : "the Contact") + " are locked in a room and guess together, "
                            + "from " + String(CR_PLAY_GUESS_MIN) + " to " + String(CR_PLAY_GUESS_MAX) + ". "
                            + "Fewer rounds is a better escape." },
    line ? h("div", { style: { display: "flex", alignItems: "center", gap: CR_S_2, flexWrap: "wrap", marginBottom: CR_S_3 } },
      h("div", { style: { flex: "1 1 auto", minWidth: "0", color: CR_DIM, fontSize: CR_T_SM } }, line),
      h(CrButton, { text: "Reset stats", icon: "", tone: "warn",
                    onClick: () => { crPlayResetStats("NumberGuess").catch(() => {}); } })
    ) : null,
    h("div", { style: { display: "flex", gap: CR_S_4, flexWrap: "wrap", alignItems: "flex-end" } },
      h("div", { style: { flex: "0 0 auto", minWidth: "0" } },
        h(CrNumField, { id: "cr-play-guess", label: "Your guess", value: crPlayGuessDraft,
                        onSet: (n: number) => {
                          crPlayGuessDraft = Math.max(CR_PLAY_GUESS_MIN, Math.min(CR_PLAY_GUESS_MAX, Math.round(n)));
                          crTouch();
                        } })),
      h("div", { style: { display: "flex", gap: CR_S_2, flexWrap: "wrap" } },
        h(CrButton, { text: "Guess", icon: "", primary: true, disabled: crPlayGuessWon || crPlayBusy === "guess",
                      onClick: () => { crPlayGuess(crPlayGuessDraft).catch(() => {}); } }),
        h(CrButton, { text: started ? "New number" : "Start", icon: "",
                      onClick: () => { crPlayGuessNew(); } })
      )
    ),
    started ? h("div", { style: { color: CR_DIM, fontSize: CR_T_SM, marginTop: CR_S_3 } },
      String(crPlayGuessTurns) + (crPlayGuessTurns === 1 ? " round" : " rounds")
      + (crPlayGuessWon ? " — out." : " so far.")) : null,
    hints.length ? h("div", { style: { display: "flex", gap: CR_S_2, flexWrap: "wrap", marginTop: CR_S_2 } },
      hints.map((hist, i) => h(CrPill, { key: String(i), text: String(hist.guess) + " — go " + hist.outcome.toLowerCase() }))
    ) : null,
    h(CrPlayRoundBox, { round: crPlayGuessRound, busy: crPlayBusy === "guess",
                     onDiscard: () => { crPlayGuessRound = null; crTouch(); } })
  );
}

function CrPlayStatsSwitch() : any
{
  return h(CrChoice, {
    label: "Game history in context",
    hint: "On sends the pairing's running score to the model with every reply, as a Game History "
      + "entry, so the Contact knows how the two of them have been doing. It covers both games.",
    options: [{ id: "off", label: "Off" }, { id: "on", label: "On" }],
    active: crPlayIncludeStats ? "on" : "off",
    onPick: (id: string) => { crPlaySetIncludeStats(id === "on").catch(() => {}); }
  });
}

function CrPlaySurface(props: { mobile: boolean }) : any
{
  if (!crPlayPairing()){
    return h("div", { style: { padding: CR_S_5 } },
      h(CrEmpty, { text: "Pair a Contact and a User on the Chat tab — these games are played against the pairing and keep its score." }));
  }
  return h("div", null,
    h(CrTabs, {
      tabs: [{ id: "rps", label: "Rock Paper Scissors" }, { id: "guess", label: "Number Guess" }],
      active: crPlayTab, mobile: props.mobile,
      onPick: (id: string) => { crPlayTab = id; crTouch(); }
    }),
    h("div", { style: { marginTop: CR_S_3 } },
      crPlayTab === "guess" ? h(CrPlayGuess, null) : h(CrPlayRps, null)),
    h("div", { style: { marginTop: CR_S_3 } },
      h(CrSection, { title: "Both games" }, h(CrPlayStatsSwitch, null))),
    crPlayNote ? h("div", { style: { color: CR_WARN, fontSize: CR_T_SM, marginTop: CR_S_3 } }, crPlayNote) : null
  );
}

// ============================================================================
// SECTION BRIDGE — SHARED BRIDGE TRANSPORT
// ============================================================================
// [KIT-FROM-CE]
const CR_BRIDGE_CHANNEL = "hypebot";
const CR_EVT_HANDSHAKE_REQUEST = "HANDSHAKE_REQUEST";
const CR_EVT_HANDSHAKE_ACK = "HANDSHAKE_ACK";
const CR_EVT_VIEWPORT = "AE_VIEWPORT";
const CR_EVT_CHAR_IMAGE_ACTION = "AE_CHAR_IMAGE_ACTION";
const CR_EVT_CHAR_IMAGE_SLOTS = "AE_CHAR_IMAGE_SLOTS";
const CR_EVT_CHAR_IMAGE_UPLOADED = "AE_CHAR_IMAGE_UPLOADED";
const CR_EVT_GALLERY_INDEX_REQ = "AE_GALLERY_INDEX_REQ";
const CR_EVT_GALLERY_INDEX_RESP = "AE_GALLERY_INDEX_RESP";
const CR_EVT_GALLERY_ACTION = "AE_GALLERY_ACTION";
const CR_EVT_STORY_IMG_DROP = "AE_STORY_IMG_DROP";
const CR_EVT_IMG_META_REQ = "AE_IMG_META_REQ";
const CR_EVT_IMG_META_RESP = "AE_IMG_META_RESP";
const CR_SLOT_PROBE_TIMEOUT_MS = 4000;
const CR_EVT_CARD_IMPORT = "AE_CARD_IMPORT";
const CR_EVT_CARD_IMPORT_RESULT = "AE_CARD_IMPORT_RESULT";
const CR_CARD_IMPORT_ACK_MS = 4000;
const CR_CARD_IMPORT_RESULT_MS = 180000;
// [KIT-FROM-CE]
const CR_IMG_ATTR = "data-ce-img";
const CR_BRIDGE_MAX_ATTEMPTS = 20;
const CR_BRIDGE_RETRY_MS = 1500;

type CrBridgeState = {
  ready: boolean;
  attempts: number;
  settled: boolean;
  lastAckAt: number;
  bridgeEngine: string;
  bridgeCrAware: boolean;
  bridgeCcavClear: boolean;
  viewportW: number;
  viewportH: number;
  unknownEvents: string[];
};

let crBridge: CrBridgeState = {
  ready: false,
  attempts: 0,
  settled: false,
  lastAckAt: 0,
  bridgeEngine: "",
  bridgeCrAware: false,
  bridgeCcavClear: false,
  viewportW: 0,
  viewportH: 0,
  unknownEvents: []
};
let crBridgeSubscribed = false;
let crBridgeConnecting = false;

type CrSlotProbe = {
  asked: string;
  askedName: string;
  answered: boolean;
  pending: boolean;
  timedOut: boolean;
  slots: string[];
};
let crSlotProbe: CrSlotProbe = {
  asked: "", askedName: "", answered: false, pending: false, timedOut: false, slots: []
};

type CrCardImportPicked =
  { kind: "json"; ticket: string; json: string; slots: string[] } |
  { kind: "cancelled" } |
  { kind: "error"; message: string } |
  { kind: "noBridge" };

type CrCardImportState = {
  ticket: string;
  acked: boolean;
  slots: string[];
  settle: ((picked: CrCardImportPicked) => void) | null;
};

let crCardImport: CrCardImportState = { ticket: "", acked: false, slots: [], settle: null };

async function crBridgeSend(event: string, data?: Record<string, any>) : Promise<void>
{
  try{
    await api.v1.messaging.broadcast(
      { type: "MESSAGE", sid: api.v1.script.id, payload: Object.assign({ event: event }, data || {}) },
      CR_BRIDGE_CHANNEL
    );
  }
  catch (e){
    api.v1.error("[CR:bridge] send failed:", event, e);
  }
}

function crBridgeNoteUnknown(event: string)
{
  if (!event || crBridge.unknownEvents.indexOf(event) >= 0){
    return;
  }
  crBridge.unknownEvents.push(event);
  if (crBridge.unknownEvents.length > 8){
    crBridge.unknownEvents.shift();
  }
}

async function crBridgeHandleMessage(msg: any) : Promise<void>
{
  try{
    const payload: any = (msg && msg.data && msg.data.payload) ? msg.data.payload : ((msg && msg.data) ? msg.data : {});
    const event: string = String(payload.event || "");
    if (!event){
      return;
    }
    if (event === CR_EVT_HANDSHAKE_ACK){
      const wasReady = crBridge.ready;
      crBridge.ready = true;
      crBridge.settled = true;
      crBridge.lastAckAt = Date.now();
      crBridge.bridgeEngine = String(payload.engine || "");
      crBridge.bridgeCrAware = payload.crAware === true;
      const ccavClear = payload.ccavClear === true;
      if (ccavClear !== crBridge.bridgeCcavClear){
        crBridge.bridgeCcavClear = ccavClear;
        crCcavEmit().catch(() => {});
      }
      if (!wasReady){
        await api.v1.ui.toast("CharacterRoom: bridge connected.", { type: "success", autoClose: 2000 });
        crBridgeProbeSlots().catch(() => {});
      }
      await updateBridgeStatusUi();
      return;
    }
    if (event === CR_EVT_CHAR_IMAGE_UPLOADED){
      const upId = String(payload.charId || "");
      if (upId){
        const target = charList.find((c) => c.id === upId);
        if (target){
          await crBridgeProbeSlots(target);
        }
      }
      crTouch();
      return;
    }
    if (event === CR_EVT_CHAR_IMAGE_SLOTS){
      const forId = String(payload.charId || "");
      if (forId && forId !== crSlotProbe.asked){
        return;
      }
      const slots: any[] = Array.isArray(payload.slots) ? payload.slots : [];
      crSlotProbe.slots = slots.map((s) => String(s));
      crRememberSlots(crSlotProbe.asked, crSlotProbe.slots).catch(() => {});
      const paired = crLiveContact();
      if (paired && paired.id === crSlotProbe.asked){
        crCcavEmit().catch(() => {});
      }
      crSlotProbe.answered = true;
      crSlotProbe.pending = false;
      crSlotProbe.timedOut = false;
      await updateBridgeStatusUi();
      crTouch();
      return;
    }
    if (event === CR_EVT_CARD_IMPORT_RESULT){
      crCardImportReceive(payload);
      return;
    }
    if (event === CR_EVT_GALLERY_INDEX_RESP){
      crGalleryReceive(payload);
      return;
    }
    if (event === CR_EVT_IMG_META_RESP){
      crGalMetaReceive(payload);
      return;
    }
    if (event === CR_EVT_STORY_IMG_DROP){
      await crChatImgDrop(String(payload.uuid || ""));
      return;
    }
    if (event === CR_EVT_VIEWPORT){
      crBridge.viewportW = Number(payload.w) || 0;
      crBridge.viewportH = Number(payload.h) || 0;
      return;
    }
    crBridgeNoteUnknown(event);
  }
  catch (e){
    api.v1.error("[CR:bridge] inbound handler failed:", e);
  }
}

async function crBridgeListen() : Promise<void>
{
  if (crBridgeSubscribed){
    return;
  }
  try{
    await api.v1.messaging.onMessage(crBridgeHandleMessage);
    crBridgeSubscribed = true;
  }
  catch (e){
    api.v1.error("[CR:bridge] onMessage registration failed:", e);
  }
}

async function crBridgeConnect() : Promise<void>
{
  if (crBridgeConnecting){
    return;
  }
  crBridgeConnecting = true;
  crBridge.settled = false;
  crBridge.attempts = 0;
  await crBridgeListen();
  if (!crBridgeSubscribed){
    crBridgeConnecting = false;
    crBridge.settled = true;
    await updateBridgeStatusUi();
    return;
  }
  while (!crBridge.ready && crBridge.attempts < CR_BRIDGE_MAX_ATTEMPTS){
    crBridge.attempts++;
    await updateBridgeStatusUi();
    try{
      await api.v1.messaging.broadcast({ type: "HANDSHAKE", sid: api.v1.script.id, payload: { handshake: "NAI_SCRIPT:IN" } });
      await api.v1.messaging.broadcast({ type: "HANDSHAKE", sid: api.v1.script.id, payload: { handshake: "NAI_SCRIPT:OUT" } });
      await crBridgeSend(CR_EVT_HANDSHAKE_REQUEST, {
        scriptId: api.v1.script.id,
        engine: "CR",
        engineName: api.v1.script.name,
        engineVersion: api.v1.script.version
      });
    }
    catch (e){
      api.v1.error("[CR:bridge] handshake attempt", crBridge.attempts, "failed:", e);
    }
    if (crBridge.ready){
      break;
    }
    await api.v1.timers.sleep(CR_BRIDGE_RETRY_MS);
  }
  crBridgeConnecting = false;
  crBridge.settled = true;
  await updateBridgeStatusUi();
}

async function crBridgeProbeSlots(target?: { id: string; name: string }) : Promise<void>
{
  const contact = target || crLiveContact();
  if (!contact || !contact.id){
    return;
  }
  crSlotProbe.asked = contact.id;
  crSlotProbe.askedName = contact.name || contact.id;
  crSlotProbe.answered = false;
  crSlotProbe.timedOut = false;
  crSlotProbe.pending = true;
  crSlotProbe.slots = [];
  await updateBridgeStatusUi();
  await crBridgeSend(CR_EVT_CHAR_IMAGE_ACTION, { charId: contact.id, op: "slots" });
  const askedFor = contact.id;
  try{
    await api.v1.timers.setTimeout(() => {
      if (crSlotProbe.pending && crSlotProbe.asked === askedFor){
        crSlotProbe.pending = false;
        crSlotProbe.timedOut = true;
        updateBridgeStatusUi().catch((e) => { api.v1.error("[CR:bridge] slot timeout repaint failed:", e); });
      }
    }, CR_SLOT_PROBE_TIMEOUT_MS);
  }
  catch (e){
    api.v1.error("[CR:bridge] slot probe timer failed:", e);
  }
}

function crCardImportReceive(payload: any) : void
{
  const ticket = String(payload.ticket || "");
  if (!ticket || ticket !== crCardImport.ticket){
    return;
  }
  const phase = String(payload.phase || "");
  if (phase === "ack"){
    crCardImport.acked = true;
    return;
  }
  if (phase === "commit"){
    crCardImport.ticket = "";
    crCardImport.slots = [];
    if (payload.ok !== true){
      api.v1.ui.toast(String(payload.error || "The bridge could not store the card's images."),
        { type: "warning" });
    }
    return;
  }
  const settle = crCardImport.settle;
  if (!settle){
    return;
  }
  crCardImport.settle = null;
  if (payload.ok !== true){
    if (payload.cancelled === true){
      settle({ kind: "cancelled" });
      return;
    }
    settle({ kind: "error", message: String(payload.error || "The bridge could not read that card.") });
    return;
  }
  const slots: string[] = Array.isArray(payload.slots) ? payload.slots.map((x: any) => String(x)) : [];
  crCardImport.slots = slots;
  settle({ kind: "json", ticket: ticket, json: String(payload.json || ""), slots: slots });
}

async function crCardImportPick() : Promise<CrCardImportPicked>
{
  if (!crBridge.ready){
    return { kind: "noBridge" };
  }
  const ticket = api.v1.uuid();
  let done = false;
  const finish = (picked: CrCardImportPicked, resolve: (p: CrCardImportPicked) => void) => {
    if (done){
      return;
    }
    done = true;
    crCardImport.settle = null;
    resolve(picked);
  };
  return await new Promise<CrCardImportPicked>((resolve) => {
    crCardImport = {
      ticket: ticket,
      acked: false,
      slots: [],
      settle: (picked) => { finish(picked, resolve); }
    };
    crBridgeSend(CR_EVT_CARD_IMPORT, { ticket: ticket, op: "pick" })
      .catch((e) => { api.v1.error("[CR:cardimport] pick send failed:", e); });
    api.v1.timers.setTimeout(() => {
      if (!done && crCardImport.ticket === ticket && !crCardImport.acked){
        crCardImport.ticket = "";
        finish({ kind: "noBridge" }, resolve);
      }
    }, CR_CARD_IMPORT_ACK_MS).catch((e) => { api.v1.error("[CR:cardimport] ack timer failed:", e); });
    api.v1.timers.setTimeout(() => {
      if (!done && crCardImport.ticket === ticket){
        crCardImport.ticket = "";
        finish({ kind: "error", message: "The bridge never answered the file picker." }, resolve);
      }
    }, CR_CARD_IMPORT_RESULT_MS).catch((e) => { api.v1.error("[CR:cardimport] result timer failed:", e); });
  });
}

function crCardImportCommit(ticket: string, charId: string) : void
{
  if (!ticket || !charId){
    return;
  }
  const slots = crCardImport.slots.slice();
  crBridgeSend(CR_EVT_CARD_IMPORT, { ticket: ticket, op: "commit", charId: charId })
    .catch((e) => { api.v1.error("[CR:cardimport] commit send failed:", e); });
  if (slots.length){
    crRememberSlots(charId, slots).catch(() => {});
  }
}

function crCardImportDiscard(ticket: string) : void
{
  if (!ticket){
    return;
  }
  if (crCardImport.ticket === ticket){
    crCardImport.ticket = "";
    crCardImport.slots = [];
    crCardImport.settle = null;
  }
  crBridgeSend(CR_EVT_CARD_IMPORT, { ticket: ticket, op: "discard" })
    .catch((e) => { api.v1.error("[CR:cardimport] discard send failed:", e); });
}

function getBridgeStatusText() : string
{
  if (crBridge.ready){
    let txt = "Connected.";
    if (crBridge.bridgeEngine && crBridge.bridgeEngine !== "CR"){
      txt += ` The bridge thinks it is serving ${crBridge.bridgeEngine}. Do not run Character Engine and CharacterRoom at the same time.`;
    }
    else if (!crBridge.bridgeCrAware){
      txt += " The bridge did not say which engine it is serving, so it is older than 3.0.23. Images will still need the newer one.";
    }
    return txt;
  }
  if (!crBridge.settled){
    return `Connecting… (attempt ${crBridge.attempts} of ${CR_BRIDGE_MAX_ATTEMPTS})`;
  }
  return "Not connected. CharacterRoom works without the bridge; images are the only thing that needs it.";
}

async function updateBridgeStatusUi() : Promise<void>
{
  crTouch();
}

// ============================================================================
// SECTION CR-GALLERY — STORED IMAGES
// ============================================================================
// [KIT-FROM-CE]
const CR_GAL_PAGE = 24;

type CrGalImage = {
  uuid: string;
  prompt: string;
  storyId: string;
  createdAt: number;
  hasBytes: boolean;
};

type CrGalMeta = {
  uuid: string;
  found: boolean;
  prompt: string;
  fu: string;
  chars: any[];
  settings: any;
  createdAt: number;
};

type CrGalState = {
  asked: boolean;
  ready: boolean;
  images: CrGalImage[];
  shown: number;
  note: string;
  openUuid: string;
  meta: CrGalMeta | null;
  metaPending: boolean;
  confirmUuid: string;
  handle: any;
};

let crGal: CrGalState = {
  asked: false, ready: false, images: [], shown: CR_GAL_PAGE, note: "",
  openUuid: "", meta: null, metaPending: false, confirmUuid: "", handle: null
};

async function crGalleryRequest() : Promise<void>
{
  crGal.asked = true;
  if (!crBridge.ready){
    crGal.ready = true;
    crGal.images = [];
    crGal.note = "The bridge is not connected. It holds the images, so there is nothing to list without it.";
    crTouch();
    return;
  }
  crGal.ready = false;
  crGal.note = "";
  crTouch();
  await crBridgeSend(CR_EVT_GALLERY_INDEX_REQ, {});
}

function crGalleryReceive(payload: any) : void
{
  const raw: any[] = (payload && Array.isArray(payload.images)) ? payload.images : [];
  const list: CrGalImage[] = [];
  for (let i = 0; i < raw.length; i++){
    const r: any = raw[i];
    if (!r || !r.uuid){
      continue;
    }
    list.push({
      uuid: String(r.uuid),
      prompt: String(r.prompt || ""),
      storyId: String(r.storyId || ""),
      createdAt: Number(r.createdAt) || 0,
      hasBytes: r.hasBytes !== false
    });
  }
  crGal.images = list;
  crGal.ready = true;
  crGal.note = "";
  crGal.shown = Math.max(CR_GAL_PAGE, Math.min(crGal.shown, list.length));
  crTouch();
}

function crGalMetaReceive(payload: any) : void
{
  const uuid = String((payload && payload.uuid) || "");
  if (!uuid || uuid !== crGal.openUuid){
    return;
  }
  crGal.metaPending = false;
  crGal.meta = {
    uuid: uuid,
    found: payload.found === true,
    prompt: String(payload.prompt || ""),
    fu: String(payload.fu || ""),
    chars: Array.isArray(payload.chars) ? payload.chars : [],
    settings: (payload.settings && typeof payload.settings === "object") ? payload.settings : {},
    createdAt: Number(payload.createdAt) || 0
  };
  crTouch();
}

async function crGalAction(uuid: string, op: string) : Promise<void>
{
  if (!uuid || !crBridge.ready){
    return;
  }
  await crBridgeSend(CR_EVT_GALLERY_ACTION, { uuid: uuid, op: op });
}

async function crGalDelete(uuid: string) : Promise<void>
{
  await crGalAction(uuid, "delete");
  crGal.confirmUuid = "";
  crGal.note = "Deleted. The bridge is sending the list again.";
  if (crGal.openUuid === uuid){
    await crGalCloseSheet();
  }
  crTouch();
}

async function crGalOpen(img: CrGalImage) : Promise<void>
{
  crGal.openUuid = img.uuid;
  crGal.meta = null;
  crGal.confirmUuid = "";
  crGal.metaPending = crBridge.ready;
  crTouch();
  if (crBridge.ready){
    await crBridgeSend(CR_EVT_IMG_META_REQ, { uuid: img.uuid });
  }
  try{
    crGal.handle = await crJsxModal("Stored image", "medium", () => CrGalSheet());
  }
  catch (e){
    api.v1.error("[CR:gallery] sheet failed to open:", e);
  }
}

async function crGalCloseSheet() : Promise<void>
{
  if (crGal.handle){
    try{ await crGal.handle.close(); }
    catch (e){}
    crGal.handle = null;
  }
  crGal.openUuid = "";
  crGal.meta = null;
  crGal.metaPending = false;
  crGal.confirmUuid = "";
  crTouch();
}

function crGalUseAsPrompt(img: CrGalImage) : void
{
  const text = (crGal.meta && crGal.meta.found && crGal.meta.prompt) ? crGal.meta.prompt : img.prompt;
  crIllus.prompt = String(text || "").slice(0, 2000);
  crIllus.note = "Prompt taken from a stored image.";
  crIllus.tab = "compose";
  crGalCloseSheet().catch(() => {});
}

function crGalWhen(ts: number) : string
{
  if (!ts){
    return "";
  }
  try{
    return new Date(ts).toLocaleString();
  }
  catch (e){
    return "";
  }
}

function crGalFindOpen() : CrGalImage | undefined
{
  return crGal.images.find((i) => i.uuid === crGal.openUuid);
}

function CrGalleryPanel(props: { mobile: boolean }) : any
{
  const mob = props.mobile;
  const cells = crGal.images.slice(0, crGal.shown);
  const remaining = crGal.images.length - cells.length;

  let status: string;
  if (!crGal.asked){
    status = "Not asked yet.";
  }
  else if (!crGal.ready){
    status = "Asking the bridge…";
  }
  else if (crGal.note){
    status = crGal.note;
  }
  else {
    status = crGal.images.length === 0
      ? "Nothing stored yet."
      : (crGal.images.length + " stored, showing " + cells.length + ".");
  }

  const tile = (img: CrGalImage) => h(CrPressable, {
    key: img.uuid,
    render: (hover: boolean, press: boolean, handlers: any) => h("button", Object.assign({
      class: "cr-gal-cell",
      title: img.prompt || img.uuid,
      onClick: () => { crGalOpen(img).catch(() => {}); },
      style: {
        appearance: "none", padding: "0", font: "inherit", cursor: "pointer",
        aspectRatio: "1 / 1", borderRadius: CR_RADIUS_S,
        border: CR_LINE_W + " solid " + (hover ? CR_ACCENT : CR_LINE),
        background: crPressBg(hover, press, CR_SUNK),
        overflow: "hidden", position: "relative", display: "grid", placeItems: "end stretch",
        transition: CR_MOTION, touchAction: "manipulation",
        transform: press ? "scale(0.97)" : "none"
      }
    }, handlers),
      crImgAnchor("ce-gallery", img.uuid, "thumb=1,fit=cover,collapse=1",
        { position: "absolute", inset: "0", width: "100%", height: "100%", display: "block" }),
      h("div", {
        style: {
          position: "relative", fontSize: CR_T_XS, padding: "3px 5px",
          color: CR_HEAD, background: CR_FILL2, textAlign: "left",
          whiteSpace: "nowrap", overflow: "hidden", textOverflow: "ellipsis"
        }
      }, img.prompt ? img.prompt : img.uuid.slice(0, 12))
    )
  });

  return h("div", { class: "cr-gallery" },
    h(CrSection, {
      title: "Stored images",
      note: status
    }, h("div", { style: { marginTop: CR_S_3, display: "flex", gap: CR_S_3, flexWrap: "wrap" } },
      h(CrButton, {
        text: crGal.asked && !crGal.ready ? "Refreshing…" : "Refresh",
        disabled: crGal.asked && !crGal.ready,
        onClick: () => { crGalleryRequest().catch(() => {}); }
      })
    )),

    cells.length === 0
      ? h(CrEmpty, { text: crBridge.ready ? "No images in the store." : "The bridge is not connected." })
      : h("div", {
          class: "cr-gal-grid",
          style: {
            display: "grid",
            gridTemplateColumns: "repeat(auto-fill, minmax(" + (mob ? "88px" : "116px") + ", 1fr))",
            gap: mob ? "6px" : "8px", marginBottom: CR_S_4
          }
        }, cells.map(tile)),

    remaining > 0 ? h("div", { style: { display: "flex", gap: CR_S_3, flexWrap: "wrap", marginBottom: CR_S_4 } },
      h(CrButton, {
        text: "Show " + Math.min(CR_GAL_PAGE, remaining) + " more",
        onClick: () => { crGal.shown = cells.length + CR_GAL_PAGE; crTouch(); }
      })
    ) : null
  );
}

function CrGalSheet() : any
{
  const img = crGalFindOpen();
  if (!img){
    return h(CrEmpty, { text: "That image is no longer in the list." });
  }
  const meta = crGal.meta;
  const settings: any = (meta && meta.settings) ? meta.settings : {};
  const w = Number(settings.width) || 0;
  const height = Number(settings.height) || 0;
  const rows: string[] = [];
  if (settings.model){ rows.push("Model: " + String(settings.model)); }
  if (w && height){ rows.push("Size: " + w + " × " + height); }
  if (settings.steps){ rows.push("Steps: " + String(settings.steps)); }
  if (settings.scale){ rows.push("Guidance: " + String(settings.scale)); }
  if (settings.seed !== undefined && settings.seed !== null && String(settings.seed) !== ""){
    rows.push("Seed: " + String(settings.seed));
  }
  const when = crGalWhen(meta ? meta.createdAt : img.createdAt);
  if (when){ rows.push("Made: " + when); }
  if (meta && meta.fu){ rows.push("Negative: " + meta.fu); }

  const chars: any[] = (meta && Array.isArray(meta.chars)) ? meta.chars : [];

  return h("div", { class: "cr-gal-sheet", style: { display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_4 } },
    h("div", {
      style: {
        width: "100%",
        aspectRatio: (w && height) ? (String(w) + " / " + String(height)) : "1 / 1",
        borderRadius: CR_RADIUS_S, border: CR_LINE_W + " solid " + CR_LINE,
        background: CR_SUNK, overflow: "hidden", position: "relative"
      }
    }, crImgAnchor("ce-gallery", img.uuid, "fit=contain,collapse=1",
        { position: "absolute", inset: "0", width: "100%", height: "100%", display: "block" })),

    h(CrSection, {
      title: "Prompt",
      note: crGal.metaPending ? "Reading the record…" : ""
    }, h("div", {
      style: { marginTop: CR_S_3, color: CR_TEXT, fontSize: CR_T_SM, lineHeight: "1.5", wordBreak: "break-word" }
    }, (meta && meta.found && meta.prompt) ? meta.prompt : (img.prompt || "(none recorded)"))),

    rows.length > 0 ? h(CrSection, { title: "Settings" }, h("div", {
      style: { marginTop: CR_S_3, color: CR_DIM, fontSize: CR_T_SM, lineHeight: "1.5", wordBreak: "break-word" }
    }, rows.map((r, i) => h("div", { key: r.slice(0, 12) + i, style: { marginTop: i > 0 ? CR_S_1 : "0" } }, r)))) : null,

    chars.length > 0 ? h(CrSection, {
      title: "Character prompts",
      note: "As they were sent. These are the record's, not any Contact's card."
    }, h("div", {
      style: { marginTop: CR_S_3, color: CR_DIM, fontSize: CR_T_SM, lineHeight: "1.5", wordBreak: "break-word" }
    }, chars.map((c: any, i: number) => h("div", {
      key: String((c && c.name) || i) + i,
      style: { marginTop: i > 0 ? CR_S_1 : "0" }
    }, String((c && c.name) || "character") + ": " + String((c && c.visuals) || ""))))) : null,

    h(CrSection, {
      title: "File",
      note: "Downloads as a PNG with its generation data attached."
    }, h("div", { style: { marginTop: CR_S_3, display: "flex", gap: CR_S_3, flexWrap: "wrap" } },
      h(CrButton, {
        text: "Download",
        disabled: !crBridge.ready,
        onClick: () => { crGalAction(img.uuid, "download").catch(() => {}); }
      }),
      h(CrButton, {
        text: "Use as prompt",
        onClick: () => crGalUseAsPrompt(img)
      }),
      crGal.confirmUuid === img.uuid
        ? h(CrButton, {
            text: "Delete for good",
            primary: true,
            disabled: !crBridge.ready,
            onClick: () => { crGalDelete(img.uuid).catch(() => {}); }
          })
        : h(CrButton, {
            text: "Delete",
            disabled: !crBridge.ready,
            onClick: () => { crGal.confirmUuid = img.uuid; crTouch(); }
          }),
      crGal.confirmUuid === img.uuid
        ? h(CrButton, { text: "Keep it", onClick: () => { crGal.confirmUuid = ""; crTouch(); } })
        : null,
      h(CrButton, { text: "Close", onClick: () => { crGalCloseSheet().catch(() => {}); } })
    ))
  );
}

// ============================================================================
// SECTION CR-STAGE — THE VISUAL-NOVEL READING OF THE CHAT
// ============================================================================

const CR_STAGE_MAX_BEATS = 300;
const CR_STAGE_MAX_FIGURES = 5;

const CR_STAGE_Z_CAST = "2";
const CR_STAGE_Z_BOX = "3";
const CR_STAGE_Z_FIGURE = "1";
const CR_STAGE_Z_SPEAKER = "2";
// A figure with no painted portrait has no ratio to take, so it stands in a portrait box.
const CR_STAGE_FIGURE_AR = "3 / 4";

type CrStageBeat = {
  who: string;
  charId: string;
  text: string;
  emotion: string;
  sectionId: number;
};

type CrStageOpts = {
  bgFit: string;
  bgPos: string;
  figure: number;
  box: number;
  text: number;
  dim: number;
  shrink: number;
  user: boolean;
};

const CR_STAGE_DEFAULT: CrStageOpts = {
  bgFit: "contain", bgPos: "middle", figure: 88, box: 34, text: 15, dim: 55, shrink: 90,
  user: true
};

const CR_STAGE_POS: { [k: string]: boolean } = { top: true, middle: true, bottom: true };

const CR_STAGE_KEY = "cr.stage";
await api.v1.storage.setIfAbsent(CR_STAGE_KEY, CR_STAGE_DEFAULT);

function crNormStageOpts(raw: any) : CrStageOpts
{
  const r = raw || {};
  const num = (v: any, lo: number, hi: number, fb: number) => {
    const n = Math.round(Number(v));
    if (!isFinite(n) || !n){
      return fb;
    }
    return Math.min(hi, Math.max(lo, n));
  };
  return {
    bgFit: r.bgFit === "cover" ? "cover" : CR_STAGE_DEFAULT.bgFit,
    bgPos: CR_STAGE_POS[String(r.bgPos)] ? String(r.bgPos) : CR_STAGE_DEFAULT.bgPos,
    figure: num(r.figure, 30, 100, CR_STAGE_DEFAULT.figure),
    box: num(r.box, 15, 70, CR_STAGE_DEFAULT.box),
    text: num(r.text, 10, 32, CR_STAGE_DEFAULT.text),
    dim: num(r.dim, 10, 100, CR_STAGE_DEFAULT.dim),
    shrink: num(r.shrink, 50, 100, CR_STAGE_DEFAULT.shrink),
    user: r.user !== false
  };
}

let crStageOpts: CrStageOpts = crNormStageOpts(await api.v1.storage.get(CR_STAGE_KEY));

async function crSetStageOpt(field: string, value: any) : Promise<void>
{
  const next: any = crNormStageOpts(crStageOpts);
  next[field] = value;
  crStageOpts = crNormStageOpts(next);
  try{ await api.v1.storage.set(CR_STAGE_KEY, crStageOpts); }
  catch (e){ api.v1.error("[CR:stage] could not store the stage settings:", e); }
  crTouch();
}

function crStageCleanText(raw: string) : string
{
  let s = crChatImgStripIdsText(String(raw || "")).trim();
  if (s.charAt(0) === "{"){
    s = s.slice(1);
    if (s.charAt(s.length - 1) === "}"){
      s = s.slice(0, s.length - 1);
    }
    s = s.trim();
  }
  return s;
}

// [CR-STAGE-BEATS] A beat is a PARAGRAPH and its owner is the segmenter's (D-94), which is
// what makes a continuation paragraph a beat of its own message rather than nothing at all:
// only the first paragraph of a reply carries a `Name:` line, so reading for that prefix
// alone showed one paragraph per message and stepped straight into the next. Ownership
// through crChatSegment also puts a group member's lines under the member (D-89).
function crStageBuildBeats(sections: { sectionId: number; section: Section; index: number }[],
                           char: Character | undefined) : CrStageBeat[]
{
  const beats: CrStageBeat[] = [];
  if (!char || !char.name || !sections || !sections.length){
    return beats;
  }
  const textById: { [id: string]: string } = {};
  for (let i = 0; i < sections.length; i++){
    textById[String(sections[i].sectionId)] = String((sections[i].section && sections[i].section.text) || "");
  }
  const cast = crGroupCast(char);
  const seg = crChatSegment(sections, char);
  for (let m = 0; m < seg.messages.length; m++){
    const msg = seg.messages[m];
    for (let k = 0; k < msg.ids.length; k++){
      const id = msg.ids[k];
      if (id === msg.emotionId){
        continue;
      }
      let text = String(textById[String(id)] || "").trim();
      if (!text){
        continue;
      }
      if (msg.side === "contact"){
        for (let c = 0; c < cast.length; c++){
          const lead = cast[c].name + ":";
          if (text.indexOf(lead) === 0){
            text = text.slice(lead.length).trim();
            break;
          }
        }
      }
      const clean = crStageCleanText(text);
      if (!clean){
        continue;
      }
      beats.push({
        who: msg.side,
        charId: msg.side === "contact" ? msg.charId : "",
        text: clean,
        emotion: msg.emotion,
        sectionId: id
      });
    }
  }
  if (beats.length > CR_STAGE_MAX_BEATS){
    return beats.slice(beats.length - CR_STAGE_MAX_BEATS);
  }
  return beats;
}

// Whose face this is carries forward past everyone else's turns — and past a beat of their
// own that nobody tagged, since a message with no Emotion line is not a blank face.
function crStageEmotionAt(beats: CrStageBeat[], at: number, charId?: string) : string
{
  const want = String(charId || "");
  for (let i = Math.min(at, beats.length - 1); i >= 0; i--){
    if (beats[i].who !== "contact"){
      continue;
    }
    if (want && beats[i].charId !== want){
      continue;
    }
    if (beats[i].emotion){
      return beats[i].emotion;
    }
  }
  return "";
}

let crStageBeats: CrStageBeat[] = [];
let crStageAt = -1;
let crStageBusy = false;
let crStagePanel = false;

async function crStageLoad() : Promise<void>
{
  if (crStageBusy){
    return;
  }
  crStageBusy = true;
  crTouch();
  const char = crLiveContact();
  let sections: { sectionId: number; section: Section; index: number }[] = [];
  try{ sections = await api.v1.document.scan(); }
  catch (e){ sections = []; }
  crStageBeats = crStageBuildBeats(sections, char);
  crStageBusy = false;
  crTouch();
}

function crStageIndex() : number
{
  if (!crStageBeats.length){
    return -1;
  }
  if (crStageAt < 0 || crStageAt >= crStageBeats.length){
    return crStageBeats.length - 1;
  }
  return crStageAt;
}

function crStageStep(delta: number) : void
{
  const at = crStageIndex();
  if (at < 0){
    return;
  }
  const next = Math.min(crStageBeats.length - 1, Math.max(0, at + delta));
  crStageAt = (next === crStageBeats.length - 1) ? -1 : next;
  crTouch();
}

type CrStagePlayer = { id: string; name: string; slot: string; speaking: boolean };

// [CR-STAGE-CAST] Who stands on the stage: the User, the paired Contact, then the group's
// members in roster order. The cap keeps a six-member group from becoming a row of slivers,
// and whoever is speaking is always on it.
function crStageCast(beats: CrStageBeat[], at: number, char: Character, user: User | undefined) : CrStagePlayer[]
{
  const beat = at >= 0 ? beats[at] : null;
  const speakingId = beat
    ? (beat.who === "user" ? (user ? user.id : "") : beat.charId)
    : char.id;
  const people: Character[] = [char];
  const members = crGroupActive() ? crGroupMembers() : [];
  for (let i = 0; i < members.length; i++){
    if (members[i].id !== char.id){
      people.push(members[i]);
    }
  }
  let shown = people.slice(0, CR_STAGE_MAX_FIGURES);
  if (speakingId && !shown.some((p) => p.id === speakingId)){
    const talker = people.find((p) => p.id === speakingId);
    if (talker){
      shown = shown.slice(0, CR_STAGE_MAX_FIGURES - 1).concat([talker]);
    }
  }
  const out: CrStagePlayer[] = [];
  if (crStageOpts.user && user){
    out.push({ id: user.id, name: user.name, slot: CR_SLOT_AVATAR, speaking: speakingId === user.id });
  }
  for (let i = 0; i < shown.length; i++){
    const p = shown[i];
    const slot = crResolveEmotionSlot(crStageEmotionAt(beats, at, p.id), crFilledSlots(p.id)) || CR_SLOT_AVATAR;
    out.push({ id: p.id, name: p.name, slot: slot, speaking: speakingId === p.id });
  }
  return out;
}

// [CR-STAGE-AR] The figure is its OWN aspect host. Every painted image writes --ce-img-ar
// onto the nearest [data-ce-ar-host] ancestor (D-77), so with only the stage carrying the
// attribute a portrait overwrote the backdrop's ratio and the scene box took the AVATAR's
// shape — which is why a figure sprawled past its room and Fill filled the window with a
// face. One host per picture; the stage's own is now the backdrop's alone.
// [CR-STAGE-MARKS] Figures stand on evenly spaced marks and are never scaled to fit each
// other. Nothing here knows how wide a portrait is until the bridge has painted it, so a
// row that tried to fit its cast would have to guess and would resize on every arrival;
// overlap is assumed instead, and the speaker comes to the front on its turn.
function CrStageFigure(props: { id: string; name: string; slot: string; speaking: boolean;
                                height: number; mark: number; edge: string }) : any
{
  const o = crStageOpts;
  const lit = props.speaking;
  return h("div", {
    class: "cr-stage-figure" + (lit ? " cr-stage-figure-on" : ""),
    "data-ce-ar-host": "1",
    style: {
      position: "absolute", bottom: "0",
      // [CR-STAGE-INSIDE] HEIGHT IS THE ONLY THING THAT SIZES A FIGURE. A figure centred on a
      // mark can reach past the stage edge, and clamping its width to the room around the mark
      // fixed that by making the outer figures smaller than the middle one — the picture is
      // `fit=contain`, so a narrowed box shrinks it whole. Position is what has to give
      // instead: the first and last figures are PINNED to the ends of the row, where their own
      // width cannot carry them out of it, and only the figures between them stand on marks.
      // Every one of them keeps the height it was given.
      left: props.edge === "left" ? "0" : (props.edge === "right" ? "auto" : String(props.mark) + "%"),
      right: props.edge === "right" ? "0" : "auto",
      transform: props.edge ? "none" : "translateX(-50%)",
      height: String(props.height) + "%",
      width: "auto", aspectRatio: "var(--ce-img-ar, " + CR_STAGE_FIGURE_AR + ")",
      zIndex: lit ? CR_STAGE_Z_SPEAKER : CR_STAGE_Z_FIGURE,
      filter: lit ? "none" : ("brightness(" + String(o.dim / 100) + ")"),
      transition: "height 180ms ease, filter 180ms ease",
      pointerEvents: "none"
    }
  },
    h("div", {
      style: { position: "absolute", left: "0", right: "0", bottom: "0", display: "flex", justifyContent: "center" }
    },
      h("div", {
        style: {
          padding: "6px 12px", borderRadius: CR_RADIUS_S, border: CR_LINE_W + " solid " + CR_LINE,
          background: CR_FILL2, color: CR_DIM, fontSize: CR_T_SM, whiteSpace: "nowrap"
        }
      }, crInitials(props.name))
    ),
    crImgAnchor(props.id, props.slot, "fit=contain,pos=bottom,collapse=1",
      { position: "absolute", inset: "0", width: "100%", height: "100%", display: "block" })
  );
}

function CrStageSettings() : any
{
  const o = crStageOpts;
  return h("div", {
    class: "cr-stage-settings",
    style: {
      borderBottom: CR_LINE_W + " solid " + CR_LINE, background: CR_SURFACE,
      padding: "12px 14px", maxHeight: "300px", overflowY: "auto"
    }
  },
    h("div", { style: { display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_4 } },
      h(CrChoice, {
        label: "Backdrop fit",
        hint: "The backdrop is the paired Scenario's Banner. Fit shows the whole picture and "
          + "sizes the figures against it; Fill crops the picture to the window and sizes the "
          + "figures against the window.",
        options: [{ id: "contain", label: "Fit the window" }, { id: "cover", label: "Fill the window" }],
        active: o.bgFit === "cover" ? "cover" : "contain",
        onPick: (id: string) => { crSetStageOpt("bgFit", id).catch(() => {}); }
      }),
      h(CrChoice, {
        label: "Backdrop sits",
        hint: o.bgFit === "cover"
          ? "Which end of the picture survives the crop. Only Bottom reaches the painter; the "
            + "other two leave it centred, which is the painter's own default."
          : "Where a picture shorter than the window sits in it. Top or Middle lifts the whole "
            + "scene — figures included — clear of the text panel instead of behind it.",
        options: [{ id: "top", label: "Top" }, { id: "middle", label: "Middle" }, { id: "bottom", label: "Bottom" }],
        active: o.bgPos,
        onPick: (id: string) => { crSetStageOpt("bgPos", id).catch(() => {}); }
      }),
      h(CrChoice, {
        label: "Your figure",
        hint: "Off leaves the Contact alone on the stage, which is what a first-person chat usually wants.",
        options: [{ id: "off", label: "Off" }, { id: "on", label: "On" }],
        active: o.user ? "on" : "off",
        onPick: (id: string) => { crSetStageOpt("user", id === "on").catch(() => {}); }
      }),
      h(CrNumField, {
        label: "Figure height",
        hint: "Percent of the backdrop, 30 to 100. How tall the figures stand. They keep their "
          + "own picture's shape and are never squeezed to fit each other, so a crowded stage overlaps.",
        value: o.figure,
        onSet: (n: number) => { crSetStageOpt("figure", n).catch(() => {}); }
      }),
      h(CrNumField, {
        label: "Text panel height",
        hint: "Percent of the window, 15 to 70.",
        value: o.box,
        onSet: (n: number) => { crSetStageOpt("box", n).catch(() => {}); }
      }),
      h(CrNumField, {
        label: "Dialogue text size",
        hint: "Pixels, 10 to 32.",
        value: o.text,
        onSet: (n: number) => { crSetStageOpt("text", n).catch(() => {}); }
      }),
      h(CrNumField, {
        label: "Non-speaker brightness",
        hint: "Percent, 10 to 100. Lower pushes whoever is not talking into the background.",
        value: o.dim,
        onSet: (n: number) => { crSetStageOpt("dim", n).catch(() => {}); }
      }),
      h(CrNumField, {
        label: "Non-speaker height",
        hint: "Percent of the speaker's, 50 to 100.",
        value: o.shrink,
        onSet: (n: number) => { crSetStageOpt("shrink", n).catch(() => {}); }
      })
    )
  );
}

function CrStageSurface(props: { mobile: boolean }) : any
{
  const o = crStageOpts;
  const char = crLiveContact();
  const user = crLiveUser();
  const scenario = crLiveScenario();

  useEffect(() => {
    crStageLoad().catch(() => {});
  }, []);

  if (!char){
    return h("div", { style: { padding: "16px 18px" } },
      h(CrEmpty, { text: "Pair a Contact on the Chat tab — the Stage reads the story by who is speaking." })
    );
  }

  const beats = crStageBeats;
  const at = crStageIndex();
  const beat = at >= 0 ? beats[at] : null;
  const players = crStageCast(beats, at, char, user);

  const bar = h("div", {
    class: "cr-stage-bar",
    style: {
      display: "flex", alignItems: "center", gap: CR_S_2, flexWrap: "wrap",
      padding: "8px 10px", background: CR_SURFACE, borderBottom: CR_LINE_W + " solid " + CR_LINE
    }
  },
    h(CrButton, { text: "◀", onClick: () => crStageStep(-1), disabled: at <= 0 }),
    h("div", {
      style: { color: CR_DIM, fontSize: CR_T_SM, minWidth: "66px", textAlign: "center" }
    }, beats.length ? (String(at + 1) + " / " + String(beats.length)) : "—"),
    h(CrButton, { text: "▶", onClick: () => crStageStep(1), disabled: at < 0 || at >= beats.length - 1 }),
    h("div", { style: { flex: "1 1 auto", minWidth: "0" } }),
    crStageAt < 0 ? null : h(CrButton, { text: "Latest", onClick: () => { crStageAt = -1; crTouch(); } }),
    h(CrButton, {
      text: crStageBusy ? "Reading…" : "Refresh",
      disabled: crStageBusy,
      onClick: () => { crStageLoad().catch(() => {}); }
    }),
    h(CrButton, {
      text: crStagePanel ? "Done" : "⚙",
      primary: crStagePanel,
      onClick: () => { crStagePanel = !crStagePanel; crTouch(); }
    })
  );

  let speakerName = "";
  if (beat){
    if (beat.who === "user"){
      speakerName = user ? user.name : "You";
    }
    else {
      const owner = players.find((p) => p.id === beat.charId);
      speakerName = owner ? owner.name : char.name;
    }
  }
  const emptyLine = crStageBusy
    ? "Reading the story…"
    : "Nothing in the story yet. Send a message and press Refresh.";

  // [CR-STAGE-FILL] Fill is the WINDOW, and carries no aspect-ratio at all. A covering box at
  // the picture's own ratio is the one thing CSS cannot build from a `W / H` custom property:
  // `min-height: 100%` on a box whose width is already definite raises the height and never
  // widens it back, so the box came out window-shaped regardless while the ratio went on
  // deciding what the figures were measured against — which is why Fill appeared to resize the
  // cast and leave the backdrop alone. Dropping it makes Fill mean what it says and leaves the
  // cropping to the painter's own `fit=cover`. Fit still takes the picture's shape, which is
  // what sizes the figures against the picture rather than the window (D-77).
  const fill = o.bgFit === "cover";
  const sceneStyle: any = fill
    ? { position: "absolute", inset: "0", width: "100%", height: "100%" }
    : {
        position: "absolute", left: "50%", width: "100%",
        aspectRatio: "var(--ce-img-ar, 3 / 2)", maxHeight: "100%",
        top: o.bgPos === "bottom" ? "auto" : (o.bgPos === "top" ? "0" : "50%"),
        bottom: o.bgPos === "bottom" ? "0" : "auto",
        transform: o.bgPos === "middle" ? "translate(-50%, -50%)" : "translateX(-50%)"
      };
  // `pos=bottom` is the only placement the painter is known to take, so the other two send
  // none and leave it centred rather than guessing at a vocabulary that may not exist.
  const bgOpts = "fit=" + (fill ? "cover" : "contain")
    + (o.bgPos === "bottom" ? ",pos=bottom" : "") + ",collapse=1";

  const scene = h("div", { class: "cr-stage-scene", style: sceneStyle },
    scenario ? crImgAnchor(scenario.id, CR_SLOT_BANNER, bgOpts,
      { position: "absolute", inset: "0", width: "100%", height: "100%", display: "block" }) : null,
    h("div", {
      class: "cr-stage-cast",
      style: {
        // Inset, so a pinned figure stands just inside the frame rather than against it.
        position: "absolute", left: "2%", right: "2%", bottom: "0",
        zIndex: CR_STAGE_Z_CAST,
        height: String(o.figure) + "%"
      }
    },
      players.map((p, i) => h(CrStageFigure, {
        key: p.id + "|" + String(i),
        id: p.id, name: p.name, slot: p.slot, speaking: p.speaking,
        height: p.speaking ? 100 : o.shrink,
        edge: players.length < 2 ? "" : (i === 0 ? "left" : (i === players.length - 1 ? "right" : "")),
        mark: players.length < 2 ? 50 : Math.round((i / (players.length - 1)) * 1000) / 10
      }))
    )
  );

  const stage = h("div", {
    class: "cr-stage",
    "data-ce-ar-host": "1",
    style: {
      position: "relative", width: "100%", height: "100%", minHeight: "260px",
      overflow: "hidden", background: CR_STAGE_BG
    }
  },
    scene,
    h("div", {
      class: "cr-stage-box",
      style: {
        position: "absolute", left: "0", right: "0", bottom: "0",
        zIndex: CR_STAGE_Z_BOX,
        height: String(o.box) + "%", minHeight: String(90 + o.text) + "px",
        boxSizing: "border-box", display: "flex", flexDirection: "column",
        padding: props.mobile ? "40px 14px 14px 14px" : "52px 10% 18px 10%",
        background: CR_STAGE_SCRIM
      }
    },
      speakerName ? h("div", {
        style: {
          color: CR_ACCENT, fontWeight: "700", letterSpacing: "0.02em",
          fontSize: String(o.text + 1) + "px", marginBottom: CR_S_2
        }
      }, speakerName) : null,
      h("div", {
        style: {
          flex: "1 1 auto", minHeight: "0", overflowY: "auto",
          color: beat ? CR_STAGE_TEXT : CR_DIM, fontSize: String(o.text) + "px",
          lineHeight: "1.55", whiteSpace: "pre-wrap"
        }
      }, beat ? (beat.text || "…") : emptyLine)
    )
  );

  return h("div", {
    style: { display: "grid", gridTemplateRows: "auto minmax(0,1fr)", height: "100%", minHeight: "0" }
  },
    h("div", { class: "cr-stage-chrome", style: { minWidth: "0" } },
      bar,
      crStagePanel ? h(CrStageSettings, null) : null
    ),
    stage
  );
}

