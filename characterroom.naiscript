        ),
        h(CrNote, { text: crGlobalNote })
      )
    ),
    h(CrSection, {
      title: "Editor portraits",
      note: "The portraits the bridge paints beside each of their turns. Size is yours to set — as big or as small as you like."
    }, h(CrEditorOptsPanel, null)),
    h(CrSection, {
      title: "Emotional modes",
      note: "Nine moods the Contact can fall into, triggered by a run of recent emotions or by time away. Off is AnotherRoom's own default."
    },
      h("div", { style: { marginTop: CR_S_3 } },
        h(CrChoice, {
          options: [{ id: "off", label: "Off" }, { id: "on", label: "On" }],
          active: crUseEmotionalModes ? "on" : "off",
          onPick: (id: string) => { crSetUseEmotionalModes(id === "on").catch(() => {}); }
        })
      )
    )
  );
