function crkFormatField(name: string, value: string): string {
  const lines = value.trim().split('\n');
  let result = name + ': ' + lines[0] + '\n';
  for (let i = 1; i < lines.length; i++) {
    result += '    ' + lines[i] + '\n';
  }
  return result;
}

function crkReplaceMacros(text: string, charName: string, userName: string, nowMs: number): string {
  var now = new Date(nowMs);
  var year = String(now.getFullYear());
  var month = String(now.getMonth() + 1);
  if (month.length < 2) month = '0' + month;
  var day = String(now.getDate());
  if (day.length < 2) day = '0' + day;
  var dateStr = year + '-' + month + '-' + day;
  var hours = now.getHours();
  var ampm = hours >= 12 ? 'PM' : 'AM';
  var h = hours % 12;
  if (h === 0) h = 12;
  var hStr = String(h);
  if (hStr.length < 2) hStr = '0' + hStr;
  var mins = String(now.getMinutes());
  if (mins.length < 2) mins = '0' + mins;
  var timeStr = hStr + ':' + mins + ' ' + ampm;
  var h24 = String(hours);
  if (h24.length < 2) h24 = '0' + h24;
  var time24Str = h24 + ':' + mins;
  return text
    .replace(/\{\{char\}\}/gi, charName)
    .replace(/\{\{user\}\}/gi, userName)
    .replace(/\{\{date\}\}/gi, dateStr)
    .replace(/\{\{time24\}\}/gi, time24Str)
    .replace(/\{\{time\}\}/gi, timeStr)
    .replace(/\$c(?:ontact)?(?=\s|$|[.,!?;:\-'")])/gi, charName)
    .replace(/\$u(?:ser)?(?=\s|$|[.,!?;:\-'")])/gi, userName);
}

function crkBuildSystemPrompt(ctx: CrkCtx, includeGameStats: boolean): string {
  let character = ctx.char;
  let user = ctx.user;
  let scenario = ctx.scenario;
  
  if (!character || !user) return 'AetherRoom';
  
  let prompt = 'AetherRoom\n----\n';
  
  prompt += character.name + '\n';
  prompt += 'Type: contact\n';
  if (character.gender && character.gender.trim()) prompt += crkFormatField('Gender', character.gender);
  if (character.pronouns && character.pronouns.trim()) prompt += crkFormatField('Pronouns', character.pronouns);
  if (character.species && character.species.trim()) prompt += crkFormatField('Species', character.species);
  if (character.persona && character.persona.trim()) prompt += crkFormatField('Personality', character.persona);
  if (character.appearance && character.appearance.trim()) prompt += crkFormatField('Appearance', character.appearance);
  
  if (ctx.chat.intimacy === 'stranger') {
    prompt += 'Opinion of ' + user.name + ': Doesn\'t know ' + user.name + '.\n';
  } else {
    prompt += 'Relationship: ' + ctx.chat.intimacy + '\n';
  }
  
  if (character.tags && character.tags.trim()) prompt += 'Categories: ' + character.tags.trim() + '\n';
  
  if (character.exampleChats.length > 0) {
    prompt += 'Example quotes:\n';
    for (let ecIdx = 0; ecIdx < character.exampleChats.length; ecIdx++) {
      const ec = character.exampleChats[ecIdx];
      prompt += (ecIdx + 1) + '.\n';
      for (let msgIdx = 0; msgIdx < ec.messages.length; msgIdx++) {
        const msg = ec.messages[msgIdx];
        const senderName = msg.isContact ? character.name : ec.userName;
        const lines = msg.text.split('\n');
        prompt += '\u2002' + senderName + ': ' + lines[0] + '\n';
        for (let li = 1; li < lines.length; li++) {
          prompt += '\u2002    ' + lines[li] + '\n';
        }
        if (msg.isContact && msg.emotion) {
          prompt += '\u2002  Emotion: ' + msg.emotion + '\n';
        }
      }
    }
  }
  
  prompt += '----\n';
  prompt += user.name + '\n';
  prompt += 'Type: user\n';
  if (user.gender && user.gender.trim()) prompt += crkFormatField('Gender', user.gender);
  if (user.pronouns && user.pronouns.trim()) prompt += crkFormatField('Pronouns', user.pronouns);
  if (user.species && user.species.trim()) prompt += crkFormatField('Species', user.species);
  if (user.persona && user.persona.trim()) prompt += crkFormatField('Personality', user.persona);
  if (user.appearance && user.appearance.trim()) prompt += crkFormatField('Appearance', user.appearance);
  if (user.tags && user.tags.trim()) prompt += 'Categories: ' + user.tags.trim() + '\n';
  
  function macros(text: string): string {
    return crkReplaceMacros(text, character!.name, user!.name, ctx.nowMs);
  }

  const hasScenarioContent = (scenario && scenario.environment && scenario.environment.trim()) ||
    (scenario && scenario.scene && scenario.scene.trim()) ||
    (ctx.chat.tags && ctx.chat.tags.trim());
  if (hasScenarioContent) {
    prompt += '----\n';
    if (scenario && scenario.environment && scenario.environment.trim()) {
      prompt += crkFormatField('Environment', scenario.environment);
    }
    if (scenario && scenario.scene && scenario.scene.trim()) {
      prompt += crkFormatField('Scene', scenario.scene);
    }
    let scenarioTagsList: string[] = [];
    if (scenario && scenario.tags) {
      scenarioTagsList.push(...scenario.tags.split(","));
    }
    if (ctx.chat.tags) {
      scenarioTagsList.push(...ctx.chat.tags.split(","));
    }
    if (scenarioTagsList.length > 0){
      const trimmed = scenarioTagsList.map((str) => str.trim());
      const deDuplicated: string[] = [...new Set(trimmed)];
      prompt += 'Tags: ' + deDuplicated.join(", ") + '\n';
    }
  }
  
  const allBrains: any[] = [];
  if (character.brains) {
    for (let bi = 0; bi < character.brains.length; bi++) allBrains.push(character.brains[bi]);
  }
  if (user.brains) {
    for (let bi = 0; bi < user.brains.length; bi++) allBrains.push(user.brains[bi]);
  }
  if (scenario && scenario.brains) {
    for (let bi = 0; bi < scenario.brains.length; bi++) allBrains.push(scenario.brains[bi]);
  }
  if (includeGameStats){
    const gameBrain: any = {
      name: "Game History",
      content: ""
    };
    let statsList: string[] = [];
    const combinedId = ctx.char!.id + ctx.user!.id;
    for (const gameType of Object.keys(ctx.gameRecord)){
      const gt = gameType;
      if (ctx.gameRecord[gt][combinedId]){
        if (ctx.gameRecord[gt][combinedId].kind == "competitive"){
          const gInstance = ctx.gameRecord[gt][combinedId] as any;
          const statsStr = `${gInstance.displayLabel}:\n${ctx.char!.name}: ${gInstance.charWins} wins, ${gInstance.charLosses} losses\n${ctx.user!.name}: ${gInstance.userWins} wins, ${gInstance.userLosses} losses\nShared: ${gInstance.ties} ties`;
          statsList.push(statsStr);
        }
        else if (ctx.gameRecord[gt][combinedId].kind == "cooperative"){
          const gInstance = ctx.gameRecord[gt][combinedId] as any;
          const winsAsNumList = gInstance.sharedWins.join(", ");
          const statsStr = `${gInstance.displayLabel}:\nShared wins: ${gInstance.sharedWins.length.toString()}\nTurns taken to complete: ${winsAsNumList}`;
          statsList.push(statsStr);
        }
        else{
          const gInstance = ctx.gameRecord[gt][combinedId] as any;
          const statsStr = `${gInstance.displayLabel}:\n${ctx.char!.name}: ${gInstance.charWins} wins, ${gInstance.charLosses} losses\n${ctx.user!.name}: ${gInstance.userWins} wins, ${gInstance.userLosses} losses\nShared: ${gInstance.ties} ties`;
          statsList.push(statsStr);
        }
      }
    }
    if (statsList.length > 0){
      gameBrain.content = statsList.join("\n");
    }
    if (gameBrain.content !== ""){
      allBrains.push(gameBrain);
    }
  }
  for (let bi = 0; bi < allBrains.length; bi++) {
    prompt += '----\n' + allBrains[bi].name + '\n' + allBrains[bi].content.trim() + '\n';
  }

  return macros(prompt);
}

function crkBrainEntries(model: string, storyTextContent: string, ctx: CrkCtx): { temporaryLorebookEntries: CrkTempLb[] } | null {
  if (model === "xialong-v1"){
    if (ctx.char && ctx.user){    
      type TempLb = {
        id?: string
        name: string
        content: string
        active?: boolean
        appearWithPermanent?: boolean
      };
      let tempLbList: TempLb[] = [];

      for (const brain of (ctx.floaty || [])){
        if (brain.entry.name !== "" && brain.entry.content !== ""){
          const macroProcessed = crkReplaceMacros(brain.entry.content, ctx.char.name, ctx.user.name, ctx.nowMs);
          tempLbList.push(
            {
              id: brain.id,
              name: brain.entry.name,
              content: `----\n${brain.entry.name}\n${macroProcessed}`,
              active: brain.active,
              appearWithPermanent: false
            }
          );
        }
      }

      const combinedId = ctx.char.id + ctx.user.id;

      if (ctx.jots && ctx.jots.length > 0){
        let factList: string[] = [];
        for (const entry of ctx.jots){
          if (entry.text){
            const macroProcessed = crkReplaceMacros(entry.text, ctx.char.name, ctx.user.name, ctx.nowMs);
            factList.push(`- ${macroProcessed}`);
          }
        }
        if (factList.length > 0){
          const cName = ctx.char.name;
          const uName = ctx.user.name;
          tempLbList.push(
            {
              name: CRK_JOTS_NAME,
              content: `----\nFacts About ${uName}\n${cName} knows the following about ${uName} and feels comfortable referencing this information in interactions.\n${factList.join("\n")}`,
              active: true,
              appearWithPermanent: false
            }
          );
        }
      }

      const diaryFound: boolean = crkHasList(ctx.diary);
      const emotionalMemoryFound: boolean = crkHasList(ctx.process);
      const conditionalBrainFound: boolean = crkHasList(ctx.char.brainsConditional);

      if (diaryFound || emotionalMemoryFound || conditionalBrainFound){
        const maxLookback = 1000;

        const cleanWord = (word: string): string =>
        word.replace(/^[^a-zA-Z0-9]+|[^a-zA-Z0-9]+$/g, '');

        const wordListCleaned: string[] = storyTextContent
          .split(/\s+/)
          .map(w => cleanWord(w))
          .filter(w => w.length > 0);

        const wordListReversed: string[] = wordListCleaned.reverse();
        const wordCount = wordListReversed.length;
        if (wordCount > maxLookback){
          wordListReversed.length = maxLookback;
        }
        const wordListForward = wordListReversed.reverse();

        let maxPhraseLength = 0;

        if (diaryFound){
          for (const brain of ctx.diary!){
            for (const key of brain.keys){
              const wordCount = key.trim().split(/\s+/).length;
              if (wordCount > maxPhraseLength){
                maxPhraseLength = wordCount;
              }
            }
          }
        }

        if (emotionalMemoryFound){
          for (const brain of ctx.process!){
            for (const key of brain.keys){
              const wordCount = key.trim().split(/\s+/).length;
              if (wordCount > maxPhraseLength){
                maxPhraseLength = wordCount;
              }
            }
          }
        }

        if (conditionalBrainFound){
          for (const brain of ctx.char.brainsConditional){
            for (const key of brain.keys){
              const wordCount = key.trim().split(/\s+/).length;
              if (wordCount > maxPhraseLength){
                maxPhraseLength = wordCount;
              }
            }
          }
        }

        const phraseSet = new Set<string>();
        for (let n = 1; n <= maxPhraseLength; n++) {
          for (let i = 0; i <= wordListForward.length - n; i++) {
            const phrase = wordListForward.slice(i, i + n).join(' ');
            phraseSet.add(phrase);
          }
        }

        if (diaryFound){
          for (const brain of ctx.diary!){
            const normalizedKeys = brain.keys.map((key: string) =>
              key.trim().split(/\s+/).join(' ')
            );
            if (normalizedKeys.some((key: string) => phraseSet.has(key))) {
              tempLbList.push(
                {
                  name: brain.name,
                  content: `----\n${brain.name}\nType: diary entry\n${brain.content}`,
                  active: true,
                  appearWithPermanent: false
                }
              );
            }
          }
        }
        if (emotionalMemoryFound){
          for (const brain of ctx.process!){
            const normalizedKeys = brain.keys.map((key: string) =>
              key.trim().split(/\s+/).join(' ')
            );
            if (normalizedKeys.some((key: string) => phraseSet.has(key))) {
              tempLbList.push(
                {
                  name: brain.name,
                  content: `----\n${brain.name}\nType: emotional memory\n${brain.content}`,
                  active: true,
                  appearWithPermanent: false
                }
              );
            }
          }
        }
        if (conditionalBrainFound){
          for (const brain of ctx.char.brainsConditional){
            if (brain.requiredIntimacy !== "none" && brain.requiredIntimacy !== ctx.chat.intimacy){
              continue;
            }
            const normalizedKeys = brain.keys.map((key: string) =>
              key.trim().split(/\s+/).join(' ')
            );
            if (normalizedKeys.some((key: string) => phraseSet.has(key))) {
              const macroProcessed = crkReplaceMacros(brain.content, ctx.char.name, ctx.user.name, ctx.nowMs);
              tempLbList.push(
                {
                  name: brain.name,
                  content: `----\n${brain.name}\n${macroProcessed}`,
                  active: true,
                  appearWithPermanent: false
                }
              );
            }
          }
        }
      }

      return { temporaryLorebookEntries: tempLbList };
    }
  }
  return null;
}

async function crkContextBuilt(messages: any[], model: string, dryRun: boolean, ctx: CrkCtx, deps: CrkDeps, roll: CrkRoll): Promise<CrkBuiltResult> {
  let plans: any[] | undefined = ctx.plans;
  let planSave = false;
  if (model === "xialong-v1"){
    const character = ctx.char;
    const user = ctx.user;
    if (character && user)
    {
      function stableMessageId(msg: CrkMessage){
        const str = msg.role + "\x00" + (msg.content || "");
        let hash = 5381;
        for (let i = 0; i < str.length; i++){
          hash = ((hash << 5) + hash) + str.charCodeAt(i);
          hash |= 0;
        }
        return 'id_' + hash.toString(36);
      }

      let attempts = 0;
      const MAX_ATTEMPTS = 2;

      while (attempts < MAX_ATTEMPTS)
      {
        attempts++;

        let prefixValid = true;
        if (roll.startIndex > 0){
          const checkLen = Math.min(roll.startIndex, messages.length);
          for (let i = 0; i < checkLen; i++){
            const msgId = stableMessageId(messages[i]);
            if (i >= roll.pathIdList.length || roll.pathIdList[i] !== msgId){
              prefixValid = false;
              break;
            }
          }
        }
        if (!prefixValid){
          crkRollReset(roll);
          continue;
        }

        const currentXialongSysPrompt = await deps.naiSystemPrompt();

        const includeGameStats = ctx.includeGameStats;
        const systemPrompt = crkBuildSystemPrompt(ctx, includeGameStats);

        let historyMsgList: CrkMessage[] = [];
        let historyMeta = [];

        let userMsgCount = 0;
        let assistantMsgCount = 0;
        let totalHistoryTokens = 0;
        let brainTokens = 0;

        for (let i = roll.startIndex; i < messages.length; i++){
          const msg = messages[i];
          if (msg.role === "system" && msg.content === currentXialongSysPrompt){
            continue;
          }

          let newMsg: CrkMessage = { role: msg.role, content: msg.content || "" };

          if (newMsg.role === "user") {
            if (newMsg.content!.endsWith("Write.") || newMsg.content!.endsWith("Continue.")) {
              continue;
            }
            else{
              if (newMsg.content != undefined && newMsg.content != ""){
                if (!newMsg.content.startsWith(`${user.name}:`)){
                  newMsg.content = user.name + ": " + newMsg.content;
                }
                newMsg.content = newMsg.content.replaceAll("\n", "\n    ");
                userMsgCount++;
              }
            }
          }
          else if (newMsg.role === "assistant"){
            if (newMsg.content!.endsWith("***\n")) {
              newMsg.content = newMsg.content!.substring(0, newMsg.content!.length - "***\n".length);
            }
            else{
              if (newMsg.content != undefined && newMsg.content != ""){
                assistantMsgCount++;
              }
            }
          }

          let isBrain = false;
          if (msg.role === "system" && msg.content!.startsWith("----")){
            isBrain = true;
          }

          if (isBrain){
            const tokens = await deps.encode(newMsg.content!, model);
            brainTokens += tokens.length;
          }
          else{
            const tokens = await deps.encode(newMsg.content || "", model);
            totalHistoryTokens += tokens.length;
          }

          historyMsgList.push(newMsg);
          historyMeta.push(isBrain ? null : i);
        }

        let isGreeting = false;
        if (assistantMsgCount === 0 && userMsgCount === 0){
          isGreeting = true;
        }

        const systemTokens = await deps.encode(systemPrompt, model);
        let softLimit = 8192;
        try {
          softLimit = await deps.maxTokens(model);
        }catch(e){
          deps.log(e);
        }
        let rolloverDelta = 0;
        try {
          rolloverDelta = await deps.rolloverTokens(model);
        }catch(e){
          deps.log(e);
        }
        const hardLimit = softLimit + rolloverDelta;
        const reservedTokens = 2200;

        const hardBudget = hardLimit - systemTokens.length - reservedTokens - brainTokens;
        const softBudget = softLimit - systemTokens.length - reservedTokens - brainTokens;

        const lowerLimit = softLimit - rolloverDelta;
        if (systemTokens.length + totalHistoryTokens + brainTokens < lowerLimit && roll.startIndex > 0){
          crkRollReset(roll);
          continue;
        }

        if (totalHistoryTokens > hardBudget || (totalHistoryTokens > softBudget && roll.checkInitialTrim)){
          while (totalHistoryTokens > softBudget && historyMsgList.length > 0){
            let removeIdx = -1;
            for (let i = 0; i < historyMsgList.length; i++) {
              if (historyMeta[i] !== null) {
                removeIdx = i;
                break;
              }
            }
            if (removeIdx === -1) break;

            const removedMeta = historyMeta[removeIdx];
            const removedMsg = historyMsgList[removeIdx];
            if (removedMeta !== null){
              const tokens = await deps.encode(removedMsg.content || "", model);
              totalHistoryTokens -= tokens.length;
              roll.startIndex = Math.max(roll.startIndex, removedMeta + 1);
            }
            historyMsgList.splice(removeIdx, 1);
            historyMeta.splice(removeIdx, 1);
          }
          roll.trimmed = true;
        }

        roll.pathIdList = messages.map(m => stableMessageId(m));

        let finalMsgList: CrkMessage[] = [{ role: "system", content: systemPrompt }];
        
        if (!roll.trimmed && roll.startIndex === 0) {
          finalMsgList.push({ role: "system", content: "Start of chat." });
        }

        for (const msg of historyMsgList){
          finalMsgList.push(msg);
        }

        const lastAssistLocation = finalMsgList.findLastIndex(msg => msg.role === "assistant");

        let styleMsg = '[ Style: ' + ctx.chat.style;
        if (isGreeting) styleMsg += ', greeting';
        styleMsg += ' ]';

        if (ctx.chat.responseLength != "unspecified") {
          styleMsg = '[ Style: ' + ctx.chat.style + (isGreeting ? ', greeting' : '') + '; Response length: ' + ctx.chat.responseLength + ' ]';
        }

        if (character.cjk) {
          styleMsg = styleMsg.slice(0, -2) + '; CJK ]';
        }

        const combinedId = character.id + user.id;

        if (lastAssistLocation != -1){
          finalMsgList.splice(lastAssistLocation, 0, { role: 'system', content: styleMsg });
          
          let nearEndSystemMsgStrAsList: string[] = [];

          let significantTimeApart = false;

          const trackRealTime = ctx.trackRealTime;
          if (trackRealTime === true){
            if (ctx.lastContactMs && ctx.lastContactMs > 0){
              const currentTime = ctx.nowMs;
              const differenceInMilliseconds = Math.abs(currentTime - ctx.lastContactMs);
              const differenceInHours = differenceInMilliseconds / (1000 * 60 * 60);
              const wholeHours = Math.floor(differenceInHours);
              if (wholeHours > 0){
                let hoursStr = "";
                if (wholeHours === 1){
                  hoursStr = `${wholeHours} hour`;
                }
                else{
                  hoursStr = `${wholeHours} hours`;
                }
                nearEndSystemMsgStrAsList.push(`----\nTime Apart\nIt's been ${hoursStr} since ${character.name} last messaged ${user.name}.`);
                significantTimeApart = true;
              }
            }

            if (character.schedule){
              let eventTextList: string[] = [];
              
              const JS_DAY_LIST: string[] = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"] as const;

              const date = new Date(ctx.nowMs);
              const dayStr = JS_DAY_LIST[date.getDay()] as string;
              const minutes = (date.getHours() * 60) + date.getMinutes();

              function addActiveEvents(eventList: any[])
              {
                for (const evt of eventList){
                  if (evt.requiredIntimacy !== "none" && ctx.chat.intimacy !== evt.requiredIntimacy){
                    continue;
                  }
                  if (evt.startTime <= evt.endTime){
                    if (minutes >= evt.startTime && minutes <= evt.endTime){
                      const text = crkReplaceMacros(evt.text, character!.name, user!.name, ctx.nowMs);
                      eventTextList.push(`- Time Range: ${crkFormatTime(evt.startTime)} - ${crkFormatTime(evt.endTime)}, Event: ${text}`);
                    }
                  }
                  else{
                    if (minutes >= evt.startTime || minutes <= evt.endTime){
                      const text = crkReplaceMacros(evt.text, character!.name, user!.name, ctx.nowMs);
                      eventTextList.push(`- Time Range: ${crkFormatTime(evt.startTime)} - ${crkFormatTime(evt.endTime)}, Event: ${text}`);
                    }
                  }
                }
              }

              if (character.schedule[dayStr].length > 0){
                addActiveEvents(character.schedule[dayStr]);
              }
              if (character.schedule["Daily"].length > 0){
                addActiveEvents(character.schedule["Daily"]);
              }
              
              if (eventTextList.length > 0){
                nearEndSystemMsgStrAsList.push(`----\nCurrent Events\nToday is ${dayStr} at ${crkFormatTime(minutes)} (24-hour clock). Current scheduled events for ${character.name}:\n${eventTextList.join("\n")}\nAn event can be something ${character.name} is currently doing or planning to do during this time.`);
              }
            }
          }

          function allEmotionsMatch(emotionList: string[], mode: string) : boolean
          {
            return emotionList.every((str) => CRK_EMOTIONAL_MODE_ATTR[mode].triggers.has(str));
          }

          const useEmotionalModes = ctx.useEmotionalModes;
          if (useEmotionalModes === true){
            if (significantTimeApart){

              const modePromptAwayPre = `----\n${character.name}'s Mood\nWhile away from the chat, ${character.name} experienced emotions that put them in the following state of mind.`;

              const randModeIndex = deps.rngInt(0, CRK_EMOTIONAL_MODE_LIST.length - 1);
              const mode = CRK_EMOTIONAL_MODE_LIST[randModeIndex];
              nearEndSystemMsgStrAsList.push(`${modePromptAwayPre}\n${mode}: ${CRK_EMOTIONAL_MODE_ATTR[mode].prompt}`);
            }
            else{
              const modePromptPre = `----\n${character.name}'s Mood\n${character.name}'s recent emotions have put them in the following state of mind.`;

              const mostRecentEmotions: string[] = await deps.recentEmotions(3);
              let matchedModesList: string[] = [];
              for (const mode of CRK_EMOTIONAL_MODE_LIST){
                const allMatch = allEmotionsMatch(mostRecentEmotions, mode);
                if (allMatch){
                  matchedModesList.push(mode);
                }
              }
              if (matchedModesList.length > 1){
                const randMatchedModeIndex = deps.rngInt(0, matchedModesList.length - 1);
                const mode = matchedModesList[randMatchedModeIndex];
                nearEndSystemMsgStrAsList.push(`${modePromptPre}\n${mode}: ${CRK_EMOTIONAL_MODE_ATTR[mode].prompt}`);
              }
              else if (matchedModesList.length === 1){
                const mode = matchedModesList[0];
                nearEndSystemMsgStrAsList.push(`${modePromptPre}\n${mode}: ${CRK_EMOTIONAL_MODE_ATTR[mode].prompt}`);
              }
            }
          }

          if (nearEndSystemMsgStrAsList.length > 0){
            finalMsgList.splice(
              lastAssistLocation, 0, { role: 'system', content: nearEndSystemMsgStrAsList.join("\n") }
            );
          }
        }

        function getValidPlanIndices()
        {
          let indicesLimited: number[] = [];
          let indicesOngoing: number[] = [];
          if (!plans){
            return { limited: indicesLimited, ongoing: indicesOngoing };
          }
          if (plans!.length === 0){
            return { limited: indicesLimited, ongoing: indicesOngoing };
          }
          for (let i = 0; i < plans!.length; i++){
            if (plans![i].content){
              if ((!plans![i].planType || plans![i].planType === "AI") && plans![i].remainingTurns >= 0){
                if (!plans![i].durationType || plans![i].durationType === "Limited"){
                  indicesLimited.push(i);
                }
                else if (plans![i].durationType === "Ongoing"){
                  indicesOngoing.push(i);
                }
              }
              else if (plans![i].planType === "User" && plans![i].remainingTurns > 0){
                if (!plans![i].durationType || plans![i].durationType === "Limited"){
                  indicesLimited.push(i);
                }
                else if (plans![i].durationType === "Ongoing"){
                  indicesOngoing.push(i);
                }
              }
            }
          }
          return { limited: indicesLimited, ongoing: indicesOngoing };
        }

        const validPlanIndices = getValidPlanIndices();

        let randPlanIndexLimited = -1;
        let randPlanIndexOngoing = -1;
        let planInjectionStrList: string[] = [];

        if (validPlanIndices.ongoing.length > 0){
          const randValidIndex = deps.rngInt(0, validPlanIndices.ongoing.length - 1);
          randPlanIndexOngoing = validPlanIndices.ongoing[randValidIndex];
          planInjectionStrList.push(plans![randPlanIndexOngoing].content);
        }

        if (validPlanIndices.limited.length > 0){
          const randValidIndex = deps.rngInt(0, validPlanIndices.limited.length - 1);
          randPlanIndexLimited = validPlanIndices.limited[randValidIndex];
          planInjectionStrList.push(plans![randPlanIndexLimited].content);
        }

        if (planInjectionStrList.length > 0){
          const currentLastAssist = finalMsgList.findLastIndex(msg => msg.role === "assistant");
          finalMsgList[currentLastAssist].content = `<think>${planInjectionStrList.join("\n")}</think>\n` + finalMsgList[currentLastAssist].content;
        }

        if (!dryRun){
          if (validPlanIndices.limited.length > 0){
            const i = randPlanIndexLimited;
            if (!plans![i].running){
              plans![i].running = true;
              plans![i].startedAtCount = userMsgCount;
            }
            else{
              if (userMsgCount < plans![i].startedAtCount){
                plans![i].remainingTurns = 0;
              }
              else{
                const turnsPassed = userMsgCount - plans![i].startedAtCount;
                plans![i].remainingTurns = plans![i].totalTurns - turnsPassed;
              }
            }
          }
          if (planInjectionStrList.length > 0){
            const filtered = plans!.filter(plan => (plan.remainingTurns > 0 && (plan.planType === undefined || plan.planType === "AI")) || (plan.planType && plan.planType === "User"));
            plans = filtered;
            planSave = true;
          }
        }

        return { messages: finalMsgList, plans: plans, planSave: planSave };
      }
    }
  }
  return { messages: null, plans: plans, planSave: planSave };
}

function crkRecentEmotionsFromSections(sections: any[], totalToFind: number): string[] {
  let emotionList = [];
  let foundCount = 0;
  const reversed = (sections || []).slice().reverse();
  for (const section of reversed){
    const matchEmotion = section.section.text.match(/(?<=\s\sEmotion:\s)(\b\w+)/g);
    if (matchEmotion){
      emotionList.push(matchEmotion[0]);
      foundCount++;
      if (foundCount >= totalToFind){
        break;
      }
    }
  }
  if (emotionList.length === 0){
    emotionList.push("neutral");
  }
  return emotionList;
}

// ============================================================================
// SECTION CR-CLOCK — THE CHAT CLOCK
// ============================================================================

type CrClockMode = "real" | "story";

const CR_CLOCK_MODE_KEY = "cr.clockMode";
const CR_CLOCK_STEP_KEY = "cr.clockStep";
const CR_CLOCK_NOW_KEY = "cr.clock";

const CR_MIN_MS = 60000;
const CR_DAY_MIN = 1440;
const CR_MORNING_MIN = 480;
const CR_JS_DAY_LIST: string[] = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
const CR_CLOCK_STEP_LIST: number[] = [0, 5, 15, 30, 60];

let crClock: { mode: CrClockMode; storyMs: number; stepMin: number; trackReal: boolean } = {
  mode: "real", storyMs: 0, stepMin: 0, trackReal: false
};

async function crClockLoad() : Promise<void>
{
  try{
    const mode = await api.v1.storyStorage.get(CR_CLOCK_MODE_KEY);
    crClock.mode = (mode === "story") ? "story" : "real";
  }
  catch (e){ crClock.mode = "real"; }
  try{
    const step = await api.v1.storyStorage.get(CR_CLOCK_STEP_KEY);
    crClock.stepMin = (typeof step === "number" && isFinite(step) && step > 0) ? Math.floor(step) : 0;
  }
  catch (e){ crClock.stepMin = 0; }
  try{
    const ms = await api.v1.historyStorage.get(CR_CLOCK_NOW_KEY);
    crClock.storyMs = (typeof ms === "number" && isFinite(ms) && ms > 0) ? Math.floor(ms) : 0;
  }
  catch (e){ crClock.storyMs = 0; }
  try{
    crClock.trackReal = (await api.v1.storyStorage.get(TRACK_REAL_TIME_KEY)) === true;
  }
  catch (e){ crClock.trackReal = false; }
}

function crClockActive() : boolean
{
  return crClock.mode === "story" && crClock.storyMs > 0;
}

function crClockNow() : number
{
  return crClockActive() ? crClock.storyMs : Date.now();
}

function crClockRoundHalf(ms: number) : number
{
  const d = new Date(ms);
  d.setSeconds(0, 0);
  d.setMinutes(d.getMinutes() < 30 ? 0 : 30);
  return d.getTime();
}

async function crClockWrite(ms: number) : Promise<void>
{
  const v = Math.floor(ms);
  crClock.storyMs = v > 0 ? v : 0;
  try{
    await api.v1.historyStorage.set(CR_CLOCK_NOW_KEY, crClock.storyMs);
  }
  catch (e){
    api.v1.error("[CR:clock] could not save the story clock:", e);
  }
  crTouch();
}

async function crClockAdvance(minutes: number) : Promise<void>
{
  if (!crClockActive()){
    return;
  }
  await crClockWrite(crClock.storyMs + Math.round(minutes) * CR_MIN_MS);
}

async function crClockNextMorning() : Promise<void>
{
  if (!crClockActive()){
    return;
  }
  const d = new Date(crClock.storyMs);
  const target = new Date(d.getFullYear(), d.getMonth(), d.getDate(),
                          Math.floor(CR_MORNING_MIN / 60), CR_MORNING_MIN % 60, 0, 0).getTime();
  await crClockWrite(target > crClock.storyMs ? target : target + CR_DAY_MIN * CR_MIN_MS);
}

async function crClockSetTimeOfDay(minutes: number) : Promise<void>
{
  if (!crClockActive()){
    return;
  }
  const m = ((Math.round(minutes) % CR_DAY_MIN) + CR_DAY_MIN) % CR_DAY_MIN;
  const d = new Date(crClock.storyMs);
  const target = new Date(d.getFullYear(), d.getMonth(), d.getDate(), Math.floor(m / 60), m % 60, 0, 0);
  await crClockWrite(target.getTime());
}

async function crClockSetStep(minutes: number) : Promise<void>
{
  crClock.stepMin = minutes > 0 ? Math.floor(minutes) : 0;
  try{
    await api.v1.storyStorage.set(CR_CLOCK_STEP_KEY, crClock.stepMin);
  }
  catch (e){
    api.v1.error("[CR:clock] could not save the per-turn step:", e);
  }
  crTouch();
}

async function crClockForgetTimeApart() : Promise<void>
{
  if (!chatSettings.char || !chatSettings.user){
    return;
  }
  const cid = chatSettings.char.id + chatSettings.user.id;
  if (trackRealTimeRecord[cid] === undefined){
    return;
  }
  delete trackRealTimeRecord[cid];
  try{
    await api.v1.storyStorage.set(TRACK_REAL_TIME_RECORD_KEY, trackRealTimeRecord);
  }
  catch (e){
    api.v1.error("[CR:clock] could not clear the Time Apart stamp:", e);
  }
}

async function crClockSetMode(mode: CrClockMode) : Promise<void>
{
  crClock.mode = mode;
  try{
    await api.v1.storyStorage.set(CR_CLOCK_MODE_KEY, mode);
  }
  catch (e){
    api.v1.error("[CR:clock] could not save the clock mode:", e);
  }
  if (mode === "story" && crClock.storyMs <= 0){
    await crClockWrite(crClockRoundHalf(Date.now()));
  }
  await crClockForgetTimeApart();
  crTouch();
}

async function crClockResetToDevice() : Promise<void>
{
  await crClockWrite(crClockRoundHalf(Date.now()));
}

function crPad2(n: number) : string
{
  const s = String(Math.floor(Math.abs(n)));
  return s.length < 2 ? "0" + s : s;
}

function crFmtHM(minutes: number) : string
{
  const m = Math.max(0, Math.round(minutes));
  if (m >= CR_DAY_MIN){
    return "24:00";
  }
  return crPad2(Math.floor(m / 60)) + ":" + crPad2(m % 60);
}

function crMinutesOfDay(ms: number) : number
{
  const d = new Date(ms);
  return (d.getHours() * 60) + d.getMinutes();
}

function crWeekdayOf(ms: number) : string
{
  return CR_JS_DAY_LIST[new Date(ms).getDay()] as string;
}

function crFmtDate(ms: number) : string
{
  const d = new Date(ms);
  return String(d.getFullYear()) + "-" + crPad2(d.getMonth() + 1) + "-" + crPad2(d.getDate());
}

function crFmtStamp(ms: number) : string
{
  return crWeekdayOf(ms) + " " + crFmtHM(crMinutesOfDay(ms));
}

// ============================================================================
// SECTION HOOKS-MISC — GENERATION END AND HISTORY HOOKS
// ============================================================================
api.v1.hooks.register("onGenerationEnd", async (params) => { 
  crGroupNativeClose(params);
  if (crGroupGenDepth > 0){
    return;
  }

  await updateEditorImages();

  await crClockLoad();

  if (params.model === "xialong-v1"){
    if (chatSettings.char && chatSettings.user){
      if (crClock.trackReal === true || crClockActive()){
        const combinedId = chatSettings.char.id + chatSettings.user.id;
        if (!trackRealTimeRecord[combinedId]){
          trackRealTimeRecord[combinedId] = 0;
        }
        const lastContactResponseTime = crClockNow();
        trackRealTimeRecord[combinedId] = lastContactResponseTime;
        await api.v1.storyStorage.set(TRACK_REAL_TIME_RECORD_KEY, trackRealTimeRecord);
      }
      if (crClockActive() && crClock.stepMin > 0){
        await crClockAdvance(crClock.stepMin);
      }
    }
  }

  if (crRoll.checkInitialTrim === true){
    crRoll.checkInitialTrim = false;
  }

  if (crSideGenBusy()){
    return;
  }
  if (params.model === "xialong-v1"){
    await crCueUserTurn().catch((e) => { api.v1.error("[CR:cue] cue failed:", e); });
    await crChatImgProcess().catch((e) => { api.v1.error("[CR:chatimg] pass failed:", e); });
  }
  else if (crCueOn){
    crCueReason = "Skipped: that generation ran on " + String(params.model) + ", not the chat's own model.";
  }
});

api.v1.hooks.register("onHistoryNavigated", async (params) => { 
  await crClockLoad();
  crTouch();
  if (params.cause === "redo" || (params.cause === "jump" && params.direction === "forward")){
    await updateEditorImages();
  }
});

// ============================================================================
// SECTION K-CONTEXT — CONTEXT HOOKS (adapters over SECTION K)
// ============================================================================

let crRoll: CrkRoll = crkRollDefault();

function crKernelCtx(extra: any): CrkCtx {
  const kChar = crGroupBuildChar || chatSettings.char;
  const cid = (kChar && chatSettings.user) ? kChar.id + chatSettings.user.id : "";
  const base: CrkCtx = {
    char: kChar,
    user: chatSettings.user,
    scenario: chatSettings.scenario,
    chat: { tags: chatSettings.tags, intimacy: chatSettings.intimacy, style: chatSettings.style, responseLength: chatSettings.responseLength },
    includeGameStats: false,
    gameRecord: gameRecord,
    floaty: floatyBrainsList,
    jots: cid ? rememberMeRecord[cid] : undefined,
    diary: cid ? diaryBrainsRecord[cid] : undefined,
    process: cid ? emotionalMemoryRecord[cid] : undefined,
    plans: cid ? actionPlansRecord[cid] : undefined,
    trackRealTime: false,
    lastContactMs: cid ? trackRealTimeRecord[cid] : undefined,
    useEmotionalModes: false,
    nowMs: crClockNow()
  };
  for (const k in extra) { (base as any)[k] = extra[k]; }
  return base;
}

function crKernelDeps(): CrkDeps {
  return {
    rngInt: (min: number, max: number) => api.v1.random.int(min, max),
    encode: (text: string, model: string) => api.v1.tokenizer.encode(text, model),
    maxTokens: (model: string) => api.v1.maxTokens(model),
    rolloverTokens: (model: string) => api.v1.rolloverTokens(model),
    naiSystemPrompt: () => api.v1.systemPrompt.get(),
    recentEmotions: async (n: number) => crkRecentEmotionsFromSections(await api.v1.document.scan(), n),
    log: (v: any) => { api.v1.log(v); }
  };
}

api.v1.hooks.register("onBeforeContextBuild", ( params ) => {
  if (crGroupGenDepth > 0){
    return;
  }
  if (crGroupBuildChar){
    crGroupSaw.before = true;
  }
  if (params.model !== "xialong-v1" || !chatSettings.char || !chatSettings.user){
    return;
  }
  const res = crkBrainEntries(params.model,
    crChatImgStripIdsText(params.storyText ? params.storyText.content : ""), crKernelCtx({}));
  if (res){
    return res;
  }
});

api.v1.hooks.register("onContextBuilt", async ({ messages, model, dryRun, continuityId }) => {
  if (crGroupGenDepth > 0 || crGroupBuildChar){
    if (crGroupBuildChar){
      crGroupSaw.built = true;
    }
    return;
  }
  if (model !== "xialong-v1" || !chatSettings.char || !chatSettings.user){
    return;
  }
  const cid = chatSettings.char.id + chatSettings.user.id;
  const ctx = crKernelCtx({
    includeGameStats: await api.v1.storage.get(INCLUDE_GAME_STATS_KEY),
    trackRealTime: crClockActive() ? true : await api.v1.storyStorage.get(TRACK_REAL_TIME_KEY),
    useEmotionalModes: await api.v1.storage.get(USE_EMOTIONAL_MODES_KEY),
  });
  const res = await crkContextBuilt(crChatImgStripIds(messages),
    model, dryRun, ctx, crKernelDeps(), crRoll);
  if (res.plans !== undefined && res.plans !== actionPlansRecord[cid]){
    actionPlansRecord[cid] = res.plans;
  }
  if (res.planSave){
    await saveActionPlans();
  }
  if (res.messages){
    if (crGroupActive()){
      // Only the real pass arms the reply newline.
      return { messages: crGroupNativeView(res.messages, dryRun ? "" : String(continuityId || "")) };
    }
    return { messages: res.messages };
  }
});

// ============================================================================
// SECTION CR-DATA — CR-ONLY CARD FIELDS
// ============================================================================
interface CrImageRef {
  id: string;
  w?: number;
  h?: number;
}

interface CrProfile {
  status?: string;
  bio?: string;
  links?: string[];
}

interface CrAvatarDisplay {
  shape: string;
  ring: boolean;
  ringColor: string;
  size: number;
}

interface CrContactImages {
  avatar?: CrImageRef;
  emotions?: Record<string, CrImageRef>;
}

interface CrOutfitChunk {
  id: string;
  label: string;
  prompt: string;
  uc: string;
  active: boolean;
}

interface CrImgCard {
  basePrompt?: string;
  baseUC?: string;
  universalPrompt?: string;
  universalUC?: string;
  illustratorPrompt?: string;
  illustratorUC?: string;
  avatarPrompt?: string;
  avatarUC?: string;
  avatarSeed?: number;
  outfits?: CrOutfitChunk[];
}

interface CrSimpleImages {
  avatar?: CrImageRef;
}

interface CrSceneImages {
  avatar?: CrImageRef;
  banner?: CrImageRef;
}

interface CrUserExtra {
  images?: CrSimpleImages;
  profile?: CrProfile;
  img?: CrImgCard;
}

interface CrSceneCard {
  basePrompt?: string;
  baseUC?: string;
  bannerPrompt?: string;
  bannerUC?: string;
  bannerSeed?: number;
}

interface CrScenarioExtra {
  images?: CrSceneImages;
  profile?: CrProfile;
  img?: CrSceneCard;
}

interface CrContactExtra {
  images?: CrContactImages;
  profile?: CrProfile;
  display?: Partial<CrAvatarDisplay>;
  imgTags?: Record<string, string>;
  img?: CrImgCard;
  bubbles?: CrBubbleLook;
}

const CR_MAX_STATUS = 200;
const CR_MAX_BIO = 2000;
const CR_MAX_LINKS = 8;
const CR_MAX_LINK = 500;
const CR_MAX_ID = 200;
const CR_DISPLAY_SHAPES: string[] = ["circle", "rounded", "square"];

function crSanitizeText(v: any, cap: number) : string | undefined
{
  if (typeof v !== "string"){
    return undefined;
  }
  const out = v.slice(0, cap);
  return out.length > 0 ? out : undefined;
}

function crSanitizeImageRef(v: any) : CrImageRef | undefined
{
  if (!v || typeof v !== "object"){
    return undefined;
  }
  const id = crSanitizeText((v as any).id, CR_MAX_ID);
  if (!id){
    return undefined;
  }
  const out: CrImageRef = { id: id };
  const w = Number((v as any).w);
  const h = Number((v as any).h);
  if (isFinite(w) && w > 0){
    out.w = Math.floor(w);
  }
  if (isFinite(h) && h > 0){
    out.h = Math.floor(h);
  }
  return out;
}

function crSanitizeProfile(v: any) : CrProfile | undefined
{
  if (!v || typeof v !== "object"){
    return undefined;
  }
  const out: CrProfile = {};
  const status = crSanitizeText((v as any).status, CR_MAX_STATUS);
  const bio = crSanitizeText((v as any).bio, CR_MAX_BIO);
  if (status){
    out.status = status;
  }
  if (bio){
    out.bio = bio;
  }
  if (Array.isArray((v as any).links)){
    const links: string[] = [];
    const raw: any[] = (v as any).links;
    for (let i = 0; i < raw.length && links.length < CR_MAX_LINKS; i++){
      const link = crSanitizeText(raw[i], CR_MAX_LINK);
      if (link){
        links.push(link);
      }
    }
    if (links.length > 0){
      out.links = links;
    }
  }
  return (out.status || out.bio || out.links) ? out : undefined;
}

function crSanitizeDisplay(v: any) : Partial<CrAvatarDisplay> | undefined
{
  if (!v || typeof v !== "object"){
    return undefined;
  }
  const out: Partial<CrAvatarDisplay> = {};
  const shape = (v as any).shape;
  if (typeof shape === "string" && CR_DISPLAY_SHAPES.indexOf(shape) >= 0){
    out.shape = shape;
  }
  if (typeof (v as any).ring === "boolean"){
    out.ring = (v as any).ring;
  }
  const ringColor = crSanitizeText((v as any).ringColor, 40);
  if (ringColor){
    out.ringColor = ringColor;
  }
  const size = Number((v as any).size);
  if (isFinite(size) && size > 0){
    out.size = Math.floor(size);
  }
  return Object.keys(out).length > 0 ? out : undefined;
}

function crSanitizeContactImages(v: any) : CrContactImages | undefined
{
  if (!v || typeof v !== "object"){
    return undefined;
  }
  const out: CrContactImages = {};
  const avatar = crSanitizeImageRef((v as any).avatar);
  if (avatar){
    out.avatar = avatar;
  }
  const rawEmotions = (v as any).emotions;
  if (rawEmotions && typeof rawEmotions === "object"){
    const emotions: Record<string, CrImageRef> = {};
    for (let i = 0; i < EMOTION_LIST.length; i++){
      const name = EMOTION_LIST[i];
      const ref = crSanitizeImageRef(rawEmotions[name]);
      if (ref){
        emotions[name] = ref;
      }
    }
    if (Object.keys(emotions).length > 0){
      out.emotions = emotions;
    }
  }
  return (out.avatar || out.emotions) ? out : undefined;
}

function crSanitizeImgTags(v: any) : Record<string, string> | undefined
{
  if (!v || typeof v !== "object"){
    return undefined;
  }
  const out: Record<string, string> = {};
  const names = EMOTION_LIST.concat([CR_SLOT_AVATAR]);
  for (let i = 0; i < names.length; i++){
    const tag = crSanitizeText((v as any)[names[i]], 400);
    if (tag){
      out[names[i]] = tag;
    }
  }
  return Object.keys(out).length > 0 ? out : undefined;
}

function crSanitizeOutfits(v: any) : CrOutfitChunk[] | undefined
{
  if (!Array.isArray(v)){
    return undefined;
  }
  const out: CrOutfitChunk[] = [];
  for (let i = 0; i < v.length && out.length < 16; i++){
    const raw = v[i];
    if (!raw || typeof raw !== "object"){
      continue;
    }
    const prompt = crSanitizeText((raw as any).prompt, 600) || "";
    const uc = crSanitizeText((raw as any).uc, 600) || "";
    const label = crSanitizeText((raw as any).label, 80) || "";
    const oid = crSanitizeText((raw as any).id, 64) || ("cr-o" + i);
    out.push({
      id: oid,
      label: label,
      prompt: prompt,
      uc: uc,
      active: (raw as any).active === true
    });
  }
  return out.length > 0 ? out : undefined;
}

function crSanitizeImgCard(v: any) : CrImgCard | undefined
{
  if (!v || typeof v !== "object"){
    return undefined;
  }
  const out: CrImgCard = {};
  const pairs: string[] = ["basePrompt", "baseUC", "universalPrompt", "universalUC",
                           "illustratorPrompt", "illustratorUC", "avatarPrompt", "avatarUC"];
  for (let i = 0; i < pairs.length; i++){
    const text = crSanitizeText((v as any)[pairs[i]], 1200);
    if (text){
      (out as any)[pairs[i]] = text;
    }
  }
  const seed = Math.round(Number((v as any).avatarSeed));
  if (isFinite(seed) && seed > 0 && seed <= 4294967295){
    out.avatarSeed = seed;
  }
  const outfits = crSanitizeOutfits((v as any).outfits);
  if (outfits){
    out.outfits = outfits;
  }
  return Object.keys(out).length > 0 ? out : undefined;
}

function crSanitizeSimpleImages(v: any) : CrSimpleImages | undefined
{
  if (!v || typeof v !== "object"){
    return undefined;
  }
  const out: CrSimpleImages = {};
  const avatar = crSanitizeImageRef((v as any).avatar);
  if (avatar){
    out.avatar = avatar;
  }
  return out.avatar ? out : undefined;
}

function crSanitizeSceneImages(v: any) : CrSceneImages | undefined
{
  if (!v || typeof v !== "object"){
    return undefined;
  }
  const out: CrSceneImages = {};
  const avatar = crSanitizeImageRef((v as any).avatar);
  const banner = crSanitizeImageRef((v as any).banner);
  if (avatar){
    out.avatar = avatar;
  }
  if (banner){
    out.banner = banner;
  }
  return (out.avatar || out.banner) ? out : undefined;
}

function crSanitizeUserExtra(v: any) : CrUserExtra | undefined
{
  if (!v || typeof v !== "object"){
    return undefined;
  }
  const out: CrUserExtra = {};
  const images = crSanitizeSimpleImages((v as any).images);
  const profile = crSanitizeProfile((v as any).profile);
  const imgCard = crSanitizeImgCard((v as any).img);
  if (images){
    out.images = images;
  }
  if (imgCard){
    out.img = imgCard;
  }
  if (profile){
    out.profile = profile;
  }
  return Object.keys(out).length > 0 ? out : undefined;
}

function crSanitizeSceneCard(v: any) : CrSceneCard | undefined
{
  if (!v || typeof v !== "object"){
    return undefined;
  }
  const out: CrSceneCard = {};
  const pairs: string[] = ["basePrompt", "baseUC", "bannerPrompt", "bannerUC"];
  for (let i = 0; i < pairs.length; i++){
    const text = crSanitizeText((v as any)[pairs[i]], 1200);
    if (text){
      (out as any)[pairs[i]] = text;
    }
  }
  const seed = Math.round(Number((v as any).bannerSeed));
  if (isFinite(seed) && seed > 0 && seed <= 4294967295){
    out.bannerSeed = seed;
  }
  return Object.keys(out).length > 0 ? out : undefined;
}

function crSanitizeScenarioExtra(v: any) : CrScenarioExtra | undefined
{
  if (!v || typeof v !== "object"){
    return undefined;
  }
  const out: CrScenarioExtra = {};
  const images = crSanitizeSceneImages((v as any).images);
  const profile = crSanitizeProfile((v as any).profile);
  const sceneCard = crSanitizeSceneCard((v as any).img);
  if (images){
    out.images = images;
  }
  if (sceneCard){
    out.img = sceneCard;
  }
  if (profile){
    out.profile = profile;
  }
  return Object.keys(out).length > 0 ? out : undefined;
}

const CR_BUBBLE_FILLS: string[] = ["none", "solid", "gradient"];
const CR_BUBBLE_BORDERS: string[] = ["none", "solid", "dashed", "dotted"];
const CR_BUBBLE_SWATCHES: string[] = [
  "#1b1d24", "#2b2f3a", "#3c4250", "#1f3350", "#26406a", "#2f5d50",
  "#4a2f52", "#5a3030", "#6b5420", "#7c9cf5", "#d6d6de", "#000000"
];

interface CrBubbleSide {
  fill?: string;
  colour?: string;
  colour2?: string;
  opacity?: number;
  text?: string;
  borderStyle?: string;
  borderWidth?: number;
  borderColour?: string;
  corner?: number;
  pad?: number;
  glow?: number;
  glowColour?: string;
}

interface CrBubbleLook {
  on?: boolean;
  emotionLine?: boolean;
  contact?: CrBubbleSide;
  user?: CrBubbleSide;
}

function crSanitizeHex(v: any) : string | undefined
{
  if (typeof v !== "string"){
    return undefined;
  }
  const s = v.trim();
  if (!s){
    return "";
  }
  return /^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$/.test(s) ? s.toLowerCase() : undefined;
}

function crSanitizeBubbleSide(v: any) : CrBubbleSide | undefined
{
  if (!v || typeof v !== "object"){
    return undefined;
  }
  const out: CrBubbleSide = {};
  const num = (raw: any, lo: number, hi: number) => {
    const n = Number(raw);
    return isFinite(n) ? Math.min(hi, Math.max(lo, Math.round(n))) : undefined;
  };
  const fill = (v as any).fill;
  if (typeof fill === "string" && CR_BUBBLE_FILLS.indexOf(fill) >= 0){
    out.fill = fill;
  }
  const bs = (v as any).borderStyle;
  if (typeof bs === "string" && CR_BUBBLE_BORDERS.indexOf(bs) >= 0){
    out.borderStyle = bs;
  }
  const colour = crSanitizeHex((v as any).colour);
  if (colour !== undefined){ out.colour = colour; }
  const colour2 = crSanitizeHex((v as any).colour2);
  if (colour2 !== undefined){ out.colour2 = colour2; }
  const text = crSanitizeHex((v as any).text);
  if (text !== undefined){ out.text = text; }
  const borderColour = crSanitizeHex((v as any).borderColour);
  if (borderColour !== undefined){ out.borderColour = borderColour; }
  const glowColour = crSanitizeHex((v as any).glowColour);
  if (glowColour !== undefined){ out.glowColour = glowColour; }
  const opacity = num((v as any).opacity, 0, 100);
  if (opacity !== undefined){ out.opacity = opacity; }
  const borderWidth = num((v as any).borderWidth, 0, 6);
  if (borderWidth !== undefined){ out.borderWidth = borderWidth; }
  const corner = num((v as any).corner, 0, 24);
  if (corner !== undefined){ out.corner = corner; }
  const pad = num((v as any).pad, 0, 16);
  if (pad !== undefined){ out.pad = pad; }
  const glow = num((v as any).glow, 0, 40);
  if (glow !== undefined){ out.glow = glow; }
  return Object.keys(out).length > 0 ? out : undefined;
}

function crSanitizeBubbles(v: any) : CrBubbleLook | undefined
{
  if (!v || typeof v !== "object"){
    return undefined;
  }
  const out: CrBubbleLook = {};
  if (typeof (v as any).on === "boolean"){ out.on = (v as any).on; }
  if (typeof (v as any).emotionLine === "boolean"){ out.emotionLine = (v as any).emotionLine; }
  const contact = crSanitizeBubbleSide((v as any).contact);
  if (contact){ out.contact = contact; }
  const user = crSanitizeBubbleSide((v as any).user);
  if (user){ out.user = user; }
  return Object.keys(out).length > 0 ? out : undefined;
}

function crSanitizeContactExtra(v: any) : CrContactExtra | undefined
{
  if (!v || typeof v !== "object"){
    return undefined;
  }
  const out: CrContactExtra = {};
  const images = crSanitizeContactImages((v as any).images);
  const profile = crSanitizeProfile((v as any).profile);
  const display = crSanitizeDisplay((v as any).display);
  const imgTags = crSanitizeImgTags((v as any).imgTags);
  const imgCard = crSanitizeImgCard((v as any).img);
  const bubbles = crSanitizeBubbles((v as any).bubbles);
  if (images){
    out.images = images;
  }
  if (imgTags){
    out.imgTags = imgTags;
  }
  if (imgCard){
    out.img = imgCard;
  }
  if (profile){
    out.profile = profile;
  }
  if (display){
    out.display = display;
  }
  if (bubbles){
    out.bubbles = bubbles;
  }
  return Object.keys(out).length > 0 ? out : undefined;
}

// ============================================================================
// SECTION CR-BUBBLE — CHAT BUBBLE LOOK
// ============================================================================
const CR_BUBBLE_DEFAULT: CrBubbleLook = {
  on: false,
  emotionLine: true,
  contact: {
    fill: "solid", colour: "#2b2f3a", colour2: "#343a48", opacity: 100, text: "",
    borderStyle: "solid", borderWidth: 1, borderColour: "#3c4250",
    corner: 14, pad: 10, glow: 0, glowColour: "#000000"
  },
  user: {
    fill: "solid", colour: "#1f3350", colour2: "#26406a", opacity: 100, text: "",
    borderStyle: "solid", borderWidth: 1, borderColour: "#2c4468",
    corner: 14, pad: 10, glow: 0, glowColour: "#000000"
  }
};

let crBubbleTab: "contact" | "user" = "contact";

const CR_BUBBLE_KEY = "crBubblesKey";
await api.v1.storage.setIfAbsent(CR_BUBBLE_KEY, CR_BUBBLE_DEFAULT);

let crBubbles: CrBubbleLook = crSanitizeBubbles(await api.v1.storage.get(CR_BUBBLE_KEY)) || CR_BUBBLE_DEFAULT;

async function crSaveBubbles() : Promise<void>
{
  try{ await api.v1.storage.set(CR_BUBBLE_KEY, crBubbles); }
  catch (e){ api.v1.error("[CR:bubble] could not store the look:", e); }
  await crBubbleApply();
  crTouch();
}

function crBubbleSideFor(char: Character | undefined, which: "contact" | "user") : CrBubbleSide
{
  const base: CrBubbleSide = (CR_BUBBLE_DEFAULT as any)[which] || {};
  const acct: CrBubbleSide = (crBubbles as any)[which] || {};
  const over: CrBubbleSide = (char && char.cr && char.cr.bubbles && (char.cr.bubbles as any)[which]) || {};
  const pick = (field: string) => {
    if (Object.prototype.hasOwnProperty.call(over, field)){ return (over as any)[field]; }
    if (Object.prototype.hasOwnProperty.call(acct, field)){ return (acct as any)[field]; }
    return (base as any)[field];
  };
  return {
    fill: pick("fill"), colour: pick("colour"), colour2: pick("colour2"),
    opacity: pick("opacity"), text: pick("text"),
    borderStyle: pick("borderStyle"), borderWidth: pick("borderWidth"),
    borderColour: pick("borderColour"),
    corner: pick("corner"), pad: pick("pad"),
    glow: pick("glow"), glowColour: pick("glowColour")
  };
}

function crBubbleFlag(char: Character | undefined, field: "on" | "emotionLine") : boolean
{
  const over = char && char.cr ? char.cr.bubbles : undefined;
  if (over && typeof (over as any)[field] === "boolean"){
    return (over as any)[field];
  }
  if (typeof (crBubbles as any)[field] === "boolean"){
    return (crBubbles as any)[field];
  }
  return (CR_BUBBLE_DEFAULT as any)[field] === true;
}

function crRgba(hex: string, pct: number) : string
{
  const s = String(hex || "").replace("#", "");
  const full = s.length === 3 ? s[0] + s[0] + s[1] + s[1] + s[2] + s[2] : s;
  const n = parseInt(full, 16);
  if (!/^[0-9a-fA-F]{6}$/.test(full) || !isFinite(n)){
    return "transparent";
  }
  const a = Math.min(100, Math.max(0, isFinite(pct) ? pct : 100)) / 100;
  return "rgba(" + ((n >> 16) & 255) + ", " + ((n >> 8) & 255) + ", " + (n & 255) + ", " + a + ")";
}

function crBubbleStyle(side: CrBubbleSide) : Record<string, string> 
{
  const style: Record<string, string> = {};
  const op = typeof side.opacity === "number" ? side.opacity : 100;
  if (side.fill === "solid"){
    style.background = crRgba(side.colour || "", op);
  }
  else if (side.fill === "gradient"){
    style.background = "linear-gradient(135deg, " + crRgba(side.colour || "", op)
      + ", " + crRgba(side.colour2 || side.colour || "", op) + ")";
  }
  const bw = typeof side.borderWidth === "number" ? side.borderWidth : 0;
  if (bw > 0 && side.borderStyle && side.borderStyle !== "none"){
    style.border = String(bw) + "px " + side.borderStyle + " " + crRgba(side.borderColour || "", 100);
  }
  style.borderRadius = String(typeof side.corner === "number" ? side.corner : 0) + "px";
  const pad = typeof side.pad === "number" ? side.pad : 0;
  if (pad > 0){
    style.padding = String(pad) + "px " + String(pad + 3) + "px";
  }
  const glow = typeof side.glow === "number" ? side.glow : 0;
  if (glow > 0){
    style.boxShadow = "0 0 " + String(glow) + "px " + crRgba(side.glowColour || "", 70);
  }
  if (side.text){
    style.color = side.text;
  }
  return style;
}

const CR_BUBBLE_MAX_MARKS = 120;
let crBubbleMarkHandles: any[] = [];

async function crBubbleMarkDispose() : Promise<void>
{
  const held = crBubbleMarkHandles;
  crBubbleMarkHandles = [];
  for (let i = 0; i < held.length; i++){
    try{
      if (held[i] && held[i].dispose){
        await held[i].dispose();
      }
    }
    catch (e){}
  }
}

function crSectionIsContacts(sec: Section) : boolean
{
  const origins: any[] = (sec && (sec as any).origin) ? (sec as any).origin : [];
  for (let i = 0; i < origins.length; i++){
    if (origins[i] && String(origins[i].data) === "ai"){
      return true;
    }
  }
  return false;
}

function crSectionIsAuthors(sec: Section) : boolean
{
  const origins: any[] = (sec && (sec as any).origin) ? (sec as any).origin : [];
  let authored = false;
  for (let i = 0; i < origins.length; i++){
    const data = origins[i] ? String(origins[i].data) : "";
    if (data === "ai"){
      return false;
    }
    if (data === "user" || data === "edit"){
      authored = true;
    }
  }
  return authored;
}

type CrBubbleOwner = { prefix: string; style: Record<string, string>; emotionLine: boolean };

async function crBubbleMark() : Promise<void>
{
  return crSerial("bubbleMark", crBubbleMarkOnce);
}

type CrChatMsg = { side: "contact" | "user"; charId: string; anchorId: number; endId: number; ids: number[];
                   emotion: string; emotionId: number; run: boolean };
type CrChatSeg = { runs: CrChatMsg[]; messages: CrChatMsg[]; nNames: number; nEmotions: number; nContactOther: number };

// [CR-SEGMENT] One reading of the document for portraits and bubbles alike.
// Runs are the portrait pass's messages (D-82, D-83); messages add the author's turns and
// model paragraphs outside any run, which get bubbles but no portrait.
function crChatSegment(sections: { sectionId: number; section: Section; index: number }[], char: Character | undefined) : CrChatSeg
{
  const cast = char ? crGroupCast(char) : [];
  const emotionRx = /^[ \t]*Emotion:[ \t]*(.+)$/;
  const runs: CrChatMsg[] = [];
  const messages: CrChatMsg[] = [];
  let pending: CrChatMsg | null = null;
  let prevId: number | null = null;
  let opened = false;
  let provisional: CrChatMsg | null = null;
  let provisionalAi = false;
  let other: CrChatMsg | null = null;
  let otherBlanks: number[] = [];
  let lastOwner = char ? char.id : "";
  let nNames = 0;
  let nEmotions = 0;
  let nContactOther = 0;
  const unrun = (m: CrChatMsg, keep: boolean) => {
    const at = runs.indexOf(m);
    if (at >= 0){ runs.splice(at, 1); }
    m.run = false;
    if (!keep){
      const mi = messages.indexOf(m);
      if (mi >= 0){ messages.splice(mi, 1); }
    }
  };
  const open = (side: "contact" | "user", charId: string, id: number) : CrChatMsg => {
    const m: CrChatMsg = { side: side, charId: charId, anchorId: prevId === null ? 0 : prevId, endId: id, ids: [id],
                           emotion: "", emotionId: -1, run: false };
    messages.push(m);
    return m;
  };

  for (let i = 0; i < sections.length; i++){
    const row = sections[i];
    const text = String((row.section && row.section.text) || "");
    const trimmed = text.trim();
    const emo = emotionRx.exec(text);
    const authored = crSectionIsAuthors(row.section);
    let owner: Character | null = null;
    for (let k = 0; k < cast.length; k++){
      if (trimmed.indexOf(cast[k].name + ":") === 0){
        owner = cast[k];
        break;
      }
    }
    if (owner){
      nNames = nNames + 1;
      pending = open("contact", owner.id, row.sectionId);
      pending.run = true;
      runs.push(pending);
      opened = true;
      provisional = null;
      lastOwner = owner.id;
      other = null;
    }
    else if (emo){
      nEmotions = nEmotions + 1;
      if (pending){
        pending.emotion = emo[1].trim().toLowerCase();
        pending.emotionId = row.sectionId;
        pending.endId = row.sectionId;
        pending.ids.push(row.sectionId);
        provisional = null;
        pending = null;
      }
      other = null;
    }
    else if (pending && !authored){
      nContactOther = nContactOther + 1;
      pending.endId = row.sectionId;
      pending.ids.push(row.sectionId);
    }
    else if (char && !opened && !authored && trimmed){
      nContactOther = nContactOther + 1;
      pending = open("contact", char.id, row.sectionId);
      pending.run = true;
      runs.push(pending);
      provisional = pending;
      provisionalAi = crSectionIsContacts(row.section);
      opened = true;
      other = null;
    }
    else {
      if (provisional && pending === provisional){
        unrun(provisional, provisionalAi);
        provisional = null;
      }
      pending = null;
      const side: "contact" | "user" | "" = !trimmed ? "" : (authored ? "user" : (crSectionIsContacts(row.section) ? "contact" : ""));
      if (!trimmed){
        if (other){ otherBlanks.push(row.sectionId); }
      }
      else if (side && other && other.side === side){
        for (let b = 0; b < otherBlanks.length; b++){ other.ids.push(otherBlanks[b]); }
        other.ids.push(row.sectionId);
        other.endId = row.sectionId;
        otherBlanks = [];
      }
      else if (side){
        other = open(side, side === "user" ? "" : lastOwner, row.sectionId);
        otherBlanks = [];
      }
      else {
        other = null;
        otherBlanks = [];
      }
      if (authored && trimmed){
        lastOwner = char ? char.id : "";
      }
    }
    if (owner || emo || (pending && !authored)){
      otherBlanks = [];
    }
    prevId = row.sectionId;
  }
  if (provisional && runs.length && runs[runs.length - 1] === provisional){
    unrun(provisional, provisionalAi);
  }
  return { runs: runs, messages: messages, nNames: nNames, nEmotions: nEmotions, nContactOther: nContactOther };
}

// [CR-BUBBLE-SHAPE] A message is one bubble: corners, padding and border only on its outer edges.
function crBubbleShaped(side: CrBubbleSide, pos: "single" | "first" | "middle" | "last") : Record<string, string>
{
  const style = crBubbleStyle(side);
  if (pos === "single"){
    return style;
  }
  const r = String(typeof side.corner === "number" ? side.corner : 0) + "px";
  style.borderRadius = pos === "first" ? r + " " + r + " 0 0" : (pos === "last" ? "0 0 " + r + " " + r : "0");
  const pad = typeof side.pad === "number" ? side.pad : 0;
  if (pad > 0){
    const v = String(pad) + "px";
    const hz = String(pad + 3) + "px";
    style.padding = pos === "first" ? v + " " + hz + " 0" : (pos === "last" ? "0 " + hz + " " + v : "0 " + hz);
  }
  if (style.border){
    const bw = String(side.borderWidth) + "px";
    delete style.border;
    style.borderStyle = String(side.borderStyle);
    style.borderColor = crRgba(side.borderColour || "", 100);
    style.borderWidth = pos === "first" ? bw + " " + bw + " 0" : (pos === "last" ? "0 " + bw + " " + bw : "0 " + bw);
  }
  return style;
}

let crBubbleShapeRefused = false;

async function crBubbleMarkOnce() : Promise<void>
{
  await crBubbleMarkDispose();
  const char = crLiveContact();
  if (!crBubbleFlag(char, "on")){
    return;
  }
  let sections: { sectionId: number; section: Section; index: number }[] = [];
  try{ sections = await api.v1.document.scan(); }
  catch (e){ return; }
  const seg = crChatSegment(sections, char);
  const from = Math.max(0, sections.length - CR_BUBBLE_MAX_MARKS);
  const textOf: { [id: number]: string } = {};
  const indexOf: { [id: number]: number } = {};
  for (let i = 0; i < sections.length; i++){
    textOf[sections[i].sectionId] = String((sections[i].section && sections[i].section.text) || "").trim();
    indexOf[sections[i].sectionId] = i;
  }
  const lookFor: { [id: string]: { side: CrBubbleSide | null; emotionLine: boolean } } = {};
  const look = (m: CrChatMsg) => {
    const key = m.side === "user" ? "\u0000user" : m.charId;
    if (!lookFor[key]){
      if (m.side === "user"){
        lookFor[key] = { side: crBubbleSideFor(char, "user"), emotionLine: false };
      }
      else {
        const who = (char && m.charId === char.id) ? char : charList.find((c) => c.id === m.charId);
        const own = !who || who === char || crBubbleFlag(who, "on");
        lookFor[key] = { side: own ? crBubbleSideFor(who || char, "contact") : null, emotionLine: crBubbleFlag(who || char, "emotionLine") };
      }
    }
    return lookFor[key];
  };
  const tag = /^\[[ \t]*Image#[0-9a-f]{8}[ \t]*:[^\]\n\r]*\]$/i;
  const shaped: any[] = [];
  const flat: any[] = [];
  for (let m = 0; m < seg.messages.length; m++){
    const msg = seg.messages[m];
    const lk = look(msg);
    if (!lk.side || !Object.keys(crBubbleStyle(lk.side)).length){
      continue;
    }
    const ids = msg.ids.filter((id) => indexOf[id] >= from && (id !== msg.emotionId || lk.emotionLine));
    const visible = ids.filter((id) => !!textOf[id] && !tag.test(textOf[id]));
    if (!visible.length){
      continue;
    }
    const first = visible[0];
    const last = visible[visible.length - 1];
    const flatStyle = crBubbleStyle(lk.side);
    for (let k = 0; k < ids.length; k++){
      const id = ids[k];
      const inside = indexOf[id] >= indexOf[first] && indexOf[id] <= indexOf[last];
      const isTag = !!textOf[id] && tag.test(textOf[id]);
      if (!inside && !isTag){
        continue;
      }
      const pos = first === last && id === first ? "single"
        : (id === first ? "first" : (id === last ? "last" : "middle"));
      shaped.push({ type: "node", sectionId: id, style: crBubbleShaped(lk.side, pos) });
      if (textOf[id]){
        flat.push({ type: "node", sectionId: id, style: flatStyle });
      }
    }
  }
  if (!shaped.length){
    return;
  }
  try{
    const handles: any = await api.v1.editor.decorations.createMarkers(shaped);
    crBubbleMarkHandles = (handles && handles.length) ? handles : [];
    crBubbleShapeRefused = false;
    return;
  }
  catch (e){
    api.v1.error("[CR:bubble] the shaped bubbles were refused; painting each paragraph whole:", e);
    crBubbleShapeRefused = true;
  }
  try{
    const handles: any = await api.v1.editor.decorations.createMarkers(flat);
    crBubbleMarkHandles = (handles && handles.length) ? handles : [];
  }
  catch (e){
    api.v1.error("[CR:bubble] could not mark the bubbles:", e);
  }
}

const CR_BUBBLE_RULE_CONTACT = "crBubbleContact";
const CR_BUBBLE_RULE_EMOTION = "crBubbleEmotion";
const CR_BUBBLE_RULE_USER = "crBubbleUser";
const CR_BUBBLE_RULE_MEMBER = "crBubbleMember-";
let crBubbleMemberRuleIds: string[] = [];

async function crBubbleApply() : Promise<void>
{
  // Bubbles are markers only now; rules from earlier builds are taken down.
  try{
    api.v1.editor.decorations.removeRules([
      CR_BUBBLE_RULE_CONTACT, CR_BUBBLE_RULE_EMOTION, CR_BUBBLE_RULE_USER
    ].concat(crBubbleMemberRuleIds, crGroupMembers().map((m) => CR_BUBBLE_RULE_MEMBER + m.id)));
  }
  catch (e){}
  crBubbleMemberRuleIds = [];
  await crBubbleMark();
}

async function crSetBubbleFlag(field: "on" | "emotionLine", value: boolean) : Promise<void>
{
  (crBubbles as any)[field] = value === true;
  await crSaveBubbles();
}

async function crSetBubbleField(which: "contact" | "user", field: string, value: any) : Promise<void>
{
  const side: CrBubbleSide = (crBubbles as any)[which] || {};
  (side as any)[field] = value;
  (crBubbles as any)[which] = crSanitizeBubbleSide(side) || side;
  await crSaveBubbles();
}

async function crSetContactBubbleField(char: Character, which: "contact" | "user", field: string, value: any) : Promise<void>
{
  const extra: CrContactExtra = char.cr || {};
  const look: CrBubbleLook = extra.bubbles || {};
  const side: CrBubbleSide = (look as any)[which] || {};
  (side as any)[field] = value;
  (look as any)[which] = side;
  extra.bubbles = look;
  char.cr = crSanitizeContactExtra(extra);
  try{ await saveCharList(); }
  catch (e){ api.v1.error("[CR:bubble] could not save the Contact's look:", e); }
  await crBubbleApply();
  crTouch();
}

async function crClearContactBubbles(char: Character) : Promise<void>
{
  const extra: CrContactExtra = char.cr || {};
  extra.bubbles = undefined;
  char.cr = crSanitizeContactExtra(extra);
  try{ await saveCharList(); }
  catch (e){ api.v1.error("[CR:bubble] could not clear the Contact's look:", e); }
  await crBubbleApply();
  crTouch();
}

function crHasBubbleOverride(char: Character) : boolean
{
  return !!(char.cr && char.cr.bubbles);
}

function CrColour(props: { label: string; hint?: string; value: string; onSet: (v: string) => void }) : any
{
  return h(CrField, { label: props.label, hint: props.hint },
    h("div", { style: { display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_2 } },
      h("div", { style: { display: "flex", gap: CR_S_2, alignItems: "center" } },
        h("div", {
          style: {
            width: "22px", height: "22px", flex: "0 0 auto", borderRadius: CR_RADIUS_S,
            border: CR_LINE_W + " solid " + CR_LINE,
            background: props.value ? props.value : "transparent"
          }
        }),
        h("div", { style: { flex: "1 1 auto", minWidth: "0" } },
          h(CrTextInput, {
            value: props.value || "",
            placeholder: "#rrggbb",
            onSet: (v: string) => { props.onSet(String(v || "")); }
          })
        )
      ),
      h("div", { style: { display: "flex", gap: CR_S_1, flexWrap: "wrap" } },
        CR_BUBBLE_SWATCHES.map((sw) => h(CrPressable, {
          key: sw,
          render: (hover: boolean, press: boolean, handlers: any) => h("button", Object.assign({
            onClick: () => { props.onSet(sw); },
            title: sw,
            style: {
              appearance: "none", cursor: "pointer", padding: "0",
              width: "18px", height: "18px", borderRadius: CR_RADIUS_S,
              background: sw,
              border: CR_LINE_W + " solid " + (hover ? CR_ACCENT : CR_LINE),
              transform: press ? "scale(0.92)" : "none",
              transition: CR_MOTION
            }
          }, handlers))
        }))
      )
    )
  );
}

function CrBubbleSideEditor(props: { side: CrBubbleSide; onSet: (field: string, value: any) => void }) : any
{
  const s = props.side;
  return h("div", { style: { display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_4, marginTop: CR_S_3 } },
    h(CrChoice, {
      label: "Fill",
      options: [{ id: "none", label: "None" }, { id: "solid", label: "Solid" }, { id: "gradient", label: "Gradient" }],
      active: s.fill || "solid",
      onPick: (id: string) => { props.onSet("fill", id); }
    }),
    s.fill === "none" ? null : h(CrColour, {
      label: "Colour", value: s.colour || "", onSet: (v: string) => { props.onSet("colour", v); }
    }),
    s.fill === "gradient" ? h(CrColour, {
      label: "Second colour", hint: "The gradient runs from the first to this one.",
      value: s.colour2 || "", onSet: (v: string) => { props.onSet("colour2", v); }
    }) : null,
    s.fill === "none" ? null : h(CrNumField, {
      label: "Fill opacity",
      hint: "0 to 100. Separate from the colour, so fading a bubble does not lose the palette.",
      value: typeof s.opacity === "number" ? s.opacity : 100,
      onSet: (n: number) => { props.onSet("opacity", n); }
    }),
    h(CrColour, {
      label: "Text colour", hint: "Leave blank to keep the editor's own.",
      value: s.text || "", onSet: (v: string) => { props.onSet("text", v); }
    }),
    h(CrChoice, {
      label: "Border",
      options: [{ id: "none", label: "None" }, { id: "solid", label: "Solid" },
                { id: "dashed", label: "Dashed" }, { id: "dotted", label: "Dotted" }],
      active: s.borderStyle || "solid",
      onPick: (id: string) => { props.onSet("borderStyle", id); }
    }),
    (s.borderStyle && s.borderStyle !== "none") ? h(CrNumField, {
      label: "Border width", hint: "Pixels, 0 to 6.",
      value: typeof s.borderWidth === "number" ? s.borderWidth : 1,
      onSet: (n: number) => { props.onSet("borderWidth", n); }
    }) : null,
    (s.borderStyle && s.borderStyle !== "none") ? h(CrColour, {
      label: "Border colour", value: s.borderColour || "",
      onSet: (v: string) => { props.onSet("borderColour", v); }
    }) : null,
    h(CrNumField, {
      label: "Corner", hint: "Pixels, 0 to 24. 0 is square, 24 is a pill.",
      value: typeof s.corner === "number" ? s.corner : 14,
      onSet: (n: number) => { props.onSet("corner", n); }
    }),
    h(CrNumField, {
      label: "Padding", hint: "Pixels, 0 to 16. The space between the text and the edge.",
      value: typeof s.pad === "number" ? s.pad : 10,
      onSet: (n: number) => { props.onSet("pad", n); }
    }),
    h(CrNumField, {
      label: "Glow", hint: "Blur radius in pixels, 0 to 40. 0 is off.",
      value: typeof s.glow === "number" ? s.glow : 0,
      onSet: (n: number) => { props.onSet("glow", n); }
    }),
    (typeof s.glow === "number" && s.glow > 0) ? h(CrColour, {
      label: "Glow colour", value: s.glowColour || "",
      onSet: (v: string) => { props.onSet("glowColour", v); }
    }) : null
  );
}

function CrBubblePreview(props: { char?: Character }) : any
{
  const name = props.char ? props.char.name : "Contact";
  const user = crLiveUser();
  const userName = user ? user.name : "You";
  const cStyle = crBubbleStyle(crBubbleSideFor(props.char, "contact"));
  const uStyle = crBubbleStyle(crBubbleSideFor(props.char, "user"));
  const line = (style: Record<string, string>, text: string) =>
    h("div", { style: Object.assign({
      color: CR_TEXT, fontSize: CR_T_MD, lineHeight: "1.5", whiteSpace: "pre-wrap"
    }, style) }, text);
  return h("div", {
    style: {
      marginTop: CR_S_3, display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_3,
      background: CR_SUNK, border: CR_LINE_W + " solid " + CR_LINE,
      borderRadius: CR_RADIUS_S, padding: CR_S_4
    }
  },
    line(cStyle, name + ": It reads like this, at whatever length the reply happens to be."),
    crBubbleFlag(props.char, "emotionLine") ? line(cStyle, "Emotion: neutral") : null,
    line(uStyle, "{ " + userName + ": and this is your turn }")
  );
}

function CrGlobalBubblesTab() : any
{
  const char = crLiveContact();
  const which = crBubbleTab;
  const side: CrBubbleSide = (crBubbles as any)[which] || {};
  return h("div", { class: "cr-global-bubbles" },
    h(CrSection, {
      title: "Chat bubbles",
      note: "A look for each side of the conversation, painted on the turns themselves. These are the account's defaults; any Contact can override them from their Visuals tab."
    },
      h("div", { style: { display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_4, marginTop: CR_S_3 } },
        h(CrChoice, {
          label: "Bubbles",
          hint: "Off leaves the editor exactly as NovelAI draws it.",
          options: [{ id: "off", label: "Off" }, { id: "on", label: "On" }],
          active: crBubbles.on ? "on" : "off",
          onPick: (id: string) => { crSetBubbleFlag("on", id === "on").catch(() => {}); }
        }),
        h(CrChoice, {
          label: "The emotion line",
          hint: "Whether the Emotion line under a reply wears the same bubble. It is its own paragraph, so it is its own decision.",
          options: [{ id: "off", label: "Bare" }, { id: "on", label: "In the bubble" }],
          active: crBubbles.emotionLine === false ? "off" : "on",
          onPick: (id: string) => { crSetBubbleFlag("emotionLine", id === "on").catch(() => {}); }
        }),
        h(CrBubblePreview, { char: char })
      )
    ),
    h("div", { style: { marginTop: CR_S_4 } },
      h(CrTabs, {
        tabs: [{ id: "contact", label: "Their turns" }, { id: "user", label: "Your turns" }],
        active: which, mobile: crUiStore.get().layout === "mobile",
        onPick: (id: string) => { crBubbleTab = (id === "user" ? "user" : "contact"); crTouch(); }
      }),
      h(CrBubbleSideEditor, {
        side: crBubbleSideFor(undefined, which),
        onSet: (field: string, value: any) => { crSetBubbleField(which, field, value).catch(() => {}); }
      })
    )
  );
}

function CrContactBubbles(props: { char: Character }) : any
{
  const char = props.char;
  const which = crBubbleTab;
  const overridden = crHasBubbleOverride(char);
  return h(CrSection, {
    title: "Bubbles for this Contact",
    note: overridden
      ? "This Contact has its own look. Every field you have not touched still follows the account default."
      : "Following the account default. Changing anything here starts an override for this Contact only."
  },
    h("div", { style: { display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_4, marginTop: CR_S_3 } },
      h(CrBubblePreview, { char: char }),
      h(CrChoice, {
        label: "Bubbles",
        hint: "Overrides the account setting for this Contact's chats.",
        options: [{ id: "off", label: "Off" }, { id: "on", label: "On" }],
        active: crBubbleFlag(char, "on") ? "on" : "off",
        onPick: (id: string) => { crSetContactBubbleFlag(char, "on", id === "on").catch(() => {}); }
      }),
      h(CrTabs, {
        tabs: [{ id: "contact", label: "Their turns" }, { id: "user", label: "Your turns" }],
        active: which, mobile: crUiStore.get().layout === "mobile",
        onPick: (id: string) => { crBubbleTab = (id === "user" ? "user" : "contact"); crTouch(); }
      }),
      h(CrBubbleSideEditor, {
        side: crBubbleSideFor(char, which),
        onSet: (field: string, value: any) => {
          crSetContactBubbleField(char, which, field, value).catch(() => {});
        }
      }),
      overridden ? h("div", { style: { display: "flex", gap: CR_S_2, flexWrap: "wrap" } },
        h(CrButton, {
          text: "Follow the account default again",
          onClick: () => { crClearContactBubbles(char).catch(() => {}); }
        })
      ) : null
    )
  );
}

async function crSetContactBubbleFlag(char: Character, field: "on" | "emotionLine", value: boolean) : Promise<void>
{
  const extra: CrContactExtra = char.cr || {};
  const look: CrBubbleLook = extra.bubbles || {};
  (look as any)[field] = value === true;
  extra.bubbles = look;
  char.cr = crSanitizeContactExtra(extra);
  try{ await saveCharList(); }
  catch (e){ api.v1.error("[CR:bubble] could not save the Contact's look:", e); }
  await crBubbleApply();
  crTouch();
}

// ============================================================================
// SECTION CR-UI — SHELL WINDOW AND SURFACES
// ============================================================================
// [KIT-FROM-CE]
function crVar(name: string, fallback: string) : string
{
  return "var(--cr-" + name + ", " + fallback + ")";
}

const CR_BG      = crVar("bg",        "var(--theme-bg1, #16161c)");
const CR_RAIL    = crVar("rail",      "var(--theme-bg0, #101015)");
const CR_SURFACE = crVar("surface",   "var(--theme-bg2, #1e1e26)");
const CR_SUNK    = crVar("sunk",      "var(--theme-bg3, #0c0c11)");
const CR_TEXT    = crVar("text",      "var(--theme-textMain, #d6d6de)");
const CR_HEAD    = crVar("text-head", "var(--theme-textHeadings, #f2f2f7)");
const CR_DIM     = crVar("text-dim",  "var(--theme-textDisabled, #83838f)");
const CR_ACCENT  = crVar("accent",    "var(--theme-textAI, #7c9cf5)");
const CR_WARN    = crVar("warn",      "var(--theme-warning, #e0a35a)");
const CR_LINE    = crVar("line",      "color-mix(in srgb, currentColor 14%, transparent)");
const CR_FILL    = crVar("fill",      "color-mix(in srgb, currentColor 7%, transparent)");
const CR_FILL2   = crVar("fill-2",    "color-mix(in srgb, currentColor 13%, transparent)");
const CR_RADIUS  = crVar("radius",    "14px");
const CR_RADIUS_S= crVar("radius-sm", "9px");
const CR_AVATAR  = crVar("avatar-radius", "50%");
const CR_FONT    = crVar("font",      "var(--theme-fontDefault, inherit)");

const CR_STAGE_BG    = crVar("stage-bg",    "#0b0b10");
const CR_STAGE_TEXT  = crVar("stage-text",  "#f3f3f8");
const CR_STAGE_SCRIM = crVar("stage-scrim",
  "linear-gradient(to bottom, rgba(0,0,0,0) 0%, rgba(0,0,0,0.72) 34%, rgba(0,0,0,0.92) 100%)");

const CR_T_XS   = crVar("t-xs",   "10.5px");
const CR_T_SM   = crVar("t-sm",   "11.5px");
const CR_T_MD   = crVar("t-md",   "12.5px");
const CR_T_BASE = crVar("t-base", "13px");
const CR_T_LG   = crVar("t-lg",   "16px");
const CR_T_XL   = crVar("t-xl",   "18px");

const CR_S_1 = crVar("s-1", "3px");
const CR_S_2 = crVar("s-2", "6px");
const CR_S_3 = crVar("s-3", "8px");
const CR_S_4 = crVar("s-4", "12px");
const CR_S_5 = crVar("s-5", "16px");

const CR_HOVER = crVar("fill-hover", "color-mix(in srgb, currentColor 10%, transparent)");
const CR_PRESS = crVar("fill-press", "color-mix(in srgb, currentColor 20%, transparent)");
const CR_MOTION = crVar("motion", "background-color 90ms ease, border-color 90ms ease, transform 60ms ease");

const CR_LINE_W   = crVar("line-w",       "1px");
const CR_BTN_PAD  = crVar("btn-pad",      "7px 14px");
const CR_BTN_PAD_I= crVar("btn-pad-icon", "6px");
const CR_TAP      = crVar("tap",          "32px");
const CR_PAD_CTL  = crVar("pad-ctl",      "7px 9px");
const CR_ICON     = crVar("icon",         "16px");

const CR_CARD_MEDIA   = crVar("card-media",   "112px");
const CR_CARD_MEDIA_D = crVar("card-media-d", "clamp(128px, 12vw, 184px)");
const CR_CARD_H       = crVar("card-h",       "88px");
const CR_CARD_H_D     = crVar("card-h-d",     "clamp(98px, 9vw, 136px)");
const CR_CARD_FADE    = crVar("card-fade",    "56%");

const CR_POST_MEDIA      = crVar("post-media",      "200px");
const CR_POST_MEDIA_OPEN = crVar("post-media-open", "340px");

const CR_DIE       = crVar("die",       "var(--cr-text-head, var(--theme-textHeadings, #f2f2f7))");
const CR_DIE_ETCH  = crVar("die-etch",  "var(--cr-text-dim, var(--theme-textDisabled, #83838f))");
const CR_DIE_BOX   = crVar("die-box",   "46px");
const CR_DIE_BOX_S = crVar("die-box-sm","30px");
const CR_DIE_FADE  = crVar("die-fade",  "0.28");

const CR_BAND_1 = crVar("band-1", "#5fb374");
const CR_BAND_2 = crVar("band-2", "#93c47d");
const CR_BAND_3 = crVar("band-3", "#dfae4e");
const CR_BAND_4 = crVar("band-4", "#d1705a");

const CR_RIBBON_H   = crVar("ribbon-h",   "5px");
const CR_METER_H    = crVar("meter-h",    "8px");
const CR_PIP        = crVar("pip",        "11px");
const CR_LADDER_BAR = crVar("ladder-bar", "72px");
const CR_LADDER_PCT = crVar("ladder-pct", "42px");

const CR_MOTION_ROLL = crVar("motion-roll",
  "transform 560ms cubic-bezier(0.17, 0.84, 0.34, 1.04), opacity 200ms linear");
const CR_MOTION_BAR  = crVar("motion-bar", "width 420ms cubic-bezier(0.2, 0.8, 0.3, 1)");

type CrSurface = "chat" | "cards" | "illustrator" | "jots" | "global" | "games";

type CrLayout = "mobile" | "desktop";
const CR_LAYOUT_KEY = "crShellLayoutKey";
await api.v1.storage.setIfAbsent(CR_LAYOUT_KEY, "mobile");
const crStoredLayout: CrLayout = (await api.v1.storage.get(CR_LAYOUT_KEY)) === "desktop" ? "desktop" : "mobile";

type CrUiState = {
  rev: number;
  layout: CrLayout;
  surface: CrSurface;
  cardTab: string;
  openContactId: string;
  openKind: string;
  profileTab: string;
  globalTab: string;
  chatTab: string;
};

const crUiStore = createStore<CrUiState>({
  rev: 0,
  layout: crStoredLayout,
  surface: "cards",
  cardTab: "contacts",
  openContactId: "",
  openKind: "contact",
  profileTab: "posts",
  globalTab: "general",
  chatTab: "chat"
});

let crShellHandle: any = null;

async function crSetLayout(layout: CrLayout) : Promise<void>
{
  crNav({ layout: layout });
  try{
    await api.v1.storage.set(CR_LAYOUT_KEY, layout);
  }
  catch (e){
    api.v1.error("[CR:ui] could not store the layout setting:", e);
  }
}

function crNav(patch: Partial<CrUiState>)
{
  const cur = crUiStore.get();
  crUiStore.set(Object.assign({}, cur, patch));
}

function crTouch()
{
  const cur = crUiStore.get();
  crUiStore.set(Object.assign({}, cur, { rev: cur.rev + 1 }));
}

function crInitials(name: string) : string
{
  const parts = String(name || "?").trim().split(/\s+/);
  if (parts.length === 1){
    return parts[0].slice(0, 2).toUpperCase();
  }
  return (parts[0].charAt(0) + parts[parts.length - 1].charAt(0)).toUpperCase();
}

function crAvatarSize(px: number, mobile: boolean, token: string, minPx: number, vw: number, maxPx: number) : string
{
  if (mobile){
    return px + "px";
  }
  return crVar(token, "clamp(" + minPx + "px, " + vw + "vw, " + maxPx + "px)");
}

function crImgAnchor(charId: string, slot: string, opts?: string, style?: any) : any
{
  const attrs: any = {
    class: "cr-img-anchor",
    style: style || { width: "100%", height: "100%", display: "block" }
  };
  const opt = opts ? String(opts).replace(/\|/g, ",") : "";
  attrs[CR_IMG_ATTR] = charId + "|" + slot + (opt ? "|" + opt : "");
  return h("div", attrs);
}

function CrAvatar(props: { src?: string; name: string; size: number | string; charId?: string;
                          slot?: string }) : any
{
  const size = props.size;
  const isNum = typeof size === "number";
  const len = isNum ? (size + "px") : String(size);
  const base: any = {
    width: len, height: len, borderRadius: CR_AVATAR,
    flex: "0 0 auto", overflow: "hidden", display: "grid", placeItems: "center",
    background: CR_FILL2, color: CR_DIM, position: "relative",
    fontSize: isNum ? (Math.round((size as number) / 2.8) + "px") : "calc(" + len + " / 2.8)",
    fontWeight: "600",
    border: CR_LINE_W + " solid " + CR_LINE
  };
  const inner = (props.src && props.src.indexOf("data:") === 0)
    ? h("img", { src: props.src, alt: props.name,
                 style: { width: "100%", height: "100%", objectFit: "cover", display: "block" } })
    : h("span", { style: { display: "block" } }, crInitials(props.name));
  if (props.charId){
    // A Scenario has no Avatar slot — its one picture is the Banner (D-46) — so the slot is a
    // prop rather than a constant, and a card whose portrait lives elsewhere can say so.
    return h("div", { class: "cr-avatar", style: base },
      crImgAnchor(props.charId, props.slot || CR_SLOT_AVATAR, "fit=cover,shrink=1",
        { position: "absolute", inset: "0", width: "100%", height: "100%", display: "block" }),
      inner
    );
  }
  return h("div", { class: "cr-avatar" + (props.src ? "" : " cr-avatar-empty"), style: base }, inner);
}

function CrPill(props: { text: string; tone?: string }) : any
{
  const tone = props.tone === "accent" ? CR_ACCENT : (props.tone === "warn" ? CR_WARN : CR_DIM);
  return h("span", {
    class: "cr-pill",
    style: {
      display: "inline-block", padding: "2px 9px", borderRadius: "999px",
      border: CR_LINE_W + " solid " + CR_LINE, background: CR_FILL,
      color: tone, fontSize: CR_T_SM, letterSpacing: "0.02em", whiteSpace: "nowrap"
    }
  }, props.text);
}

