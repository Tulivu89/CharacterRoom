function crkRollDefault(): CrkRoll { return { startIndex: 0, pathIdList: [], checkInitialTrim: true, trimmed: false }; }
function crkRollReset(roll: CrkRoll): void { roll.startIndex = 0; roll.pathIdList = []; }

function crkHasList(list: any): boolean { return !!(list && list.length > 0); }

const CRK_JOTS_NAME = "Jots";

// The seed inside an open <think>. A numbered opener puts the model in the enumerated
// reasoning trace it was trained on; the tag alone reasons unnumbered.

const crkFormatTime = (m: number) => {
  const h = Math.floor(m / 60).toString().padStart(2, '0');
  const min = (m % 60).toString().padStart(2, '0');
  return `${h}:${min}`;
};

