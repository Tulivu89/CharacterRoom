  trash:    ["M4 7h16", "M9.5 7V4.5h5V7", "M6.5 7l1 12.5h9l1-12.5", "M10 10.5v6", "M14 10.5v6"],
  pencil:   ["M4 20l4.2-1.1 9.4-9.4a1.8 1.8 0 0 0 0-2.5l-1.1-1.1a1.8 1.8 0 0 0-2.5 0L4.6 15.3z", "M13 6.6l4.4 4.4"],
  plus:     ["M12 5v14", "M5 12h14"],
  close:    ["M6 6l12 12", "M18 6L6 18"],
  check:    ["M5 12.5l4.5 4.5L19 7"],
  download: ["M12 4v11", "M7.5 10.5l4.5 4.5 4.5-4.5", "M5 19.5h14"],
  upload:   ["M12 19.5V8.5", "M7.5 13L12 8.5 16.5 13", "M5 4.5h14"],
  "import": ["M20 12H9", "M13 8l-4 4 4 4", "M4.5 4.5v15"],
  "export": ["M4 12h11", "M11 8l4 4-4 4", "M19.5 4.5v15"],
  back:     ["M15 5l-7 7 7 7"],
  camera:   ["M4 8.5h3.2L8.7 6.4h6.6l1.5 2.1H20v10H4z", "M15.2 13.4a3.2 3.2 0 1 1-6.4 0 3.2 3.2 0 0 1 6.4 0"],
  comment:  ["M20 12.3c0 3.5-3.6 6.4-8 6.4-.9 0-1.8-.12-2.6-.35L4.5 20l1.4-3.2C4.7 15.6 4 14 4 12.3 4 8.8 7.6 6 12 6s8 2.8 8 6.3z"],
  dots:     ["M12 5.3a1.15 1.15 0 1 1 0 2.3 1.15 1.15 0 0 1 0-2.3", "M12 10.85a1.15 1.15 0 1 1 0 2.3 1.15 1.15 0 0 1 0-2.3", "M12 16.4a1.15 1.15 0 1 1 0 2.3 1.15 1.15 0 0 1 0-2.3"],
  bookmark: ["M6.5 4.5h11v15l-5.5-4.1-5.5 4.1z"],
  spark:    ["M12 4.4l1.9 4.8 4.8 1.9-4.8 1.9L12 17.8l-1.9-4.8-4.8-1.9 4.8-1.9z"],
  list:     ["M5 7h14", "M5 12h14", "M5 17h9"],
