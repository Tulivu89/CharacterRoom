    h("div", { style: { marginTop: CR_S_4 } },
      tab === "editor" ? h(CrGlobalEditorTab, null)
        : tab === "bubbles" ? h(CrGlobalBubblesTab, null)
        : tab === "report" ? h(CrGlobalReportTab, null)
        : h(CrGlobalGeneralTab, { st: props.st })
