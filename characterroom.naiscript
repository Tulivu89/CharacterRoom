// ============================================================================
// SECTION CR-SIDEGEN — THE SIDE-GENERATION DEPTH COUNTER
// ============================================================================

let crSideGenDepth = 0;

function crSideGenBusy() : boolean { return crSideGenDepth > 0; }

// api.v1.generate fires this script's own hooks; the depth counter keeps CR's tail out of them.
async function crSideGenerate(...args: any[]) : Promise<any>
{
  crSideGenDepth++;
  try{
    return await (api.v1.generate as any).apply(null, args);
  }
  finally{
    crSideGenDepth--;
    if (crSideGenDepth < 0){
      crSideGenDepth = 0;
    }
  }
}

let crGroupGenDepth = 0;
let crGroupBuildChar: Character | null = null;

// An auto grid column grows to its longest nowrap child; this keeps it inside the card.
const CR_GRID_COL = "minmax(0, 1fr)";

const crSerialState: { [key: string]: { running: Promise<void> | null; again: boolean } } = {};
// Dispose, scan, create passes must not overlap or they leak each other's handles.
function crSerial(key: string, fn: () => Promise<void>) : Promise<void>
{
  const st = crSerialState[key] || (crSerialState[key] = { running: null, again: false });
  if (st.running){
    st.again = true;
    return st.running;
  }
  st.running = (async () => {
    try{
      do {
        st.again = false;
        await fn();
      } while (st.again);
    }
    finally{
      st.running = null;
    }
  })();
  return st.running;
}
const crGroupSaw = { before: false, built: false };

