  image:    ["M4.5 5.5h15v13h-15z", "M4.5 15.2l4.6-4.4 3.4 3.3 2.6-2.1 4.4 4", "M10 9.1a1.3 1.3 0 1 1-2.6 0 1.3 1.3 0 0 1 2.6 0"],
  eye:      ["M2.6 12S6.4 6.6 12 6.6 21.4 12 21.4 12 17.6 17.4 12 17.4 2.6 12 2.6 12z", "M14.5 12a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0"],
  help:     ["M20 12a8 8 0 1 1-16 0 8 8 0 0 1 16 0", "M9.7 9.6a2.35 2.35 0 1 1 3.2 2.2c-.6.25-.9.75-.9 1.35v.35", "M12 16.3v.05"],
  dot:      ["M13 12a1 1 0 1 1-2 0 1 1 0 0 1 2 0"],
  minus:    ["M5 12h14"],
  dice:     ["M5.5 5.5h13v13h-13z", "M9.7 9.2a.9.9 0 1 1-1.8 0 .9.9 0 0 1 1.8 0", "M12.9 12a.9.9 0 1 1-1.8 0 .9.9 0 0 1 1.8 0", "M16.1 14.8a.9.9 0 1 1-1.8 0 .9.9 0 0 1 1.8 0"]
};

function CrIcon(props: { name: string; size?: string }) : any
{
  const paths = CR_ICON_PATHS[props.name] || CR_ICON_PATHS.dot;
  const len = props.size || CR_ICON;
  return h("svg", {
    class: "cr-icon cr-icon-" + props.name,
    viewBox: "0 0 24 24", width: len, height: len,
    fill: "none", stroke: "currentColor",
    "stroke-width": "1.7", "stroke-linecap": "round", "stroke-linejoin": "round",
    "aria-hidden": "true",
    style: { display: "block", flex: "0 0 auto", overflow: "visible" }
  }, paths.map((d, i) => h("path", { key: "p" + i, d: d })));
}

const CR_VERB_ICONS: { [k: string]: string } = {
  "delete": "trash", "delete for good": "trash", "remove": "trash", "remove line": "trash",
  "remove photo": "trash", "clear": "trash", "discard": "trash",
  "edit": "pencil", "edit photo": "pencil", "rename": "pencil",
  "close": "close", "cancel": "close",
  "save": "check", "done": "check", "accept": "check",
  "download": "download", "upload": "upload",
  "new photo": "camera", "add a photo": "camera", "generate from this": "camera",
  "read": "eye", "reflect": "spark", "plan": "list", "process": "spark", "imitate": "spark",
  "keep on the profile": "bookmark", "return to this chat": "bookmark",
  "another comment": "comment", "add a comment": "comment"
};

const CR_VERB_ICON_ONLY: { [k: string]: boolean } = {
  "delete": true, "remove": true, "remove line": true, "edit": true,
  "close": true, "cancel": true, "save": true, "add": true, "new": true
};

function crVerbKey(text: string) : string
{
  return String(text || "").trim().toLowerCase().replace(/[\u2026.?!]+$/, "").trim();
}

function crVerbIcon(text: string) : string
{
  const key = crVerbKey(text);
  if (CR_VERB_ICONS[key]){
    return CR_VERB_ICONS[key];
  }
  if (/^(add|new)\b/.test(key)){
    return "plus";
  }
  if (/^back\b/.test(key)){
    return "back";
  }
  if (/^import\b/.test(key)){
    return "import";
  }
  if (/^export\b/.test(key)){
    return "export";
  }
  return "";
}

function CrButton(props: { text: string; onClick?: () => void; primary?: boolean; disabled?: boolean;
                          icon?: string; iconOnly?: boolean; tone?: string; title?: string }) : any
{
  const [hover, setHover] = useState(false);
  const [press, setPress] = useState(false);
  const off = props.disabled === true;
  const icon = (props.icon !== undefined) ? String(props.icon) : crVerbIcon(props.text);
  const only = props.iconOnly === true
    || ((props.icon === undefined) && icon !== "" && CR_VERB_ICON_ONLY[crVerbKey(props.text)] === true);
  const tone = props.tone === "warn" ? CR_WARN : (props.primary ? CR_ACCENT : CR_TEXT);
  let bg = props.primary ? CR_FILL2 : "transparent";
  if (!off && press){
    bg = CR_PRESS;
  }
  else if (!off && hover){
    bg = CR_HOVER;
  }
  const edge = props.primary ? CR_ACCENT : ((hover && !off) ? CR_ACCENT : CR_LINE);
  const inner = icon
    ? [h(CrIcon, { name: icon }), only ? null : h("span", { style: { display: "block" } }, props.text)]
    : [props.text];
  return h("button", {
    class: "cr-btn" + (props.primary ? " cr-btn-primary" : "") + (only ? " cr-btn-icon" : "")
      + (press ? " cr-btn-press" : ""),
    disabled: off,
    title: props.title || props.text,
    "aria-label": props.text,
    onClick: props.onClick,
    onPointerEnter: () => { if (!off){ setHover(true); } },
    onPointerLeave: () => { setHover(false); setPress(false); },
    onPointerDown: () => { if (!off){ setPress(true); } },
    onPointerUp: () => { setPress(false); },
    onPointerCancel: () => { setPress(false); },
    style: {
      appearance: "none", cursor: off ? "default" : "pointer",
      padding: only ? CR_BTN_PAD_I : CR_BTN_PAD, borderRadius: CR_RADIUS_S,
      border: CR_LINE_W + " solid " + edge,
      background: bg,
      color: off ? CR_DIM : tone,
      font: "inherit", fontSize: CR_T_BASE, opacity: off ? "0.55" : "1",
      minWidth: only ? CR_TAP : "0", minHeight: only ? CR_TAP : "0",
      display: "inline-flex", alignItems: "center", justifyContent: "center",
      gap: (icon && !only) ? CR_S_2 : "0",
      whiteSpace: "nowrap", flexShrink: "0",
      maxWidth: "100%", overflow: "hidden", textOverflow: "ellipsis",
      transition: CR_MOTION,
      transform: (press && !off) ? "translateY(1px)" : "none",
      touchAction: "manipulation"
    }
  }, inner);
}

function CrIconButton(props: { icon: string; label: string; onClick?: () => void; disabled?: boolean;
                              primary?: boolean; tone?: string }) : any
{
  return h(CrButton, {
    text: props.label, icon: props.icon, iconOnly: true,
    onClick: props.onClick, disabled: props.disabled, primary: props.primary, tone: props.tone
  });
}

function CrMenuRow(props: { icon: string; label: string; note?: string; onClick?: () => void;
                            disabled?: boolean; tone?: string }) : any
{
  const off = props.disabled === true;
  const tone = props.tone === "warn" ? CR_WARN : CR_TEXT;
  return h(CrPressable, {
    render: (hover: boolean, press: boolean, handlers: any) => h("button", Object.assign({
      class: "cr-menu-row",
      disabled: off,
      onClick: props.onClick,
      style: {
        appearance: "none", width: "100%", textAlign: "left",
        display: "flex", alignItems: "center", gap: CR_S_3,
        padding: CR_S_4, borderRadius: CR_RADIUS_S,
        border: CR_LINE_W + " solid " + ((hover && !off) ? CR_ACCENT : CR_LINE),
        background: off ? "transparent" : crPressBg(hover, press, "transparent"),
        color: off ? CR_DIM : tone,
        font: "inherit", fontSize: CR_T_BASE,
        cursor: off ? "default" : "pointer",
        transition: CR_MOTION,
        transform: (press && !off) ? "translateY(1px)" : "none",
        touchAction: "manipulation"
      }
    }, off ? {} : handlers),
      h(CrIcon, { name: props.icon }),
      h("div", { style: { display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_1, minWidth: "0" } },
        h("div", { style: { fontSize: CR_T_BASE } }, props.label),
        props.note ? h("div", { style: { color: CR_DIM, fontSize: CR_T_SM, lineHeight: "1.4",
                                         whiteSpace: "normal" } }, props.note) : null
      )
    )
  });
}

function CrPressable(props: { render: (hover: boolean, press: boolean, handlers: any) => any }) : any
{
  const [hover, setHover] = useState(false);
  const [press, setPress] = useState(false);
  const handlers = {
    onPointerEnter: () => setHover(true),
    onPointerLeave: () => { setHover(false); setPress(false); },
    onPointerDown: () => setPress(true),
    onPointerUp: () => setPress(false),
    onPointerCancel: () => setPress(false)
  };
  return props.render(hover, press, handlers);
}

function crPressBg(hover: boolean, press: boolean, base: string) : string
{
  if (press){
    return CR_PRESS;
  }
  if (hover){
    return CR_HOVER;
  }
  return base;
}

function CrTabs(props: { tabs: { id: string; label: string }[]; active: string; onPick: (id: string) => void; mobile?: boolean }) : any
{
  const mob = props.mobile === true;
  return h("div", {
    class: "cr-tabs",
    style: {
      display: "flex", gap: CR_S_1, overflowX: "auto",
      borderBottom: CR_LINE_W + " solid " + CR_LINE, padding: "0 2px",
      scrollbarWidth: "none", WebkitOverflowScrolling: "touch"
    }
  }, props.tabs.map((t) => {
    const on = t.id === props.active;
    return h("button", {
      key: t.id,
      class: "cr-tab" + (on ? " cr-tab-on" : ""),
      onClick: () => props.onPick(t.id),
      style: {
        appearance: "none", cursor: "pointer", background: "transparent",
        border: "none", borderBottom: "calc(" + CR_LINE_W + " * 2) solid " + (on ? CR_ACCENT : "transparent"),
        color: on ? CR_HEAD : CR_DIM, font: "inherit",
        fontSize: mob ? CR_T_MD : CR_T_BASE,
        fontWeight: on ? "600" : "400",
        padding: mob ? "9px 10px" : "10px 14px", whiteSpace: "nowrap"
      }
    }, t.label);
  }));
}

function CrField(props: { label?: string; hint?: string; children?: any }) : any
{
  return h("label", { class: "cr-field", style: { display: "block", minWidth: "0" } },
    props.label ? h("div", {
      style: { color: CR_DIM, fontSize: CR_T_SM, marginBottom: CR_S_1 }
    }, props.label) : null,
    props.children || null,
    props.hint ? h("div", {
      style: { color: CR_DIM, fontSize: CR_T_SM, marginTop: CR_S_1, lineHeight: "1.45" }
    }, props.hint) : null
  );
}

function crInputStyle(size: string) : any
{
  return {
    width: "100%", boxSizing: "border-box",
    background: CR_SUNK, color: CR_TEXT, font: "inherit", fontSize: size,
    border: CR_LINE_W + " solid " + CR_LINE, borderRadius: CR_RADIUS_S, padding: CR_PAD_CTL
  };
}

function CrTextInput(props: { value: string; placeholder?: string; onSet: (v: string) => void }) : any
{
  return h("input", {
    type: "text",
    value: props.value,
    placeholder: props.placeholder || "",
    onChange: (e: any) => { props.onSet(String(e.target.value || "")); },
    style: crInputStyle(CR_T_BASE)
  });
}

function CrChoice(props: {
  label?: string; hint?: string; options: { id: string; label: string }[];
  active: string; onPick: (id: string) => void;
}) : any
{
  return h(CrField, { label: props.label, hint: props.hint },
    h("div", { style: { display: "flex", gap: CR_S_2, flexWrap: "wrap", marginTop: props.label ? "0" : CR_S_1 } },
      props.options.map((o) => h(CrButton, {
        key: o.id,
        text: o.label,
        icon: "",
        primary: o.id === props.active,
        onClick: () => props.onPick(o.id)
      }))
    )
  );
}

function CrStepper(props: { label?: string; value: number; text?: string; name?: string;
                            onSet: (n: number) => void; disabled?: boolean }) : any
{
  const what = props.name || props.label || "value";
  const body = h("div", { class: "cr-stepper", style: { display: "flex", alignItems: "center", gap: CR_S_2 } },
    h(CrIconButton, { icon: "minus", label: "Lower " + what, disabled: props.disabled,
                      onClick: () => props.onSet(props.value - 1) }),
    h("div", { style: { minWidth: CR_TAP, textAlign: "center", color: CR_HEAD,
                        fontSize: CR_T_BASE, fontWeight: "600", whiteSpace: "nowrap" } },
      props.text !== undefined ? props.text : String(props.value)),
    h(CrIconButton, { icon: "plus", label: "Raise " + what, disabled: props.disabled,
                      onClick: () => props.onSet(props.value + 1) })
  );
  return props.label ? h(CrField, { label: props.label }, body) : body;
}

type CrMeterLook = "auto" | "bar" | "pips" | "plain";

// A count is drawn, not just printed. Small pools read better as pips than as a bar —
// three Fate points are three things, not 60% of something — so "auto" picks by size.
function CrMeter(props: { value: number; max: number; colour: string; look?: CrMeterLook }) : any
{
  const max = Math.max(0, Math.round(props.max));
  const val = Math.max(0, Math.min(max, Math.round(props.value)));
  const look = (!props.look || props.look === "auto") ? (max > 0 && max <= 12 ? "pips" : "bar") : props.look;
  if (look === "plain" || max <= 0){
    return null;
  }
  if (look === "pips"){
    const pips: any[] = [];
    for (let i = 0; i < max; i++){
      pips.push(h("span", {
        key: String(i),
        style: { width: CR_PIP, height: CR_PIP, borderRadius: "50%", display: "block", flex: "0 0 auto",
                 background: i < val ? props.colour : "transparent",
                 border: CR_LINE_W + " solid " + (i < val ? props.colour : CR_LINE),
                 transition: CR_MOTION }
      }));
    }
    return h("div", { class: "cr-meter cr-meter-pips",
      style: { display: "flex", gap: CR_S_1, flexWrap: "wrap", alignItems: "center" } }, pips);
  }
  return h("div", { class: "cr-meter cr-meter-bar",
    style: { height: CR_METER_H, borderRadius: CR_METER_H, background: CR_SUNK,
             overflow: "hidden", border: CR_LINE_W + " solid " + CR_LINE } },
    h("span", { style: { display: "block", height: "100%", background: props.colour,
                         width: (max ? (val / max) * 100 : 0).toFixed(1) + "%",
                         transition: CR_MOTION_BAR } })
  );
}

function CrEmpty(props: { text: string }) : any
{
  return h("div", {
    class: "cr-empty",
    style: { color: CR_DIM, fontSize: CR_T_BASE, padding: "28px 4px", textAlign: "center" }
  }, props.text);
}

let crHeadNote: { [k: string]: boolean } = {};

function CrHeading(props: { id: string; title: string; note?: string; children?: any }) : any
{
  const open = crHeadNote[props.id] === true;
  return h("div", { class: "cr-heading" },
    h("div", {
      style: {
        display: "flex", alignItems: "center", gap: CR_S_2,
        borderBottom: CR_LINE_W + " solid " + CR_LINE, paddingBottom: CR_S_2, marginBottom: CR_S_3
      }
    },
      h("div", { style: { color: CR_HEAD, fontSize: CR_T_BASE, fontWeight: "600" } }, props.title),
      h("div", { style: { flex: "1 1 auto" } }),
      props.note ? h(CrIconButton, {
        icon: open ? "close" : "help",
        label: open ? "Hide the note" : "What is this?",
        onClick: () => { crHeadNote[props.id] = !open; crTouch(); }
      }) : null
    ),
    (props.note && open) ? h("div", {
      style: { color: CR_DIM, fontSize: CR_T_MD, lineHeight: "1.5", marginBottom: CR_S_3 }
    }, props.note) : null,
    props.children || null
  );
}

function CrSection(props: { title: string; note?: string; children?: any }) : any
{
  return h("section", {
    class: "cr-section",
    style: {
      background: CR_SURFACE, border: CR_LINE_W + " solid " + CR_LINE, borderRadius: CR_RADIUS,
      padding: "14px 16px", marginBottom: CR_S_4
    }
  },
    h("div", { style: { color: CR_HEAD, fontSize: CR_T_BASE, fontWeight: "600", marginBottom: props.note || props.children ? "8px" : "0" } }, props.title),
    props.note ? h("div", { style: { color: CR_DIM, fontSize: CR_T_MD, lineHeight: "1.5" } }, props.note) : null,
    props.children || null
  );
}

function CrCardRow(props: { name: string; handle: string; blurb: string; avatar?: string; charId?: string; slot?: string; onOpen?: () => void; mobile?: boolean }) : any
{
  const mob = props.mobile === true;
  const tap = props.onOpen;
  const media = mob ? CR_CARD_MEDIA : CR_CARD_MEDIA_D;
  const rowH = mob ? CR_CARD_H : CR_CARD_H_D;
  const fade = "linear-gradient(to right, #000 " + CR_CARD_FADE + ", rgba(0,0,0,0) 100%)";
  const stored = props.charId
    ? crImgAnchor(props.charId, props.slot || CR_SLOT_AVATAR, "fit=cover,shrink=1",
        { position: "absolute", inset: "0", width: "100%", height: "100%", display: "block" })
    : null;
  const fallback = (props.avatar && props.avatar.indexOf("data:") === 0)
    ? h("img", { src: props.avatar, alt: props.name,
                 style: { position: "absolute", inset: "0", width: "100%", height: "100%",
                          objectFit: "cover", display: "block" } })
    : h("span", { style: { position: "relative", color: CR_DIM, fontWeight: "600",
                           fontSize: "calc(" + media + " / 3.6)" } }, crInitials(props.name));
  const body = (hover: boolean, press: boolean, handlers: any) => h("div", Object.assign({
    class: "cr-card-row" + (tap ? " cr-card-row-tap" : "") + (press ? " cr-card-row-press" : ""),
    onClick: tap,
    style: {
      position: "relative", display: "flex", alignItems: "stretch", overflow: "hidden",
      minHeight: rowH,
      background: tap ? crPressBg(hover, press, CR_SURFACE) : CR_SURFACE,
      border: CR_LINE_W + " solid " + ((tap && hover) ? CR_ACCENT : CR_LINE),
      borderRadius: CR_RADIUS, marginBottom: CR_S_3,
      cursor: tap ? "pointer" : "default",
      transform: (tap && press) ? "translateY(1px)" : "none",
      transition: CR_MOTION, touchAction: "manipulation"
    }
  }, tap ? handlers : {}),
    h("div", {
      class: "cr-card-media",
      style: {
        position: "absolute", left: "0", top: "0", bottom: "0", width: media,
        display: "grid", placeItems: "center", background: CR_FILL2, overflow: "hidden",
        maskImage: fade, WebkitMaskImage: fade
      }
    }, fallback, stored),
    h("div", {
      class: "cr-card-body",
      style: {
        position: "relative", flex: "1 1 auto", minWidth: "0",
        paddingLeft: "calc(" + media + " * 0.82)",
        paddingRight: mob ? CR_S_4 : CR_S_5,
        paddingTop: mob ? CR_S_3 : CR_S_4, paddingBottom: mob ? CR_S_3 : CR_S_4,
        display: "grid", gridTemplateColumns: CR_GRID_COL, alignContent: "center", gap: CR_S_1
      }
    },
      h("div", { style: { display: "flex", gap: CR_S_3, alignItems: "baseline", flexWrap: "wrap" } },
        h("span", { style: { color: CR_HEAD, fontWeight: "600", fontSize: CR_T_LG } }, props.name),
        props.handle ? h("span", { style: { color: CR_DIM, fontSize: CR_T_MD } }, props.handle) : null
      ),
      h("div", {
        style: {
          color: CR_TEXT, fontSize: CR_T_MD, lineHeight: "1.45",
          display: "-webkit-box", WebkitLineClamp: "2", WebkitBoxOrient: "vertical", overflow: "hidden"
        }
      }, props.blurb || "No description yet.")
    )
  );
  if (!tap){
    return body(false, false, {});
  }
  return h(CrPressable, { render: body });
}

function CrCardsSurface(props: { st: CrUiState }) : any
{
  const tab = props.st.cardTab;
  const mob = props.st.layout === "mobile";
  const tabs = [
    { id: "contacts", label: "Contacts (" + charList.length + ")" },
    { id: "users", label: "Users (" + userList.length + ")" },
    { id: "scenarios", label: "Scenarios (" + scenarioList.length + ")" }
  ];
  let body: any;
  if (tab === "users"){
    body = h("div", null,
      h("div", { style: { display: "flex", gap: CR_S_3, flexWrap: "wrap", marginBottom: CR_S_4 } },
        h(CrButton, {
          text: "New User", primary: true,
          onClick: () => { crNewUser().catch(() => {}); }
        }),
        h(CrButton, {
          text: "Import",
          onClick: () => { importUser("fileInput").catch(() => {}); }
        })
      ),
      userList.length === 0
        ? h(CrEmpty, { text: "No Users yet." })
        : userList.map((u) => h(CrCardRow, {
            key: u.id, name: u.name || "Unnamed", handle: "",
            blurb: u.description || u.persona || "", charId: u.id, mobile: mob,
            onOpen: () => crNav({ openContactId: u.id, openKind: "user", profileTab: "about" })
          }))
    );
  }
  else if (tab === "scenarios"){
    body = h("div", null,
      h("div", { style: { display: "flex", gap: CR_S_3, flexWrap: "wrap", marginBottom: CR_S_4 } },
        h(CrButton, {
          text: "New Scenario", primary: true,
          onClick: () => { crNewScenario().catch(() => {}); }
        }),
        h(CrButton, {
          text: "Import",
          onClick: () => { importScenario("fileInput").catch(() => {}); }
        })
      ),
      scenarioList.length === 0
        ? h(CrEmpty, { text: "No Scenarios yet." })
        : scenarioList.map((s) => h(CrCardRow, {
            key: s.id, name: s.name || "Unnamed", handle: "",
            blurb: s.description || "", mobile: mob,
            charId: s.id, slot: CR_SLOT_BANNER,
            onOpen: () => crNav({ openContactId: s.id, openKind: "scenario", profileTab: "about" })
          }))
    );
  }
  else {
    body = h("div", null,
      h("div", { style: { display: "flex", gap: CR_S_3, flexWrap: "wrap", marginBottom: CR_S_4 } },
        h(CrButton, {
          text: "New Contact", primary: true,
          onClick: () => { crNewContact().catch(() => {}); }
        }),
        h(CrButton, {
          text: "Import",
          onClick: () => { importCharacter("fileInput").catch(() => {}); }
        })
      ),
      charList.length === 0
        ? h(CrEmpty, { text: "No Contacts yet." })
        : charList.map((c) => h(CrCardRow, {
            key: c.id, name: c.name || "Unnamed", handle: c.alias ? "@" + c.alias : "",
            blurb: c.description || c.persona || "", avatar: c.avatar, charId: c.id, mobile: mob,
            onOpen: () => crNav({ openContactId: c.id, openKind: "contact", profileTab: "posts" })
          }))
    );
  }
  return h("div", { class: "cr-surface cr-surface-cards" },
    h(CrTabs, { tabs: tabs, active: tab, mobile: mob, onPick: (id: string) => crNav({ cardTab: id }) }),
    h("div", { style: { padding: "14px 0 0 0" } }, body)
  );
}

async function crSlotUpload(charId: string, slot: string) : Promise<void>
{
  if (!crBridge.ready){
    try{ await api.v1.ui.toast("The bridge is not connected, so images cannot be stored.", { type: "warning" }); }
    catch (e){}
    return;
  }
  await crBridgeSend(CR_EVT_CHAR_IMAGE_ACTION, { charId: charId, slot: slot, op: "upload" });
}

async function crSlotDelete(charId: string, slot: string) : Promise<void>
{
  if (!crBridge.ready){
    return;
  }
  await crBridgeSend(CR_EVT_CHAR_IMAGE_ACTION, { charId: charId, slot: slot, op: "delete" });
  const again = charList.find((c) => c.id === charId);
  try{
    await api.v1.timers.setTimeout(() => {
      crBridgeProbeSlots(again).catch(() => {});
    }, 600);
  }
  catch (e){
    api.v1.error("[CR:ui] delete re-probe timer failed:", e);
  }
}

async function crSlotDownload(charId: string, slot: string) : Promise<void>
{
  if (!crBridge.ready){
    return;
  }
  await crBridgeSend(CR_EVT_CHAR_IMAGE_ACTION, { charId: charId, slot: slot, op: "download" });
}

async function crJsxModal(title: string, size: "small" | "medium" | "large" | "full", body: () => any) : Promise<any>
{
  let handle: any = null;
  const part: any = {
    type: "jsx",
    id: "cr-modal-jsx",
    style: { display: "grid", gridTemplateRows: "minmax(0,1fr)", gridTemplateColumns: "minmax(0,1fr)" },
    onMount: function(elem: any){
      try{
        elem.style.display = "grid";
        elem.style.gridTemplateRows = "minmax(0,1fr)";
        elem.style.gridTemplateColumns = "minmax(0,1fr)";
        elem.style.minHeight = "0";
        render(h(CrModalBody, { body: body }), elem);
      }
      catch (e){
        api.v1.error("[CR:ui] modal mount failed:", e);
      }
    }
  };
  handle = await api.v1.ui.modal.open({ title: title, size: size, content: [part as UIPart] });
  return handle;
}

function CrModalBody(props: { body: () => any }) : any
{
  useStoreValue(crUiStore);
  return h("div", {
    class: "cr-modal",
    style: {
      color: CR_TEXT, font: CR_FONT, fontSize: CR_T_BASE,
      minHeight: "0", overflowY: "auto", padding: "2px"
    }
  }, props.body());
}

let crEmoPickTitle: string = "";
let crEmoPickValue: string = "";
let crEmoPickApply: ((v: string) => void) | null = null;
let crEmoPickHandle: any = null;

async function crOpenEmotionPicker(title: string, current: string, apply: (v: string) => void) : Promise<void>
{
  crEmoPickTitle = title;
  crEmoPickValue = current || "";
  crEmoPickApply = apply;
  try{
    crEmoPickHandle = await crJsxModal(title, "small", () => CrEmotionSheet());
  }
  catch (e){
    api.v1.error("[CR:cards] emotion picker failed:", e);
  }
}

async function crCloseEmotionPicker() : Promise<void>
{
  if (crEmoPickHandle){
    try{ await crEmoPickHandle.close(); }
    catch (e){}
    crEmoPickHandle = null;
  }
  crEmoPickApply = null;
  crTouch();
}

function CrEmotionSheet() : any
{
  const options = [{ id: "", label: "None" }].concat(EMOTION_LIST.map((e) => ({ id: e, label: e })));
  return h("div", { class: "cr-emotion-sheet", style: { display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_4 } },
    h(CrChoice, {
      label: crEmoPickTitle,
      hint: "None leaves the line without an emotion, which is what AR's own blank does.",
      options: options,
      active: crEmoPickValue,
      onPick: (id: string) => {
        crEmoPickValue = id;
        if (crEmoPickApply){ crEmoPickApply(id); }
        crCloseEmotionPicker().catch(() => {});
      }
    }),
    h(CrButton, { text: "Close", onClick: () => { crCloseEmotionPicker().catch(() => {}); } })
  );
}

let crSlotSheetChar: Character | null = null;
let crSlotSheetSlot: string = "";
let crSlotSheetHandle: any = null;

async function crOpenSlotSheet(char: Character, slot: string) : Promise<void>
{
  crSlotSheetChar = char;
  crSlotSheetSlot = slot;
  try{
    crSlotSheetHandle = await crJsxModal(slot, "small", () => CrSlotSheet());
  }
  catch (e){
    api.v1.error("[CR:ui] slot sheet failed:", e);
  }
}

async function crCloseSlotSheet() : Promise<void>
{
  if (crSlotSheetHandle){
    try{ await crSlotSheetHandle.close(); }
    catch (e){}
    crSlotSheetHandle = null;
  }
}

function CrSlotSheet() : any
{
  const char = crSlotSheetChar;
  const slot = crSlotSheetSlot;
  if (!char){
    return null;
  }
  const stored = (crSlotProbe.asked === char.id && crSlotProbe.answered)
    ? crSlotProbe.slots.indexOf(slot) >= 0
    : false;
  return h("div", null,
    h("div", {
      style: {
        width: "100%", maxWidth: "220px", aspectRatio: "3 / 4", margin: "0 auto 12px auto",
        borderRadius: CR_RADIUS_S, border: CR_LINE_W + " solid " + (stored ? CR_ACCENT : CR_LINE),
        background: stored ? "transparent" : CR_SUNK, overflow: "hidden", position: "relative"
      }
    }, crImgAnchor(char.id, slot, "fit=contain,collapse=1",
        { position: "absolute", inset: "0", width: "100%", height: "100%", display: "block" })),
    stored ? null : (function(){
      const standIn = crResolveEmotionSlot(slot, (crSlotProbe.asked === char.id && crSlotProbe.answered)
        ? crSlotProbe.slots
        : crFilledSlots(char.id));
      return h("div", {
        style: {
          color: CR_DIM, fontSize: CR_T_SM, lineHeight: "1.45", marginBottom: CR_S_3,
          background: CR_SUNK, border: CR_LINE_W + " solid " + CR_LINE, borderRadius: CR_RADIUS_S,
          padding: CR_PAD_CTL
        }
      }, standIn
        ? ("Empty. Until it is filled, " + standIn + " stands in for it.")
        : "Empty, and nothing is stored for this Contact yet, so their initials stand in.");
    })(),
    h(CrSection, {
      title: "Emotion tag",
      note: "What makes a render read as " + slot + ". This is the account default and every Contact uses it. Left empty, the slot name is sent as written."
    }, h("div", { style: { marginTop: CR_S_3 } },
      h(CrTextInput, {
        value: crEmotionTagDefault(slot),
        placeholder: slot,
        onSet: (v: string) => { crSetEmotionTag(slot, v).catch(() => {}); }
      })
    )),
    h(CrSection, {
      title: "Override for " + (char.name || "this Contact"),
      note: crHasSlotOverride(char, slot)
        ? "This Contact ignores the account default for this slot."
        : "Only fill this in if this Contact needs different wording. Empty means it follows the default above."
    }, h("div", { style: { marginTop: CR_S_3 } },
      h(CrTextInput, {
        value: crHasSlotOverride(char, slot) ? crSlotTag(char, slot) : "",
        placeholder: crEmotionTagDefault(slot) || slot,
        onSet: (v: string) => { crSetSlotTag(char, slot, v).catch(() => {}); }
      })
    )),
    h("div", { style: { display: "flex", gap: CR_S_3, flexWrap: "wrap" } },
      h(CrButton, {
        text: "Generate", primary: true,
        onClick: () => { crGenerateSlot(char, slot).catch(() => {}); }
      }),
      h(CrButton, { text: "Upload", onClick: () => { crSlotUpload(char.id, slot).catch(() => {}); } }),
      h(CrButton, { text: "Download", disabled: !stored, onClick: () => { crSlotDownload(char.id, slot).catch(() => {}); } }),
      h(CrButton, {
        text: "Delete", disabled: !stored,
        onClick: () => { crSlotDelete(char.id, slot).catch(() => {}); crCloseSlotSheet().catch(() => {}); }
      }),
      h(CrButton, { text: "Close", onClick: () => { crCloseSlotSheet().catch(() => {}); } })
    )
  );
}

function CrPhotosTab(props: { char: Character; mobile: boolean }) : any
{
  const char = props.char;
  const probeIsThis = crSlotProbe.asked === char.id && crSlotProbe.answered;
  const stored: string[] = probeIsThis ? crSlotProbe.slots : [];
  const isStored: Record<string, boolean> = {};
  for (let i = 0; i < stored.length; i++){
    isStored[stored[i]] = true;
  }
  const storedEmotions = EMOTION_LIST.filter((e) => isStored[e]);
  const hasAvatar = isStored[CR_SLOT_AVATAR] === true;

  useEffect(() => {
    if (crBridge.ready && crSlotProbe.asked !== char.id){
      crBridgeProbeSlots(char).catch(() => {});
    }
  }, [char.id]);

  const tile = (slot: string, label: string) => h(CrPressable, {
    key: slot,
    render: (hover: boolean, press: boolean, handlers: any) => h("button", Object.assign({
    class: "cr-slot" + (isStored[slot] ? " cr-slot-filled" : ""),
    title: isStored[slot] ? (label + " — stored") : (label + " — empty"),
    onClick: () => { crOpenSlotSheet(char, slot).catch(() => {}); },
    style: {
      appearance: "none", padding: "0", font: "inherit", cursor: "pointer",
      aspectRatio: "3 / 4", borderRadius: CR_RADIUS_S,
      border: CR_LINE_W + " solid " + (isStored[slot] ? CR_ACCENT : (hover ? CR_ACCENT : CR_LINE)),
      background: isStored[slot] ? "transparent" : crPressBg(hover, press, CR_SUNK),
      overflow: "hidden", position: "relative", display: "grid", placeItems: "end stretch",
      transition: CR_MOTION, touchAction: "manipulation",
      transform: press ? "scale(0.97)" : "none"
    }
  }, handlers),
    crImgAnchor(char.id, slot, "fit=cover,collapse=1",
      { position: "absolute", inset: "0", width: "100%", height: "100%", display: "block" }),
    h("div", {
      style: {
        position: "relative", fontSize: CR_T_XS, padding: "3px 5px",
        color: isStored[slot] ? CR_HEAD : CR_DIM,
        background: isStored[slot] ? CR_FILL2 : "transparent", textAlign: "center",
        whiteSpace: "nowrap", overflow: "hidden", textOverflow: "ellipsis"
      }
    }, label)
    )
  });

  let storeNote: string;
  if (!crBridge.ready){
    storeNote = "Bridge not connected. Images are stored in the browser by the bridge, so nothing here works without it.";
  }
  else if (crSlotProbe.pending && crSlotProbe.asked === char.id){
    storeNote = "Reading the store…";
  }
  else if (crSlotProbe.timedOut && crSlotProbe.asked === char.id){
    storeNote = "The bridge did not answer. It may be older than 3.0.24.";
  }
  else if (!probeIsThis){
    storeNote = "Not read yet.";
  }
  else {
    storeNote = storedEmotions.length + " of " + EMOTION_LIST.length + " emotion slots stored" +
                (hasAvatar ? ", plus an avatar." : ", no avatar yet.");
  }

  return h("div", { class: "cr-photos" },
    h(CrSection, { title: "Avatar" },
      h("div", { style: { display: "flex", gap: CR_S_4, alignItems: "flex-end", marginTop: CR_S_3 } },
        h("div", { style: { width: props.mobile ? "76px" : "96px", flex: "0 0 auto" } },
          tile(CR_SLOT_AVATAR, CR_SLOT_AVATAR)),
        h("div", { style: { color: CR_DIM, fontSize: CR_T_MD, lineHeight: "1.5" } },
          "Tap to choose a file. The bridge stores it in this browser under this Contact, so it follows the Contact across every story.")
      )
    ),
    h(CrSection, { title: "Emotions", note: storeNote }),
    h("div", {
      class: "cr-slot-grid",
      style: {
        display: "grid",
        gridTemplateColumns: "repeat(auto-fill, minmax(" + (props.mobile ? "72px" : "88px") + ", 1fr))",
        gap: props.mobile ? "6px" : "8px", marginBottom: CR_S_4
      }
    }, EMOTION_LIST.map((name) => tile(name, name))),
    h("div", { style: { display: "flex", gap: CR_S_3, flexWrap: "wrap", marginBottom: CR_S_4 } },
      h(CrButton, {
        text: "Re-read the store",
        disabled: !crBridge.ready,
        onClick: () => { crBridgeProbeSlots(char).catch(() => {}); }
      }),
      h(CrButton, {
        text: "Open the first empty slot",
        disabled: !crBridge.ready || storedEmotions.length === EMOTION_LIST.length,
        onClick: () => {
          const next = EMOTION_LIST.filter((e) => !isStored[e])[0];
          if (next){
            crOpenSlotSheet(char, next).catch(() => {});
          }
        }
      })
    ),
    h(CrSection, {
      title: "Generation",
      note: "Model, size and the prompt chunks live in Global. A slot's own tag lives in its sheet — tap a tile. Images are drawn from this Contact's Appearance, so a blank Appearance cannot generate."
    })
  );
}

function crIsUserCard(card: CrCastCard) : boolean
{
  return userList.some((u) => u.id === card.id);
}

function crSanitizeCastExtra(card: CrCastCard, extra: any) : any
{
  return crIsUserCard(card) ? crSanitizeUserExtra(extra) : crSanitizeContactExtra(extra);
}

async function crSaveCastCard(card: CrCastCard, what: string) : Promise<void>
{
  try{
    if (crIsUserCard(card)){
      await saveUserList();
    }
    else {
      await saveCharList();
    }
  }
  catch (e){
    api.v1.error("[CR:img] could not save " + what + ":", e);
  }
  crTouch();
}

function CrOneImage(props: {
  id: string; slot: string; label: string; aspect: string; mobile: boolean;
  onGenerate?: () => void; generateLabel?: string; note?: string;
}) : any
{
  return h("div", { class: "cr-one-image", style: { display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_3, marginTop: CR_S_3 } },
    h("div", {
      style: {
        width: "100%", aspectRatio: props.aspect, borderRadius: CR_RADIUS_S,
        border: CR_LINE_W + " solid " + CR_LINE, background: CR_SUNK,
        position: "relative", overflow: "hidden", display: "grid", placeItems: "center"
      }
    },
      crImgAnchor(props.id, props.slot, "fit=cover,shrink=1",
        { position: "absolute", inset: "0", width: "100%", height: "100%", display: "block" }),
      h("div", { style: { position: "relative", color: CR_DIM, fontSize: CR_T_SM } }, props.label)
    ),
    props.note ? h("div", { style: { color: CR_DIM, fontSize: CR_T_SM, lineHeight: "1.5" } }, props.note) : null,
    h("div", { style: { display: "flex", gap: CR_S_3, flexWrap: "wrap" } },
      h(CrButton, {
        text: "Upload", disabled: !crBridge.ready,
        onClick: () => { crSlotUpload(props.id, props.slot).catch(() => {}); }
      }),
      props.onGenerate ? h(CrButton, {
        text: props.generateLabel || "Generate", primary: true, disabled: !crBridge.ready,
        onClick: props.onGenerate
      }) : null,
      h(CrButton, {
        text: "Download", disabled: !crBridge.ready,
        onClick: () => { crSlotDownload(props.id, props.slot).catch(() => {}); }
      }),
      h(CrButton, {
        text: "Delete", disabled: !crBridge.ready,
        onClick: () => { crSlotDelete(props.id, props.slot).catch(() => {}); }
      })
    )
  );
}

async function crSetImgCardField(char: CrCastCard, key: string, value: string) : Promise<void>
{
  const extra: any = char.cr || {};
  const card: any = extra.img || {};
  card[key] = value;
  extra.img = card;
  char.cr = crSanitizeCastExtra(char, extra);
  await crSaveCastCard(char, "the image card");
}

async function crSetAvatarSeed(char: CrCastCard, seed: number) : Promise<void>
{
  const extra: any = char.cr || {};
  const card: any = extra.img || {};
  card.avatarSeed = Math.max(0, Math.min(4294967295, Math.round(seed)));
  extra.img = card;
  char.cr = crSanitizeCastExtra(char, extra);
  await crSaveCastCard(char, "the avatar seed");
}

const CR_SCENARIO_CAPS: Record<string, number> = {
  name: 120, description: 2000, environment: 2000, scene: 2000, tags: 400
};

type CrCardKind = "contact" | "user" | "scenario";

async function crCommitCard(kind: CrCardKind, what: string, card?: CrAnyCard) : Promise<void>
{
  try{
    if (kind === "user"){ await saveUserList(); }
    else if (kind === "scenario"){ await saveScenarioList(); }
    else { await saveCharList(); }
  }
  catch (e){
    api.v1.error("[CR:cards] could not save " + what + ":", e);
  }
  if (card){
    try{
      if (kind === "user"){ await reflectUserChangesInChatSettings(card as User); }
      else if (kind === "scenario"){ await reflectScenarioChangesInChatSettings(card as Scenario); }
      else { await reflectCharChangesInChatSettings(card as Character); }
    }
    catch (e){}
  }
  crTouch();
}

async function crSetScenarioField(scenario: Scenario, key: string, value: string) : Promise<void>
{
  const cap = CR_SCENARIO_CAPS[key] || 400;
  (scenario as any)[key] = String(value || "").slice(0, cap);
  await crCommitCard("scenario", "the Scenario", scenario);
}

type CrAnyCard = Character | User | Scenario;

async function crSetBrains(card: CrAnyCard, kind: CrCardKind, brains: BrainEntry[]) : Promise<void>
{
  card.brains = brains;
  await crCommitCard(kind, "the brains", card);
}

async function crSetBrainsConditional(card: CrAnyCard, kind: CrCardKind, list: BrainComplexConditional[]) : Promise<void>
{
  card.brainsConditional = list;
  await crCommitCard(kind, "the conditional brains", card);
}

function crKeysFromText(text: string) : string[]
{
  return String(text || "").split(",").map((k) => k.trim()).filter((k) => k.length > 0);
}

const CR_CHAR_CAPS: Record<string, number> = {
  name: 120, alias: 80, description: 2000, persona: 4000, appearance: 2000,
  species: 120, gender: 120, pronouns: 120, tags: 400, greeting: 4000
};

async function crSetCharField(char: Character, key: string, value: string) : Promise<void>
{
  const cap = CR_CHAR_CAPS[key] || 400;
  (char as any)[key] = String(value || "").slice(0, cap);
  await crCommitCard("contact", "the Contact");
}

async function crSetCharChoice(char: Character, key: string, value: any) : Promise<void>
{
  (char as any)[key] = value;
  await crCommitCard("contact", "the Contact");
}

async function crSetExampleChats(char: Character, chats: ExampleChat[]) : Promise<void>
{
  char.exampleChats = chats;
  await crCommitCard("contact", "the example chats", char);
}

async function crNewContact() : Promise<void>
{
  const made = createCharTemplate();
  charList.push(made);
  await crCommitCard("contact", "the new Contact");
  crNav({ openContactId: made.id, openKind: "contact", profileTab: "about" });
}

let crFarewellChar: Character | null = null;
let crFarewellText: string = "";
let crFarewellState: string = "waiting";
let crFarewellArmed: boolean = false;
let crFarewellHandle: any = null;

async function crOpenDeleteSheet(char: Character) : Promise<void>
{
  crFarewellChar = char;
  crFarewellText = "";
  crFarewellState = "waiting";
  crFarewellArmed = false;
  try{
    crFarewellHandle = await crJsxModal("Delete " + (char.name || "Contact") + "?", "small",
                                        () => CrFarewellSheet());
  }
  catch (e){
    api.v1.error("[CR:cards] delete sheet failed:", e);
    return;
  }
  try{
    await api.v1.timers.setTimeout(function(){
      if (crFarewellChar === char && !crFarewellArmed){
        crFarewellArmed = true;
        crTouch();
      }
    }, 2000);
  }
  catch (e){
    crFarewellArmed = true;
  }
  crFarewellGenerate(char).catch(() => {});
}

async function crCloseDeleteSheet() : Promise<void>
{
  crFarewellChar = null;
  if (crFarewellHandle){
    try{ await crFarewellHandle.close(); }
    catch (e){}
    crFarewellHandle = null;
  }
}

async function crFarewellGenerate(char: Character) : Promise<void>
{
  const user = chatSettings.user || createUserTemplate();
  try{
    const genParams = await api.v1.generationParameters.get();
    if (genParams.model === "glm-4-6"){
      genParams.model = "xialong-v1";
    }
    const messages: APIMessage[] = [
      { role: "system", content: buildDeletionSystemPrompt(char, user) },
      { role: "system", content: "Start of chat." },
      { role: "system", content: char.cjk ? "[ Style: deletion response; CJK ]" : "[ Style: deletion response ]" }
    ];
    const response = await crSideGenerate(
      messages,
      {
        model: genParams.model,
        max_tokens: 1536,
        temperature: genParams.temperature,
        top_p: genParams.top_p,
        top_k: genParams.top_k,
        min_p: genParams.min_p
      },
      async function(){},
      "background"
    );
    if (crFarewellChar !== char){
      return;
    }
    const responseText = (response && response.choices && response.choices[0])
      ? (response.choices[0].text || "") : "";
    const subs = parseResponseBody(responseText, char.name);
    if (subs.length > 0 && (subs[0].text || "").trim()){
      crFarewellText = subs[0].text;
      crFarewellState = "said";
    }
    else{
      crFarewellState = "silent";
    }
  }
  catch (e){
    if (crFarewellChar !== char){
      return;
    }
    crFarewellState = "silent";
  }
  crFarewellArmed = true;
  crTouch();
}

function CrFarewellSheet() : any
{
  const char = crFarewellChar;
  if (!char){
    return h(CrEmpty, { text: "Nothing to delete." });
  }
  const said = crFarewellState === "said";
  return h("div", { style: { display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_4, padding: CR_S_2 } },
    h("div", { style: { display: "flex", gap: CR_S_3, alignItems: "center" } },
      h(CrAvatar, { src: char.avatar, name: char.name, charId: char.id, size: 40 }),
      h("div", { style: { minWidth: "0" } },
        h("div", { style: { color: CR_HEAD, fontSize: CR_T_BASE, fontWeight: "600" } },
          char.name || "Unnamed"),
        h("div", { style: { color: CR_DIM, fontSize: CR_T_SM } },
          "Deleting a Contact cannot be undone.")
      )
    ),
    h("div", {
      style: {
        background: CR_FILL, border: CR_LINE_W + " solid " + CR_LINE, borderRadius: CR_RADIUS_S,
        padding: "10px 12px", color: said ? CR_TEXT : CR_DIM, fontSize: CR_T_MD,
        lineHeight: "1.5", fontStyle: said ? "normal" : "italic",
        whiteSpace: "pre-wrap", maxHeight: "220px", overflowY: "auto"
      }
    },
      said ? crFarewellText
           : (crFarewellState === "silent"
              ? (char.name || "They") + " had nothing to say."
              : (char.name || "They") + " is typing…")
    ),
    h("div", { style: { color: CR_DIM, fontSize: CR_T_SM } },
      "Their last message is generated while you decide, and costs one generation."),
    h("div", { style: { display: "flex", gap: CR_S_3, flexWrap: "wrap", paddingTop: CR_S_2 } },
      h(CrButton, { text: "Keep it", onClick: () => { crCloseDeleteSheet().catch(() => {}); } }),
      h("div", { style: { flex: "1 1 auto" } }),
      h(CrButton, {
        text: crFarewellArmed ? "Delete for good" : "Delete",
        primary: crFarewellArmed, disabled: !crFarewellArmed,
        onClick: () => {
          if (!crFarewellArmed){
            return;
          }
          const doomed = char;
          crCloseDeleteSheet()
            .then(() => crDeleteContact(doomed))
            .catch(() => {});
        }
      })
    )
  );
}

async function crDeleteContact(char: Character) : Promise<void>
{
  const at = charList.findIndex((c) => c.id === char.id);
  if (at < 0){
    return;
  }
  if (chatSettings.char && chatSettings.char.id === char.id){
    chatSettings.char = undefined;
    try{ await saveChatSettings(); }
    catch (e){ api.v1.error("[CR:cards] could not unpair the deleted Contact:", e); }
  }
  charList.splice(at, 1);
  await crCommitCard("contact", "the Contact list");
  crNav({ openContactId: "" });
}

const CR_USER_CAPS: Record<string, number> = {
  name: 120, description: 2000, persona: 4000, appearance: 2000,
  species: 120, gender: 120, pronouns: 120, tags: 400
};

async function crSetUserField(user: User, key: string, value: string) : Promise<void>
{
  const cap = CR_USER_CAPS[key] || 400;
  (user as any)[key] = String(value || "").slice(0, cap);
  await crCommitCard("user", "the User");
}

async function crNewUser() : Promise<void>
{
  const made = createUserTemplate();
  userList.push(made);
  await crCommitCard("user", "the new User");
  crNav({ openContactId: made.id, openKind: "user", profileTab: "about" });
}

async function crDeleteUser(user: User) : Promise<void>
{
  const at = userList.findIndex((u) => u.id === user.id);
  if (at < 0){
    return;
  }
  if (chatSettings.user && chatSettings.user.id === user.id){
    chatSettings.user = undefined;
    try{ await saveChatSettings(); }
    catch (e){ api.v1.error("[CR:cards] could not unpair the deleted User:", e); }
  }
  userList.splice(at, 1);
  await crCommitCard("user", "the User list");
  crNav({ openContactId: "" });
}

async function crNewScenario() : Promise<void>
{
  const made = createScenarioTemplate();
  scenarioList.push(made);
  await crCommitCard("scenario", "the new Scenario");
  crNav({ openContactId: made.id, openKind: "scenario", profileTab: "about" });
}

async function crDeleteScenario(scenario: Scenario) : Promise<void>
{
  const at = scenarioList.findIndex((s) => s.id === scenario.id);
  if (at < 0){
    return;
  }
  if (chatSettings.scenario && chatSettings.scenario.id === scenario.id){
    chatSettings.scenario = undefined;
    try{ await saveChatSettings(); }
    catch (e){ api.v1.error("[CR:cards] could not unpair the deleted Scenario:", e); }
  }
  scenarioList.splice(at, 1);
  await crCommitCard("scenario", "the Scenario list");
  crNav({ openContactId: "" });
}

async function crSetSceneField(scenario: Scenario, key: string, value: string) : Promise<void>
{
  const extra: CrScenarioExtra = scenario.cr || {};
  const card: any = extra.img || {};
  card[key] = value;
  extra.img = card;
  scenario.cr = crSanitizeScenarioExtra(extra);
  try{ await saveScenarioList(); }
  catch (e){ api.v1.error("[CR:scene] could not save the scene card:", e); }
  crTouch();
}

async function crSetBannerSeed(scenario: Scenario, seed: number) : Promise<void>
{
  const extra: CrScenarioExtra = scenario.cr || {};
  const card: any = extra.img || {};
  card.bannerSeed = Math.max(0, Math.min(4294967295, Math.round(seed)));
  extra.img = card;
  scenario.cr = crSanitizeScenarioExtra(extra);
  try{ await saveScenarioList(); }
  catch (e){ api.v1.error("[CR:scene] could not save the banner seed:", e); }
  crTouch();
}

async function crSetOutfits(char: CrCastCard, outfits: CrOutfitChunk[]) : Promise<void>
{
  const extra: CrContactExtra = char.cr || {};
  const card: any = extra.img || {};
  card.outfits = outfits;
  extra.img = card;
  char.cr = crSanitizeContactExtra(extra);
  try{ await saveCharList(); }
  catch (e){ api.v1.error("[CR:img] could not save the outfits:", e); }
  crTouch();
}

function CrVisualsTab(props: { char: CrCastCard }) : any
{
  const char = props.char;
  const isUser = crIsUserCard(char);
  const card: CrImgCard = (char.cr && char.cr.img) ? char.cr.img : {};
  const outfits: CrOutfitChunk[] = (card.outfits || []).slice();
  const set = (k: string) => (v: string) => { crSetImgCardField(char, k, v).catch(() => {}); };
  const preview = crAssembleCharacterPrompt(char, "avatar");
  const previewIll = crAssembleCharacterPrompt(char, "illustrate");

  return h("div", { class: "cr-images-tab" },
    h(CrSection, {
      title: "Base",
      note: "Goes in the scene prompt of any image this card is in. Scene-level things, not body description."
    }, h("div", { style: { marginTop: CR_S_3 } },
      h(CrPromptPair, {
        label: "", prompt: card.basePrompt || "", uc: card.baseUC || "",
        onPrompt: set("basePrompt"), onUC: set("baseUC")
      })
    )),
    h(CrSection, {
      title: "Universal",
      note: "Always present in the character prompt. Face, hair, build — what makes them recognisable at any crop. Left empty, AR's Appearance is used instead."
    }, h("div", { style: { marginTop: CR_S_3 } },
      h(CrPromptPair, {
        label: "", prompt: card.universalPrompt || "", uc: card.universalUC || "",
        onPrompt: set("universalPrompt"), onUC: set("universalUC")
      })
    )),
    h(CrSection, {
      title: "Illustrator",
      note: "Added only when illustrating a scene. Put anything below the shoulders here — \"thick thighs\" in Universal drags a bust shot out to full body so the model can obey it."
    }, h("div", { style: { marginTop: CR_S_3 } },
      h(CrPromptPair, {
        label: "", prompt: card.illustratorPrompt || "", uc: card.illustratorUC || "",
        onPrompt: set("illustratorPrompt"), onUC: set("illustratorUC")
      })
    )),
    h(CrSection, {
      title: "Avatar",
      note: isUser
        ? "Added only to the avatar. A User has no emotion set, so this pair has one slot to reach rather than twenty-six."
        : "Added only to avatar and emotion slots. A shared background or outfit, so twenty-five reactions read as one set."
    }, h("div", { style: { marginTop: CR_S_3, display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_4 } },
      h(CrPromptPair, {
        label: "", prompt: card.avatarPrompt || "", uc: card.avatarUC || "",
        onPrompt: set("avatarPrompt"), onUC: set("avatarUC")
      }),
      h(CrNumField, {
        label: "Avatar seed", value: card.avatarSeed || 0,
        hint: isUser
          ? "0 uses the account seed, and 0 there is random each time."
          : "One seed across every slot keeps a set consistent. 0 uses the account seed, and 0 there is random each time.",
        onSet: (n: number) => { crSetAvatarSeed(char, n).catch(() => {}); }
      })
    )),
    h(CrSection, {
      title: "Outfits",
      note: "A wardrobe to toggle rather than retype. Active outfits join the character prompt for every image."
    }, h("div", { style: { marginTop: CR_S_3 } },
      outfits.map((o, idx) => h("div", {
        key: o.id,
        style: {
          border: CR_LINE_W + " solid " + CR_LINE, borderRadius: CR_RADIUS_S,
          padding: CR_S_4, marginBottom: CR_S_3, background: o.active ? "transparent" : CR_SUNK
        }
      },
        h("div", { style: { display: "flex", gap: CR_S_3, alignItems: "center", marginBottom: CR_S_3, flexWrap: "wrap" } },
          h("div", { style: { flex: "1 1 120px", minWidth: "0" } },
            h(CrTextInput, {
              value: o.label,
              placeholder: "Outfit name",
              onSet: (v: string) => { outfits[idx].label = v; crSetOutfits(char, outfits).catch(() => {}); }
            })
          ),
          h(CrButton, {
            text: o.active ? "Worn" : "Off", primary: o.active,
            onClick: () => { outfits[idx].active = !outfits[idx].active; crSetOutfits(char, outfits).catch(() => {}); }
          }),
          h(CrButton, {
            text: "Remove",
            onClick: () => { outfits.splice(idx, 1); crSetOutfits(char, outfits).catch(() => {}); }
          })
        ),
        h(CrPromptPair, {
          label: "", prompt: o.prompt, uc: o.uc,
          onPrompt: (v: string) => { outfits[idx].prompt = v; crSetOutfits(char, outfits).catch(() => {}); },
          onUC: (v: string) => { outfits[idx].uc = v; crSetOutfits(char, outfits).catch(() => {}); }
        })
      )),
      h(CrButton, {
        text: "Add an outfit",
        disabled: outfits.length >= 16,
        onClick: () => {
          outfits.push({ id: "cr-o" + Date.now(), label: "New outfit", prompt: "", uc: "", active: false });
          crSetOutfits(char, outfits).catch(() => {});
        }
      })
    )),
    h(CrSection, {
      title: "What gets sent",
      note: "The character prompt as assembled now, before the account's chunks and the slot's own tag are added."
    }, h("div", { style: { marginTop: CR_S_3, color: CR_DIM, fontSize: CR_T_SM, lineHeight: "1.5", wordBreak: "break-word" } },
      h("div", null, "Slots: " + (preview.visuals || "(nothing — write an Appearance or a Universal prompt)")),
      preview.uc ? h("div", { style: { marginTop: CR_S_1 } }, "Slots negative: " + preview.uc) : null,
      h("div", { style: { marginTop: CR_S_2 } }, "Illustrations: " + (previewIll.visuals || "(nothing)")),
      previewIll.uc ? h("div", { style: { marginTop: CR_S_1 } }, "Illustrations negative: " + previewIll.uc) : null
    )),
    isUser ? null : h(CrContactBubbles, { char: char as Character })
  );
}

const CR_SLOT_INDEX_KEY = "crSlotIndexKey";
await api.v1.storage.setIfAbsent(CR_SLOT_INDEX_KEY, {});
let crSlotIndex: Record<string, string[]> = await api.v1.storage.get(CR_SLOT_INDEX_KEY);

function crFilledSlots(charId: string) : string[]
{
  const got = crSlotIndex[charId];
  return got && got.length ? got : [];
}

async function crRememberSlots(charId: string, slots: string[]) : Promise<void>
{
  if (!charId){
    return;
  }
  crSlotIndex[charId] = slots.map((s) => String(s));
  try{ await api.v1.storage.set(CR_SLOT_INDEX_KEY, crSlotIndex); }
  catch (e){ api.v1.error("[CR:slots] could not store the slot index:", e); }
}

const CR_EDOPT_SOURCE = ["emotion", "avatar", "off"];
const CR_EDOPT_PLACE  = ["inline", "above", "gutter"];
const CR_CCAV_GUTTER_GAP = 12;
const CR_EDOPT_SIZE_MIN = 16;
const CR_EDOPT_SIZE_MAX = 320;
const CR_EDOPT_SHAPE  = ["round", "rounded", "portrait", "square"];
const CR_EDOPT_LINE   = ["dim", "hide", "plain"];

type CrEditorOpts = {
  source: string;
  place: string;
  size: number;
  shape: string;
  emoji: boolean;
  line: string;
  boldName: boolean;
  clearWrap: boolean;
};

const CR_EDOPTS_DEFAULT: CrEditorOpts = {
  source: "emotion", place: "inline", size: 44, shape: "round",
  emoji: true, line: "dim", boldName: true, clearWrap: true
};

const CR_EDOPTS_KEY = "crEditorOptsKey";
await api.v1.storage.setIfAbsent(CR_EDOPTS_KEY, CR_EDOPTS_DEFAULT);

function crNormEdOpts(raw: any) : CrEditorOpts
{
  const pick = (list: string[], v: any, fb: string) => (list.indexOf(String(v)) >= 0 ? String(v) : fb);
  const r = raw || {};
  return {
    source: pick(CR_EDOPT_SOURCE, r.source, CR_EDOPTS_DEFAULT.source),
    place: pick(CR_EDOPT_PLACE, r.place, CR_EDOPTS_DEFAULT.place),
    size: Math.min(CR_EDOPT_SIZE_MAX, Math.max(CR_EDOPT_SIZE_MIN,
      Math.round(Number(r.size)) || CR_EDOPTS_DEFAULT.size)),
    shape: pick(CR_EDOPT_SHAPE, r.shape, CR_EDOPTS_DEFAULT.shape),
    emoji: r.emoji !== false,
    line: pick(CR_EDOPT_LINE, r.line, CR_EDOPTS_DEFAULT.line),
    boldName: r.boldName !== false,
    clearWrap: r.clearWrap !== false
  };
}

let crEditorOpts: CrEditorOpts = crNormEdOpts(await api.v1.storage.get(CR_EDOPTS_KEY));

async function crSetEditorOpt(field: string, value: any) : Promise<void>
{
  const next: any = crNormEdOpts(crEditorOpts);
  next[field] = value;
  crEditorOpts = crNormEdOpts(next);
  try{ await api.v1.storage.set(CR_EDOPTS_KEY, crEditorOpts); }
  catch (e){ api.v1.error("[CR:edopts] could not store the display options:", e); }
  crCcavEmit().catch(() => {});
  updateEmotionRule().catch(() => {});
  try{ updateNameStyling(); }
  catch (e){}
  crTouch();
}

function CrEditorOptsPanel() : any
{
  const o = crEditorOpts;
  const row = (label: string, hint: string, list: string[], labels: string[], field: string, active: string) =>
    h(CrChoice, {
      label: label, hint: hint,
      options: list.map((id, i) => ({ id: id, label: labels[i] })),
      active: active,
      onPick: (id: string) => { crSetEditorOpt(field, id).catch(() => {}); }
    });
  return h("div", { style: { display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_4, marginTop: CR_S_3 } },
    row("Source", "Which image a turn gets. Emotion follows the fallback chain; Avatar always uses the one portrait.",
        CR_EDOPT_SOURCE, ["Emotion portrait", "Avatar only", "Off"], "source", o.source),
    row("Placement", (o.place === "gutter" && crCcavIndentFailed
          ? "The editor refused the indent markers last time, so there is no gutter for the portraits to stand in — Beside the text gives the same reading without one. "
          : "") + "Beside wraps the message around the portrait. Above puts it on its own line over the turn. Gutter indents the Contact's turns and stands the portrait in the space that opens up — it needs bridge 3.0.29 or newer, and your own turns are not indented.",
        CR_EDOPT_PLACE, ["Beside the text", "Above the turn", "In the gutter"], "place", o.place),
    h(CrNumField, {
      label: "Size",
      hint: "Pixels, " + String(CR_EDOPT_SIZE_MIN) + " to " + String(CR_EDOPT_SIZE_MAX) + ". Make them as big or small as you like.",
      value: o.size,
      onSet: (n: number) => { crSetEditorOpt("size", n).catch(() => {}); }
    }),
    row("Shape", "", CR_EDOPT_SHAPE, ["Circle", "Rounded", "Portrait", "Square"], "shape", o.shape),
    row("Emotion line", "Hidden is near-invisible, which is what an emoji image needs to sit on top of. With no emoji set, use Dimmed. Neither removes the line from the document or from context.",
        CR_EDOPT_LINE, ["Dimmed", "Hidden", "Plain"], "line", o.line),
    h(CrChoice, {
      label: "Emoji", hint: "Beside the emotion line, from the imported set.",
      options: [{ id: "off", label: "Off" }, { id: "on", label: "On" }],
      active: o.emoji ? "on" : "off",
      onPick: (id: string) => { crSetEditorOpt("emoji", id === "on").catch(() => {}); }
    }),
    h(CrChoice, {
      label: "Speaker name", options: [{ id: "plain", label: "Plain" }, { id: "bold", label: "Bold" }],
      active: o.boldName ? "bold" : "plain",
      onPick: (id: string) => { crSetEditorOpt("boldName", id === "bold").catch(() => {}); }
    }),
    o.place !== "inline" ? null : h(CrChoice, {
      label: "Stop the wrap after a reply",
      hint: crCcavClearFailed
        ? "The editor refused these last time, so your turn may still start beside a tall portrait. Portraits are unaffected."
        : "Beside lets the message wrap around the portrait. This stops the wrap where the reply ends, so YOUR turn starts below it rather than beside it. Turn it off if a portrait ever goes missing.",
      options: [{ id: "off", label: "Off" }, { id: "on", label: "On" }],
      active: o.clearWrap ? "on" : "off",
      onPick: (id: string) => { crSetEditorOpt("clearWrap", id === "on").catch(() => {}); }
    })
  );
}

// Must match the bridge's AE_CHARCHAT_AVA_SENTINEL.
const CR_CCAV_SENTINEL = "ce-chatava:";

const CR_CCAV_MAX_RUNS = 24;

let crCcavHandles: any[] = [];

let crCcavClearFailed = false;

type CrCcavLast = {
  at: number;
  reason: string;
  sections: number;
  nameLines: number;
  emotionLines: number;
  contactOther: number;
  runs: number;
  emitted: number;
  created: number;
  error: string;
};
let crCcavLast: CrCcavLast = {
  at: 0, reason: "never run", sections: 0, nameLines: 0, emotionLines: 0,
  contactOther: 0, runs: 0, emitted: 0, created: 0, error: ""
};
type CrGenLast = {
  at: number;
  slot: string;
  charId: string;
  refused: string;
  visualsLen: number;
  promptLen: number;
  baseLen: number;
  model: string;
  size: string;
  steps: number;
  seed: number;
};
let crGenLast: CrGenLast = {
  at: 0, slot: "", charId: "", refused: "never run", visualsLen: 0, promptLen: 0,
  baseLen: 0, model: "", size: "", steps: 0, seed: 0
};
function crGenReqNote(slot: string, charId: string, refused: string, over?: Partial<CrGenLast>) : void
{
  crGenLast = Object.assign(
    { at: Date.now(), slot: slot, charId: charId, refused: refused, visualsLen: 0,
      promptLen: 0, baseLen: 0, model: "", size: "", steps: 0, seed: 0 },
    over || {}
  );
}

function crCcavNote(reason: string, over?: Partial<CrCcavLast>) : void
{
  crCcavLast = Object.assign(
    { at: Date.now(), reason: reason, sections: 0, nameLines: 0, emotionLines: 0,
      contactOther: 0, runs: 0, emitted: 0, created: 0, error: "" },
    over || {}
  );
}

let crCcavIndentFailed = false;

async function crCcavDispose() : Promise<void>
{
  const held = crCcavHandles;
  crCcavHandles = [];
  for (let i = 0; i < held.length; i++){
    try{
      if (held[i] && held[i].dispose){
        await held[i].dispose();
      }
    }
    catch (e){}
  }
}

function crCcavOptString() : string
{
  const o = crEditorOpts;
  return "size=" + String(o.size) + ",shape=" + o.shape + ",place=" + o.place;
}

async function crCcavEmit() : Promise<void>
{
  return crSerial("ccav", crCcavEmitOnce);
}

async function crCcavEmitOnce() : Promise<void>
{
  crBubbleMark().catch(() => {});
  crChatImgEmit().catch(() => {});
  await crCcavDispose();
  const char = crLiveContact();
  if (!char){
    crCcavNote("no Contact is paired with this chat");
    return;
  }
  if (crEditorOpts.source === "off"){
    crCcavNote("editor portraits are set to Off");
    return;
  }
  let sections: { sectionId: number; section: Section; index: number }[] = [];
  try{ sections = await api.v1.document.scan(); }
  catch (e){ crCcavNote("the document scan failed"); return; }
  if (!sections.length){
    crCcavNote("the document is empty");
    return;
  }

  const opts = crCcavOptString();
  const seg = crChatSegment(sections, char);
  const runs = seg.runs;
  const nNames = seg.nNames;
  const nEmotions = seg.nEmotions;
  const nContactOther = seg.nContactOther;
  if (!runs.length){
    crCcavNote("no Contact runs found in the document", {
      sections: sections.length, nameLines: nNames, emotionLines: nEmotions,
      contactOther: nContactOther
    });
    return;
  }

  const capped = runs.length > CR_CCAV_MAX_RUNS ? runs.slice(runs.length - CR_CCAV_MAX_RUNS) : runs;
  const floats = crEditorOpts.place === "inline" && crEditorOpts.clearWrap;

  const parts: any[] = [];
  const clears: any[] = [];
  const indents: any[] = [];
  const lane = String(crEditorOpts.size + CR_CCAV_GUTTER_GAP) + "px";
  for (let r = 0; r < capped.length; r++){
    const want = crEditorOpts.source === "avatar" ? "" : capped[r].emotion;
    const resolved = want ? crResolveEmotionSlot(want, crFilledSlots(capped[r].charId)) : "";
    parts.push({
      type: "node",
      // A node widget goes after its section; 0 means before the first.
      sectionId: capped[r].anchorId,
      content: [{
        type: "text",
        text: CR_CCAV_SENTINEL + capped[r].charId + "|" + (resolved === CR_SLOT_AVATAR ? "" : resolved) + "|" + opts,
        style: { fontSize: "1px", color: "transparent", lineHeight: "0" }
      }]
    });
    if (crEditorOpts.place === "gutter"){
      const runIds = capped[r].ids;
      for (let s = 0; s < runIds.length; s++){
        indents.push({ type: "node", sectionId: runIds[s], style: { marginLeft: lane } });
      }
    }
    if (floats){
      const nextRun = r + 1 < capped.length ? capped[r + 1] : null;
      let clearAt = capped[r].endId;
      // A clear on the next portrait's anchor would sit between that portrait and its text.
      if (nextRun && nextRun.anchorId === capped[r].endId){
        // Bridge 3.0.36 clears on the next portrait's own box, so nothing is placed inside this message.
        if (crBridge.bridgeCcavClear){
          continue;
        }
        const runIds = capped[r].ids;
        clearAt = runIds.length >= 2 ? runIds[runIds.length - 2] : -1;
      }
      if (clearAt < 0){
        continue;
      }
      clears.push({
        type: "node",
        sectionId: clearAt,
        content: [{
          type: "text",
          // No top-level display on a node widget (the runtime refuses the batch); a blank text can be refused.
          text: "\u200b",
          style: {
            display: "block", clear: "both", height: "0",
            fontSize: "1px", lineHeight: "0", color: "transparent"
          }
        }]
      });
    }
  }
  const tally: Partial<CrCcavLast> = {
    sections: sections.length, nameLines: nNames, emotionLines: nEmotions,
    contactOther: nContactOther, runs: runs.length, emitted: parts.length
  };
  try{
    const handles: any = await api.v1.editor.decorations.createWidgets(parts);
    crCcavHandles = (handles && handles.length) ? handles : [];
    crCcavNote("", Object.assign({}, tally, { created: crCcavHandles.length }));
  }
  catch (e){
    crCcavNote("the editor refused the portrait widgets", Object.assign({}, tally, { error: String(e) }));
    api.v1.error("[CR:ccav] widget create failed; portraits will not bind:", e);
    return;
  }
  if (indents.length){
    try{
      const marks: any = await api.v1.editor.decorations.createMarkers(indents);
      if (marks && marks.length){
        crCcavHandles = crCcavHandles.concat(marks);
      }
      crCcavIndentFailed = false;
    }
    catch (e){
      crCcavIndentFailed = true;
      api.v1.error("[CR:ccav] the gutter indent markers were refused; portraits are unaffected:", e);
    }
  }
  else {
    crCcavIndentFailed = false;
  }
  if (!clears.length){
    crCcavClearFailed = false;
    return;
  }
  try{
    const cleared: any = await api.v1.editor.decorations.createWidgets(clears);
    if (cleared && cleared.length){
      crCcavHandles = crCcavHandles.concat(cleared);
    }
    crCcavClearFailed = false;
  }
  catch (e){
    const narrow: any[] = clears.map((c) => ({
      type: "node",
      sectionId: c.sectionId,
      content: [{
        type: "text",
        text: "\u200b",
        style: { clear: "both", fontSize: "1px", lineHeight: "0", color: "transparent" }
      }]
    }));
    try{
      const retried: any = await api.v1.editor.decorations.createWidgets(narrow);
      if (retried && retried.length){
        crCcavHandles = crCcavHandles.concat(retried);
      }
      crCcavClearFailed = false;
      api.v1.log("[CR:ccav] the full clearing widget was refused; the pared-back one was accepted. "
        + "The style fields it dropped are display and height.");
    }
    catch (e2){
      crCcavClearFailed = true;
      api.v1.error("[CR:ccav] the wrap-clearing widgets were refused twice; portraits are unaffected. Full shape:", e);
      api.v1.error("[CR:ccav] pared-back shape also refused:", e2);
    }
  }
}

const CR_CUE_KEY = "cr.cueUserTurn";
await api.v1.storage.setIfAbsent(CR_CUE_KEY, false);
let crCueOn: boolean = (await api.v1.storage.get(CR_CUE_KEY)) === true;

async function crSetCueOn(on: boolean) : Promise<void>
{
  crCueOn = on === true;
  try{ await api.v1.storage.set(CR_CUE_KEY, crCueOn); }
  catch (e){ api.v1.error("[CR:cue] could not store the setting:", e); }
  crTouch();
}

const CR_CUE_OPENER = "{ ";

function crCueOpener() : string
{
  return CR_CUE_OPENER;
}

let crCueReason = "";

async function crCueUserTurn() : Promise<void>
{
  if (!crCueOn){
    return;
  }
  const char = crLiveContact();
  const user = crLiveUser();
  if (!char || !user || !user.name){
    crCueReason = "Skipped: the chat needs both a Contact and a User paired.";
    return;
  }
  let sections: { sectionId: number; section: Section; index: number }[] = [];
  try{ sections = await api.v1.document.scan(); }
  catch (e){ return; }
  const cuePermission: ScriptPermission = "documentEdit";
  let allowed = false;
  try{ allowed = await permissionCheckPassed(cuePermission); }
  catch (e){ allowed = false; }
  if (!allowed){
    crCueReason = "Blocked: CharacterRoom does not have permission to write to the document.";
    return;
  }
  let tail = "";
  for (let i = sections.length - 1; i >= 0; i--){
    const t = String((sections[i].section && sections[i].section.text) || "").trim();
    if (t){
      tail = t;
      break;
    }
  }
  if (!tail){
    crCueReason = "Skipped: the document is empty.";
    return;
  }
  if (tail.indexOf("{") === 0){
    crCueReason = "Skipped: your turn is already open at the end of the story.";
    return;
  }
  const speaker = char.name + ":";
  const isReply = tail.indexOf(speaker) === 0 || /^[ \t]*Emotion:[ \t]*/.test(tail);
  if (!isReply){
    crCueReason = "Skipped: the last line of the story is not " + char.name + "'s reply.";
    api.v1.log("[CR:cue] not cueing \u2014 the last paragraph is not "
      + char.name + "'s reply. It is: " + JSON.stringify(tail.slice(0, 200)));
    return;
  }
  try{
    await api.v1.document.appendParagraph({ text: crCueOpener() });
    crCueReason = "Wrote your turn's opening line.";
    api.v1.log("[CR:cue] wrote the opener.");
  }
  catch (e){
    api.v1.error("[CR:cue] could not append the user turn:", e);
    crCueReason = "Failed: the document would not take the line.";
  }
}

const CR_EMOTION_NEIGHBOURS: Record<string, string[]> = {
  angry:       ["irritated", "disgusted", "determined"],
  aroused:     ["love", "playful", "embarrassed"],
  bored:       ["tired", "neutral", "thinking"],
  confused:    ["thinking", "surprised", "nervous"],
  determined:  ["angry", "thinking", "neutral"],
  disgusted:   ["irritated", "angry", "bored"],
  embarrassed: ["shy", "nervous", "surprised"],
  excited:     ["happy", "playful", "surprised"],
  happy:       ["playful", "excited", "laughing"],
  hurt:        ["sad", "scared", "nervous"],
  irritated:   ["angry", "disgusted", "bored"],
  laughing:    ["happy", "playful", "excited"],
  love:        ["happy", "shy", "aroused"],
  nervous:     ["worried", "scared", "shy"],
  neutral:     ["thinking", "bored"],
  playful:     ["happy", "smug", "excited"],
  sad:         ["hurt", "worried", "tired"],
  scared:      ["nervous", "worried", "surprised"],
  shy:         ["embarrassed", "nervous", "love"],
  smug:        ["playful", "determined", "happy"],
  surprised:   ["confused", "excited", "scared"],
  thinking:    ["neutral", "confused", "bored"],
  tired:       ["bored", "sad", "neutral"],
  worried:     ["nervous", "sad", "scared"]
};

function crResolveEmotionSlot(want: string, filled: string[]) : string
{
  if (!filled || filled.length === 0){
    return "";
  }
  const has: Record<string, boolean> = {};
  for (let i = 0; i < filled.length; i++){
    has[filled[i]] = true;
  }
  const asked = want || FALLBACK_EMOTION;
  if (has[asked]){
    return asked;
  }
  const neighbours = CR_EMOTION_NEIGHBOURS[asked] || [];
  for (let i = 0; i < neighbours.length; i++){
    if (has[neighbours[i]]){
      return neighbours[i];
    }
  }
  if (has[FALLBACK_EMOTION]){
    return FALLBACK_EMOTION;
  }
  if (has[CR_SLOT_AVATAR]){
    return CR_SLOT_AVATAR;
  }
  return "";
}

let crMemConfirm: string = "";

type CrMemKind = "diary" | "process";

function crMemRecord(kind: CrMemKind) : Record<string, BrainConditional[]>
{
  return kind === "diary" ? diaryBrainsRecord : emotionalMemoryRecord;
}

async function crMemSave(kind: CrMemKind) : Promise<void>
{
  try{
    if (kind === "diary"){
      await saveDiaryBrains();
    }
    else{
      await saveEmotionalMemories();
    }
  }
  catch (e){
    api.v1.error("[CR:mem] could not save:", e);
  }
  crTouch();
}

function crMemList(kind: CrMemKind, combinedId: string) : BrainConditional[]
{
  const rec = crMemRecord(kind);
  if (!rec[combinedId]){
    rec[combinedId] = [];
  }
  return rec[combinedId];
}

async function crMemSetField(kind: CrMemKind, combinedId: string, at: number, field: string, value: string) : Promise<void>
{
  const list = crMemList(kind, combinedId);
  if (at < 0 || at >= list.length){
    return;
  }
  if (field === "name"){
    list[at].name = String(value || "").slice(0, 200);
  }
  else if (field === "content"){
    list[at].content = String(value || "").slice(0, 4000);
  }
  else{
    list[at].keys = String(value || "").split(",").map((k) => k.trim()).filter((k) => k.length > 0);
  }
  await crMemSave(kind);
}

async function crMemDelete(kind: CrMemKind, combinedId: string, at: number) : Promise<void>
{
  const list = crMemList(kind, combinedId);
  if (at < 0 || at >= list.length){
    return;
  }
  list.splice(at, 1);
  crMemConfirm = "";
  await crMemSave(kind);
}

async function crMemAdd(kind: CrMemKind, combinedId: string) : Promise<void>
{
  crMemList(kind, combinedId).push({ name: "", content: "", keys: [] });
  await crMemSave(kind);
}

function CrMemEntry(props: { kind: CrMemKind; combinedId: string; at: number; entry: BrainConditional; mobile: boolean }) : any
{
  const token = props.kind + ":" + String(props.at);
  const armed = crMemConfirm === token;
  return h("div", {
    class: "cr-mem-entry",
    style: {
      border: CR_LINE_W + " solid " + CR_LINE, borderRadius: CR_RADIUS_S,
      padding: props.mobile ? "9px" : "11px", marginBottom: CR_S_3,
      display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_3
    }
  },
    h(CrTextInput, {
      value: props.entry.name || "",
      placeholder: "what this memory is called",
      onSet: (v: string) => { crMemSetField(props.kind, props.combinedId, props.at, "name", v).catch(() => {}); }
    }),
    h(CrTextArea, {
      value: props.entry.content || "",
      placeholder: "what they remember",
      rows: props.mobile ? 4 : 3,
      onSet: (v: string) => { crMemSetField(props.kind, props.combinedId, props.at, "content", v).catch(() => {}); }
    }),
    h(CrField, {
      label: "Keys",
      hint: "Comma separated. The memory is only sent when one of these appears in the recent chat."
    }, h(CrTextInput, {
      value: (props.entry.keys || []).join(", "),
      placeholder: "the bar, that night, her brother",
      onSet: (v: string) => { crMemSetField(props.kind, props.combinedId, props.at, "keys", v).catch(() => {}); }
    })),
    h("div", { style: { display: "flex", justifyContent: "flex-end" } },
      h(CrButton, {
        text: armed ? "Really delete?" : "Delete",
        primary: armed,
        onClick: () => {
          if (armed){
            crMemDelete(props.kind, props.combinedId, props.at).catch(() => {});
          }
          else{
            crMemConfirm = token;
            crTouch();
          }
        }
      })
    )
  );
}

function CrMemSection(props: { kind: CrMemKind; title: string; note: string; combinedId: string;
                               mobile: boolean; gen?: string; onGen?: () => void }) : any
{
  const list = crMemList(props.kind, props.combinedId);
  const running = !!props.gen && crGenBusy === props.gen;
  return h(CrSection, { title: props.title, note: props.note },
    h("div", { style: { marginTop: CR_S_3 } },
      list.length > 0
        ? list.map((e, i) => h(CrMemEntry, {
            key: props.kind + String(i),
            kind: props.kind, combinedId: props.combinedId, at: i, entry: e, mobile: props.mobile
          }))
        : h("div", { style: { color: CR_DIM, fontSize: CR_T_MD } }, "Nothing here yet.")
    ),
    h("div", { style: { display: "flex", gap: CR_S_3, flexWrap: "wrap" } },
      (!props.gen || !props.onGen) ? null : h(CrButton, {
        text: running ? "Writing…" : props.gen,
        primary: true,
        disabled: !!crGenBusy,
        onClick: props.onGen
      }),
      h(CrButton, { text: "Add one", onClick: () => { crMemAdd(props.kind, props.combinedId).catch(() => {}); } })
    )
  );
}

function CrPlanRow(props: { cid: string; at: number; plan: ActionPlan; mobile: boolean }) : any
{
  const p = props.plan;
  const ongoing = p.durationType === "Ongoing";
  return h("div", {
    style: {
      border: CR_LINE_W + " solid " + CR_LINE, borderRadius: CR_RADIUS_S,
      padding: props.mobile ? "10px 11px" : "12px 14px", display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_3,
      background: p.running ? CR_FILL2 : CR_SURFACE
    }
  },
    h("div", { style: { display: "flex", gap: CR_S_2, alignItems: "center", flexWrap: "wrap" } },
      h("div", { style: { color: CR_DIM, fontSize: CR_T_SM } },
        (p.planType === "AI" ? "Written by " : "Yours · ")
        + (p.planType === "AI" ? "them" : "")
        + " · " + (p.running ? "running" : "stopped")
        + " · " + (ongoing ? "ongoing" : String(p.remainingTurns) + " turns left")),
      h("div", { style: { flex: "1 1 auto" } }),
      h(CrButton, {
        text: p.running ? "Stop" : "Start",
        primary: !p.running,
        onClick: () => { crPlanSet(props.cid, props.at, "running", !p.running).catch(() => {}); }
      }),
      h(CrButton, {
        text: "Delete",
        onClick: () => { crPlanDelete(props.cid, props.at).catch(() => {}); }
      })
    ),
    h(CrField, { label: "Name", hint: "Not seen by the model. For you." },
      h(CrTextInput, {
        value: p.name || "", placeholder: "what this plan is",
        onSet: (v: string) => { crPlanSet(props.cid, props.at, "name", v.slice(0, 200)).catch(() => {}); }
      })),
    h(CrField, { label: "Content", hint: "First person reads best — it is written as them." },
      h(CrTextArea, {
        value: p.content || "", placeholder: "I am going to …", rows: 3,
        onSet: (v: string) => { crPlanSet(props.cid, props.at, "content", v.slice(0, 4000)).catch(() => {}); }
      })),
    h("div", { style: { display: "flex", gap: CR_S_3, flexWrap: "wrap", alignItems: "flex-end" } },
      h("div", { style: { flex: "0 1 180px" } },
        h(CrNumField, {
          label: "Turns",
          hint: "Changing this stops the plan, so the next Start re-anchors its countdown.",
          value: p.remainingTurns,
          onSet: (n: number) => { crPlanSet(props.cid, props.at, "remainingTurns", n).catch(() => {}); }
        })),
      h(CrButton, {
        text: ongoing ? "Ongoing ∞" : "Limited",
        primary: ongoing,
        onClick: () => {
          crPlanSet(props.cid, props.at, "durationType", ongoing ? "Limited" : "Ongoing").catch(() => {});
        }
      })
    )
  );
}

function CrMemoriesTab(props: { char: Character; mobile: boolean }) : any
{
  const user = crLiveUser();
  if (!user){
    return h("div", { class: "cr-memories" },
      h(CrSection, {
        title: "Memories",
        note: "Diaries, Process entries and Jots are all filed under a Contact AND a User, because they are what these two have between them."
      }),
      h(CrEmpty, { text: "Pair a User on the Chat screen to see what " + props.char.name + " remembers." })
    );
  }
  const combinedId = props.char.id + user.id;
  const jots = crJotList(combinedId);
  return h("div", { class: "cr-memories", style: { display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_4 } },
    crGenNote ? h("div", {
      style: {
        color: CR_DIM, fontSize: CR_T_SM, lineHeight: "1.5",
        border: CR_LINE_W + " solid " + CR_LINE, borderRadius: CR_RADIUS_S, padding: "8px 10px"
      }
    }, crGenNote) : null,
    h(CrMemSection, {
      kind: "diary", combinedId: combinedId, mobile: props.mobile,
      title: "Diaries",
      note: "Contact reflections on the chat. Sent only when one of its keys turns up in recent chat.",
      gen: "Reflect",
      onGen: () => { crGenReflect().catch(() => {}); }
    }),
    h(CrSection, {
      title: "Plans",
      note: "Contact's ongoing plans for the chat. A running plan is sent with every reply until its turns run out — it is the one thing here that acts on its own once started."
    },
      h("div", { style: { marginTop: CR_S_3, display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_3 } },
        crPlanList(combinedId).length > 0
          ? crPlanList(combinedId).map((p, i) => h(CrPlanRow, {
              key: "plan" + String(i), cid: combinedId, at: i, plan: p, mobile: props.mobile
            }))
          : h("div", { style: { color: CR_DIM, fontSize: CR_T_MD } }, "Nothing here yet.")
      ),
      h("div", { style: { display: "flex", gap: CR_S_3, flexWrap: "wrap", marginTop: CR_S_3 } },
        h(CrButton, {
          text: crGenBusy === "Plan" ? "Writing…" : "Plan",
          primary: true,
          disabled: !!crGenBusy,
          onClick: () => { crGenPlan().catch(() => {}); }
        }),
        h(CrButton, { text: "Add one", onClick: () => { crPlanAdd(combinedId).catch(() => {}); } })
      )
    ),
    h(CrMemSection, {
      kind: "process", combinedId: combinedId, mobile: props.mobile,
      title: "Process",
      note: "Contact emotional impressions from the chat — the same shape as a Diary, but about how something felt rather than what happened.",
      gen: "Process",
      onGen: () => { crGenProcess().catch(() => {}); }
    }),
    h(CrSection, {
      title: "Jots",
      note: "Short facts about " + user.name + " that " + props.char.name + " is always told. They have their own screen."
    },
      h("div", { style: { marginTop: CR_S_3 } },
        jots.length > 0
          ? h("div", { style: { display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_2 } },
              jots.map((j) => h("div", {
                key: j.id,
                style: {
                  color: j.text ? CR_TEXT : CR_DIM, fontSize: CR_T_MD, lineHeight: "1.45",
                  background: CR_SUNK, border: CR_LINE_W + " solid " + CR_LINE,
                  borderRadius: CR_RADIUS_S, padding: CR_PAD_CTL
                }
              }, j.text || "(empty)"))
            )
          : h("div", { style: { color: CR_DIM, fontSize: CR_T_MD } }, "Nothing jotted for this pairing yet.")
      ),
      h("div", { style: { marginTop: CR_S_3 } },
        h(CrButton, { text: "Open Jots", onClick: () => { crNav({ surface: "jots" }); } })
      )
    )
  );
}

function CrProfileHead(props: {
  name: string; handle?: string; sub?: string; avatarSrc?: string; cardId: string;
  pills?: any[]; status?: any; actions?: any[]; back: any; mobile: boolean
}) : any
{
  const mob = props.mobile;
  const pills = (props.pills || []).filter((p) => !!p);
  const actions = (props.actions || []).filter((a) => !!a);
  return h("div", { class: "cr-profile-head", style: { display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_3 } },
    h("div", { style: { display: "flex" } }, props.back),
    h("div", {
      style: {
        display: "flex", gap: mob ? CR_S_4 : CR_S_5, alignItems: "flex-start",
        paddingBottom: CR_S_4
      }
    },
      h(CrAvatar, {
        src: props.avatarSrc, name: props.name, charId: props.cardId,
        size: crAvatarSize(88, mob, "avatar-profile", 96, 9, 168)
      }),
      h("div", { style: { flex: "1 1 auto", minWidth: "0", display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_2 } },
        h("div", { style: { display: "flex", gap: CR_S_2, alignItems: "flex-start" } },
          h("div", { style: { flex: "1 1 auto", minWidth: "0" } },
            h("div", {
              style: {
                color: CR_HEAD, fontSize: mob ? CR_T_LG : CR_T_XL, fontWeight: "700",
                overflow: "hidden", textOverflow: "ellipsis"
              }
            }, props.name || "Unnamed"),
            props.handle ? h("div", { style: { color: CR_DIM, fontSize: CR_T_MD } }, props.handle) : null
          ),
          actions.length ? h("div", { style: { display: "flex", gap: CR_S_2, flex: "0 0 auto" } }, actions) : null
        ),
        pills.length ? h("div", {
          style: { display: "flex", gap: CR_S_2, flexWrap: "wrap" }
        }, pills) : null,
        props.status ? h("div", null, props.status) : null
      )
    )
  );
}

function CrContactProfile(props: { st: CrUiState; char: Character }) : any
{
  const char = props.char;
  const tab = props.st.profileTab;
  const mob = props.st.layout === "mobile";
  const tabs = [
    { id: "posts", label: "Posts" },
    { id: "about", label: "About" },
    { id: "schedule", label: "Schedule" },
    { id: "memories", label: "Memories" },
    { id: "voice", label: "Voice" },
    { id: "brains", label: "Brains" },
    { id: "photos", label: "Photos" },
    { id: "visuals", label: "Visuals" }
  ];
  let body: any;
  if (tab === "photos"){
    body = h(CrPhotosTab, { char: char, mobile: mob });
  }
  else if (tab === "visuals"){
    body = h(CrVisualsTab, { char: char });
  }
  else if (tab === "memories"){
    body = h(CrMemoriesTab, { char: char, mobile: mob });
  }
  else if (tab === "about"){
    const setField = (k: string) => (v: string) => { crSetCharField(char, k, v).catch(() => {}); };
    body = h("div", { class: "cr-contact-about", style: { display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_4 } },
      h(CrSection, { title: "Name" }, h("div", { style: { marginTop: CR_S_3, display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_3 } },
        h(CrTextInput, { value: char.name || "", placeholder: "New Character", onSet: setField("name") }),
        h(CrField, { label: "Handle", hint: "Shown as @handle on this profile, and used in the card's filename." },
          h(CrTextInput, { value: char.alias || "", placeholder: "handle", onSet: setField("alias") }))
      )),
      h(CrSection, {
        title: "Description",
        note: "What this Contact is, for you. It does not reach the model."
      }, h("div", { style: { marginTop: CR_S_3 } },
        h(CrTextArea, {
          value: char.description || "", placeholder: "The bartender who knows everyone.",
          rows: mob ? 4 : 3, onSet: setField("description")
        })
      )),
      h(CrSection, {
        title: "Persona",
        note: "Who they are. This is the field the model actually reads."
      }, h("div", { style: { marginTop: CR_S_3 } },
        h(CrTextArea, {
          value: char.persona || "", placeholder: "Dry, unhurried, remembers every tab that was never paid.",
          rows: mob ? 6 : 5, onSet: setField("persona")
        })
      )),
      h(CrSection, {
        title: "Appearance",
        note: "Also the fallback for this card's Universal image prompt — written here, they can be drawn without touching Visuals."
      }, h("div", { style: { marginTop: CR_S_3 } },
        h(CrTextArea, {
          value: char.appearance || "", placeholder: "Grey at the temples, sleeves always rolled.",
          rows: mob ? 4 : 3, onSet: setField("appearance")
        })
      )),
      h(CrSection, { title: "Attributes" }, h("div", {
        style: { marginTop: CR_S_3, display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_3 }
      },
        h(CrField, { label: "Species" },
          h(CrTextInput, { value: char.species || "", placeholder: "human", onSet: setField("species") })),
        h(CrField, { label: "Gender" },
          h(CrTextInput, { value: char.gender || "", placeholder: "", onSet: setField("gender") })),
        h(CrField, { label: "Pronouns" },
          h(CrTextInput, { value: char.pronouns || "", placeholder: "they/them", onSet: setField("pronouns") })),
        h(CrField, { label: "Tags", hint: "Comma-separated, as AR's own field takes them." },
          h(CrTextInput, { value: char.tags || "", placeholder: "noir, bartender", onSet: setField("tags") }))
      )),
      h(CrSection, {
        title: "Defaults",
        note: "Where a new chat with this Contact starts. The chat can move from here without changing the card."
      }, h("div", { style: { marginTop: CR_S_3, display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_4 } },
        h(CrChoice, {
          label: "Intimacy",
          options: INTIMACY_LIST.map((i) => ({ id: i, label: i })),
          active: char.defaultIntimacy || "stranger",
          onPick: (id: string) => { crSetCharChoice(char, "defaultIntimacy", id).catch(() => {}); }
        }),
        h(CrChoice, {
          label: "Style",
          options: STYLE_LIST.map((s) => ({ id: s, label: s })),
          active: char.defaultStyle || "chat",
          onPick: (id: string) => { crSetCharChoice(char, "defaultStyle", id).catch(() => {}); }
        }),
        h(CrChoice, {
          label: "CJK",
          hint: "Counts characters the way Chinese, Japanese and Korean text needs counting.",
          options: [{ id: "off", label: "Off" }, { id: "on", label: "On" }],
          active: char.cjk ? "on" : "off",
          onPick: (id: string) => { crSetCharChoice(char, "cjk", id === "on").catch(() => {}); }
        })
      )),
      h(CrSection, {
        title: "Brains",
        note: (char.brains || []).length + " static, " + (char.brainsConditional || []).length +
              " conditional. Edited on the Brains tab; the Schedule has its own tab now."
      }),
      h(CrSection, {
        title: "Card",
        note: "Export and Delete are at the top of this profile, beside the name. Export writes the card as a json file, avatar and emotion images included."
      })
    );
  }
  else if (tab === "voice"){
    const chats: ExampleChat[] = (char.exampleChats || []).slice();
    const commit = () => { crSetExampleChats(char, chats).catch(() => {}); };
    body = h("div", { class: "cr-voice-tab", style: { display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_4 } },
      h(CrSection, {
        title: "Greeting",
        note: "The first thing they say, before the story has anything to go on."
      }, h("div", { style: { marginTop: CR_S_3, display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_3 } },
        h(CrTextArea, {
          value: char.greeting || "", placeholder: "\"You again. Same as last time?\"",
          rows: mob ? 5 : 4,
          onSet: (v: string) => { crSetCharField(char, "greeting", v).catch(() => {}); }
        }),
        h(CrField, { label: "Greeting emotion", hint: "Which portrait the greeting is spoken with." },
          h(CrButton, {
            text: char.greetingEmotion || "None",
            onClick: () => {
              crOpenEmotionPicker("Greeting emotion", String(char.greetingEmotion || ""), (v: string) => {
                crSetCharChoice(char, "greetingEmotion", v || undefined).catch(() => {});
              }).catch(() => {});
            }
          })
        )
      )),
      h(CrSection, {
        title: "Imitate",
        note: "Create example chats from chat history. A generated one waits here until you add it to the card or throw it away — it does nothing at all until it is added."
      },
        h("div", { style: { marginTop: CR_S_3, display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_3 } },
          crImitateList(char).length === 0
            ? h("div", { style: { color: CR_DIM, fontSize: CR_T_MD } }, "Nothing waiting.")
            : crImitateList(char).map((g, gi) => h("div", {
                key: "im" + String(gi),
                style: {
                  border: CR_LINE_W + " solid " + CR_LINE, borderRadius: CR_RADIUS_S,
                  padding: mob ? "10px 11px" : "12px 14px", display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_3
                }
              },
                h("div", { style: { color: CR_HEAD, fontWeight: "600", fontSize: CR_T_MD } },
                  g.name || "Untitled"),
                h("div", {
                  style: {
                    fontSize: CR_T_SM, lineHeight: "1.55", whiteSpace: "pre-wrap",
                    maxHeight: "260px", overflowY: "auto", color: CR_TEXT
                  }
                }, g.content || ""),
                h("div", { style: { display: "flex", gap: CR_S_3, flexWrap: "wrap" } },
                  h(CrButton, {
                    text: "Add to Example Chats",
                    primary: true,
                    onClick: () => { crImitateAccept(char, gi).catch(() => {}); }
                  }),
                  h(CrButton, {
                    text: "Delete",
                    onClick: () => { crImitateDiscard(char, gi).catch(() => {}); }
                  })
                )
              ))
        ),
        crGenNote ? h("div", { style: { color: CR_DIM, fontSize: CR_T_SM, marginTop: CR_S_3 } }, crGenNote) : null,
        h("div", { style: { marginTop: CR_S_3 } },
          h(CrButton, {
            text: crGenBusy === "Imitate" ? "Writing…" : "Imitate",
            primary: true,
            disabled: !!crGenBusy,
            onClick: () => { crGenImitate().catch(() => {}); }
          })
        )
      ),
      h(CrSection, {
        title: "Example chats",
        note: "Sample exchanges that teach the model how this Contact talks. Each one carries its own style, so a card can show both a chat voice and a novel voice."
      }, h("div", { style: { marginTop: CR_S_3, display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_4 } },
        chats.length === 0 ? h(CrEmpty, { text: "None on this card yet." }) : null,
        chats.map((chat, ci) => h("div", {
          key: "ec" + ci,
          style: {
            border: CR_LINE_W + " solid " + CR_LINE, borderRadius: CR_RADIUS_S,
            padding: CR_S_4, display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_3
          }
        },
          h("div", { style: { display: "flex", gap: CR_S_3, alignItems: "center", flexWrap: "wrap" } },
            h("div", { style: { flex: "1 1 140px", minWidth: "0" } },
              h(CrTextInput, {
                value: chat.name || "", placeholder: "Example name",
                onSet: (v: string) => { chats[ci].name = v.slice(0, 120); commit(); }
              })
            ),
            h(CrButton, {
              text: "Remove",
              onClick: () => { chats.splice(ci, 1); commit(); }
            })
          ),
          h(CrField, { label: "User name in this example", hint: "Who the Contact is talking to here." },
            h(CrTextInput, {
              value: chat.userName || "", placeholder: "You",
              onSet: (v: string) => { chats[ci].userName = v.slice(0, 120); commit(); }
            })
          ),
          h(CrChoice, {
            label: "Style",
            options: STYLE_LIST.map((s) => ({ id: s, label: s })),
            active: chat.style || "chat",
            onPick: (id: string) => { chats[ci].style = id as Style; commit(); }
          }),
          h("div", { style: { display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_3 } },
            (chat.messages || []).map((msg, mi) => h("div", {
              key: "ec" + ci + "m" + mi,
              style: {
                borderLeft: "calc(" + CR_LINE_W + " * 2) solid " + (msg.isContact ? CR_ACCENT : CR_LINE),
                paddingLeft: CR_S_3, display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_2
              }
            },
              h("div", { style: { display: "flex", gap: CR_S_2, flexWrap: "wrap", alignItems: "center" } },
                h(CrButton, {
                  text: msg.isContact ? (char.name || "Contact") : (chat.userName || "User"),
                  primary: msg.isContact,
                  onClick: () => { chats[ci].messages[mi].isContact = !msg.isContact; commit(); }
                }),
                msg.isContact ? h(CrButton, {
                  text: msg.emotion || "no emotion",
                  onClick: () => {
                    crOpenEmotionPicker("Message emotion", String(msg.emotion || ""), (v: string) => {
                      chats[ci].messages[mi].emotion = (v || undefined) as Emotion;
                      commit();
                    }).catch(() => {});
                  }
                }) : null,
                h(CrButton, {
                  text: "Remove line",
                  onClick: () => { chats[ci].messages.splice(mi, 1); commit(); }
                })
              ),
              h(CrTextArea, {
                value: msg.text || "", placeholder: "What they say",
                rows: 2,
                onSet: (v: string) => { chats[ci].messages[mi].text = v.slice(0, 4000); commit(); }
              })
            ))
          ),
          h("div", { style: { display: "flex", gap: CR_S_3, flexWrap: "wrap" } },
            h(CrButton, {
              text: "Add a line",
              onClick: () => {
                const last = (chat.messages || [])[chat.messages.length - 1];
                chats[ci].messages = (chat.messages || []).concat([
                  { isContact: last ? !last.isContact : true, text: "" }
                ]);
                commit();
              }
            })
          )
        )),
        h(CrButton, {
          text: "Add an example chat",
          disabled: chats.length >= 12,
          onClick: () => {
            chats.push({ name: "Example " + (chats.length + 1), style: char.defaultStyle || "chat",
                         userName: "You", messages: [] });
            commit();
          }
        })
      ))
    );
  }
  else if (tab === "brains"){
    body = h(CrBrainsTab, { card: char, kind: "contact", mobile: mob });
  }
  else if (tab === "posts"){
    body = h(CrPostsTab, { char: char, mobile: mob });
  }
  else if (tab === "schedule"){
    body = h(CrScheduleTab, { char: char, mobile: mob });
  }
  else {
    body = h(CrEmpty, { text: "Jots, Diary, Process and Plans for this Contact." });
  }

  return h("div", { class: "cr-profile" },
    h(CrProfileHead, {
      name: char.name || "Unnamed",
      handle: char.alias ? "@" + char.alias : "",
      avatarSrc: char.avatar,
      cardId: char.id,
      mobile: mob,
      back: h(CrButton, { text: "Back to Contacts", onClick: () => crNav({ openContactId: "" }) }),
      pills: [
        h(CrPill, { text: char.defaultIntimacy || "stranger", tone: "accent" }),
        h(CrPill, { text: char.defaultStyle || "chat" }),
        char.species ? h(CrPill, { text: char.species }) : null,
        char.gender ? h(CrPill, { text: char.gender }) : null,
        char.pronouns ? h(CrPill, { text: char.pronouns }) : null,
        char.cr ? h(CrPill, { text: "cr data", tone: "accent" }) : null
      ],
      status: h(CrStatusLine, { char: char, mobile: mob }),
      actions: [
        h(CrIconButton, {
          icon: "export", label: "Export the card",
          onClick: () => { exportCharacter("fileDownload", char).catch(() => {}); }
        }),
        h(CrIconButton, {
          icon: "trash", label: "Delete this Contact", tone: "warn",
          onClick: () => { crOpenDeleteSheet(char).catch(() => {}); }
        })
      ]
    }),
    h(CrTabs, { tabs: tabs, active: tab, mobile: mob, onPick: (id: string) => crNav({ profileTab: id }) }),
    h("div", { style: { padding: "14px 0 0 0" } }, body)
  );
}

function CrBrainsTab(props: { card: CrAnyCard; kind: CrCardKind; mobile: boolean }) : any
{
  const card = props.card;
  const mob = props.mobile;
  const brains: BrainEntry[] = (card.brains || []).slice();
  const conds: BrainComplexConditional[] = (card.brainsConditional || []).slice();
  const commitStatic = () => { crSetBrains(card, props.kind, brains).catch(() => {}); };
  const commitCond = () => { crSetBrainsConditional(card, props.kind, conds).catch(() => {}); };

  const rowStyle: any = {
    border: CR_LINE_W + " solid " + CR_LINE, borderRadius: CR_RADIUS_S,
    padding: CR_S_4, display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_3
  };

  return h("div", { class: "cr-brains-tab", style: { display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_4 } },
    h(CrSection, {
      title: "Brains file",
      note: "Brains on their own, as json, to copy a set of entries between cards. Import adds to what is here; it does not replace it."
    }, h("div", { style: { marginTop: CR_S_3, display: "flex", gap: CR_S_3, flexWrap: "wrap" } },
      h(CrButton, {
        text: "Import brains",
        onClick: () => {
          cardBrainImport("fileInput", card)
            .then((changed) => { if (changed){ crCommitCard(props.kind, "the imported brains", card).catch(() => {}); } })
            .catch(() => {});
        }
      }),
      h(CrButton, {
        text: "Export brains",
        onClick: () => { cardBrainExport("fileDownload", card).catch(() => {}); }
      })
    )),
    h(CrSection, {
      title: "Always in context",
      note: "Facts the model should never have to be reminded of. Every one of these is sent with every message, so they cost tokens on every turn."
    }, h("div", { style: { marginTop: CR_S_3, display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_3 } },
      brains.length === 0 ? h(CrEmpty, { text: "None on this card." }) : null,
      brains.map((b, i) => h("div", { key: "b" + i, style: rowStyle },
        h("div", { style: { display: "flex", gap: CR_S_3, alignItems: "center", flexWrap: "wrap" } },
          h("div", { style: { flex: "1 1 140px", minWidth: "0" } },
            h(CrTextInput, {
              value: b.name || "", placeholder: "Entry name",
              onSet: (v: string) => { brains[i].name = v.slice(0, 120); commitStatic(); }
            })
          ),
          h(CrButton, {
            text: "Remove",
            onClick: () => { brains.splice(i, 1); commitStatic(); }
          })
        ),
        h(CrTextArea, {
          value: b.content || "", placeholder: "What is true, in as few words as it takes.",
          rows: mob ? 4 : 3,
          onSet: (v: string) => { brains[i].content = v.slice(0, 4000); commitStatic(); }
        })
      )),
      h(CrButton, {
        text: "Add an entry",
        disabled: brains.length >= 40,
        onClick: () => { brains.push({ name: "", content: "" }); commitStatic(); }
      }),
      props.kind !== "contact" ? null : h(CrButton, {
        text: crChatImgHasBrain(card) ? "Rewrite the photo instruction" : "Add the photo instruction",
        onClick: () => { crChatImgAddBrain(card, props.kind).catch(() => {}); }
      })
    )),

    h(CrSection, {
      title: "Conditional",
      note: "In context only when one of its keys comes up, and only once the chat is at the intimacy it asks for. This is where anything long or situational belongs."
    }, h("div", { style: { marginTop: CR_S_3, display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_3 } },
      conds.length === 0 ? h(CrEmpty, { text: "None on this card." }) : null,
      conds.map((c, i) => h("div", { key: "c" + i, style: rowStyle },
        h("div", { style: { display: "flex", gap: CR_S_3, alignItems: "center", flexWrap: "wrap" } },
          h("div", { style: { flex: "1 1 140px", minWidth: "0" } },
            h(CrTextInput, {
              value: c.name || "", placeholder: "Entry name",
              onSet: (v: string) => { conds[i].name = v.slice(0, 120); commitCond(); }
            })
          ),
          h(CrButton, {
            text: "Remove",
            onClick: () => { conds.splice(i, 1); commitCond(); }
          })
        ),
        h(CrField, {
          label: "Keys",
          hint: "Comma-separated. Any one of them brings the entry in; an entry with no keys never fires."
        }, h(CrTextInput, {
          value: (c.keys || []).join(", "), placeholder: "harbour, ferry, the docks",
          onSet: (v: string) => { conds[i].keys = crKeysFromText(v); commitCond(); }
        })),
        h(CrChoice, {
          label: "Needs intimacy",
          hint: "\"none\" means no requirement at all.",
          options: REQUIRED_INTIMACY_LIST.map((r) => ({ id: r, label: r })),
          active: c.requiredIntimacy || "none",
          onPick: (id: string) => { conds[i].requiredIntimacy = id as RequiredIntimacy; commitCond(); }
        }),
        h(CrTextArea, {
          value: c.content || "", placeholder: "What the model should know when this comes up.",
          rows: mob ? 5 : 4,
          onSet: (v: string) => { conds[i].content = v.slice(0, 4000); commitCond(); }
        })
      )),
      h(CrButton, {
        text: "Add a conditional entry",
        disabled: conds.length >= 40,
        onClick: () => {
          conds.push({ name: "", content: "", keys: [], requiredIntimacy: "none" });
          commitCond();
        }
      })
    ))
  );
}

let crUserConfirmId: string = "";

function CrUserProfile(props: { st: CrUiState; user: User }) : any
{
  const user = props.user;
  const tab = props.st.profileTab;
  const mob = props.st.layout === "mobile";
  const tabs = [
    { id: "about", label: "About" },
    { id: "brains", label: "Brains" },
    { id: "photos", label: "Photos" },
    { id: "visuals", label: "Visuals" }
  ];
  let body: any;
  if (tab === "visuals"){
    body = h(CrVisualsTab, { char: user });
  }
  else if (tab === "photos"){
    body = h("div", null,
      h(CrSection, {
        title: "Avatar",
        note: crBridge.ready
          ? "Stored in this browser by the bridge, under this User, so it follows the card across every story."
          : "Bridge not connected. The bridge holds the images, so nothing here works without it."
      }, h(CrOneImage, {
        id: user.id, slot: CR_SLOT_AVATAR, label: "No avatar stored",
        aspect: "3 / 4", mobile: mob, generateLabel: "Generate",
        note: "Drawn from this card's Universal pair, or its Appearance if that is empty.",
        onGenerate: () => { crGenerateSlot(user, CR_SLOT_AVATAR).catch(() => {}); }
      }))
    );
  }
  else if (tab === "brains"){
    body = h(CrBrainsTab, { card: user, kind: "user", mobile: mob });
  }
  else {
    const setField = (k: string) => (v: string) => { crSetUserField(user, k, v).catch(() => {}); };
    body = h("div", { class: "cr-user-about", style: { display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_4 } },
      h(CrSection, { title: "Name" }, h("div", { style: { marginTop: CR_S_3 } },
        h(CrTextInput, { value: user.name || "", placeholder: "New User", onSet: setField("name") })
      )),
      h(CrSection, {
        title: "Description",
        note: "What this persona is, for you. It does not reach the model."
      }, h("div", { style: { marginTop: CR_S_3 } },
        h(CrTextArea, {
          value: user.description || "", placeholder: "The one I use for noir stories.",
          rows: mob ? 4 : 3, onSet: setField("description")
        })
      )),
      h(CrSection, {
        title: "Persona",
        note: "Who you are in the story. This is the field the model actually reads."
      }, h("div", { style: { marginTop: CR_S_3 } },
        h(CrTextArea, {
          value: user.persona || "", placeholder: "A harbour-side fixer who owes everyone a favour.",
          rows: mob ? 6 : 5, onSet: setField("persona")
        })
      )),
      h(CrSection, {
        title: "Appearance",
        note: "Also the fallback for this card's Universal image prompt — written here, it can be drawn without touching Visuals."
      }, h("div", { style: { marginTop: CR_S_3 } },
        h(CrTextArea, {
          value: user.appearance || "", placeholder: "Short dark hair, a coat two sizes too big.",
          rows: mob ? 4 : 3, onSet: setField("appearance")
        })
      )),
      h(CrSection, { title: "Attributes" }, h("div", {
        style: { marginTop: CR_S_3, display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_3 }
      },
        h(CrField, { label: "Species" },
          h(CrTextInput, { value: user.species || "", placeholder: "human", onSet: setField("species") })),
        h(CrField, { label: "Gender" },
          h(CrTextInput, { value: user.gender || "", placeholder: "", onSet: setField("gender") })),
        h(CrField, { label: "Pronouns" },
          h(CrTextInput, { value: user.pronouns || "", placeholder: "they/them", onSet: setField("pronouns") })),
        h(CrField, { label: "Tags", hint: "Comma-separated, as AR's own field takes them." },
          h(CrTextInput, { value: user.tags || "", placeholder: "noir, fixer", onSet: setField("tags") }))
      )),
      h(CrSection, {
        title: "Brains",
        note: (user.brains || []).length + " static, " + (user.brainsConditional || []).length +
              " conditional. Edited on the Brains tab."
      }),
      h(CrSection, {
        title: "Card",
        note: "Export and Delete are at the top of this profile, beside the name. Export writes the card as a json file."
      })
    );
  }

  const armed = crUserConfirmId === user.id;
  return h("div", { class: "cr-profile cr-profile-user" },
    h(CrProfileHead, {
      name: user.name || "Unnamed",
      cardId: user.id,
      mobile: mob,
      back: h(CrButton, { text: "Back to Users", onClick: () => crNav({ openContactId: "" }) }),
      pills: [
        h(CrPill, { text: "user", tone: "accent" }),
        (chatSettings.user && chatSettings.user.id === user.id) ? h(CrPill, { text: "this chat" }) : null,
        user.species ? h(CrPill, { text: user.species }) : null,
        user.gender ? h(CrPill, { text: user.gender }) : null,
        user.pronouns ? h(CrPill, { text: user.pronouns }) : null,
        user.cr ? h(CrPill, { text: "cr data", tone: "accent" }) : null
      ],
      actions: [
        h(CrIconButton, {
          icon: "export", label: "Export the card",
          onClick: () => { exportUser("fileDownload", user).catch(() => {}); }
        }),
        armed
          ? h(CrButton, {
              text: "Delete for good", tone: "warn",
              onClick: () => { crUserConfirmId = ""; crDeleteUser(user).catch(() => {}); }
            })
          : h(CrIconButton, {
              icon: "trash", label: "Delete this User", tone: "warn",
              onClick: () => { crUserConfirmId = user.id; crTouch(); }
            }),
        armed
          ? h(CrIconButton, { icon: "close", label: "Keep it",
                              onClick: () => { crUserConfirmId = ""; crTouch(); } })
          : null
      ]
    }),
    h(CrTabs, { tabs: tabs, active: tab, mobile: mob, onPick: (id: string) => crNav({ profileTab: id }) }),
    h("div", { style: { padding: "14px 0 0 0" } }, body)
  );
}

let crScenarioConfirmId: string = "";

function CrScenarioProfile(props: { st: CrUiState; scenario: Scenario }) : any
{
  const scenario = props.scenario;
  const tab = props.st.profileTab;
  const mob = props.st.layout === "mobile";
  const card: CrSceneCard = (scenario.cr && scenario.cr.img) ? scenario.cr.img : {};
  const tabs = [
    { id: "about", label: "About" },
    { id: "brains", label: "Brains" },
    { id: "photos", label: "Banner" },
    { id: "visuals", label: "Visuals" }
  ];
  const setScene = (k: string) => (v: string) => { crSetSceneField(scenario, k, v).catch(() => {}); };
  let body: any;
  if (tab === "visuals"){
    body = h("div", { class: "cr-scene-tab" },
      h(CrSection, {
        title: "Scene",
        note: "Joins the base prompt of every illustration drawn while this is the chat's Scenario, ahead of anyone's own base tags. The weather, the light, the place."
      }, h("div", { style: { marginTop: CR_S_3 } },
        h(CrPromptPair, {
          label: "", prompt: card.basePrompt || "", uc: card.baseUC || "",
          onPrompt: setScene("basePrompt"), onUC: setScene("baseUC")
        })
      )),
      h(CrSection, {
        title: "Banner",
        note: "For drawing the place itself, with nobody in it. Left empty, the scene pair is used instead."
      }, h("div", { style: { marginTop: CR_S_3, display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_4 } },
        h(CrPromptPair, {
          label: "", prompt: card.bannerPrompt || "", uc: card.bannerUC || "",
          onPrompt: setScene("bannerPrompt"), onUC: setScene("bannerUC")
        }),
        h(CrNumField, {
          label: "Banner seed", value: card.bannerSeed || 0,
          hint: "One seed keeps a set of images of this place looking like one place. 0 uses the account seed.",
          onSet: (n: number) => { crSetBannerSeed(scenario, n).catch(() => {}); }
        })
      )),
      h(CrSection, {
        title: "What gets sent",
        note: (card.basePrompt || "").trim()
          ? "Every illustration while this Scenario is the chat's: " + (card.basePrompt || "").trim()
          : "Nothing yet — an empty scene pair adds nothing to an illustration."
      })
    );
  }
  else if (tab === "brains"){
    body = h(CrBrainsTab, { card: scenario, kind: "scenario", mobile: mob });
  }
  else if (tab === "photos"){
    body = h(CrSection, {
      title: "Banner",
      note: crBridge.ready
        ? "Stored in this browser by the bridge, under this Scenario."
        : "Bridge not connected. The bridge holds the images, so nothing here works without it."
    }, h(CrOneImage, {
      id: scenario.id, slot: CR_SLOT_BANNER, label: "No banner stored",
      aspect: "16 / 9", mobile: mob, generateLabel: "Generate the place",
      note: "Drawn from the banner pair, or the scene pair if that is empty. Nobody is in it.",
      onGenerate: () => { crGenerateBanner(scenario).catch(() => {}); }
    }));
  }
  else {
    const setField = (k: string) => (v: string) => { crSetScenarioField(scenario, k, v).catch(() => {}); };
    body = h("div", { class: "cr-scenario-about", style: { display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_4 } },
      h(CrSection, { title: "Name" }, h("div", { style: { marginTop: CR_S_3 } },
        h(CrTextInput, {
          value: scenario.name || "", placeholder: "New Scenario", onSet: setField("name")
        })
      )),
      h(CrSection, {
        title: "Description",
        note: "What this Scenario is, for you. It does not reach the model."
      }, h("div", { style: { marginTop: CR_S_3 } },
        h(CrTextArea, {
          value: scenario.description || "", placeholder: "A rainy port city, late autumn.",
          rows: mob ? 4 : 3, onSet: setField("description")
        })
      )),
      h(CrSection, {
        title: "Environment",
        note: "The standing facts of the place — what is always true while this Scenario is the chat's."
      }, h("div", { style: { marginTop: CR_S_3 } },
        h(CrTextArea, {
          value: scenario.environment || "", placeholder: "Neon over wet streets. The ferries stop at midnight.",
          rows: mob ? 5 : 4, onSet: setField("environment")
        })
      )),
      h(CrSection, {
        title: "Scene",
        note: "Where this particular story opens."
      }, h("div", { style: { marginTop: CR_S_3 } },
        h(CrTextArea, {
          value: scenario.scene || "", placeholder: "The last ferry has gone and the rain has not let up.",
          rows: mob ? 5 : 4, onSet: setField("scene")
        })
      )),
      h(CrSection, {
        title: "Tags",
        note: "Comma-separated, as AR's own field takes them."
      }, h("div", { style: { marginTop: CR_S_3 } },
        h(CrTextInput, {
          value: scenario.tags || "", placeholder: "noir, rain, harbour", onSet: setField("tags")
        })
      )),
      h(CrSection, {
        title: "Brains",
        note: (scenario.brains || []).length + " static, " + (scenario.brainsConditional || []).length +
              " conditional. Edited on the Brains tab."
      }),
      h(CrSection, {
        title: "Card",
        note: "Export writes the card as a json file. Delete cannot be undone, and unpairs this chat if it is the one paired."
      }, h("div", { style: { marginTop: CR_S_3, display: "flex", gap: CR_S_3, flexWrap: "wrap" } },
        h(CrButton, {
          text: "Export",
          onClick: () => { exportScenario("fileDownload", scenario).catch(() => {}); }
        }),
        crScenarioConfirmId === scenario.id
          ? h(CrButton, {
              text: "Delete for good", primary: true,
              onClick: () => { crScenarioConfirmId = ""; crDeleteScenario(scenario).catch(() => {}); }
            })
          : h(CrButton, {
              text: "Delete",
              onClick: () => { crScenarioConfirmId = scenario.id; crTouch(); }
            }),
        crScenarioConfirmId === scenario.id
          ? h(CrButton, { text: "Keep it", onClick: () => { crScenarioConfirmId = ""; crTouch(); } })
          : null
      ))
    );
  }

  const bannerH = mob ? 120 : 180;
  return h("div", { class: "cr-profile cr-profile-scenario" },
    mob ? h("div", { style: { marginBottom: "10px" } },
      h(CrButton, { text: "← Scenarios", onClick: () => crNav({ openContactId: "" }) })
    ) : null,
    h("div", {
      class: "cr-banner",
      style: {
        height: bannerH + "px", borderRadius: CR_RADIUS, background: CR_FILL,
        border: CR_LINE_W + " solid " + CR_LINE, position: "relative", overflow: "hidden",
        marginBottom: CR_S_4, display: "grid", placeItems: "center"
      }
    },
      crImgAnchor(scenario.id, CR_SLOT_BANNER, "fit=cover,shrink=1",
        { position: "absolute", inset: "0", width: "100%", height: "100%", display: "block" }),
      h("div", { style: { position: "relative", color: CR_DIM, fontSize: CR_T_SM } }, "No banner yet"),
      mob ? null : h("div", { style: { position: "absolute", right: "12px", top: "12px" } },
        h(CrButton, { text: "Back to Scenarios", onClick: () => crNav({ openContactId: "" }) })
      )
    ),
    h("div", { style: { padding: "0 4px 12px 4px" } },
      h("div", { style: { color: CR_HEAD, fontSize: mob ? CR_T_LG : CR_T_XL, fontWeight: "700" } }, scenario.name || "Unnamed"),
      h("div", { style: { display: "flex", gap: CR_S_2, marginTop: CR_S_3, flexWrap: "wrap" } },
        h(CrPill, { text: "scenario", tone: "accent" }),
        (chatSettings.scenario && chatSettings.scenario.id === scenario.id) ? h(CrPill, { text: "this chat" }) : null,
        (card.basePrompt || "").trim() ? h(CrPill, { text: "scene tags", tone: "accent" }) : null
      )
    ),
    h(CrTabs, { tabs: tabs, active: tab, mobile: mob, onPick: (id: string) => crNav({ profileTab: id }) }),
    h("div", { style: { padding: "14px 0 0 0" } }, body)
  );
}

// [KIT-FROM-CE]

function CrClockPanel(props: { mobile: boolean }) : any
{
  const story = crClock.mode === "story";
  const active = crClockActive();
  const nowMs = crClockNow();
  const step = crClock.stepMin;
  const jump = (mins: number) => () => { crClockAdvance(mins).catch(() => {}); };
  return h(CrSection, {
    title: "Clock",
    note: story
      ? "Story time. It moves when you move it, and undo rewinds it with the turn that spent it."
      : "Real time, from this device. Time Apart follows AR's Track Real Time toggle, which is "
        + (crClock.trackReal ? "on." : "off — the schedule reaches the model only while it is on.")
  },
    h("div", { style: { marginTop: CR_S_3, display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_4 } },
      h("div", {
        style: {
          background: CR_SUNK, border: CR_LINE_W + " solid " + CR_LINE, borderRadius: CR_RADIUS_S,
          padding: "10px 12px", display: "flex", alignItems: "baseline", gap: CR_S_3, flexWrap: "wrap"
        }
      },
        h("div", { style: { color: CR_HEAD, fontSize: CR_T_XL, fontWeight: "700" } },
          crFmtHM(crMinutesOfDay(nowMs))),
        h("div", { style: { color: CR_TEXT, fontSize: CR_T_MD } }, crWeekdayOf(nowMs)),
        h("div", { style: { color: CR_DIM, fontSize: CR_T_SM } }, crFmtDate(nowMs)),
        h("div", { style: { flex: "1 1 auto" } }),
        h(CrPill, { text: story ? (active ? "story" : "story, unset") : "real", tone: story ? "accent" : "" })
      ),
      h(CrChoice, {
        label: "This chat runs on",
        options: [{ id: "real", label: "Real time" }, { id: "story", label: "Story time" }],
        active: crClock.mode,
        onPick: (id: string) => { crClockSetMode(id === "story" ? "story" : "real").catch(() => {}); }
      }),
      story ? h(CrField, { label: "Move the clock", hint: "Every consumer reads this: macros, Time Apart, Current Events and the schedule." },
        h("div", { style: { display: "flex", gap: CR_S_2, flexWrap: "wrap", marginTop: CR_S_1 } },
          h(CrButton, { text: "−1h", onClick: jump(-60) }),
          h(CrButton, { text: "−30m", onClick: jump(-30) }),
          h(CrButton, { text: "+30m", onClick: jump(30) }),
          h(CrButton, { text: "+1h", onClick: jump(60) }),
          h(CrButton, { text: "+8h", onClick: jump(480) }),
          h(CrButton, { text: "Next morning", onClick: () => { crClockNextMorning().catch(() => {}); } })
        )
      ) : null,
      story ? h(CrField, { label: "Move the day" },
        h("div", { style: { display: "flex", gap: CR_S_2, flexWrap: "wrap", marginTop: CR_S_1 } },
          h(CrButton, { text: "−1 day", onClick: jump(-CR_DAY_MIN) }),
          h(CrButton, { text: "+1 day", onClick: jump(CR_DAY_MIN) }),
          h(CrButton, { text: "Set to 08:00", onClick: () => { crClockSetTimeOfDay(CR_MORNING_MIN).catch(() => {}); } }),
          h(CrButton, { text: "Match device", onClick: () => { crClockResetToDevice().catch(() => {}); } })
        )
      ) : null,
      story ? h(CrChoice, {
        label: "Advance per reply",
        hint: "Added after every xialong reply. Off leaves the clock entirely in your hands.",
        options: CR_CLOCK_STEP_LIST.map((n) => ({ id: String(n), label: n === 0 ? "Off" : String(n) + "m" })),
        active: String(step),
        onPick: (id: string) => { crClockSetStep(Number(id)).catch(() => {}); }
      }) : null,
      h(CrChoice, {
        label: "Track Real Time",
        hint: story
          ? "Only read in real time. Story time carries Time Apart and Current Events by itself."
          : (crClock.trackReal
            ? "On, so the model is told how long you were away and the schedule is sent."
            : "Off, so the model is never told how long you were away and the schedule is not sent."),
        options: [{ id: "off", label: "Off" }, { id: "on", label: "On" }],
        active: crClock.trackReal ? "on" : "off",
        onPick: (id: string) => { crSetTrackRealTime(id === "on").catch(() => {}); }
      })
    )
  );
}

type CrSchedPiece = { evt: ScheduleEvent; from: number; to: number; wrapped: boolean };

function crSchedPieces(list: ScheduleEvent[]) : CrSchedPiece[]
{
  const out: CrSchedPiece[] = [];
  for (const e of (list || [])){
    const s = Math.max(0, Math.min(CR_DAY_MIN, Number(e.startTime) || 0));
    const t = Math.max(0, Math.min(CR_DAY_MIN, Number(e.endTime) || 0));
    if (s <= t){
      out.push({ evt: e, from: s, to: Math.max(t, s + 5), wrapped: false });
    }
    else{
      out.push({ evt: e, from: s, to: CR_DAY_MIN, wrapped: true });
      out.push({ evt: e, from: 0, to: Math.max(t, 5), wrapped: true });
    }
  }
  out.sort((a, b) => a.from - b.from);
  return out;
}

function crSchedLanes(pieces: CrSchedPiece[]) : CrSchedPiece[][]
{
  const lanes: CrSchedPiece[][] = [];
  for (const p of pieces){
    let placed = false;
    for (const lane of lanes){
      const last = lane[lane.length - 1];
      if (last && last.to <= p.from){
        lane.push(p);
        placed = true;
        break;
      }
    }
    if (!placed){
      lanes.push([p]);
    }
  }
  return lanes;
}

function crSchedLive(evt: ScheduleEvent, minutes: number) : boolean
{
  if (evt.startTime <= evt.endTime){
    return minutes >= evt.startTime && minutes <= evt.endTime;
  }
  return minutes >= evt.startTime || minutes <= evt.endTime;
}

function crSchedGated(evt: ScheduleEvent) : boolean
{
  return evt.requiredIntimacy !== "none" && chatSettings.intimacy !== evt.requiredIntimacy;
}

function crSchedPct(minutes: number) : string
{
  return String((minutes / CR_DAY_MIN) * 100) + "%";
}

function CrDayNow(props: { minutes: number; flag: boolean }) : any
{
  return h("div", {
    class: "cr-day-now",
    style: {
      position: "absolute", top: "0", bottom: "0", zIndex: "3",
      left: "calc(" + crSchedPct(props.minutes) + " - 1px)",
      width: "2px", background: CR_WARN, pointerEvents: "none"
    }
  },
    props.flag ? h("div", {
      style: {
        position: "absolute", top: "-2px", left: "50%", transform: "translateX(-50%)",
        fontSize: CR_T_XS, lineHeight: "1.3", padding: "0 3px", borderRadius: "3px",
        whiteSpace: "nowrap", background: CR_SUNK, color: CR_TEXT,
        border: CR_LINE_W + " solid " + CR_WARN
      }
    }, crFmtHM(props.minutes)) : null
  );
}

function CrDayStrip(props: {
  list: ScheduleEvent[]; laneH: number; nowMinutes: number; showNow: boolean;
  labels: boolean; onPick?: (id: string) => void;
}) : any
{
  const lanes = crSchedLanes(crSchedPieces(props.list));
  const rows = Math.max(1, lanes.length);
  const blocks: any[] = [];
  for (let li = 0; li < lanes.length; li++){
    const lane = lanes[li] as CrSchedPiece[];
    for (let pi = 0; pi < lane.length; pi++){
      const p = lane[pi] as CrSchedPiece;
      const live = crSchedLive(p.evt, props.nowMinutes);
      const gated = crSchedGated(p.evt);
      const text = (p.evt.text || "").trim();
      const wide = props.labels && (p.to - p.from) >= 150;
      blocks.push(h(CrPressable, {
        key: p.evt.id + "_" + String(p.from),
        render: (hover: boolean, press: boolean, handlers: any) => h("div", Object.assign({
          class: "cr-day-block",
          title: crFmtHM(p.evt.startTime) + " – " + crFmtHM(p.evt.endTime)
                 + (text ? " · " + text : " · (no text yet)")
                 + (p.wrapped ? " · runs past midnight" : "")
                 + (gated ? " · needs intimacy: " + p.evt.requiredIntimacy : ""),
          style: {
            position: "absolute", top: String(li * props.laneH + 1) + "px",
            height: String(props.laneH - 2) + "px",
            left: crSchedPct(p.from), width: crSchedPct(Math.max(5, p.to - p.from)),
            borderRadius: "4px", overflow: "hidden", whiteSpace: "nowrap",
            textOverflow: "ellipsis", padding: "0 4px", boxSizing: "border-box",
            fontSize: CR_T_XS, lineHeight: String(props.laneH - 2) + "px",
            color: live ? CR_BG : CR_TEXT,
            background: live ? CR_ACCENT : crPressBg(hover, press, CR_FILL2),
            border: gated ? "1px dashed " + CR_DIM : CR_LINE_W + " solid " + CR_LINE,
            opacity: gated ? "0.7" : "1",
            cursor: props.onPick ? "pointer" : "default", transition: CR_MOTION
          },
          onClick: () => { if (props.onPick){ props.onPick(p.evt.id); } }
        }, handlers), wide ? (text || "untitled") : "")
      }));
    }
  }
  return h("div", {
    class: "cr-day-strip",
    style: {
      position: "relative", width: "100%", height: String(rows * props.laneH) + "px",
      background: CR_SUNK, border: CR_LINE_W + " solid " + CR_LINE, borderRadius: CR_RADIUS_S,
      overflow: "hidden"
    }
  },
    [6, 12, 18].map((hh) => h("div", {
      key: "q" + String(hh),
      style: {
        position: "absolute", top: "0", bottom: "0", width: "1px",
        left: crSchedPct(hh * 60), background: CR_LINE, pointerEvents: "none"
      }
    })),
    blocks,
    props.showNow ? h(CrDayNow, { minutes: props.nowMinutes, flag: props.labels }) : null
  );
}

function CrDayRuler() : any
{
  const marks: any[] = [];
  for (let hh = 0; hh <= 24; hh += 4){
    marks.push(h("div", {
      key: "r" + String(hh),
      style: { flex: (hh === 24) ? "0 0 auto" : "1 1 0", color: CR_DIM, fontSize: CR_T_XS }
    }, crPad2(hh % 24)));
  }
  return h("div", { style: { display: "flex", width: "100%", paddingTop: CR_S_1 } }, marks);
}

let crSchedDay: string = "Daily";
let crEvtSheetCharId: string = "";
let crEvtSheetId: string = "";
let crEvtSheetHandle: any = null;
let crEvtSheetConfirm: boolean = false;

function crScheduleOf(char: Character) : Record<Day, ScheduleEvent[]>
{
  if (!char.schedule){
    char.schedule = {
      Daily: [], Monday: [], Tuesday: [], Wednesday: [], Thursday: [],
      Friday: [], Saturday: [], Sunday: []
    };
  }
  for (const d of DAY_LIST){
    if (!char.schedule[d]){
      char.schedule[d] = [];
    }
  }
  return char.schedule;
}

async function crScheduleSave(char: Character) : Promise<void>
{
  const sched = crScheduleOf(char);
  for (const d of DAY_LIST){
    sched[d].sort((a, b) => a.startTime - b.startTime);
  }
  await crCommitCard("contact", "the schedule", char);
}

function crScheduleFind(char: Character, id: string) : { day: Day; evt: ScheduleEvent } | null
{
  const sched = crScheduleOf(char);
  for (const d of DAY_LIST){
    for (const e of sched[d]){
      if (e.id === id){
        return { day: d, evt: e };
      }
    }
  }
  return null;
}

async function crScheduleAdd(char: Character, day: Day) : Promise<void>
{
  const sched = crScheduleOf(char);
  const evt: ScheduleEvent = {
    id: api.v1.uuid(), startTime: 540, endTime: 600, text: "", requiredIntimacy: "none"
  };
  sched[day].push(evt);
  await crScheduleSave(char);
  await crOpenEventSheet(char.id, evt.id);
}

async function crScheduleSet(char: Character, id: string, patch: any) : Promise<void>
{
  const found = crScheduleFind(char, id);
  if (!found){
    return;
  }
  for (const k in patch){
    (found.evt as any)[k] = patch[k];
  }
  await crScheduleSave(char);
}

async function crScheduleMove(char: Character, id: string, day: Day) : Promise<void>
{
  const found = crScheduleFind(char, id);
  if (!found || found.day === day){
    return;
  }
  const sched = crScheduleOf(char);
  sched[found.day] = sched[found.day].filter((e) => e.id !== id);
  sched[day].push(found.evt);
  await crScheduleSave(char);
}

async function crScheduleDelete(char: Character, id: string) : Promise<void>
{
  const sched = crScheduleOf(char);
  for (const d of DAY_LIST){
    sched[d] = sched[d].filter((e) => e.id !== id);
  }
  await crScheduleSave(char);
}

function crEvtSheetCard() : Character | null
{
  for (const c of charList){
    if (c.id === crEvtSheetCharId){
      return c;
    }
  }
  return null;
}

async function crOpenEventSheet(charId: string, id: string) : Promise<void>
{
  crEvtSheetCharId = charId;
  crEvtSheetId = id;
  crEvtSheetConfirm = false;
  try{
    crEvtSheetHandle = await crJsxModal("Event", "small", () => CrEventSheet());
  }
  catch (e){
    api.v1.error("[CR:sched] event sheet failed:", e);
  }
}

async function crCloseEventSheet() : Promise<void>
{
  if (crEvtSheetHandle){
    try{ await crEvtSheetHandle.close(); }
    catch (e){}
    crEvtSheetHandle = null;
  }
}

function crEvtStep(value: number, delta: number) : number
{
  return ((Math.round(value + delta) % CR_DAY_MIN) + CR_DAY_MIN) % CR_DAY_MIN;
}

function CrEventSheet() : any
{
  const char = crEvtSheetCard();
  const found = char ? crScheduleFind(char, crEvtSheetId) : null;
  if (!char || !found){
    return h(CrEmpty, { text: "This event is gone." });
  }
  const evt = found.evt;
  const wrapped = evt.startTime > evt.endTime;
  const set = (patch: any) => { crScheduleSet(char, evt.id, patch).catch(() => {}); };
  const timeRow = (label: string, value: number, key: string) => h(CrField, { label: label },
    h("div", { style: { display: "flex", gap: CR_S_2, alignItems: "center", flexWrap: "wrap", marginTop: CR_S_1 } },
      h(CrButton, { text: "−1h", onClick: () => set({ [key]: crEvtStep(value, -60) }) }),
      h(CrButton, { text: "−30m", onClick: () => set({ [key]: crEvtStep(value, -30) }) }),
      h("div", {
        style: {
          minWidth: "62px", textAlign: "center", color: CR_HEAD, fontSize: CR_T_LG,
          fontWeight: "600"
        }
      }, crFmtHM(value)),
      h(CrButton, { text: "+30m", onClick: () => set({ [key]: crEvtStep(value, 30) }) }),
      h(CrButton, { text: "+1h", onClick: () => set({ [key]: crEvtStep(value, 60) }) })
    )
  );
  return h("div", { style: { display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_4, padding: CR_S_2 } },
    h(CrField, { label: "What they are doing", hint: "Macros work here: {{char}}, {{user}}, {{time}}." },
      h(CrTextInput, {
        value: evt.text || "", placeholder: "yoga",
        onSet: (v: string) => set({ text: v.slice(0, 400) })
      })
    ),
    timeRow("Starts", evt.startTime, "startTime"),
    timeRow("Ends", evt.endTime, "endTime"),
    h("div", { style: { color: wrapped ? CR_WARN : CR_DIM, fontSize: CR_T_SM } },
      wrapped
        ? "Runs past midnight — live from " + crFmtHM(evt.startTime) + " and again until " + crFmtHM(evt.endTime) + "."
        : "Live for " + String(Math.max(0, evt.endTime - evt.startTime)) + " minutes."),
    h(CrChoice, {
      label: "Day",
      options: DAY_LIST.map((d) => ({ id: d, label: d === "Daily" ? "Daily" : d.slice(0, 3) })),
      active: found.day,
      onPick: (id: string) => { crScheduleMove(char, evt.id, id as Day).catch(() => {}); }
    }),
    h(CrChoice, {
      label: "Needs intimacy",
      hint: "The kernel skips an event whose intimacy is not the chat's exactly — this is a match, not a floor.",
      options: REQUIRED_INTIMACY_LIST.map((r) => ({ id: r, label: r })),
      active: evt.requiredIntimacy || "none",
      onPick: (id: string) => set({ requiredIntimacy: id })
    }),
    h("div", { style: { display: "flex", gap: CR_S_3, flexWrap: "wrap", paddingTop: CR_S_2 } },
      h(CrButton, { text: "Close", onClick: () => { crCloseEventSheet().catch(() => {}); } }),
      h("div", { style: { flex: "1 1 auto" } }),
      h(CrButton, {
        text: crEvtSheetConfirm ? "Delete for good" : "Delete",
        onClick: () => {
          if (!crEvtSheetConfirm){
            crEvtSheetConfirm = true;
            crTouch();
            return;
          }
          crScheduleDelete(char, evt.id)
            .then(() => crCloseEventSheet())
            .catch(() => {});
        }
      })
    )
  );
}

type CrStatusRead = { live: ScheduleEvent[]; gated: ScheduleEvent[]; paired: boolean; sent: boolean };

function crStatusRead(char: Character) : CrStatusRead
{
  const ms = crClockNow();
  const minutes = crMinutesOfDay(ms);
  const today = crWeekdayOf(ms) as Day;
  const sched = char.schedule;
  const live: ScheduleEvent[] = [];
  const gated: ScheduleEvent[] = [];
  const paired = !!(chatSettings.char && chatSettings.char.id === char.id);
  if (sched){
    const lists: ScheduleEvent[][] = [];
    if (sched["Daily"]){ lists.push(sched["Daily"]); }
    if (sched[today]){ lists.push(sched[today]); }
    for (const list of lists){
      for (const e of list){
        if (!crSchedLive(e, minutes)){
          continue;
        }
        if (paired && crSchedGated(e)){
          gated.push(e);
        }
        else{
          live.push(e);
        }
      }
    }
  }
  return { live: live, gated: gated, paired: paired, sent: paired && (crClockActive() || crClock.trackReal) };
}

function crStatusText(read: CrStatusRead) : string
{
  if (read.live.length > 0){
    return read.live.map((e) => (e.text || "").trim() || "something unwritten").join("  ·  ");
  }
  if (read.gated.length > 0){
    return String(read.gated.length) + " event" + (read.gated.length === 1 ? "" : "s")
           + " on now, held back by intimacy";
  }
  return "Nothing scheduled right now.";
}

function CrStatusLine(props: { char: Character; mobile: boolean }) : any
{
  const read = crStatusRead(props.char);
  const has = read.live.length > 0;
  const dim = !has;
  return h("div", {
    class: "cr-status",
    style: {
      display: "flex", alignItems: "center", gap: CR_S_2, flexWrap: "wrap",
      color: dim ? CR_DIM : CR_TEXT, fontSize: CR_T_SM, minWidth: "0"
    }
  },
    h("div", {
      style: {
        width: "7px", height: "7px", borderRadius: "50%", flex: "0 0 auto",
        background: has ? CR_ACCENT : CR_LINE,
        border: has ? "none" : CR_LINE_W + " solid " + CR_DIM
      }
    }),
    h("div", { style: { minWidth: "0", overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" } },
      crStatusText(read)),
    h("div", { style: { color: CR_DIM, fontSize: CR_T_XS } }, crFmtHM(crMinutesOfDay(crClockNow()))),
    (has && read.paired && !read.sent) ? h(CrPill, { text: "not sent" }) : null
  );
}

function CrScheduleTab(props: { char: Character; mobile: boolean }) : any
{
  const char = props.char;
  const sched = crScheduleOf(char);
  const nowMs = crClockNow();
  const today = crWeekdayOf(nowMs);
  const nowMin = crMinutesOfDay(nowMs);
  const day = (DAY_LIST as readonly string[]).indexOf(crSchedDay) >= 0 ? (crSchedDay as Day) : "Daily";
  const paired = !!(chatSettings.char && chatSettings.char.id === char.id);
  const reaching = crClockActive() || crClock.trackReal;
  const list = sched[day];
  const laneH = props.mobile ? 20 : 22;

  const weekRows = DAY_LIST.map((d) => h("div", {
    key: "w" + d,
    style: { display: "flex", alignItems: "center", gap: CR_S_3, marginBottom: CR_S_1 }
  },
    h(CrPressable, {
      render: (hover: boolean, press: boolean, handlers: any) => h("div", Object.assign({
        style: {
          width: props.mobile ? "38px" : "62px", flex: "0 0 auto", cursor: "pointer",
          color: d === day ? CR_HEAD : CR_DIM, fontSize: CR_T_XS,
          fontWeight: d === day ? "700" : "400",
          background: crPressBg(hover, press, "transparent"), borderRadius: "4px",
          padding: "2px 3px", transition: CR_MOTION
        },
        onClick: () => { crSchedDay = d; crTouch(); }
      }, handlers), props.mobile ? (d === "Daily" ? "All" : d.slice(0, 3)) : d)
    }),
    h("div", { style: { flex: "1 1 auto", minWidth: "0" } },
      h(CrDayStrip, {
        list: sched[d], laneH: 12, nowMinutes: nowMin,
        showNow: (d === today || d === "Daily"), labels: false,
        onPick: () => { crSchedDay = d; crTouch(); }
      })
    ),
    h("div", { style: { width: "18px", flex: "0 0 auto", textAlign: "right", color: CR_DIM, fontSize: CR_T_XS } },
      sched[d].length > 0 ? String(sched[d].length) : "")
  ));

  const rows = list.map((e) => {
    const live = crSchedLive(e, nowMin);
    const gated = crSchedGated(e);
    return h(CrPressable, {
      key: "e" + e.id,
      render: (hover: boolean, press: boolean, handlers: any) => h("div", Object.assign({
        style: {
          display: "flex", gap: CR_S_3, alignItems: "center", cursor: "pointer",
          padding: CR_PAD_CTL, marginBottom: CR_S_2, borderRadius: CR_RADIUS_S,
          border: CR_LINE_W + " solid " + CR_LINE, background: crPressBg(hover, press, CR_FILL),
          transition: CR_MOTION
        },
        onClick: () => { crOpenEventSheet(char.id, e.id).catch(() => {}); }
      }, handlers),
        h("div", {
          style: {
            flex: "0 0 auto", color: live ? CR_ACCENT : CR_TEXT, fontSize: CR_T_SM,
            fontWeight: live ? "700" : "400"
          }
        }, crFmtHM(e.startTime) + " – " + crFmtHM(e.endTime)),
        h("div", {
          style: {
            flex: "1 1 auto", minWidth: "0", overflow: "hidden", whiteSpace: "nowrap",
            textOverflow: "ellipsis", color: (e.text || "").trim() ? CR_TEXT : CR_DIM,
            fontSize: CR_T_MD
          }
        }, (e.text || "").trim() || "No text yet"),
        e.startTime > e.endTime ? h(CrPill, { text: "overnight" }) : null,
        e.requiredIntimacy !== "none"
          ? h(CrPill, { text: e.requiredIntimacy, tone: gated ? "" : "accent" })
          : null
      )
    });
  });

  return h("div", { class: "cr-sched" },
    h(CrSection, {
      title: "The week",
      note: "Tap a day to open it. The line is now on the chat clock — "
            + crFmtStamp(nowMs) + (crClockActive() ? " (story time)." : " (real time).")
    },
      h("div", { style: { marginTop: CR_S_3 } }, h(CrStatusLine, { char: char, mobile: props.mobile })),
      h("div", { style: { marginTop: CR_S_3 } }, weekRows),
      h("div", { style: { paddingLeft: props.mobile ? "46px" : "70px", paddingRight: "18px" } },
        h(CrDayRuler, null)
      )
    ),
    !paired ? h(CrSection, {
      title: "Not this chat's Contact",
      note: "The schedule still saves. Current Events only reads the Contact paired to this story."
    }) : null,
    paired && !reaching ? h(CrSection, {
      title: "Nothing reaches the model yet",
      note: "AR gates Current Events behind Track Real Time, which is off. Turn it on in the Chat "
            + "screen's Clock panel, or put this chat on story time there — story time carries the "
            + "schedule on its own."
    }) : null,
    h(CrSection, {
      title: day === "Daily" ? "Daily — every day of the week" : day,
      note: day === "Daily"
        ? "Daily events are added to whatever the weekday's own list says, not instead of it."
        : "Only read on " + day + "s, on top of the Daily list."
    },
      h("div", { style: { marginTop: CR_S_3 } },
        h(CrDayStrip, {
          list: list, laneH: laneH, nowMinutes: nowMin,
          showNow: (day === today || day === "Daily"), labels: true,
          onPick: (id: string) => { crOpenEventSheet(char.id, id).catch(() => {}); }
        }),
        h(CrDayRuler, null)
      ),
      h("div", { style: { marginTop: CR_S_4 } },
        rows.length > 0 ? rows : h("div", { style: { color: CR_DIM, fontSize: CR_T_MD } },
          "Nothing on this day yet.")
      ),
      h("div", { style: { marginTop: CR_S_3, display: "flex", gap: CR_S_3, flexWrap: "wrap" } },
        h(CrButton, {
          text: "Add an event", primary: true,
          onClick: () => { crScheduleAdd(char, day).catch(() => {}); }
        })
      )
    )
  );
}

let crChatNote: string = "";

function crSetChatNote(text: string) : void
{
  crChatNote = text;
  crTouch();
}

function CrNote(props: { text: string }) : any
{
  if (!props.text){
    return null;
  }
  return h("div", {
    class: "cr-note",
    style: {
      marginTop: CR_S_3, color: CR_DIM, fontSize: CR_T_SM, lineHeight: "1.45",
      background: CR_SUNK, border: CR_LINE_W + " solid " + CR_LINE, borderRadius: CR_RADIUS_S,
      padding: CR_PAD_CTL
    }
  }, props.text);
}

let crPickTitle: string = "";
let crPickHint: string = "";
let crPickOptions: { id: string; label: string }[] = [];
let crPickValue: string = "";
let crPickApply: ((v: string) => void) | null = null;
let crPickHandle: any = null;

async function crOpenPickSheet(
  title: string, hint: string, options: { id: string; label: string }[],
  current: string, apply: (v: string) => void
) : Promise<void>
{
  crPickTitle = title;
  crPickHint = hint;
  crPickOptions = options;
  crPickValue = current || "";
  crPickApply = apply;
  try{
    crPickHandle = await crJsxModal(title, "small", () => CrPickSheet());
  }
  catch (e){
    api.v1.error("[CR:chat] picker failed:", e);
  }
}

async function crClosePickSheet() : Promise<void>
{
  if (crPickHandle){
    try{ await crPickHandle.close(); }
    catch (e){}
    crPickHandle = null;
  }
  crPickApply = null;
  crTouch();
}

function CrPickSheet() : any
{
  return h("div", { class: "cr-pick-sheet", style: { display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_4 } },
    h(CrChoice, {
      label: crPickTitle,
      hint: crPickHint,
      options: crPickOptions,
      active: crPickValue,
      onPick: (id: string) => {
        crPickValue = id;
        if (crPickApply){ crPickApply(id); }
        crClosePickSheet().catch(() => {});
      }
    }),
    h(CrButton, { text: "Close", onClick: () => { crClosePickSheet().catch(() => {}); } })
  );
}

type CrPairKind = "contact" | "user" | "scenario";

let crCardPickKind: CrPairKind = "contact";
let crCardPickHandle: any = null;

async function crOpenCardPicker(kind: CrPairKind) : Promise<void>
{
  crCardPickKind = kind;
  const title = kind === "contact" ? "Contact" : (kind === "user" ? "User" : "Scenario");
  try{
    crCardPickHandle = await crJsxModal(title, "small", () => CrCardPickSheet());
  }
  catch (e){
    api.v1.error("[CR:chat] card picker failed:", e);
  }
}

async function crCloseCardPicker() : Promise<void>
{
  if (crCardPickHandle){
    try{ await crCardPickHandle.close(); }
    catch (e){}
    crCardPickHandle = null;
  }
  crTouch();
}

function CrPickRow(props: { name: string; sub: string; avatar?: string; charId?: string; active: boolean; onPick: () => void; pill?: string }) : any
{
  return h(CrPressable, {
    render: (hover: boolean, press: boolean, handlers: any) => h("div", Object.assign({
      class: "cr-pick-row",
      style: {
        display: "flex", alignItems: "center", gap: CR_S_3,
        padding: "8px 9px", borderRadius: CR_RADIUS_S, cursor: "pointer",
        border: CR_LINE_W + " solid " + (props.active ? CR_ACCENT : CR_LINE),
        background: crPressBg(hover, press, "transparent"),
        transform: press ? "translateY(1px)" : "none"
      },
      onClick: props.onPick
    }, handlers),
      h(CrAvatar, { src: props.avatar || "", name: props.name, charId: props.charId, size: 28 }),
      h("div", { style: { minWidth: "0", flex: "1 1 auto" } },
        h("div", { style: { color: CR_HEAD, fontSize: CR_T_BASE, fontWeight: "600" } }, props.name),
        props.sub ? h("div", {
          style: { color: CR_DIM, fontSize: CR_T_SM, overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }
        }, props.sub) : null
      ),
      props.active ? h(CrPill, { text: props.pill || "paired", tone: "accent" }) : null
    )
  });
}

function CrCardPickSheet() : any
{
  const kind = crCardPickKind;
  const rows: any[] = [];
  if (kind === "contact"){
    const cur = chatSettings.char ? chatSettings.char.id : "";
    for (const char of charList){
      rows.push(h(CrPickRow, {
        key: char.id,
        name: char.alias || char.name,
        sub: char.description || char.persona || "",
        avatar: char.avatar,
        charId: char.id,
        active: char.id === cur,
        onPick: () => { crPairContact(char).catch(() => {}); crCloseCardPicker().catch(() => {}); }
      }));
    }
  }
  else if (kind === "user"){
    const cur = chatSettings.user ? chatSettings.user.id : "";
    for (const user of userList){
      rows.push(h(CrPickRow, {
        key: user.id,
        name: user.name,
        sub: user.description || user.persona || "",
        charId: user.id,
        active: user.id === cur,
        onPick: () => { crPairUser(user).catch(() => {}); crCloseCardPicker().catch(() => {}); }
      }));
    }
  }
  else{
    const cur = chatSettings.scenario ? chatSettings.scenario.id : "";
    for (const scenario of scenarioList){
      rows.push(h(CrPickRow, {
        key: scenario.id,
        name: scenario.name,
        sub: scenario.environment || scenario.description || "",
        charId: scenario.id,
        active: scenario.id === cur,
        onPick: () => { crPairScenario(scenario).catch(() => {}); crCloseCardPicker().catch(() => {}); }
      }));
    }
  }
  return h("div", { class: "cr-card-pick-sheet", style: { display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_3 } },
    rows.length ? h("div", { style: { display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_2 } }, rows)
      : h(CrEmpty, { text: "No cards of this kind yet. Make one on the Cards screen." }),
    h("div", { style: { display: "flex", gap: CR_S_2, flexWrap: "wrap", marginTop: CR_S_2 } },
      h(CrButton, {
        text: "Unpair",
        onClick: () => {
          if (kind === "contact"){ crPairContact(undefined).catch(() => {}); }
          else if (kind === "user"){ crPairUser(undefined).catch(() => {}); }
          else{ crPairScenario(undefined).catch(() => {}); }
          crCloseCardPicker().catch(() => {});
        }
      }),
      h(CrButton, { text: "Close", onClick: () => { crCloseCardPicker().catch(() => {}); } })
    )
  );
}

async function crPairContact(char: Character | undefined) : Promise<void>
{
  if (char){
    if (char.defaultIntimacy){
      chatSettings.intimacy = char.defaultIntimacy;
    }
    if (char.defaultStyle){
      chatSettings.style = char.defaultStyle;
    }
  }
  chatSettings.char = char;
  try{ await saveChatSettings(); }
  catch (e){
    api.v1.error("[CR:chat] could not save the pairing:", e);
    crSetChatNote("Could not save the pairing.");
    return;
  }
  if (char){
    try{
      clearEditorImages();
      await updateEditorImages();
    }
    catch (e){}
    if (crBridge.ready){
      crBridgeProbeSlots(char).catch(() => {});
    }
  }
  crBubbleApply().catch(() => {});
  crChatImgRuleApply().catch(() => {});
  crChatImgEmit().catch(() => {});
  try{ updateNameStyling(); }
  catch (e){}
  crSetChatNote(char ? ("Paired with " + (char.alias || char.name) + ".") : "Contact unpaired.");
}

async function crPairUser(user: User | undefined) : Promise<void>
{
  chatSettings.user = user;
  try{ await saveChatSettings(); }
  catch (e){
    api.v1.error("[CR:chat] could not save the User pairing:", e);
    crSetChatNote("Could not save the pairing.");
    return;
  }
  crSetChatNote(user ? ("You are " + user.name + " in this story.") : "User unpaired.");
}

async function crPairScenario(scenario: Scenario | undefined) : Promise<void>
{
  chatSettings.scenario = scenario;
  try{ await saveChatSettings(); }
  catch (e){
    api.v1.error("[CR:chat] could not save the Scenario pairing:", e);
    crSetChatNote("Could not save the pairing.");
    return;
  }
  crSetChatNote(scenario ? ("Scenario set to " + scenario.name + ".") : "Scenario cleared.");
}

const CR_CHAT_TAGS_CAP = 400;

async function crSetChatTags(value: string) : Promise<void>
{
  chatSettings.tags = String(value || "").slice(0, CR_CHAT_TAGS_CAP);
  try{ await saveChatSettings(); }
  catch (e){ api.v1.error("[CR:chat] could not save tags:", e); }
  crTouch();
}

async function crSetIntimacy(id: string) : Promise<void>
{
  const found = INTIMACY_LIST.find((i) => i === id);
  if (!found){
    return;
  }
  chatSettings.intimacy = found;
  try{ await saveChatSettings(); }
  catch (e){ api.v1.error("[CR:chat] could not save intimacy:", e); }
  crTouch();
}

async function crSetStyle(id: string) : Promise<void>
{
  const found = STYLE_LIST.find((s) => s === id);
  if (!found){
    return;
  }
  chatSettings.style = found;
  try{ await saveChatSettings(); }
  catch (e){ api.v1.error("[CR:chat] could not save style:", e); }
  crTouch();
}

async function crSetResponseLength(id: string) : Promise<void>
{
  const found = RESPONSE_LENGTH_LIST.find((r) => r === id);
  if (!found){
    return;
  }
  chatSettings.responseLength = found;
  try{ await saveChatSettings(); }
  catch (e){ api.v1.error("[CR:chat] could not save response length:", e); }
  crTouch();
}

async function crSetTrackRealTime(on: boolean) : Promise<void>
{
  try{
    await api.v1.storyStorage.set(TRACK_REAL_TIME_KEY, on === true);
    crClock.trackReal = on === true;
  }
  catch (e){
    api.v1.error("[CR:clock] could not save Track Real Time:", e);
  }
  crTouch();
}

function crInjecting() : boolean
{
  return !!(chatSettings.char && chatSettings.user);
}

function crGreetingText() : string
{
  const char = crLiveContact();
  const user = crLiveUser();
  if (!char || !user || !char.greeting){
    return "";
  }
  return replaceMacros(char.greeting, char.name, user.name);
}

async function crInsertGreeting() : Promise<void>
{
  const char = crLiveContact();
  const text = crGreetingText();
  if (!char || !text){
    crSetChatNote("Nothing to insert: this needs a paired Contact with a greeting, and a paired User.");
    return;
  }
  let documentEmpty = false;
  try{
    documentEmpty = (await api.v1.document.textFromSelection()) === "";
  }
  catch (e){
    crSetChatNote("Could not read the story document.");
    return;
  }
  if (!documentEmpty){
    crSetChatNote("The story is not empty. A greeting starts a chat, so it only goes into an empty document.");
    return;
  }
  const scriptPermission: ScriptPermission = "documentEdit";
  const hasPermission = await permissionCheckPassed(scriptPermission);
  if (!hasPermission){
    permissionRejectedShowWarning(scriptPermission);
    return;
  }
  try{
    await api.v1.document.append(`${char.name}: ${text}\n  Emotion: ${char.greetingEmotion || "neutral"}`);
  }
  catch (e){
    api.v1.error("[CR:chat] greeting insert failed:", e);
    crSetChatNote("Could not write to the story document.");
    return;
  }
  try{ await updateEditorImages(); }
  catch (e){}
  crSetChatNote("Greeting inserted.");
}

function CrPairRow(props: {
  label: string; value: string; empty: boolean; avatar?: string; charId?: string; slot?: string;
  onOpen: () => void; mobile: boolean;
}) : any
{
  return h("div", {
    class: "cr-pair-row",
    style: {
      display: "flex", alignItems: "center", gap: CR_S_3,
      padding: props.mobile ? "7px 0" : "8px 0",
      borderTop: CR_LINE_W + " solid " + CR_LINE
    }
  },
    h("div", { style: { color: CR_DIM, fontSize: CR_T_SM, width: props.mobile ? "62px" : "78px", flex: "0 0 auto" } }, props.label),
    h(CrAvatar, {
      src: props.avatar || "", name: props.empty ? "?" : props.value,
      charId: props.charId, slot: props.slot, size: 26
    }),
    h("div", {
      style: {
        flex: "1 1 auto", minWidth: "0", color: props.empty ? CR_DIM : CR_HEAD,
        fontSize: CR_T_BASE, overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap"
      }
    }, props.value),
    h(CrButton, { text: props.empty ? "Pick" : "Change", onClick: props.onOpen })
  );
}

function CrPairingPanel(props: { mobile: boolean }) : any
{
  const contact = crLiveContact();
  const user = crLiveUser();
  const scenario = crLiveScenario();
  return h(CrSection, {
    title: "Pairing",
    note: "A Contact and a User are what CharacterRoom needs before it puts anything in context. A Scenario is optional and sets the place."
  },
    h("div", { style: { marginTop: CR_S_3 } },
      h(CrPairRow, {
        label: "Contact", mobile: props.mobile,
        value: contact ? (contact.alias || contact.name) : "none",
        empty: !contact, avatar: contact ? contact.avatar : "",
        charId: contact ? contact.id : undefined,
        onOpen: () => { crOpenCardPicker("contact").catch(() => {}); }
      }),
      h(CrPairRow, {
        label: "User", mobile: props.mobile,
        value: user ? user.name : "none",
        empty: !user, charId: user ? user.id : undefined,
        onOpen: () => { crOpenCardPicker("user").catch(() => {}); }
      }),
      h(CrPairRow, {
        label: "Scenario", mobile: props.mobile,
        value: scenario ? scenario.name : "none",
        empty: !scenario, charId: scenario ? scenario.id : undefined,
        slot: CR_SLOT_BANNER,
        onOpen: () => { crOpenCardPicker("scenario").catch(() => {}); }
      })
    ),
    h("div", { style: { marginTop: CR_S_4 } },
      h(CrField, {
        label: "Tags",
        hint: "Joined with the Scenario's own tags and sent as Categories. Comma separated."
      }, h(CrTextInput, {
        value: chatSettings.tags || "",
        placeholder: "first person, present tense, superhero, comedy",
        onSet: (v: string) => { crSetChatTags(v).catch(() => {}); }
      }))
    )
  );
}

function CrTonePanel() : any
{
  return h(CrSection, {
    title: "Tone",
    note: "Picking a Contact adopts whatever defaults its card carries, so these are the chat's values rather than the card's."
  },
    h("div", { style: { marginTop: CR_S_3, display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_4 } },
      h(CrChoice, {
        label: "Intimacy",
        hint: "How well they know you. Brains and schedule events can require a level before they fire.",
        options: INTIMACY_LIST.map((i) => ({ id: i, label: i })),
        active: chatSettings.intimacy,
        onPick: (id: string) => { crSetIntimacy(id).catch(() => {}); }
      }),
      h(CrChoice, {
        label: "Style",
        options: STYLE_LIST.map((s) => ({ id: s, label: s })),
        active: chatSettings.style,
        onPick: (id: string) => { crSetStyle(id).catch(() => {}); }
      }),
      h(CrField, {
        label: "Response length",
        hint: "Sent with the style line. Thirteen options, so this one opens a sheet."
      },
        h("div", { style: { display: "flex", gap: CR_S_2, alignItems: "center", marginTop: CR_S_1 } },
          h("div", { style: { flex: "1 1 auto", color: CR_HEAD, fontSize: CR_T_BASE } },
            chatSettings.responseLength),
          h(CrButton, {
            text: "Change",
            onClick: () => {
              crOpenPickSheet(
                "Response length",
                "unspecified leaves the line out entirely, which is AR's own default.",
                RESPONSE_LENGTH_LIST.map((r) => ({ id: r, label: r })),
                chatSettings.responseLength,
                (id: string) => { crSetResponseLength(id).catch(() => {}); }
              ).catch(() => {});
            }
          })
        )
      )
    )
  );
}

function CrGreetingPanel() : any
{
  const contact = crLiveContact();
  const text = crGreetingText();
  const reason = !contact
    ? "No Contact is paired."
    : (!crLiveUser()
      ? "No User is paired, and a greeting is addressed to one."
      : (!contact.greeting ? (contact.name + " has no greeting on their card.") : ""));
  return h(CrSection, {
    title: "Greeting",
    note: "Appends the Contact's greeting and its emotion line to an empty story, which is the reliable way to open a chat."
  },
    h("div", { style: { marginTop: CR_S_3, display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_3 } },
      text ? h("div", {
        style: {
          background: CR_SUNK, border: CR_LINE_W + " solid " + CR_LINE, borderRadius: CR_RADIUS_S,
          padding: "9px 11px", color: CR_TEXT, fontSize: CR_T_MD, lineHeight: "1.5",
          whiteSpace: "pre-wrap"
        }
      }, text) : null,
      reason ? h("div", { style: { color: CR_DIM, fontSize: CR_T_SM } }, reason) : null,
      h("div", { style: { display: "flex", gap: CR_S_2, flexWrap: "wrap" } },
        h(CrButton, {
          text: "Insert greeting", primary: !!text, disabled: !text,
          onClick: () => { crInsertGreeting().catch(() => {}); }
        })
      ),
      h(CrChoice, {
        label: "Cue my turn after a reply",
        hint: "Writes \u201c" + crCueOpener() + "\u201d on a new line when "
          + (contact ? contact.name : "the Contact") + " finishes, so the line is open and waiting."
          + " The closing brace stays yours, and your name is added on the way to the model rather"
          + " than written into the story. Applies to every story.",
        options: [{ id: "off", label: "Off" }, { id: "on", label: "On" }],
        active: crCueOn ? "on" : "off",
        onPick: (id: string) => { crSetCueOn(id === "on").catch(() => {}); }
      }),
      (crCueOn && crCueReason) ? h("div", {
        style: { color: CR_DIM, fontSize: CR_T_SM, lineHeight: "1.5" }
      }, "Last generation: " + crCueReason) : null,
      h(CrChoice, {
        label: "Let " + (contact ? contact.name : "the Contact") + " send photos",
        hint: "When " + (contact ? contact.name : "they") + " writes \u201c[Image: ...]\u201d on"
          + " its own line, CharacterRoom turns the description into a picture and shows it under"
          + " the message. Costs one image generation each time, and needs the bridge."
          + " Add the instruction that asks for them from the Contact's Brains tab."
          + " Applies to every story.",
        options: [{ id: "off", label: "Off" }, { id: "on", label: "On" }],
        active: crChatImgOn ? "on" : "off",
        onPick: (id: string) => { crSetChatImgOn(id === "on").catch(() => {}); }
      }),
      (!crChatImgOn && contact && crChatImgHasBrain(contact)) ? h("div", {
        style: { color: CR_DIM, fontSize: CR_T_SM, lineHeight: "1.5" }
      }, contact.name + " has been told they can send photos, but this is off \u2014 so the"
        + " request will appear as text in the story and nothing will draw it.") : null,
      (crChatImgOn && contact && !crChatImgHasBrain(contact)) ? h("div", {
        style: { color: CR_DIM, fontSize: CR_T_SM, lineHeight: "1.5" }
      }, contact.name + " has not been told they can send photos \u2014 the Brains tab on their"
        + " profile has the button that tells them.") : null,
      (crChatImgOn && crChatImgReason) ? h("div", {
        style: { color: CR_DIM, fontSize: CR_T_SM, lineHeight: "1.5" }
      }, "Last reply: " + crChatImgReason) : null
    )
  );
}

function CrChatSurface(props: { mobile: boolean; tab: string }) : any
{
  const tab = (props.tab === "stage" || props.tab === "group") ? props.tab : "chat";
  const strip = h(CrTabs, {
    tabs: [{ id: "chat", label: "Chat" }, { id: "stage", label: "Stage" }, { id: "group", label: "Group" }],
    active: tab, mobile: props.mobile,
    onPick: (id: string) => crNav({ chatTab: id })
  });
  if (tab === "stage"){
    return h("div", {
      class: "cr-surface cr-surface-chat cr-surface-stage",
      style: { display: "grid", gridTemplateRows: "auto minmax(0,1fr)", height: "100%", minHeight: "0" }
    },
      h("div", { style: { padding: "0 8px", background: CR_RAIL } }, strip),
      h(CrStageSurface, { mobile: props.mobile })
    );
  }
  if (tab === "group"){
    return h("div", { class: "cr-surface cr-surface-chat cr-surface-group" },
      h("div", { style: { marginBottom: CR_S_4 } }, strip),
      h(CrGroupTab, { mobile: props.mobile })
    );
  }
  const contact = crLiveContact();
  const user = crLiveUser();
  const injecting = crInjecting();
  return h("div", { class: "cr-surface cr-surface-chat" },
    h("div", { style: { marginBottom: CR_S_4 } }, strip),
    h(CrSection, { title: "This story" },
      h("div", { style: { display: "flex", gap: CR_S_5, alignItems: "center", marginTop: CR_S_3 } },
        h(CrAvatar, { src: contact ? contact.avatar : "", name: contact ? contact.name : "?",
                      charId: contact ? contact.id : undefined,
                      size: crAvatarSize(40, props.mobile, "avatar-chat", 48, 3.4, 80) }),
        h("div", { style: { flex: "1 1 auto", minWidth: "0" } },
          h("div", { style: { color: CR_HEAD, fontSize: CR_T_LG, fontWeight: "600" } },
            contact ? contact.name : "No Contact paired"),
          h("div", { style: { color: CR_DIM, fontSize: CR_T_MD } },
            "with " + (user ? user.name : "no User")),
          contact ? h("div", { style: { marginTop: CR_S_2 } },
            h(CrStatusLine, { char: contact, mobile: props.mobile })) : null
        ),
        h(CrPill, { text: injecting ? "in context" : "not sent", tone: injecting ? "accent" : "" })
      ),
      injecting ? null : h("div", { style: { marginTop: CR_S_3, color: CR_DIM, fontSize: CR_T_SM, lineHeight: "1.45" } },
        "CharacterRoom adds nothing to context until both a Contact and a User are paired."),
      h(CrNote, { text: crChatNote })
    ),
    h(CrPairingPanel, { mobile: props.mobile }),
    h(CrTonePanel, null),
    h(CrGreetingPanel, null),
    h(CrClockPanel, { mobile: props.mobile }),
    h(CrSection, { title: "Bridge", note: getBridgeStatusText() })
  );
}
let crJotConfirmId: string = "";

function crJotPairing() : { combinedId: string; char: Character; user: User } | null
{
  const char = crLiveContact();
  const user = crLiveUser();
  if (!char || !user){
    return null;
  }
  return { combinedId: char.id + user.id, char: char, user: user };
}

function crJotList(combinedId: string) : RememberMeEntry[]
{
  if (!rememberMeRecord[combinedId]){
    rememberMeRecord[combinedId] = [];
  }
  return rememberMeRecord[combinedId];
}

async function crJotSave() : Promise<void>
{
  try{ await saveRememberMeList(); }
  catch (e){ api.v1.error("[CR:jots] could not save:", e); }
  crTouch();
}

async function crJotAdd(combinedId: string) : Promise<void>
{
  crJotList(combinedId).push({ text: "", id: api.v1.uuid() });
  await crJotSave();
}

async function crJotSetText(combinedId: string, id: string, text: string) : Promise<void>
{
  const list = crJotList(combinedId);
  const at = list.findIndex((e) => e.id === id);
  if (at < 0){
    return;
  }
  list[at].text = String(text || "").slice(0, 600);
  await crJotSave();
}

async function crJotDelete(combinedId: string, id: string) : Promise<void>
{
  const list = crJotList(combinedId);
  const at = list.findIndex((e) => e.id === id);
  if (at < 0){
    return;
  }
  list.splice(at, 1);
  crJotConfirmId = "";
  await crJotSave();
}

function CrJotRow(props: { combinedId: string; entry: RememberMeEntry }) : any
{
  const armed = crJotConfirmId === props.entry.id;
  return h("div", {
    class: "cr-jot-row",
    style: { display: "flex", gap: CR_S_2, alignItems: "center", marginBottom: CR_S_2 }
  },
    h("div", { style: { flex: "1 1 auto", minWidth: "0" } },
      h(CrTextInput, {
        value: props.entry.text,
        placeholder: "something they should know about you",
        onSet: (v: string) => { crJotSetText(props.combinedId, props.entry.id, v).catch(() => {}); }
      })
    ),
    h(CrButton, {
      text: armed ? "Delete?" : "×",
      primary: armed,
      onClick: () => {
        if (armed){
          crJotDelete(props.combinedId, props.entry.id).catch(() => {});
        }
        else{
          crJotConfirmId = props.entry.id;
          crTouch();
        }
      }
    })
  );
}

function CrJotsSurface() : any
{
  const pair = crJotPairing();
  if (!pair){
    return h("div", { class: "cr-surface cr-surface-jots" },
      h(CrSection, {
        title: "Jots",
        note: "Short facts about you, kept per Contact and User pairing and sent to the model as \"Facts About you\"."
      }),
      h(CrEmpty, { text: "Pair a Contact and a User on the Chat screen first — a Jot is filed under both." })
    );
  }
  const list = crJotList(pair.combinedId);
  return h("div", { class: "cr-surface cr-surface-jots" },
    h(CrSection, {
      title: "Jots",
      note: "Short facts about you that " + pair.char.name + " should know. They go into every generation "
            + "as \"Facts About " + pair.user.name + "\", so keep them to one line each."
    },
      h("div", { style: { marginTop: CR_S_3 } },
        list.length > 0
          ? list.map((e) => h(CrJotRow, { key: e.id, combinedId: pair.combinedId, entry: e }))
          : h("div", { style: { color: CR_DIM, fontSize: CR_T_MD } }, "Nothing jotted for this pairing yet.")
      ),
      h("div", { style: { marginTop: CR_S_3, display: "flex", gap: CR_S_2, flexWrap: "wrap" } },
        h(CrButton, { text: "Add a jot", primary: true, onClick: () => { crJotAdd(pair.combinedId).catch(() => {}); } }),
        h(CrButton, { text: "Import", onClick: () => { rememberMeImport("fileInput", pair.combinedId).catch(() => {}); } }),
        h(CrButton, { text: "Export", onClick: () => { rememberMeExport("fileDownload", pair.combinedId).catch(() => {}); } })
      )
    )
  );
}

const crNumDrafts: Record<string, string> = {};

function CrNumField(props: { label: string; value: number; hint?: string; id?: string; onSet: (n: number) => void }) : any
{
  const key = props.id || props.label;
  const held = Object.prototype.hasOwnProperty.call(crNumDrafts, key);
  const commit = () => {
    const raw = crNumDrafts[key];
    delete crNumDrafts[key];
    const n = Number(raw);
    if (raw !== undefined && String(raw).trim() !== "" && isFinite(n)){
      props.onSet(n);
    }
    else{
      crTouch();
    }
  };
  return h(CrField, { label: props.label, hint: props.hint },
    h("input", {
      type: "text",
      inputMode: "decimal",
      value: held ? crNumDrafts[key] : String(props.value),
      onInput: (e: any) => { crNumDrafts[key] = String(e.target.value); },
      onBlur: () => { if (held || Object.prototype.hasOwnProperty.call(crNumDrafts, key)){ commit(); } },
      onKeyDown: (e: any) => { if (e && e.key === "Enter"){ commit(); } },
      style: crInputStyle(CR_T_BASE)
    })
  );
}

function CrTextArea(props: { value: string; placeholder: string; rows?: number; onSet: (v: string) => void }) : any
{
  const st = crInputStyle(CR_T_MD);
  st.resize = "vertical";
  return h("textarea", {
    value: props.value,
    placeholder: props.placeholder,
    rows: props.rows || 2,
    onChange: (e: any) => { props.onSet(String(e.target.value || "")); },
    style: st
  });
}

function CrPromptPair(props: {
  label: string; hint?: string;
  prompt: string; uc: string;
  onPrompt: (v: string) => void; onUC: (v: string) => void;
}) : any
{
  return h(CrField, { label: props.label, hint: props.hint },
    h("div", { style: { display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_2 } },
      h(CrTextArea, { value: props.prompt, placeholder: "prompt", onSet: props.onPrompt }),
      h(CrTextArea, { value: props.uc, placeholder: "negative prompt", onSet: props.onUC })
    )
  );
}

function CrImgFieldsPanel() : any
{
  const compiled = crCompileImgFields();
  return h("div", null,
    crImgFields.map((f, idx) => h("div", {
      key: f.id,
      style: {
        border: CR_LINE_W + " solid " + CR_LINE, borderRadius: CR_RADIUS_S,
        padding: "10px", marginBottom: CR_S_3, background: f.active ? "transparent" : CR_SUNK
      }
    },
      h("div", { style: { display: "flex", gap: CR_S_3, alignItems: "center", marginBottom: CR_S_3, flexWrap: "wrap" } },
        h("input", {
          type: "text",
          value: f.label,
          onChange: (e: any) => { crImgFields[idx].label = String(e.target.value || "").slice(0, 80); crSaveImgFields().catch(() => {}); },
          style: {
            flex: "1 1 120px", minWidth: "0", boxSizing: "border-box",
            background: "transparent", color: CR_HEAD, font: "inherit", fontSize: CR_T_BASE,
            fontWeight: "600", border: "none", borderBottom: CR_LINE_W + " solid " + CR_LINE, padding: "3px 2px"
          }
        }),
        h(CrButton, {
          text: f.active ? "On" : "Off", primary: f.active,
          onClick: () => { crImgFields[idx].active = !crImgFields[idx].active; crSaveImgFields().catch(() => {}); }
        }),
        h(CrButton, {
          text: "Remove",
          onClick: () => { crImgFields.splice(idx, 1); crSaveImgFields().catch(() => {}); }
        })
      ),
      h("div", { style: { display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_2 } },
        h(CrTextArea, {
          value: f.basePrompt, placeholder: "added to the prompt",
          onSet: (v: string) => { crImgFields[idx].basePrompt = v.slice(0, 1200); crSaveImgFields().catch(() => {}); }
        }),
        h(CrTextArea, {
          value: f.uc, placeholder: "added to the negative prompt",
          onSet: (v: string) => { crImgFields[idx].uc = v.slice(0, 1200); crSaveImgFields().catch(() => {}); }
        }),
        h(CrNumField, {
          label: "Weight", value: f.weight,
          hint: "1 sends the text plain. Anything else wraps it as N::text::",
          onSet: (n: number) => { crImgFields[idx].weight = Math.max(0.1, Math.min(10, n)); crSaveImgFields().catch(() => {}); }
        })
      )
    )),
    h("div", { style: { display: "flex", gap: CR_S_3, marginBottom: "10px" } },
      h(CrButton, {
        text: "Add a chunk",
        disabled: crImgFields.length >= 24,
        onClick: () => {
          crImgFields.push({ id: "cr-f" + Date.now(), label: "New chunk", basePrompt: "", uc: "", weight: 1, active: true });
          crSaveImgFields().catch(() => {});
        }
      })
    ),
    h("div", { style: { color: CR_DIM, fontSize: CR_T_SM, lineHeight: "1.5", wordBreak: "break-word" } },
      h("div", null, "Prompt: " + (compiled.quality || "(nothing active)")),
      h("div", { style: { marginTop: CR_S_1 } }, "Negative: " + (compiled.negative || "(nothing active)"))
    )
  );
}

