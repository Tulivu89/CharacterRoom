const MACRO_LIST: string[] = ["{{char}}", "{{user}}", "{{date}}", "{{time24}}", "{{time}}"] as const;

// ============================================================================
// SECTION SCENARIO — SCENARIO CARDS
// ============================================================================
const EDIT_BRAINS_PREFIX = "Edit Brains: ";

const SCENARIO_LIST_KEY = "scenarioListKey";
function createScenarioTemplate(): Scenario {
  return {
    cardType: "scenario",
    format: CARD_FORMAT,
    id: api.v1.uuid(),
    author: defaultAuthorUsersetting || DEFAULT_AUTHOR_NAME,
    name: "New Scenario",
    brains: [],
    brainsConditional: []
  };
}
let scenarioList: Scenario[] = [];
await api.v1.storage.setIfAbsent(SCENARIO_LIST_KEY, scenarioList);
scenarioList = await api.v1.storage.get(SCENARIO_LIST_KEY);

async function saveScenarioList()
{
  await api.v1.storage.set(SCENARIO_LIST_KEY, scenarioList);
}

async function reflectScenarioChangesInChatSettings(scenario: Scenario) : Promise<void>
{
  if (!chatSettings.scenario){
    return;
  }
  if (scenario.id === chatSettings.scenario.id){
    chatSettings.scenario = scenario;
    await saveChatSettings();
  }
}

async function exportScenario(scriptPermission: ScriptPermission, scenario: Scenario): Promise<void> {
  const hasPermission = await permissionCheckPassed(scriptPermission);
  if (!hasPermission){
    permissionRejectedShowWarning(scriptPermission);
    return;
  }

  if (scenario.author === ""){
    scenario.author = DEFAULT_AUTHOR_NAME;
  }
  scenario.cardType = "scenario";
  await api.v1.file.save(`Scenario_${scenario.name}_${scenario.id}.json`, JSON.stringify(scenario, null, 2));
}

async function importScenario(scriptPermission: ScriptPermission): Promise<void> {
  const hasPermission = await permissionCheckPassed(scriptPermission);
  if (!hasPermission){
    permissionRejectedShowWarning(scriptPermission);
    return;
  }
  
  const file = await api.v1.file.prompt({ accept: '.json' });
  if (!file) return;
  
  try {
    const data = JSON.parse(file);
    if (data.cardType){
      if (data.cardType != "scenario"){
        api.v1.ui.toast("Card type is not scenario. Canceling import.", {type: "warning"});
        return;
      }
    }
    const newScenario = createScenarioTemplate();
    newScenario.id = data.id || api.v1.uuid();
    const existingId = scenarioList.findIndex(obj => obj.id === newScenario.id);
    if (existingId != -1){
      api.v1.ui.toast("A Scenario with the same id already exists. Canceling import.", {type: "warning"});
      return;
    }
    newScenario.author = data.author || DEFAULT_AUTHOR_NAME;
    newScenario.name = data.name || newScenario.name;
    newScenario.description = data.description;
    newScenario.environment = data.environment;
    newScenario.scene = data.scene;
    newScenario.tags = data.tags;
    if (data.brains && Array.isArray(data.brains)) newScenario.brains = data.brains;
    if (data.brainsConditional && Array.isArray(data.brainsConditional)){
      newScenario.brainsConditional = data.brainsConditional;
    }
    newScenario.cr = crSanitizeScenarioExtra(data.cr);
    scenarioList.push(newScenario);
    await saveScenarioList();
    crTouch();
  } catch (e) {
    api.v1.error('Failed to import scenario:', e);
  }
}

const CARD_BRAIN_FILE_TYPE = "cardBrainsAlone";

async function cardBrainImport(scriptPermission: ScriptPermission, card: Card) : Promise<boolean>
{
  const hasPermission = await permissionCheckPassed(scriptPermission);
  if (!hasPermission){
    permissionRejectedShowWarning(scriptPermission);
    return false;
  }
  const file = await api.v1.file.prompt({ accept: '.json' });
  if (!file) return false;
  
  try {
    const data = JSON.parse(file);
    if (data.fileType){
      if (data.fileType != CARD_BRAIN_FILE_TYPE){
        api.v1.ui.toast(`Data type is not ${CARD_BRAIN_FILE_TYPE}. Canceling import.`, {type: "warning"});
        return false;
      }
    }

    const brains: BrainEntry[] = data.brains;
    const brainsConditional: BrainComplexConditional[] = data.brainsConditional;

    if (brains.length === 0 && brainsConditional.length === 0){
      api.v1.ui.toast(`No valid entries found. Canceling import.`, {type: "warning"});
      return false;
    }

    let pushCount: number = 0;

    for (const entry of brains){
      if (card.brains.some(item => JSON.stringify(item) === JSON.stringify(entry))){
        continue;
      }
      card.brains.push(entry);
      pushCount++;
    }
    for (const entry of brainsConditional){
      if (card.brainsConditional.some(item => JSON.stringify(item) === JSON.stringify(entry))){
        continue;
      }
      card.brainsConditional.push(entry);
      pushCount++;
    }

    if (pushCount > 0){
      const properEnglish = pushCount === 1 ? "entry": "entries";
      api.v1.ui.toast(`Imported ${pushCount.toString()} ${properEnglish}`, {type: "success"});
      return true;
    }
    else{
      api.v1.ui.toast(`Only duplicate entries found. Canceling import.`, {type: "warning"});
      return false;
    }
  } catch (e) {
    api.v1.error(`Failed to import Brains:`, e);
  }
  return false;
}

async function cardBrainExport(scriptPermission: ScriptPermission, card: Card)
{
  const hasPermission = await permissionCheckPassed(scriptPermission);
  if (!hasPermission){
    permissionRejectedShowWarning(scriptPermission);
    return;
  }
  if (hasPermission){
    const currentDate = new Date();
    const suggestedName = `CR_${CARD_BRAIN_FILE_TYPE}_${currentDate.toLocaleDateString()}_${currentDate.toLocaleTimeString().replace(" ", "_")}.json`;
    const namedData = {
      fileType: CARD_BRAIN_FILE_TYPE,
      format: CARD_FORMAT,
      brains: card.brains,
      brainsConditional: card.brainsConditional
    };
    await api.v1.file.save(suggestedName, JSON.stringify(namedData, null, 2));
  }
}

