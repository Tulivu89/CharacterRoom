const CHARACTER_LIST_KEY = "characterListKey";
function createCharTemplate(): Character {
  return {
    cardType: "contact",
    format: CARD_FORMAT,
    id: api.v1.uuid(),
    author: defaultAuthorUsersetting || DEFAULT_AUTHOR_NAME,
    name: "New Character",
    emotions: {},
    exampleChats: [],
    defaultIntimacy: "stranger",
    defaultStyle: "chat",
    brains: [],
    brainsConditional: []
  };
}
let charList: Character[] = [];
await api.v1.storage.setIfAbsent(CHARACTER_LIST_KEY, charList);
charList = await api.v1.storage.get(CHARACTER_LIST_KEY);

async function saveCharList()
{
  await api.v1.storage.set(CHARACTER_LIST_KEY, charList);
}

async function reflectCharChangesInChatSettings(char: Character) : Promise<void>
{
  if (!chatSettings.char){
    return;
  }
  if (char.id === chatSettings.char.id){
    chatSettings.char = char;
    await saveChatSettings();
  }
}

async function importCharacter(scriptPermission: ScriptPermission): Promise<void> {
  const hasPermission = await permissionCheckPassed(scriptPermission);
  if (!hasPermission){
    permissionRejectedShowWarning(scriptPermission);
    return;
  }
  
  const picked = await crCardImportPick();
  if (picked.kind === "cancelled"){
    return;
  }
  if (picked.kind === "error"){
    api.v1.ui.toast(picked.message, {type: "warning"});
    return;
  }
  let ticket = "";
  let file: string | void;
  if (picked.kind === "json"){
    ticket = picked.ticket;
    file = picked.json;
  }
  else {
    file = await api.v1.file.prompt({ accept: '.json' });
  }
  if (!file){
    if (ticket){
      crCardImportDiscard(ticket);
    }
    return;
  }

  let committed = false;
  try {
    const data = JSON.parse(file);
    if (data.cardType){
      if (data.cardType != "contact"){
        api.v1.ui.toast("Card type is not contact. Canceling import.", {type: "warning"});
        return;
      }
    }
    const newChar = createCharTemplate();
    newChar.id = data.id || api.v1.uuid();
    const existingId = charList.findIndex(obj => obj.id === newChar.id);
    if (existingId != -1){
      api.v1.ui.toast("A Contact with the same id already exists. Canceling import.", {type: "warning"});
      return;
    }
    newChar.author = data.author || DEFAULT_AUTHOR_NAME;
    newChar.name = data.name || 'Imported Character';
    newChar.alias = data.alias || "";
    newChar.description = data.description;
    newChar.gender = data.gndr || data.gender;
    newChar.pronouns = data.pronouns;
    newChar.species = data.species;
    newChar.tags = data.tags;
    newChar.persona = data.persona;
    newChar.appearance = data.appearance;
    newChar.greeting = data.greeting;
    newChar.greetingEmotion = data.greetingEmotion;
    newChar.defaultIntimacy = data.relationship || 'stranger';
    newChar.defaultStyle = data.style || 'chat';
    newChar.cjk = data.cjk;
    if (data.brains && Array.isArray(data.brains)) newChar.brains = data.brains;
    if (data.brainsConditional && Array.isArray(data.brainsConditional)){
      newChar.brainsConditional = data.brainsConditional;
    }
    newChar.cr = crSanitizeContactExtra(data.cr);

    if (data.avatarUri && typeof data.avatarUri === 'string' && data.avatarUri.startsWith('data:')) {
      newChar.avatar = data.avatarUri;
    }

    if (data.emotions && typeof data.emotions === 'object') {
      const emotionNames = Object.keys(data.emotions);
      for (let i = 0; i < emotionNames.length; i++) {
        const emotionName = emotionNames[i];
        const emotionData = data.emotions[emotionName];
        if (emotionData && typeof emotionData === 'string' && emotionData.startsWith('data:')) {
          newChar.emotions[emotionName] = emotionData;
        }
      }
    }

    newChar.schedule = {
      Daily: [],
      Monday: [],
      Tuesday: [],
      Wednesday: [],
      Thursday: [],
      Friday: [],
      Saturday: [],
      Sunday: []
    }

    if (data.schedule && typeof data.schedule === 'object') {
      for (const day of DAY_LIST){
        newChar.schedule[day] = data.schedule[day];
      }
    }

    if (data.exampleMessages && Array.isArray(data.exampleMessages)) {
      newChar.exampleChats = [];
      for (let i = 0; i < data.exampleMessages.length; i++) {
        const ec = data.exampleMessages[i];
        const newEc = { name: ec.name || 'Example', style: ec.style || 'chat', userName: ec.userName || 'Example User', messages: [] as ExampleMessage[] };
        if (ec.messages && Array.isArray(ec.messages)) {
          for (let j = 0; j < ec.messages.length; j++) {
            const m = ec.messages[j];
            newEc.messages.push({ isContact: m.isContact, text: m.text, emotion: m.emotion || 'neutral' });
          }
        }
        newChar.exampleChats.push(newEc);
      }
    }

    charList.push(newChar);
    await saveCharList();
    crTouch();

    if (ticket){
      committed = true;
      crCardImportCommit(ticket, newChar.id);
    }

  } catch (e) {
    api.v1.error('Failed to import character:', e);
  }
  finally {
    if (ticket && !committed){
      crCardImportDiscard(ticket);
    }
  }
}

async function exportCharacter(scriptPermission: ScriptPermission, char: Character): Promise<void> {
  const hasPermission = await permissionCheckPassed(scriptPermission);
  if (!hasPermission){
    permissionRejectedShowWarning(scriptPermission);
    return;
  }
  
  const exampleMessages = [];
  for (let i = 0; i < char.exampleChats.length; i++) {
    const ec = char.exampleChats[i];
    const msgs = [];
    for (let j = 0; j < ec.messages.length; j++) {
      const m = ec.messages[j];
      msgs.push({ isContact: m.isContact, text: m.text, emotion: m.emotion });
    }
    exampleMessages.push({ name: ec.name, messages: msgs, userName: ec.userName, style: ec.style });
  }

  let avatarBase64 = '';
  if (char.avatar) {
    const avatarData = char.avatar;
    if (avatarData && typeof avatarData === 'string') {
      avatarBase64 = avatarData;
    }
  }

  const exportData = {
    cardType: char.cardType || "contact",
    format: CARD_FORMAT,
    id: char.id,
    author: char.author || DEFAULT_AUTHOR_NAME,
    name: char.name,
    alias: char.alias,
    description: char.description,
    avatarUri: avatarBase64,
    gndr: char.gender,
    pronouns: char.pronouns,
    species: char.species,
    tags: char.tags,
    persona: char.persona,
    appearance: char.appearance,
    greeting: char.greeting,
    greetingEmotion: char.greetingEmotion,
    exampleMessages: exampleMessages,
    emotions: char.emotions,
    relationship: char.defaultIntimacy,
    responseLength: 'unspecified',
    style: char.defaultStyle,
    cjk: char.cjk,
    brains: char.brains || [],
    brainsConditional: char.brainsConditional || [],
    schedule: char.schedule || {},
    cr: crSanitizeContactExtra(char.cr)
  };

  await api.v1.file.save(`Character_${char.alias || char.name}_${char.id}.json`, JSON.stringify(exportData, null, 2));
}

type VisState = "block" | "none";
function getVisState(showElement: boolean) : VisState
{
  if (showElement){
    return "block";
  }
  else{
    return "none";
  }
}

async function setUiPartVisState(id: string, visible: boolean)
{
  await api.v1.ui.updateParts([
    {
      id: id, 
      style: { display: getVisState(visible) } 
    }
  ]);
}

// ============================================================================
// SECTION BUBBLES — MARKDOWN, BUBBLES, RESPONSE PARSER
// ============================================================================
function prepareMarkdown(text: string): string {
  var lines = text.split('\n');
  var result: string[] = [];
  var inCodeBlock = false;
  for (var i = 0; i < lines.length; i++) {
    var line = lines[i];
    if (line.trimStart().startsWith('```')) {
      inCodeBlock = !inCodeBlock;
      result.push(line);
    } else if (inCodeBlock) {
      result.push(line);
    } else {
      result.push(line + '  ');
    }
  }
  if (inCodeBlock) {
    result.push('```');
  }
  return result.join('\n');
}

function applyBoldSpeechLine(line: string): string {
  var result = '';
  var pos = 0;
  while (pos < line.length) {
    if (line[pos] === '*') {
      var end = line.indexOf('*', pos + 1);
      if (end === -1) {
        var rest = line.slice(pos);
        result += rest;
        pos = line.length;
      } else {
        result += line.slice(pos, end + 1);
        pos = end + 1;
      }
    } else {
      var next = line.indexOf('*', pos);
      var segment = next === -1 ? line.slice(pos) : line.slice(pos, next);
      if (segment.trim()) {
        var leadMatch = segment.match(/^(\s*)/);
        var trailMatch = segment.match(/(\s*)$/);
        var lead = leadMatch ? leadMatch[1] : '';
        var trail = trailMatch ? trailMatch[1] : '';
        var trimmed = segment.trim();
        result += lead + '**' + trimmed + '**' + trail;
      } else {
        result += segment;
      }
      pos = next === -1 ? line.length : next;
    }
  }
  return result;
}

function applyBoldSpeech(text: string): string {
  var lines = text.split('\n');
  var result: string[] = [];
  var inCodeBlock = false;
  for (var i = 0; i < lines.length; i++) {
    if (lines[i].trimStart().startsWith('```')) {
      inCodeBlock = !inCodeBlock;
      result.push(lines[i]);
    } else if (inCodeBlock) {
      result.push(lines[i]);
    } else {
      result.push(applyBoldSpeechLine(lines[i]));
    }
  }
  return result.join('\n');
}

function buildMessageBubbleForPost(
  name: string,
  text: string,
  emotion: Emotion,
  imgUri?: string
): UIPart {
  const headerRightContent: UIPart[] = [];

  headerRightContent.push({
    type: 'text',
    text: emotion,
    style: { fontSize: '0.6875rem', opacity: 0.6, fontStyle: 'italic', margin: 0, marginRight: '8px', textTransform: 'capitalize' }
  });

  const messageContent: UIPart[] = [
    {
      type: 'row',
      spacing: 'space-between',
      alignment: 'center',
      style: { marginBottom: '4px' },
      content: [
        { type: 'text', text: name, style: { fontWeight: 'bold', fontSize: '0.8125rem', margin: 0 } },
        { type: 'row', alignment: 'center', content: headerRightContent }
      ]
    },
    {
      type: 'text',
      text: prepareMarkdown(text),
      markdown: true,
      style: { fontSize: "14px", margin: 0 }
    }
  ];

  return {
    type: 'row',
    style: {
      marginBottom: '12px',
      borderRadius: '4px',
      gap: 0,
      alignItems: 'flex-start',
      alignSelf: 'flex-start',
      width: '90%',
      backgroundColor: 'bg2'
    },
    content: [
      {
        type: 'image',
        src: imgUri || PLACEHOLDER_FORUM_AVATAR,
        width: 64,
        height: 64,
        style: {
          width: "3em",
          height: "3em",
          borderRadius: "3em",
          objectFit: "cover",
          background: "bg3",
          position: "relative",
          top: '-1px',
          left: '-1px'
        },
      },
      {
        type: 'column',
        spacing: 'start',
        style: {
          marginBottom: '12px',
          borderRadius: '4px',
          marginLeft: '0',
          alignSelf: 'flex-start',
          width: '90%',
          backgroundColor: 'bg1',
          gap: '4px',
          padding: '8px 12px'
        },
        content: messageContent
      }
    ]
  };

}

function buildMessageBubble(
  name: string,
  text: string,
  emotion: Emotion,
  sender: string,
  char: Character,
  siblingIndex: number,
  siblingCount: number,
  onPrev?: () => Promise<void>,
  onNext?: () => Promise<void>,
  onReroll?: () => Promise<void>,
  onEdit?: () => Promise<void>,
  onDelete?: () => Promise<void>,
  hasBrain?: boolean,
  onBrain?: () => Promise<void>
): UIPart {
  const isContact = sender === 'contact';
  const emotionImage = isContact ? (char.emotions[emotion] || char.avatar) : undefined;

  const headerRightContent: UIPart[] = [];

  if (isContact) {
    headerRightContent.push({
      type: 'text',
      text: emotion,
      style: { fontSize: '0.6875rem', opacity: 0.6, fontStyle: 'italic', margin: 0, marginRight: '8px', textTransform: 'capitalize' }
    });
  }

  if (siblingCount > 0) {
    headerRightContent.push({
      type: 'button',
      iconId: 'chevron-left',
      style: { margin: 0, padding: '2px 4px', opacity: siblingCount <= 1 ? 0.3 : 1 },
      disabled: siblingCount <= 1,
      callback: onPrev || (async function() {})
    });

    headerRightContent.push({
      type: 'text',
      text: (siblingIndex + 1) + ' / ' + siblingCount,
      style: { fontSize: '0.6875rem', opacity: 0.7, margin: '0 2px', whiteSpace: 'nowrap' }
    });

    headerRightContent.push({
      type: 'button',
      iconId: 'chevron-right',
      style: { margin: 0, padding: '2px 4px', opacity: siblingCount <= 1 ? 0.3 : 1 },
      disabled: siblingCount <= 1,
      callback: onNext || (async function() {})
    });
  }

  if (onReroll) {
    headerRightContent.push({
      type: 'button',
      iconId: 'rotate-ccw',
      style: { margin: 0, padding: '2px 6px', marginLeft: '4px' },
      disabledWhileCallbackRunning: true,
      callback: onReroll
    });
  }

  if (onEdit) {
    headerRightContent.push({
      type: 'button',
      iconId: 'edit',
      style: { margin: 0, padding: '2px 6px', marginLeft: '4px' },
      callback: onEdit
    });
  }

  if (onBrain) {
    headerRightContent.push({
      type: 'button',
      text: hasBrain ? '\uD83E\uDDE0' : '\uD83D\uDCAD',
      style: { margin: 0, padding: '2px 6px', marginLeft: '4px' },
      callback: onBrain
    });
  }

  if (onDelete) {
    headerRightContent.push({
      type: 'button',
      iconId: 'x',
      style: { margin: 0, padding: '2px 6px', marginLeft: '4px' },
      callback: onDelete
    });
  }

  const messageContent: UIPart[] = [
    {
      type: 'row',
      spacing: 'space-between',
      alignment: 'center',
      style: { marginBottom: '4px' },
      content: [
        { type: 'text', text: name, style: { fontWeight: 'bold', fontSize: '0.8125rem', margin: 0 } },
        { type: 'row', alignment: 'center', content: headerRightContent }
      ]
    },
    {
      type: 'text',
      text: prepareMarkdown(text),
      markdown: true,
      style: { fontSize: "14px", margin: 0 }
    }
  ];

  if (isContact && Object.keys(char.emotions).length === 24) {
    return {
      type: 'row',
      style: {
        marginBottom: '12px',
        borderRadius: '4px',
        gap: 0,
        alignItems: 'flex-start',
        alignSelf: 'flex-start',
        width: '90%',
        backgroundColor: 'bg2'
      },
      content: [
        {
          type: 'image',
          src: char.emotions[emotion],
          width: 64,
          height: 64,
          style: {
            width: "3em",
            height: "3em",
            borderRadius: "3em",
            objectFit: "cover",
            background: "bg3",
            position: "relative",
            top: '-1px',
            left: '-1px'
          },
        },
        {
          type: 'column',
          spacing: 'start',
          style: {
            marginBottom: '12px',
            borderRadius: '4px',
            marginLeft: '0',
            alignSelf: 'flex-start',
            width: '90%',
            backgroundColor: 'bg1',
            gap: '4px',
            padding: '8px 12px'
          },
          content: messageContent
        }
      ]
    };
  }
  
  if (isContact && char.avatar) {
    return {
      type: 'row',
      style: {
        marginBottom: '12px',
        borderRadius: '4px',
        gap: 0,
        alignItems: 'flex-start',
        alignSelf: 'flex-start',
        width: '90%',
        backgroundColor: 'bg2'
      },
      content: [
        {
          type: 'image',
          src: char.avatar,
          width: 64,
          height: 64,
          style: {
            width: "3em",
            height: "3em",
            borderRadius: "3em",
            objectFit: "cover",
            background: "bg3",
            position: "relative",
            top: '-1px',
            left: '-1px'
          },
        },
        {
          type: 'column',
          spacing: 'start',
          style: {
            marginBottom: '12px',
            borderRadius: '4px',
            marginLeft: '0',
            alignSelf: 'flex-start',
            width: '90%',
            backgroundColor: 'bg1',
            gap: '4px',
            padding: '8px 12px'
          },
          content: messageContent
        }
      ]
    };
  }

  if (isContact) {
    return {
      type: 'column',
      style: {
        marginBottom: '12px',
        borderRadius: '4px',
        marginLeft: '0',
        alignSelf: 'flex-start',
        width: '90%',
        backgroundColor: 'bg1',
        gap: '4px',
        padding: '8px 12px'
      },
      content: messageContent
    };
  }

  return {
    type: 'column',
    style: {
      marginBottom: '12px',
      borderRadius: '4px',
      alignSelf: 'flex-end',
      maxWidth: '85%',
      backgroundColor: 'bg1',
      gap: '4px',
      padding: '8px 12px'
    },
    content: messageContent
  };
}

function parseResponseBody(text: string, charName: string): SubMessage[] {
  const subMessages: SubMessage[] = [];
  const lines = text.split('\n');
  
  let currentText = '';
  let currentEmotion = 'neutral';
  let inMessage = false;
  
  const escapedName = escapeRegex(charName);
  const nameRegex = new RegExp('^' + escapedName + ':\\s*(.*)$', 'i');
  
  for (let i = 0; i < lines.length; i++) {
    const line = lines[i];
    const emotionMatch = line.match(/^\s{2}Emotion:\s*(\w+)/i);
    const nameMatch = line.match(nameRegex);
    const continuationMatch = line.match(/^\s{4}(.*)$/);
    
    if (emotionMatch) {
      const emotionStr = emotionMatch[1].toLowerCase();
      if (EMOTION_LIST.indexOf(emotionStr) >= 0) {
        currentEmotion = emotionStr;
      }
      if (currentText.trim()) {
        subMessages.push({ text: currentText.trim(), emotion: currentEmotion });
        currentText = '';
        currentEmotion = 'neutral';
      }
      inMessage = false;
    } else if (nameMatch) {
      if (currentText.trim() && inMessage) {
        subMessages.push({ text: currentText.trim(), emotion: 'neutral' });
      }
      currentText = nameMatch[1];
      inMessage = true;
    } else if (continuationMatch && inMessage) {
      currentText += '\n' + continuationMatch[1];
    } else if (inMessage && line.trim() && !line.startsWith('  ')) {
      currentText += ' ' + line.trim();
    }
  }
  
  if (currentText.trim()) {
    subMessages.push({ text: currentText.trim(), emotion: currentEmotion });
  }
  
  if (subMessages.length === 0 && text.trim()) {
    let cleanText = text.trim();
    const leadingNameMatch = cleanText.match(new RegExp('^' + escapedName + ':\\s*', 'i'));
    if (leadingNameMatch) {
      cleanText = cleanText.slice(leadingNameMatch[0].length);
    }
    subMessages.push({ text: cleanText || text.trim(), emotion: 'neutral' });
  }
  
  return subMessages;
}

// ============================================================================
// SECTION LISTINGS — DELETE WITH FAREWELL, CARD LISTINGS
// ============================================================================
function buildDeletionSystemPrompt(char: Character, user: User): string {
  let prompt = 'AetherRoom\n----\n';
  prompt += char.name + '\n';
  prompt += 'Type: contact\n';
  if (char.gender && char.gender.trim()) prompt += formatField('Gender', char.gender);
  if (char.pronouns && char.pronouns.trim()) prompt += formatField('Pronouns', char.pronouns);
  if (char.species && char.species.trim()) prompt += formatField('Species', char.species);
  if (char.persona && char.persona.trim()) prompt += formatField('Personality', char.persona);
  if (char.appearance && char.appearance.trim()) prompt += formatField('Appearance', char.appearance);
  const intimacy = char.defaultIntimacy || 'stranger';
  if (intimacy === 'stranger') {
    prompt += 'Opinion of ' + user.name + ': Doesn\'t know ' + user.name + '.\n';
  } else {
    prompt += 'Relationship: ' + intimacy + '\n';
  }
  if (char.tags && char.tags.trim()) prompt += 'Categories: ' + char.tags.trim() + '\n';

  if (char.exampleChats.length > 0) {
    prompt += 'Example quotes:\n';
    for (let ecIdx = 0; ecIdx < char.exampleChats.length; ecIdx++) {
      const ec = char.exampleChats[ecIdx];
      prompt += (ecIdx + 1) + '.\n';
      for (let msgIdx = 0; msgIdx < ec.messages.length; msgIdx++) {
        const msg = ec.messages[msgIdx];
        const senderName = msg.isContact ? char.name : ec.userName;
        const lines = msg.text.split('\n');
        prompt += '\u2002' + senderName + ': ' + lines[0] + '\n';
        for (let li = 1; li < lines.length; li++) {
          prompt += '\u2002    ' + lines[li] + '\n';
        }
        if (msg.isContact && msg.emotion) {
          prompt += '\u2002  Emotion: ' + msg.emotion + '\n';
        }
      }
    }
  }

  prompt += '----\n';
  prompt += user.name + '\n';
  prompt += 'Type: user\n';
  if (user.gender && user.gender.trim()) prompt += formatField('Gender', user.gender);
  if (user.pronouns && user.pronouns.trim()) prompt += formatField('Pronouns', user.pronouns);
  if (user.species && user.species.trim()) prompt += formatField('Species', user.species);
  if (user.persona && user.persona.trim()) prompt += formatField('Personality', user.persona);
  if (user.appearance && user.appearance.trim()) prompt += formatField('Appearance', user.appearance);
  if (user.tags && user.tags.trim()) prompt += 'Categories: ' + user.tags.trim() + '\n';

  const allBrains: BrainEntry[] = [];
  if (char.brains) {
    for (let bi = 0; bi < char.brains.length; bi++) allBrains.push(char.brains[bi]);
  }
  if (user.brains) {
    for (let bi = 0; bi < user.brains.length; bi++) allBrains.push(user.brains[bi]);
  }
  for (let bi = 0; bi < allBrains.length; bi++) {
    prompt += '----\n' + allBrains[bi].name + '\n' + allBrains[bi].content.trim() + '\n';
  }

  return replaceMacros(prompt, char.name, user.name);
}

