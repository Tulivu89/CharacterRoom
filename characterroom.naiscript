const EMOJI_REF_KEY = "emojiRefKey";
type Emoji = typeof EMOTION_LIST[number];
let emojiRef: Record<Emoji, string> = {};
await api.v1.storage.setIfAbsent(EMOJI_REF_KEY, emojiRef);
emojiRef = await api.v1.storage.get(EMOJI_REF_KEY);

const CR_EMOTION_MATCH = "(?<!.)  Emotion: \\w+";

const CR_EMOTION_OPACITY: Record<string, string> = { dim: "0.35", hide: "0.05" };

let emotionRuleApplied = "";

async function updateEmotionRule() : Promise<void>
{
  const want = crEditorOpts.line === "plain" ? "" : crEditorOpts.line;
  if (want === emotionRuleApplied){
    return;
  }
  try{
    api.v1.editor.decorations.removeRules(["emotionRule"]);
    if (want){
      await api.v1.editor.decorations.registerRules([{
        id: "emotionRule",
        type: "inline",
        match: CR_EMOTION_MATCH,
        flags: "g",
        style: { opacity: CR_EMOTION_OPACITY[want] || "0.35" }
      }]);
    }
    emotionRuleApplied = want;
  }
  catch (e){
    api.v1.error("[CR:edopts] could not update the emotion rule:", e);
  }
}

let crNameMemberRuleIds: string[] = [];
function updateNameStyling() {
  if (crNameMemberRuleIds.length){
    try{ api.v1.editor.decorations.removeRules(crNameMemberRuleIds); }
    catch (e){}
    crNameMemberRuleIds = [];
  }
  if (chatSettings.char && crEditorOpts.boldName) {
    api.v1.editor.decorations.registerRules([{
      id: "characterName",
      type: "inline",
      match: "(?<!.)" + escapeRegex(chatSettings.char.name) + ":",
      flags: "g",
      style: { fontWeight: "bold" }
    }]);
    if (crGroupActive()){
      const rules: DecorationRule[] = [];
      const members = crGroupMembers();
      for (let i = 0; i < members.length; i++){
        if (!members[i].name){
          continue;
        }
        const ruleId = "characterName-" + members[i].id;
        rules.push({ id: ruleId, type: "inline", match: "(?<!.)" + escapeRegex(members[i].name) + ":", flags: "g", style: { fontWeight: "bold" } });
        crNameMemberRuleIds.push(ruleId);
      }
      if (rules.length){
        api.v1.editor.decorations.registerRules(rules).catch((e) => { api.v1.error("[CR:group] could not bold the member names:", e); });
      }
    }
  } else {
    api.v1.editor.decorations.removeRules(["characterName"]);
  }
}

function clearEditorImages()
{
  crCcavDispose().catch(() => {});
  crBubbleMarkDispose().catch(() => {});
  crChatImgDispose().catch(() => {});
  api.v1.editor.decorations.clearWidgets();
  api.v1.editor.decorations.clearMarkers();
}

function hasAvatar() : boolean
{
  if (chatSettings.char){
    if (chatSettings.char.avatar){
      return true;
    }
  }
  return false;
}

function hasEmotionImages() : boolean
{
  if (chatSettings.char){
    if (Object.keys(chatSettings.char.emotions).length === 24){
      return true;
    }
  }
  return false;
}

async function updateEditorImages(): Promise<void> {
  if (!chatSettings.char){
    crCcavEmit().catch(() => {});
    return;
  }
  
  const hardCap = 50;
  const softCap = 25;
  
  const useImageDeco = await api.v1.storage.get(USE_IMAGE_DECO_KEY);
  if (!useImageDeco){
    crCcavEmit().catch(() => {});
    return;
  }
  const sections = await api.v1.document.scan();
  const sectionsReversed = sections.reverse();
  if (sectionsReversed.length === 0){
    clearEditorImages();
  }

  const existingWidgets = await api.v1.editor.decorations.getWidgets() as DecorationInlineWidgetInfo[];
  const arWidgets = existingWidgets.filter(info => info && info.position);
  if (arWidgets.length >= hardCap){
    clearEditorImages();
  }
  const existingWidgetSectionIds = new Set(
    arWidgets.map(info => info.position.sectionId)
  );

  const existingMarkers: DecorationMarkerInfo[] = await api.v1.editor.decorations.getMarkers();
  const nodeMarkers = existingMarkers.filter(
    (marker): marker is DecorationNodeMarkerInfo => marker.type === "node"
  );
  const existingMarkerSectionIds = new Set(
    nodeMarkers.map(info => info.sectionId)
  );

  interface EmotionFind {
    found: boolean,
    emotion: Emotion,
    sectionId?: number
  }
  const emotionFind: EmotionFind = { found: false, emotion: "neutral" };
  let tempWidgetCount = 0;
  
  type DecoStyle = "EmotionImages" | "Hybrid";
  interface HybridFlags {
    hasAvatar: boolean,
    hasEmoji: boolean
  }
  function getDecoStyle() : DecoStyle
  { 
    if (hasEmotionImages()){ 
      return "EmotionImages";
    } 
    else{ 
      return "Hybrid";
    } 
  };
  function getHybridFlags() : HybridFlags
  {
    let flags: HybridFlags = {
      hasAvatar: false,
      hasEmoji: false
    };
    if (hasAvatar()){
      flags.hasAvatar = true;
    }
    if (Object.keys(emojiRef).length === 24){
      flags.hasEmoji = true;
    }
    return flags;
  }
  const decoStyle: DecoStyle = getDecoStyle();
  const hybridFlags: HybridFlags = getHybridFlags();

  const charNameWithColon: string = chatSettings.char!.name + ":";

  let widgetsCreated = 0;

  let markerIndentWidgets: DecorationCreateNodeMarkerOptions[] = [];

  for (const section of sectionsReversed) {
    if (decoStyle === "EmotionImages"){
      if (section.section.source !== "instruction" && !existingMarkerSectionIds.has(section.sectionId)) {
        markerIndentWidgets.push({
          type: "node",
          sectionId: section.sectionId,
          style: {
            paddingLeft: "3.5em",
            textIndent: "0"
          }
        });
      }
      const matchEmotion = section.section.text.match(/(?<=\s\sEmotion:\s)(\b\w+)/g);
      if (matchEmotion){
        emotionFind.found = true;
        emotionFind.emotion = matchEmotion[0];
        emotionFind.sectionId = section.sectionId;
        continue;
      }
      if (section.section.text.startsWith(charNameWithColon) && emotionFind.found) {
        tempWidgetCount++;
        if (!existingWidgetSectionIds.has(section.sectionId)){
          let aviWidget = await api.v1.editor.decorations.createWidget({
            type: "inline",
            position: {
              sectionId: section.sectionId,
              offset: 0
            },
            side: "before",
            content: [
              {
                type: "image",
                style: {
                  width: "3em",
                  height: "3em",
                  borderRadius: "3em",
                  objectFit: "cover",
                  background: "bg3",
                  position: "absolute",
                  left: "-3.5em"
                },
                src: chatSettings.char!.emotions[emotionFind.emotion] || ""
              },
            ],
            onChange: (event) => {
              if (event.type === "change"){
                let info = event.info as DecorationInlineWidgetInfo;
                if (info.position.offset !== 0 || info.position.sectionId !== section.sectionId){
                  aviWidget.dispose();
                }
              }
            }
          });
          widgetsCreated++;
          let emoMarker = api.v1.editor.decorations.createMarker({
            type: "node",
            sectionId: emotionFind.sectionId!,
            style: { },
            onChange: (event) => {
              if (event.type === "dispose"){
                aviWidget.dispose();
              }
            }
          })
          emotionFind.found = false;
        }
      }
    }
    else{
      if (hybridFlags.hasAvatar){
        if (section.section.source !== "instruction") {
          markerIndentWidgets.push({
            type: "node",
            sectionId: section.sectionId,
            style: {
              paddingLeft: "3.5em",
              textIndent: "0"
            }
          })
        }
        if (section.section.text.startsWith(charNameWithColon)) {
          tempWidgetCount++;
          if (!existingWidgetSectionIds.has(section.sectionId)){
            let widget = await api.v1.editor.decorations.createWidget({
              type: "inline",
              position: {
                sectionId: section.sectionId,
                offset: 0
              },
              side: "before",
              content: [{
                type: "image",
                style: {
                  width: "3em",
                  height: "3em",
                  borderRadius: "3em",
                  objectFit: "cover",
                  background: "bg3",
                  position: "absolute",
                  left: "-3.5em"
                },
                src: chatSettings.char!.avatar || ""
              }],
              onChange: (event) => {
                if (event.type === "change"){
                  let info = event.info as DecorationInlineWidgetInfo;
                  if (info.position.offset !== 0 || info.position.sectionId !== section.sectionId){
                    widget.dispose();
                  }
                }
              }
            });
          }
        }
      }
      if (hybridFlags.hasEmoji)
      {
        const matchEmoji = section.section.text.match(/(?<=\s\sEmotion:\s)(\b\w+)/g);
        if (matchEmoji){
          tempWidgetCount++;
          if (!existingWidgetSectionIds.has(section.sectionId)){
            let widget = await api.v1.editor.decorations.createWidget({
              type: "inline",
              position: {
                sectionId: section.sectionId,
                offset: 0
              },
              side: "after",
              content: [{
                type: "image",
                style: {
                  width: "1.33em",
                  height: "1.33em",
                  objectFit: "contain",
                  position: "absolute",
                  top: "-0.4em"
                },
                src: emojiRef[matchEmoji[0]] || ""
              }],
              onChange: (event) => {
                if (event.type === "change"){
                  let info = event.info as DecorationInlineWidgetInfo;
                  if (info.position.offset !== 0 || info.position.sectionId !== section.sectionId){
                    widget.dispose();
                  }
                }
              }
            });
          }
        }
      }
    }
    if (tempWidgetCount >= softCap){
      break;
    }
  }
  await api.v1.editor.decorations.createMarkers(markerIndentWidgets);
  await crCcavEmit().catch(() => {});
}

