function CrMacroReference() : any
{
  const char = crLiveContact();
  const user = crLiveUser();
  const names = { c: char ? char.name : "the Contact", u: user ? user.name : "the User" };
  return h(CrSection, {
    title: "Macros",
    note: "Written into any card field, a brain or a schedule event, and expanded on the way to the model."
  }, h("div", { style: { marginTop: CR_S_3, display: "grid", gridTemplateColumns: CR_GRID_COL, gap: CR_S_2 } },
    MACRO_LIST.map((m) => h("div", {
      key: m,
      style: { display: "flex", gap: CR_S_3, alignItems: "baseline", flexWrap: "wrap" }
    },
      h("div", { style: { color: CR_HEAD, fontSize: CR_T_MD, minWidth: "78px" } }, m),
      h("div", { style: { color: CR_DIM, fontSize: CR_T_SM } },
        replaceMacros(m, names.c, names.u))
    )),
    h("div", { style: { color: CR_DIM, fontSize: CR_T_SM, marginTop: CR_S_2 } },
      "$c and $u are the short forms of the first two. The times come from this chat's clock.")
  ));
}

let crUseImageDeco: boolean = (await api.v1.storage.get(USE_IMAGE_DECO_KEY)) === true;
let crUseEmotionalModes: boolean = (await api.v1.storage.get(USE_EMOTIONAL_MODES_KEY)) === true;
let crEmojiConfirm: boolean = false;
let crGlobalNote: string = "";

function crSetGlobalNote(text: string) : void
{
  crGlobalNote = text;
  crTouch();
}

async function crSetDefaultAuthor(value: string) : Promise<void>
{
  const name = String(value || "").slice(0, 120);
  try{
    await api.v1.storage.set(DEFAULT_AUTHOR_USER_SETTING_KEY, name);
    defaultAuthorUsersetting = name;
  }
  catch (e){
    api.v1.error("[CR:global] could not save the default author:", e);
  }
  crTouch();
}

async function crSetUseImageDeco(on: boolean) : Promise<void>
{
  try{
    await api.v1.storage.set(USE_IMAGE_DECO_KEY, on === true);
    crUseImageDeco = on === true;
  }
  catch (e){
    api.v1.error("[CR:global] could not save Use Image Decorations:", e);
    crTouch();
    return;
  }
  try{
    if (on){
      await updateEditorImages();
    }
    else{
      clearEditorImages();
    }
    await updateEmotionRule();
  }
  catch (e){
    api.v1.error("[CR:global] decorations refresh failed:", e);
  }
  crTouch();
}

async function crSetUseEmotionalModes(on: boolean) : Promise<void>
{
  try{
    await api.v1.storage.set(USE_EMOTIONAL_MODES_KEY, on === true);
    crUseEmotionalModes = on === true;
  }
  catch (e){
    api.v1.error("[CR:global] could not save Use Emotional Modes:", e);
  }
  crTouch();
}

async function crImportEmojis() : Promise<void>
{
  let file: any = undefined;
  try{
    file = await api.v1.file.prompt({ accept: ".json" });
  }
  catch (e){
    crSetGlobalNote("Could not open the file picker.");
    return;
  }
  if (!file){
    return;
  }
  let taken = 0;
  try{
    const data = JSON.parse(file);
    for (const emotion of EMOTION_LIST){
      if (data[emotion]){
        emojiRef[emotion] = data[emotion];
        taken++;
      }
    }
    await api.v1.storage.set(EMOJI_REF_KEY, emojiRef);
  }
  catch (e){
    api.v1.error("[CR:global] failed to import emojis:", e);
    crSetGlobalNote("That file could not be read as an emoji set.");
    return;
  }
  try{
    await updateEditorImages();
    await updateEmotionRule();
  }
  catch (e){}
  crSetGlobalNote("Read " + String(taken) + " emoji from that file. The set now holds "
    + String(Object.keys(emojiRef).length) + " of 24.");
}

async function crDeleteEmojis() : Promise<void>
{
  emojiRef = {};
  try{
    await api.v1.storage.set(EMOJI_REF_KEY, emojiRef);
  }
  catch (e){
    api.v1.error("[CR:global] could not clear the emoji set:", e);
    crSetGlobalNote("Could not clear the emoji set.");
    return;
  }
  try{
    clearEditorImages();
    await updateEditorImages();
    await updateEmotionRule();
  }
  catch (e){}
  crEmojiConfirm = false;
  crSetGlobalNote("Emoji set deleted.");
}

