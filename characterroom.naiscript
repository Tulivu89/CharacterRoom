let crReportText = "";
let crReportRunning = false;

function crReportSize(bytes: number) : string
{
  if (bytes < 1024){
    return String(bytes) + " B";
  }
  if (bytes < 1048576){
    return (bytes / 1024).toFixed(1) + " KB";
  }
  return (bytes / 1048576).toFixed(2) + " MB";
}

function crReportAgo(at: number) : string
{
  if (!at){
    return "never";
  }
  const secs = Math.max(0, Math.round((Date.now() - at) / 1000));
  if (secs < 90){
    return String(secs) + "s ago";
  }
  return String(Math.round(secs / 60)) + "m ago";
}

function crReportId(id: string) : string
{
  return (id || "").replace(/-/g, "").slice(0, 8) || "(none)";
}

function crReportCardLine(c: Character) : string
{
  const avatarBytes = (c.avatar && typeof c.avatar === "string") ? c.avatar.length : 0;
  let emoCount = 0;
  let emoBytes = 0;
  const emo: any = c.emotions || {};
  const names = Object.keys(emo);
  for (let i = 0; i < names.length; i++){
    const v = emo[names[i]];
    if (typeof v === "string" && v.indexOf("data:") === 0){
      emoCount = emoCount + 1;
      emoBytes = emoBytes + v.length;
    }
  }
  let textBytes = 0;
  try{
    const shallow: any = Object.assign({}, c);
    shallow.avatar = "";
    shallow.emotions = {};
    textBytes = JSON.stringify(shallow).length;
  }
  catch (e){ textBytes = -1; }
  const slots = crSlotIndex[c.id] || [];
  return "  " + crReportId(c.id)
    + "  slots " + String(slots.length)
    + "  base64 avatar " + (avatarBytes ? "YES" : "no")
    + "  base64 emotions " + String(emoCount)
    + "  images " + crReportSize(avatarBytes + emoBytes)
    + "  text " + (textBytes < 0 ? "unreadable" : crReportSize(textBytes));
}

async function crReportBuild() : Promise<void>
{
  if (crReportRunning){
    return;
  }
  crReportRunning = true;
  crReportText = "";
  crTouch();
  const out: string[] = [];
  try{
    out.push("CharacterRoom report");
    out.push("engine " + String(api.v1.script.version) + "  ·  " + new Date().toISOString());
    out.push("");

    out.push("BRIDGE");
    out.push("  connected: " + (crBridge.ready ? "yes" : "no")
      + "   settled: " + (crBridge.settled ? "yes" : "no")
      + "   attempts: " + String(crBridge.attempts));
    out.push("  bridge says it serves: " + (crBridge.bridgeEngine || "(nothing)")
      + "   knows about CR: " + (crBridge.bridgeCrAware ? "yes" : "no"));
    out.push("  last ack: " + crReportAgo(crBridge.lastAckAt));
    out.push("  viewport: " + String(crBridge.viewportW) + "x" + String(crBridge.viewportH));
    out.push("  events it sent that this build does not know: "
      + (crBridge.unknownEvents.length ? crBridge.unknownEvents.join(", ") : "none"));
    out.push("");

    out.push("EDITOR PORTRAITS");
    out.push("  source " + crEditorOpts.source
      + "   placement " + crEditorOpts.place
      + "   size " + String(crEditorOpts.size)
      + "   shape " + crEditorOpts.shape);
    out.push("  emotion line " + crEditorOpts.line
      + "   gutter markers refused: " + (crCcavIndentFailed ? "yes" : "no")
      + "   wrap clears refused: " + (crCcavClearFailed ? "yes" : "no")
      + "   bridge clears portraits: " + (crBridge.bridgeCcavClear ? "yes" : "no")
      + "   shaped bubbles refused: " + (crBubbleShapeRefused ? "yes" : "no"));
    out.push("  last emit: " + crReportAgo(crCcavLast.at)
      + (crCcavLast.reason ? "  STOPPED — " + crCcavLast.reason : "  ran"));
    out.push("    sections " + String(crCcavLast.sections)
      + "   name lines " + String(crCcavLast.nameLines)
      + "   emotion lines " + String(crCcavLast.emotionLines)
      + "   other Contact paragraphs " + String(crCcavLast.contactOther));
    out.push("    runs " + String(crCcavLast.runs)
      + "   widgets asked for " + String(crCcavLast.emitted)
      + "   widgets created " + String(crCcavLast.created));
    if (crCcavLast.error){
      out.push("    editor said: " + crCcavLast.error.slice(0, 200));
    }
    const paired = crLiveContact();
    out.push("  paired Contact: " + (paired
      ? crReportId(paired.id) + "  slots on record " + String((crSlotIndex[paired.id] || []).length)
      : "none — this chat has no Contact"));
    out.push("  slot probe: asked " + crReportId(crSlotProbe.asked)
      + "   answered " + (crSlotProbe.answered ? "yes" : "no")
      + "   timed out " + (crSlotProbe.timedOut ? "yes" : "no")
      + "   slots " + String(crSlotProbe.slots.length));
    out.push("");

    out.push("IMAGE GENERATION");
    out.push("  last request: " + crReportAgo(crGenLast.at)
      + (crGenLast.slot ? "   slot " + crGenLast.slot : "")
      + (crGenLast.charId ? "   card " + crReportId(crGenLast.charId) : ""));
    if (crGenLast.refused){
      out.push("  NOT SENT — " + crGenLast.refused);
    }
    else if (crGenLast.at){
      out.push("  sent: character prompt " + String(crGenLast.visualsLen) + " chars,"
        + " scene " + String(crGenLast.promptLen) + ","
        + " base " + String(crGenLast.baseLen));
      out.push("  settings: " + crGenLast.model + "  " + crGenLast.size
        + "  steps " + String(crGenLast.steps) + "  seed " + String(crGenLast.seed));
      out.push("  A request that left and produced no picture failed inside the bridge —");
      out.push("  bridge 3.0.32 or newer shows that failure as a message on screen.");
    }
    out.push("");

    const groupLines = crGroupReportLines();
    for (let i = 0; i < groupLines.length; i++){
      out.push(groupLines[i]);
    }
    out.push("");

    out.push("CARDS  " + String(charList.length) + " Contacts, "
      + String(userList.length) + " Users, " + String(scenarioList.length) + " Scenarios");
    out.push("  id        slots  base64 avatar  base64 emotions  images  text");
    for (let i = 0; i < charList.length; i++){
      out.push(crReportCardLine(charList[i]));
    }
    if (!charList.length){
      out.push("  (none)");
    }
    out.push("");
    out.push("A Contact with base64 still on it was imported without the bridge, or before");
    out.push("0.0.63. Its pictures live in the card instead of the image store, which is what");
    out.push("makes a card slow to load and a script slow to start.");
  }
  catch (e){
    out.push("");
    out.push("The report stopped early: " + String(e));
  }
  crReportText = out.join("\n");
  crReportRunning = false;
  crTouch();
}

async function crReportSave() : Promise<void>
{
  if (!crReportText){
    return;
  }
  try{
    await api.v1.file.save("CharacterRoom-report.txt", crReportText);
  }
  catch (e){
    api.v1.error("[CR:report] could not save the report:", e);
    api.v1.ui.toast("Could not save the report. Copy it from the box instead.", { type: "warning" });
  }
}

function CrGlobalReportTab() : any
{
  return h("div", { class: "cr-global-report" },
    h(CrSection, {
      title: "Report",
      note: "Everything needed to work out why images, portraits or the bridge are misbehaving, "
        + "in one block you can paste into a message. It contains no card text, no names, no "
        + "chat and no prompts — Contacts appear as the first eight characters of their id and "
        + "a set of counts."
    },
      h("div", { style: { display: "flex", gap: CR_S_3, marginTop: CR_S_3 } },
        h(CrButton, {
          text: crReportRunning ? "Checking…" : "Run checks",
          primary: true, disabled: crReportRunning,
          onClick: () => { crReportBuild().catch(() => {}); }
        }),
        h(CrButton, {
          text: "Save as a file", disabled: !crReportText,
          onClick: () => { crReportSave().catch(() => {}); }
        })
      )
    ),
    crReportText
      ? h(CrSection, {
          title: "Result",
          note: "Select it all and copy, or save it as a file and send that."
        },
          h("div", { style: { marginTop: CR_S_3 } },
            h(CrTextArea, {
              value: crReportText, placeholder: "", rows: 18,
              onSet: () => { crTouch(); }
            })
          )
        )
      : h(CrEmpty, { text: "Run the checks and the result appears here." })
  );
}

const CR_GLOBAL_TABS: { id: string; label: string }[] = [
  { id: "general", label: "General" },
  { id: "editor", label: "Editor" },
  { id: "bubbles", label: "Bubbles" },
  { id: "report", label: "Report" }
];

function CrGlobalSurface(props: { st: CrUiState }) : any
